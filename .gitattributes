# Collapse captured model transcripts in PR diffs; reviews and result notes stay visible.
claude/evals/socrates-dialogue/results/**/record.json linguist-generated=true

# Collapse generated contracts and adapters in PR diffs.
design-system/generated/** linguist-generated=true
config/schema.json linguist-generated=true
config/targets.mk linguist-generated=true
nvim/lua/zellij/schema.lua linguist-generated=true
nvim/tests/zellij-protobuf.json linguist-generated=true
zellij/cli/src/ipc/contract.rs linguist-generated=true

# Claude Code rewrites settings.json in place (it is symlinked to ~/.claude).
# Strip the keys it writes as bookkeeping; `make claude` configures the filter.
.claude/settings.json filter=claude-settings

# WHY: Unified patch context contains intentional leading and trailing spaces.
patches/git-worktree-hooks/*.patch -whitespace
