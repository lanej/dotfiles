#!/bin/sh
# Keep forwarded agents scoped to the actual owning Zellij server.
# Usage: zellij-agent init
#        zellij-agent refresh SESSION
#        zellij-agent follow-popup
#        zellij-agent publish RAW_SOCKET PRIVATE_REQUEST_DIRECTORY
# Linux dash and macOS /bin/sh both support owner checks.
# shellcheck disable=SC3067
set -u
umask 077

fail() { printf 'zellij-agent: %s\n' "$*" >&2; exit 1; }

safe_directory() {
    # Existing directories must belong to us and must not be writable by others.
    [ ! -L "$1" ] || return 1
    if [ "$2" = create ] && [ ! -e "$1" ]; then
        mkdir -m 700 "$1" 2>/dev/null || [ -d "$1" ] || return 1
    fi
    [ -d "$1" ] && [ ! -L "$1" ] && [ -O "$1" ] || return 1
    permissions=$(stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null) || return 1
    case "$permissions" in ''|*[!0-7]*) return 1 ;; esac
    [ "$((0$permissions & 0022))" -eq 0 ]
}

owning_socket() {
    ancestor=$PPID
    depth=0
    while [ "$ancestor" -gt 1 ] && [ "$depth" -lt 16 ]; do
        arguments=$(ps -ww -p "$ancestor" -o command=) || return 1
        case "$arguments" in
            *' --server '*)
                executable=${arguments%% --server *}
                if [ "${executable##*/}" = zellij ]; then
                    server=${arguments#* --server }
                    # The pinned launcher optionally appends this flag.
                    server=${server% --debug}
                    case "$server" in /*) ;; *) return 1 ;; esac
                    [ -S "$server" ] && [ ! -L "$server" ] && [ -O "$server" ] || return 1
                    key=${server##*/}
                    # The pinned runtime gives each server a 12-hex persistent ID.
                    case "$key" in ''|*[!0-9a-f]*) return 1 ;; esac
                    [ "${#key}" -eq 12 ] || return 1
                    printf '%s\n' "$key"
                    return 0
                fi
                ;;
        esac
        parent=$(ps -p "$ancestor" -o ppid=) || return 1
        parent=$(printf '%s' "$parent" | tr -d '[:space:]')
        case "$parent" in ''|*[!0-9]*) return 1 ;; esac
        [ "$parent" != "$ancestor" ] || return 1
        ancestor=$parent
        depth=$((depth + 1))
    done
    return 1
}

validate_link() {
    [ -L "$link" ] || return 1
    # A disconnected forwarding socket is allowed: retain its stable name.
    [ ! -e "$link" ] || { [ -S "$link" ] && [ -O "$link" ]; }
}

managed_source() {
    # Only the one-hop stable link created by this helper is a valid source.
    # Do not resolve arbitrary symlinks or accept another follower as a source.
    directory=$HOME/.ssh/dotfiles-agent
    safe_directory "$HOME/.ssh" existing && safe_directory "$directory" existing || return 1
    [ "$permissions" = 700 ] || return 1
    case "$raw" in "$directory"/zellij-*.sock) ;; *) return 1 ;; esac
    source_key=${raw#"$directory"/zellij-}
    source_key=${source_key%.sock}
    case "$source_key" in ''|*[!0-9a-f]*) return 1 ;; esac
    [ "${#source_key}" -eq 12 ] || return 1
    [ -L "$raw" ] && [ -O "$raw" ] || return 1
    source_target=$(readlink "$raw") || return 1
    case "$source_target" in /*) ;; *) return 1 ;; esac
    [ -S "$source_target" ] && [ ! -L "$source_target" ] && [ -O "$source_target" ]
}

if { [ "${1:-}" = refresh ] && [ "$#" -eq 2 ]; } ||
   { [ "${1:-}" = follow-popup ] && [ "$#" -eq 1 ]; }; then
    session=${2:-dotfiles-popup}
    publisher=publish
    [ -n "${SSH_CONNECTION:-}" ] && [ -n "${SSH_AUTH_SOCK:-}" ] || exit 0
    raw=$SSH_AUTH_SOCK
    if [ "$1" = follow-popup ]; then
        managed_source || exit 1
        publisher=publish-popup
    else
        [ -S "$raw" ] && [ ! -L "$raw" ] && [ -O "$raw" ] || exit 1
    fi
    request=$(mktemp -d "${TMPDIR:-/tmp}/zellij-agent-update.XXXXXX") || exit 1
    trap 'rm -f "$request/success"; rmdir "$request" 2>/dev/null || :' 0
    trap 'exit 1' HUP INT TERM

    zellij --session "$session" run --floating --no-focus --close-on-exit --blocking \
        -- /bin/sh "$0" "$publisher" "$raw" "$request" </dev/null >/dev/null 2>&1 &
    updater=$!
    (
        sleep 2
        kill -TERM "$updater" 2>/dev/null || exit 0
        sleep 1
        kill -KILL "$updater" 2>/dev/null || :
    ) &
    watchdog=$!
    wait "$updater" 2>/dev/null || :
    kill "$watchdog" 2>/dev/null || :
    wait "$watchdog" 2>/dev/null || :

    # A missing session or failed helper still returns control to ordinary attach.
    [ -f "$request/success" ] && [ ! -L "$request/success" ] && [ -O "$request/success" ]
    exit $?
fi

operation=${1:-}
case "$operation:$#" in
    init:1)
        [ -n "${SSH_CONNECTION:-}" ] && [ -n "${SSH_AUTH_SOCK:-}" ] || exit 0
        raw=$SSH_AUTH_SOCK
        request=
        ;;
    publish:3|publish-popup:3)
        raw=$2
        request=$3
        if [ "$operation" = publish-popup ]; then
            [ "${ZELLIJ_SESSION_NAME:-}" = dotfiles-popup ] || fail 'not the shared popup server'
        fi
        # The caller, not the old server environment, supplies the fresh socket.
        case "$request" in /*) ;; *) fail 'request path must be absolute' ;; esac
        safe_directory "$request" existing && [ "$permissions" = 700 ] || fail 'unsafe or expired request'
        ;;
    *) fail 'usage: zellij-agent init | refresh SESSION | follow-popup | publish RAW_SOCKET PRIVATE_REQUEST_DIRECTORY' ;;
esac

key=$(owning_socket) || fail 'cannot identify the owning pinned Zellij server'
directory=$HOME/.ssh/dotfiles-agent
safe_directory "$HOME/.ssh" create || fail 'unsafe ~/.ssh directory'
safe_directory "$directory" create || fail 'unsafe forwarded-agent directory'
chmod 700 "$directory" || fail 'cannot secure forwarded-agent directory'
link=$directory/zellij-$key.sock

if [ "$operation" = init ] && [ -L "$link" ]; then
    validate_link || fail 'unsafe managed agent link'
    printf '%s\n' "$link"
    exit 0
fi
[ ! -d "$link" ] || fail 'refusing directory at managed agent path'
[ ! -e "$link" ] || [ -L "$link" ] || fail 'refusing unmanaged agent path'
case "$raw" in /*) ;; *) fail 'forwarded socket must be absolute' ;; esac
if [ "$operation" = publish-popup ] || { [ "$operation" = init ] && [ -L "$raw" ]; }; then
    [ "${ZELLIJ_SESSION_NAME:-}" = dotfiles-popup ] || fail 'only the shared popup may follow a managed agent'
    [ "$raw" != "$link" ] || fail 'cannot follow the popup itself'
    managed_source || fail 'invalid managed agent source'
else
    [ -S "$raw" ] && [ ! -L "$raw" ] && [ -O "$raw" ] || fail 'invalid raw forwarded socket'
fi

if [ "$operation" = init ]; then
    # No replacement: a stale pane cannot undo a simultaneous fresh publication.
    ln -s "$raw" "$link" 2>/dev/null || validate_link || fail 'cannot initialize session agent'
else
    temporary=$(mktemp -d "$directory/.refresh.XXXXXX") || fail 'cannot stage agent update'
    trap 'rm -f "$temporary/agent.sock"; rmdir "$temporary" 2>/dev/null || :' 0
    trap 'exit 1' HUP INT TERM
    ln -s "$raw" "$temporary/agent.sock" || fail 'cannot stage agent link'
    # Reject queued work that has not reached publication before timeout.
    # Concurrent updates to one session select the last completed publication.
    safe_directory "$request" existing && [ "$permissions" = 700 ] || fail 'expired update request'
    mv -f "$temporary/agent.sock" "$link" || fail 'cannot publish session agent'
    # Do not trust the native CLI exit status to represent this helper's result.
    (set -C; printf '%s\n' "$link" > "$request/success") || fail 'cannot acknowledge update'
fi
validate_link || fail 'unsafe session agent result'
printf '%s\n' "$link"
