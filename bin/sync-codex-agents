#!/usr/bin/env python3
"""Convert shared Claude Markdown agents into personal Codex TOML agents."""

import argparse
import json
from pathlib import Path
import re
import sys


MARKER = "# Generated by sync-codex-agents; edit the Claude source instead.\n"


def scalar(value):
    value = value.strip()
    if value.startswith('"'):
        return json.loads(value)
    if value.startswith("'") and value.endswith("'"):
        return value[1:-1].replace("''", "'")
    return value


def convert(path):
    lines = path.read_text().splitlines(keepends=True)
    if not lines or lines[0].strip() != "---":
        raise ValueError(f"{path}: missing agent frontmatter")
    fields = {}
    index = 1
    # Claude's shared tree also contains legacy agents without a closing ---.
    # In those files, the first non-metadata line starts the instruction body.
    while index < len(lines):
        line = lines[index]
        if line.strip() == "---":
            index += 1
            break
        match = re.fullmatch(r"([\w-]+):[ \t]*(.*)\n?", line)
        if not match:
            if line.strip() and not line.lstrip().startswith("#"):
                print(f"sync-codex-agents: {path}: using legacy unclosed frontmatter",
                      file=sys.stderr)
                break
            index += 1
            continue
        key, value = match.groups()
        index += 1
        if value in ("|", "|-", ">", ">-"):
            chunks = []
            while index < len(lines) and (lines[index].startswith((" ", "\t")) or
                                          not lines[index].strip()):
                chunks.append(lines[index].strip())
                index += 1
            separator = " " if value.startswith(">") else "\n"
            fields[key] = separator.join(chunks)
        else:
            fields[key] = scalar(value)

    name = fields.get("name", "")
    description = fields.get("description", "")
    body = "".join(lines[index:]).strip()
    if not re.fullmatch(r"[A-Za-z0-9_-]+", name) or not description or not body:
        raise ValueError(f"{path}: requires a valid name, description, and instructions")
    agent = {"name": name, "description": description, "developer_instructions": body}
    # Claude model aliases and tool identifiers are not Codex configuration.
    # Keep the parent's model/tools; preserve strictly read-only agents.
    tools = fields.get("tools", fields.get("allowed-tools", ""))
    if tools and set(t.strip() for t in tools.split(",")) <= {"Read", "Glob", "Grep"}:
        agent["sandbox_mode"] = "read-only"
    return name, MARKER + "".join(
        f"{key} = {json.dumps(value, ensure_ascii=False)}\n" for key, value in agent.items()
    )


def sync(source, home):
    if not source.is_dir():
        print(f"sync-codex-agents: no agent tree at {source}, skipping", file=sys.stderr)
        return
    agents = {}
    for path in sorted(source.glob("*.md")):
        if not path.exists():
            print(f"sync-codex-agents: unavailable source {path}, skipping", file=sys.stderr)
            continue
        name, content = convert(path)
        if name in agents:
            raise ValueError(f"{path}: duplicate agent name {name}")
        agents[name] = content

    destination = home / ".codex/agents"
    destination.mkdir(parents=True, exist_ok=True)
    installed = 0
    for name, content in agents.items():
        target = destination / f"{name}.toml"
        if target.is_symlink() or (target.exists() and
                                  not target.read_text().startswith(MARKER)):
            print(f"sync-codex-agents: preserving local agent {target}", file=sys.stderr)
            continue
        if not target.exists() or target.read_text() != content:
            temporary = target.with_suffix(".toml.tmp")
            temporary.write_text(content)
            temporary.replace(target)
        installed += 1
    for target in destination.glob("*.toml"):
        if (not target.is_symlink() and target.stem not in agents and
                target.read_text().startswith(MARKER)):
            target.unlink()
    print(f"sync-codex-agents: shared {installed} agents in {destination}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path,
                        default=Path(__file__).resolve().parents[1] / "claude/agents")
    parser.add_argument("--home", type=Path, default=Path.home())
    args = parser.parse_args()
    try:
        sync(args.source.expanduser().absolute(), args.home.expanduser().absolute())
    except (OSError, ValueError) as error:
        parser.exit(1, f"sync-codex-agents: {error}\n")


if __name__ == "__main__":
    main()
