#!/usr/bin/env python3
"""Pick a Zellij tab, tab swap, pane destination, session or client to detach.

Run in a floating pane with close_on_exit. Titles never become shell commands.
"""

import base64
import json
import os
from pathlib import Path
import re
import runpy
import shlex
import subprocess
import sys
import time
from typing import NamedTuple
import unicodedata


def run_zellij(*args, session=None, timeout=5):
    command = ["zellij"]
    if session is not None:
        command += ["--session=" + session]
    # Requests are complete in argv. Inherited input would become additional
    # CLI pipe messages and could replace an ownership-aware snapshot.
    result = subprocess.run(
        command + list(args), stdin=subprocess.DEVNULL,
        capture_output=True, text=True, timeout=timeout
    )
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "Zellij command failed")
    return result.stdout


def status_pipe(name, payload, *, session, timeout=5):
    # Broadcast pipes also wait for unrelated plugins that are still loading
    # or requesting permissions. Match the visible bars' configured URL and
    # empty configuration, not the clipboard receiver's distinct role.
    # Preserve this spelling: resolving the installed symlink would launch a
    # different plugin rather than address the bars already in the session.
    return run_zellij("pipe", "--plugin", "file:~/.config/zellij/plugins/lane-status.wasm",
                      "--name", name, "--", json.dumps(payload),
                      session=session, timeout=timeout)


def snapshot(session, kind, timeout=5):
    result = json.loads(run_zellij("action", f"list-{kind}", "--json", session=session, timeout=timeout))
    if not isinstance(result, list):
        raise RuntimeError(f"Zellij did not return a {kind} list")
    return result


def label(value):
    # Titles are display data, including when they contain tabs, newlines or ANSI.
    return "".join(c if c.isprintable() else " " for c in str(value))


def display_tab_name(tab, panes, *, legacy=False, owned=None):
    # Keep explicit names. Native generated names are based on stable IDs,
    # which can differ from positions after tabs close or move.
    if legacy or (tab["name"] != f"Tab #{tab['tab_id'] + 1}"
                  and (owned or {}).get(str(tab["tab_id"])) != tab["name"]):
        return label(tab["name"])
    # Native focus is aggregated across attachments, not scoped to this picker.
    focused = [pane for pane in panes if pane.get("tab_id") == tab["tab_id"]
               and pane.get("is_focused") and not pane.get("is_plugin")
               and not pane.get("is_floating") and not pane.get("is_suppressed")
               and not pane.get("exited")]
    title = label(focused[0].get("title", "")) if len(focused) == 1 else ""
    if title and not re.fullmatch(r"Pane #[0-9]+", title):
        return title
    return f"Tab #{tab['position']}"


def owned_titles(session):
    helper = runpy.run_path(str(Path(__file__).resolve().with_name("zellij-title-state")))
    return helper["owned_titles"](session)


def session_names():
    # --short includes resurrectable, exited sessions without marking them.
    # Keep only running sessions; resurrection remains in the native manager.
    names = []
    for line in run_zellij("list-sessions", "--no-formatting").splitlines():
        name, separator, metadata = line.rpartition(" [Created ")
        if not separator or not re.fullmatch(
            r".+ ago\] (?:\(current\)|\(EXITED - attach to resurrect\))?", metadata
        ):
            raise RuntimeError("Cannot parse session names; use the native session manager")
        if not metadata.endswith("(EXITED - attach to resurrect)"):
            names.append(name)
    return names


def own_pane_id():
    value = os.environ.get("ZELLIJ_PANE_ID", "")
    return int(value) if value.isdecimal() else None


class Cell(NamedTuple):
    text: str
    style: tuple = ()


def update_style(style, parameters):
    codes = [int(value or "0") for value in parameters.split(";")]
    resets = {
        22: (1, 2), 23: (3,), 24: (4, 21), 25: (5, 6),
        27: (7,), 28: (8,), 29: (9,), 39: (38,), 49: (48,), 59: (58,),
    }
    index = 0
    while index < len(codes):
        code = codes[index]
        index += 1
        if code == 0:
            style.clear()
        elif code in resets:
            for key in resets[code]:
                style.pop(key, None)
        elif code in (38, 48, 58):
            if index >= len(codes):
                break
            mode = codes[index]
            count = {2: 4, 5: 2}.get(mode)
            if count is None or index + count > len(codes):
                break
            style[code] = (code, *codes[index:index + count])
            index += count
        elif 30 <= code <= 37 or 90 <= code <= 97:
            style[38] = (code,)
        elif 40 <= code <= 47 or 100 <= code <= 107:
            style[48] = (code,)
        elif 1 <= code <= 9 or code == 21:
            style[code] = (code,)
    return tuple(value for key in sorted(style) for value in style[key])


def screen_rows(text, width, ansi=False):
    """Wrap printable text into terminal cells without splitting wide glyphs."""
    rows, cells, style = [], [], {}
    active = ()
    # WHY: Preserve only text styles; cursor movement and OSC commands cannot enter fzf.
    tokens = r"\x1b\[[0-?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\n|."
    for token in re.finditer(tokens, text, re.DOTALL):
        character = token.group()
        if character.startswith("\x1b"):
            sgr = re.fullmatch(r"\x1b\[([0-9;]*)m", character)
            if ansi and sgr:
                active = update_style(style, sgr[1])
            continue
        if character == "\n":
            rows.append(cells + [Cell(" ")] * (width - len(cells)))
            cells = []
            continue
        if not character.isprintable():
            character = " "
        if unicodedata.category(character) in ("Mn", "Me"):
            if cells:
                index = -2 if cells[-1].text == "" else -1
                cells[index] = cells[index]._replace(text=cells[index].text + character)
            continue
        size = 2 if unicodedata.east_asian_width(character) in ("W", "F") else 1
        if size > width:
            character, size = "?", 1
        if len(cells) + size > width:
            rows.append(cells + [Cell(" ")] * (width - len(cells)))
            cells = []
        cells.append(Cell(character, active))
        if size == 2:
            cells.append(Cell(""))
    if cells or not rows:
        rows.append(cells + [Cell(" ")] * (width - len(cells)))
    return rows


def render_rows(rows):
    rendered = []
    for row in rows:
        active, line = (), []
        for cell in row:
            if not cell.text:
                continue
            if cell.style != active:
                line.append("\x1b[0m")
                if cell.style:
                    line.append("\x1b[" + ";".join(map(str, cell.style)) + "m")
                active = cell.style
            line.append(cell.text)
        rendered.append("".join(line) + "\x1b[0m")
    return "\n".join(rendered)


def pane_title(pane):
    title = label(pane.get("title", ""))
    title = re.sub(r"\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F-]+(?:\.{3}|…)?", "", title)
    return " | ".join(part.strip() for part in title.split("|") if part.strip())


def pane_screen(session, pane):
    try:
        return run_zellij(
            "action", "dump-screen", "--ansi", "--pane-id", f"terminal_{pane['id']}",
            session=session
        ).rstrip()
    except RuntimeError as error:
        return f"Preview unavailable: {label(error)}"


def preview_tab(session, tab_id):
    own_id = own_pane_id() if session == os.environ.get("ZELLIJ_SESSION_NAME") else None
    panes = [
        pane
        for pane in snapshot(session, "panes")
        if pane.get("tab_id") == tab_id
        and not pane.get("is_plugin")
        and not pane.get("is_suppressed")
        and pane["id"] != own_id
    ]
    if not panes:
        print("No other terminal pane in this tab.")
        return
    tab = next((tab for tab in snapshot(session, "tabs") if tab["tab_id"] == tab_id), None)
    if tab is None:
        print("Tab closed while loading preview.")
        return
    panes = [pane for pane in panes
             if not pane.get("is_floating") or tab.get("are_floating_panes_visible")]
    fullscreen = any(pane.get("is_fullscreen") for pane in panes)
    panes = [pane for pane in panes
             if not fullscreen or pane.get("is_fullscreen") or pane.get("is_floating")]
    if not panes:
        print("No visible terminal pane in this tab.")
        return
    width = max(1, int(os.environ.get("FZF_PREVIEW_COLUMNS", "100")))
    height = max(1, int(os.environ.get("FZF_PREVIEW_LINES", "30")))
    left = min(pane["pane_x"] for pane in panes)
    top = min(pane["pane_y"] for pane in panes)
    span_x = max(pane["pane_x"] + pane["pane_columns"] for pane in panes) - left
    span_y = max(pane["pane_y"] + pane["pane_rows"] for pane in panes) - top
    rectangles = []
    for pane in panes:
        x = round((pane["pane_x"] - left) * width / span_x)
        y = round((pane["pane_y"] - top) * height / span_y)
        right = round((pane["pane_x"] + pane["pane_columns"] - left) * width / span_x)
        bottom = round((pane["pane_y"] + pane["pane_rows"] - top) * height / span_y)
        rectangles.append((pane, x, y, right, bottom))
    if any(right - x < 4 or bottom - y < 4 for _, x, y, right, bottom in rectangles):
        rows = []
        per_pane = max(1, height // len(panes))
        for pane in sorted(panes, key=lambda pane: (pane["pane_y"], pane["pane_x"])):
            rows.append(screen_rows(f"{pane['id']}: {pane_title(pane)}", width)[0])
            if per_pane > 1:
                rows.extend(screen_rows(pane_screen(session, pane), width, ansi=True)[-(per_pane - 1):])
        if len(rows) > height:
            rows = rows[:height - 1] + [screen_rows("More panes; enlarge preview", width)[0]]
        print(render_rows(rows))
        return
    canvas = [[Cell(" ")] * width for _ in range(height)]
    # WHY: Draw floating panes last so the snapshot reflects their visible overlay.
    for pane, x, y, right, bottom in sorted(
        rectangles, key=lambda rect: (rect[0].get("is_floating", False), rect[0]["id"])
    ):
        columns, lines = right - x, bottom - y
        inner = columns - 2
        for row in range(y, bottom):
            if canvas[row][x].text == "" and x:
                canvas[row][x - 1] = Cell(" ")
            if right < width and canvas[row][right].text == "":
                canvas[row][right] = Cell(" ")
            canvas[row][x:right] = [Cell("│")] + [Cell(" ")] * inner + [Cell("│")]
        canvas[y][x:right] = [Cell("┌")] + [Cell("─")] * inner + [Cell("┐")]
        canvas[bottom - 1][x:right] = [Cell("└")] + [Cell("─")] * inner + [Cell("┘")]
        marker = "*" if pane.get("is_focused") else ""
        title = f" {marker}{pane['id']}: {pane_title(pane)} "
        canvas[y][x + 1:right - 1] = screen_rows(title, inner)[0]
        command = label(pane.get("pane_command") or "terminal")
        cwd = Path(pane.get("pane_cwd") or "").name
        canvas[y + 1][x + 1:right - 1] = screen_rows(f"{command} | {cwd}", inner)[0]
        rows = screen_rows(pane_screen(session, pane), inner, ansi=True)
        available = lines - 3
        if len(rows) > available:
            rows = [screen_rows("↑ earlier screen lines", inner)[0]] + rows[-(available - 1):]
        for index, row in enumerate(rows[:available]):
            canvas[y + 2 + index][x + 1:right - 1] = row
    print(render_rows(canvas))


def preview_session(session):
    owned = owned_titles(session)
    tabs = snapshot(session, "tabs")
    panes = snapshot(session, "panes")
    legacy = (Path.home() / ".config/zellij/config.kdl").resolve().name == "config-legacy.kdl"
    for tab in sorted(tabs, key=lambda tab: tab["position"]):
        marker = "*" if tab.get("active") else " "
        print(f"{marker} {tab['position'] + int(legacy)}: {display_tab_name(tab, panes, legacy=legacy, owned=owned)}")


def choose(rows, heading, preview=None):
    # fzf shell-quotes its {1} replacement. Only an integer or base64 token is
    # ever in that column; untrusted names never become command text.
    preview_args = []
    if preview:
        preview_command = shlex.join([sys.executable, str(Path(__file__).resolve()), preview])
        window = "right:70%:border-left" if preview == "--preview-tab" else "right:60%"
        preview_args = ["--preview=" + preview_command + " {1}", "--preview-window=" + window]
    result = subprocess.run(
        [
            "fzf", "--height=100%", "--reverse", "--no-multi",
            "--delimiter=\t", "--with-nth=2..", "--header=" + heading,
            "--color=dark,pointer:#d787d7,header:#d787d7,hl+:#ffafaf",
            *preview_args,
        ],
        input="\n".join(rows) + "\n", stdout=subprocess.PIPE, text=True,
    )
    if result.returncode in (1, 130):
        return None
    if result.returncode:
        raise RuntimeError(f"fzf exited with status {result.returncode}")
    return result.stdout.split("\t", 1)[0].strip()


def client_choices(session):
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        try:
            output = status_pipe("lane-client-snapshot", {"auto_titles": owned_titles(session)},
                                 session=session, timeout=max(0.01, deadline - time.monotonic()))
            rows = [json.loads(line) for line in output.splitlines() if line.strip()]
            for row in rows:
                if row.get("error"):
                    raise RuntimeError(row["error"])
            # A new attachment can render its shell before its plugin clone is
            # ready. Use native tab metadata, which includes scrollback-editor
            # clients, to require a complete read rather than a partial picker.
            tabs = snapshot(session, "tabs", timeout=max(0.01, deadline - time.monotonic()))
            attached = {str(client) for tab in tabs for client in tab["other_focused_clients"]}
            choices = {str(row["token"]["client_id"]): row for row in rows
                       if str(row["token"]["client_id"]) in attached}
            if attached and choices.keys() == attached:
                return choices
        except (subprocess.TimeoutExpired, json.JSONDecodeError):
            pass
        # Retry only the read. Never merge tokens from different snapshots or
        # replay a detach: its result can be lost after the mutation succeeds.
        time.sleep(min(0.1, max(0, deadline - time.monotonic())))
    raise RuntimeError("Timed out waiting for all attached clients. Check lane-status permission prompts on each attached client, then reopen the chooser")


def pick_client(session):
    print("Loading attached clients...", flush=True)
    choices = client_choices(session)
    selected = choose(
        [f"{key}	Client {key} | {label(row.get('tab') or '')} | {label(row.get('pane') or '')}"
         for key, row in sorted(choices.items(), key=lambda item: int(item[0]))],
        "Detach one client: Enter confirms; Esc cancels",
    )
    if selected is None:
        return
    if selected not in choices:
        raise RuntimeError("Invalid client selection")
    # The receiver compares its native attachment and plugin identity, then
    # queries native focus again. Never disconnect all other clients.
    reply = status_pipe("lane-client-detach", choices[selected]["token"], session=session).strip()
    if reply != "detached":
        raise RuntimeError(reply or "The selected attachment changed; reopen the client chooser")


def pick_tab(session):
    owned = owned_titles(session)
    tabs = snapshot(session, "tabs")
    panes = snapshot(session, "panes")
    pane_id = own_pane_id()
    source_tab = next(
        (pane.get("tab_id") for pane in panes
         if not pane.get("is_plugin") and pane["id"] == pane_id), None
    )
    priorities = {"NeedsYou": 0, "Failed": 0, "Done": 1, "Working": 2}
    tabs.sort(key=lambda tab: (
        priorities.get(tab.get("attention", {}).get("status"),
                       0 if tab.get("has_bell_notification") else 3), tab["position"]))
    choices = {str(tab["tab_id"]): tab for tab in tabs}
    rows = []
    legacy = (Path.home() / ".config/zellij/config.kdl").resolve().name == "config-legacy.kdl"
    for token, tab in choices.items():
        flags = " [current]" if tab["tab_id"] == source_tab else ""
        if tab.get("has_bell_notification"):
            flags += " [bell]"
        rows.append(f"{token}\t{tab['position'] + int(legacy)}: {display_tab_name(tab, panes, legacy=legacy, owned=owned)}{flags}")
    token = choose(rows, "Tabs (attention first)", "--preview-tab")
    if token is None:
        return
    if token not in choices or not any(
        str(tab["tab_id"]) == token for tab in snapshot(session, "tabs")
    ):
        raise RuntimeError("The selected tab no longer exists")
    run_zellij("action", "go-to-tab-by-id", token, session=session)


def swap_order(tabs):
    tabs = sorted(tabs, key=lambda tab: tab["position"])
    order = [tab["tab_id"] for tab in tabs]
    if len(set(order)) != len(order) or [tab["position"] for tab in tabs] != list(range(len(tabs))):
        raise RuntimeError("Tab positions are inconsistent; reopen the swap picker")
    return order


def check_swap_state(session, order, source_tab, source_id, picker_id, token):
    # Attachment tokens remain stable across position/name updates. Aggregate
    # is_focused/active flags cannot identify the requesting client.
    # Discovery may elect a different bar as cached manifests catch up. Pin
    # subsequent read-only queries to the captured instance; never substitute
    # a new token after a reload, detach, missing reply or focus change.
    output = status_pipe("lane-client-snapshot",
                         {"auto_titles": owned_titles(session), "token": token}, session=session)
    rows = [json.loads(line) for line in output.splitlines() if line.strip()]
    for row in rows:
        if row.get("error"):
            raise RuntimeError(row["error"])
    if len(rows) != 1 or rows[0].get("token") != token:
        raise RuntimeError("The captured attachment snapshot was not confirmed")
    if rows[0].get("pane_id") != f"terminal_{picker_id}":
        raise RuntimeError(f"Picker terminal_{picker_id} lost its requesting client; "
                           f"observed pane: {rows[0].get('pane_id')}")
    panes = snapshot(session, "panes")
    for pane_id in (source_id, picker_id):
        if not any(not p["is_plugin"] and p["id"] == pane_id and
                   p["tab_id"] == source_tab and not p["is_suppressed"] for p in panes):
            raise RuntimeError("The original pane or picker changed tabs or closed")
    if swap_order(snapshot(session, "tabs")) != order:
        raise RuntimeError("Tab order or membership changed")


def swap_tab(session):
    """Exchange endpoint positions, never insert or change any client's tab ID.

    Native adjacent moves are non-atomic. Check the complete expected order
    around every single-shot move; never cross an endpoint (native moves wrap).
    A concurrent change between a read and action remains possible. Stop on any
    uncertainty, retaining the partial order for inspection rather than undoing
    other clients' work or replaying a move whose reply was lost. Closing the
    picker can kill this helper before it can display its partial-order warning.
    """
    if (Path.home() / ".config/zellij/config.kdl").resolve().name == "config-legacy.kdl":
        raise RuntimeError("Tab swap needs the status plugin and pinned runtime; run make zellij-status zellij and restart this session")
    origin = os.environ.get("ZELLIJ_ORIGIN_PANE_ID", "")
    if not re.fullmatch(r"terminal_[0-9]+", origin):
        raise RuntimeError("Tab swap needs the pinned runtime; restart this session after make zellij-runtime")
    source_id, picker_id = int(origin.removeprefix("terminal_")), own_pane_id()
    panes = snapshot(session, "panes")
    source = next((p for p in panes if not p["is_plugin"] and p["id"] == source_id), None)
    if source is None:
        raise RuntimeError("The original pane closed; reopen the swap picker")
    source_tab = source["tab_id"]
    owners = [row for row in client_choices(session).values()
              if row.get("pane_id") == f"terminal_{picker_id}"]
    if len(owners) != 1:
        raise RuntimeError("Cannot identify the picker’s attached client")
    token = owners[0]["token"]
    tabs = snapshot(session, "tabs")
    order = swap_order(tabs)
    check_swap_state(session, order, source_tab, source_id, picker_id, token)
    owned = owned_titles(session)
    selected = choose([
        f"{tab['tab_id']}\t{tab['position']}: {display_tab_name(tab, panes, owned=owned)}" +
        (" [current]" if tab["tab_id"] == source_tab else "")
        for tab in sorted(tabs, key=lambda tab: tab["position"])
    ], "Swap tab positions", "--preview-tab")
    if selected is None:
        return
    if selected not in {str(tab_id) for tab_id in order}:
        raise RuntimeError("Invalid swap destination")
    destination = int(selected)
    check_swap_state(session, order, source_tab, source_id, picker_id, token)
    a, b = order.index(source_tab), order.index(destination)
    if a == b:
        return
    step = 1 if a < b else -1
    distance = abs(b - a)
    final_order = order.copy()
    final_order[a], final_order[b] = final_order[b], final_order[a]
    attempted = False
    try:
        for tab_id, delta, count in ((source_tab, step, distance), (destination, -step, distance - 1)):
            for _ in range(count):
                check_swap_state(session, order, source_tab, source_id, picker_id, token)
                index = order.index(tab_id)
                neighbor = index + delta
                if not 0 <= neighbor < len(order):
                    raise RuntimeError("Refusing a wrapping tab move")
                expected = order.copy()
                expected[index], expected[neighbor] = expected[neighbor], expected[index]
                attempted = True
                command_error = None
                try:
                    run_zellij("action", "move-tab", "right" if delta > 0 else "left",
                               "--tab-id", str(tab_id), session=session)
                except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
                    command_error = error
                # Even a successful CLI exit is not proof of the requested order.
                # Inspect after a failed/unknown command too, but never continue it.
                try:
                    check_swap_state(session, expected, source_tab, source_id, picker_id, token)
                except (OSError, RuntimeError, ValueError, KeyError, IndexError,
                        subprocess.TimeoutExpired) as error:
                    if command_error is not None:
                        raise RuntimeError(f"Move command: {command_error}; inspection: {error}") from error
                    raise
                if command_error is not None:
                    raise RuntimeError(f"Move command failed despite observed order: {command_error}")
                order = expected
        if order != final_order:
            raise RuntimeError("Endpoint swap was not confirmed")
    except (OSError, RuntimeError, ValueError, KeyError, IndexError,
            subprocess.TimeoutExpired, KeyboardInterrupt) as error:
        if attempted:
            raise RuntimeError(f"Tab swap stopped; tabs may be partially reordered. Inspect their positions before retrying. No rollback was attempted. {error}") from error
        raise


def move_pane(session):
    # Zellij records the originating pane before it opens this floating command.
    # Never infer it from mutable focus or from the picker’s own pane ID.
    if (Path.home() / ".config/zellij/config.kdl").resolve().name == "config-legacy.kdl":
        raise RuntimeError("The move picker needs the status plugin and pinned runtime; run make zellij-status zellij and restart this session")
    origin = os.environ.get("ZELLIJ_ORIGIN_PANE_ID", "")
    if not re.fullmatch(r"terminal_[0-9]+", origin):
        raise RuntimeError("The move picker requires the pinned Zellij runtime; restart this session after make zellij-runtime")
    source_id, picker_id = int(origin.removeprefix("terminal_")), own_pane_id()
    panes = snapshot(session, "panes")
    source = next((p for p in panes if not p["is_plugin"] and p["id"] == source_id), None)
    picker = next((p for p in panes if not p["is_plugin"] and p["id"] == picker_id), None)
    if not source or not picker or source["tab_id"] != picker["tab_id"]:
        raise RuntimeError("The original pane changed; reopen the move picker")
    owners = [row for row in client_choices(session).values()
              if row.get("pane_id") == f"terminal_{picker_id}"]
    if len(owners) != 1:
        raise RuntimeError("Cannot identify the picker’s attached client; reopen the move picker")
    owned = owned_titles(session)
    choices = {str(tab["tab_id"]): tab for tab in snapshot(session, "tabs")}
    rows = ["new\tNew Tab"] + [
        f"{key}\t{tab['position']}: {display_tab_name(tab, panes, owned=owned)}" +
        (" [current]" if tab["tab_id"] == source["tab_id"] else "")
        for key, tab in sorted(choices.items(), key=lambda item: item[1]["position"])
    ]
    selected = choose(rows, "Move pane to tab", "--preview-move")
    if selected is None:
        return
    if selected != "new" and selected not in choices:
        raise RuntimeError("Invalid destination selection")
    if selected != "new" and not any(str(tab["tab_id"]) == selected
                                     for tab in snapshot(session, "tabs")):
        raise RuntimeError("The destination tab closed; reopen the move picker")
    if not any(not p["is_plugin"] and p["id"] == source_id and
               p["tab_id"] == source["tab_id"] and not p["is_suppressed"]
               for p in snapshot(session, "panes")):
        raise RuntimeError("The original pane changed; reopen the move picker")
    request = {"token": owners[0]["token"], "source": source_id,
               "source_tab": source["tab_id"], "picker": picker_id,
               "destination": None if selected == "new" else int(selected)}
    # Single-shot mutation. A lost reply must never replay a pane transfer.
    reply = status_pipe("lane-move-pane", request, session=session).strip()
    if reply != "moved":
        raise RuntimeError(reply or "Pane transfer was not confirmed; inspect the tabs before retrying")


def pick_session(session):
    choices = {
        base64.urlsafe_b64encode(name.encode()).decode(): name
        for name in session_names()
    }
    rows = [
        f"{token}\t{label(name)}" + (" [current]" if name == session else "")
        for token, name in choices.items()
    ]
    token = choose(rows, "Running sessions", "--preview-session")
    if token is None:
        return
    destination = choices.get(token)
    if destination is None or destination not in session_names():
        raise RuntimeError("The selected session is no longer running")
    if destination != session:
        run_zellij("action", "switch-session", "--", destination, session=session)


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in (
        "tabs", "swap-tab", "move-pane", "sessions", "clients", "--preview-tab", "--preview-move", "--preview-session"
    ):
        raise RuntimeError("Usage: zellij-picker tabs|swap-tab|move-pane|sessions|clients (inside Zellij)")
    session = os.environ.get("ZELLIJ_SESSION_NAME")
    if not session:
        raise RuntimeError("Run zellij-picker inside a Zellij session")
    mode = sys.argv[1]
    if mode == "--preview-move" and sys.argv[2] == "new":
        print("Move the original live pane to a new tab.")
    elif mode in ("--preview-tab", "--preview-move"):
        preview_tab(session, int(sys.argv[2]))
    elif mode == "--preview-session":
        preview_session(base64.urlsafe_b64decode(sys.argv[2]).decode())
    elif mode == "tabs":
        pick_tab(session)
    elif mode == "swap-tab":
        swap_tab(session)
    elif mode == "move-pane":
        move_pane(session)
    elif mode == "clients":
        pick_client(session)
    else:
        pick_session(session)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except (OSError, RuntimeError, ValueError, KeyError, IndexError, subprocess.TimeoutExpired) as error:
        print(f"zellij-picker: {error}", file=sys.stderr)
        if len(sys.argv) > 1 and not sys.argv[1].startswith("--preview") and sys.stdin.isatty():
            input("Press Enter to close.")
        sys.exit(1)
