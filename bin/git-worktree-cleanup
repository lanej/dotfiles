#!/usr/bin/env bash
# Preview or remove idle, merged worktrees for one repository or a project tree.
set -euo pipefail

AGE_HOURS="${WORKTREE_CLEANUP_AGE_HOURS:-24}"
BASE_BRANCH="${WORKTREE_CLEANUP_BASE_BRANCH:-}"
APPLY=0
RECHECK=0
REFRESH=0
WIP_PUSH=0
JSON=0
INTEGRATED=0
TARGET_WORKTREE=""
CONFLICT_FILES=5
target_seen=0
SIZE_CACHE_SECONDS=900
SIZE_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/git-worktree-cleanup"

usage() {
    cat <<'EOF'
Usage: git-worktree-cleanup [-a HOURS] [-b BRANCH] [-y] [--refresh] [--wip-push] [--json] [DIRECTORY]
       git-worktree-cleanup [OPTIONS] --worktree PATH

Inside a repository, checks its registered worktrees wherever they live on disk.
Otherwise, discovers repositories recursively below the current directory.
Pass DIRECTORY to scan that project tree from anywhere, e.g. ~/src.
Linked checkouts of the same repository are checked only once. Dependency,
build, and managed worktree directories are excluded from repository discovery.
Discovery stops at each repository; repositories nested inside it are excluded.

Only idle, clean worktrees merged into their repository's base branch whose
HEAD commit is older than the age threshold are eligible. Primary and locked worktrees are
retained, as are ignored files other than disposable dependency/build caches.
Requires lsof to check for processes using a worktree. Dry-run by default;
eligibility is checked again before removal. Branches are never deleted.
With --integrated, also accepts a named branch whose complete file tree is
identical to the base's file tree.
The branch must retain HEAD, preserving its original commits after squash or
rebase integration. Detached non-ancestor commits are retained.
With --wip-push, idle worktrees can instead be preserved on unique wip/cleanup
branches, including dirty and unmerged work. Only GitHub push URLs owned by
easypost-sandbox are allowed. Changes are committed, pushed, and verified before
removal. The age threshold applies to HEAD before the WIP commit. Ignored
artifacts, locks, active processes, and unfinished Git operations still prevent
cleanup. Dry-run shows the proposed recovery branch without committing or pushing.

Shows allocated disk usage; the combined reclaimable total includes only
removal candidates. Actual savings may vary with shared filesystem blocks.
Rows are sorted by disk usage, smallest first; unknown sizes are listed last.
Sizes are cached for 15 minutes under $XDG_CACHE_HOME/git-worktree-cleanup
(default: ~/.cache/git-worktree-cleanup). AGE shows HEAD commit age;
SIZE AGE shows disk-estimate freshness.
Directory identity changes invalidate cached sizes. Eligibility is never cached.
Terminal progress is shown on stderr; colors respect NO_COLOR.
Checks for unresolved index conflicts and whether unmerged HEADs conflict
with the base branch, without changing working files (requires Git 2.38+).
Below the table, merge conflicts list the top five files by combined changed
lines on HEAD and the base since their common ancestor, with per-side +/- stats.
Binary or unavailable line counts are labeled; omitted files are counted.
CODEX SESSION shows the most recently updated primary conversation matching
the worktree path (or a subdirectory), plus a count of other matches. Reads
Codex's local state database without modifying it; unavailable metadata is labeled.

  -a HOURS   minimum HEAD commit age (default: 24h; env WORKTREE_CLEANUP_AGE_HOURS)
  -b BRANCH  base ref for every repository (default: each repository's
             origin/HEAD, else local main/master; env WORKTREE_CLEANUP_BASE_BRANCH)
  -y         actually remove; without this, only lists candidates
  --refresh  remeasure sizes and update their cache entries
  --wip-push preserve work on an easypost-sandbox remote before removal
  --json     emit a structured dry-run report (requires uv; excludes -y/--wip-push)
  --worktree PATH  inspect only this registered checkout; excludes DIRECTORY
  --integrated    also accept changes already integrated into the base
  --conflict-files N  maximum files per merge-conflict report (default: 5)
  -h         show this help
EOF
}

while getopts ":a:b:yh-:" opt; do
    case "$opt" in
        a) AGE_HOURS="$OPTARG" ;;
        b) BASE_BRANCH="$OPTARG" ;;
        y) APPLY=1 ;;
        h) usage; exit 0 ;;
        -) case "$OPTARG" in
               refresh) REFRESH=1 ;;
               wip-push) WIP_PUSH=1 ;;
               json) JSON=1 ;;
               integrated) INTEGRATED=1 ;;
               conflict-files)
                   [[ "$OPTIND" -le $# ]] || { usage >&2; exit 1; }
                   CONFLICT_FILES="${!OPTIND}"
                   OPTIND=$(( OPTIND + 1 ))
                   ;;
               worktree)
                   [[ "$OPTIND" -le $# ]] || { usage >&2; exit 1; }
                   TARGET_WORKTREE="${!OPTIND}"
                   OPTIND=$(( OPTIND + 1 ))
                   [[ -n "$TARGET_WORKTREE" ]] || { usage >&2; exit 1; }
                   ;;
               *) usage >&2; exit 1 ;;
           esac ;;
        *) usage >&2; exit 1 ;;
    esac
done
shift $((OPTIND - 1))
[[ $# -le 1 ]] || { usage >&2; exit 1; }
if [[ "$JSON" -eq 1 && ( "$APPLY" -eq 1 || "$WIP_PUSH" -eq 1 ) ]]; then
    echo "error: --json supports inspection only; omit -y and --wip-push" >&2
    exit 1
fi
[[ "$AGE_HOURS" =~ ^[0-9]+$ ]] \
    || { echo "error: age must be a nonnegative integer" >&2; exit 1; }
[[ "$CONFLICT_FILES" =~ ^[0-9]{1,6}$ ]] \
    || { echo "error: conflict-files must be a nonnegative integer up to 999999" >&2; exit 1; }
CONFLICT_FILES=$(( 10#$CONFLICT_FILES ))
SCAN_TREE=1
if [[ -n "$TARGET_WORKTREE" ]]; then
    [[ $# -eq 0 ]] || { echo "error: --worktree excludes DIRECTORY" >&2; exit 1; }
    TARGET_WORKTREE="$(cd "$TARGET_WORKTREE" && pwd -P)"
    ROOT="$(git -C "$TARGET_WORKTREE" rev-parse --show-toplevel)"
    [[ "$ROOT" == "$TARGET_WORKTREE" ]] || { echo "error: specify the checkout root" >&2; exit 1; }
    SCAN_TREE=0
elif [[ $# -eq 0 ]] && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    ROOT="$(git rev-parse --show-toplevel)"
    SCAN_TREE=0
else
    ROOT="${1:-$PWD}"
fi
[[ -d "$ROOT" ]] || { echo "error: not a directory: $ROOT" >&2; exit 1; }
ROOT="$(cd "$ROOT" && pwd -P)"
REQUESTED_BASE="$BASE_BRANCH"
AGE_SECONDS=$(( 10#$AGE_HOURS * 3600 ))
NOW=$(date +%s)

if [[ "$JSON" -eq 0 ]]; then
    echo "Project root:  $ROOT"
    echo "Age threshold: ${AGE_HOURS}h"
    echo "Mode:          $([[ $APPLY -eq 1 ]] && echo REMOVE || echo "dry-run (pass -y to remove)")"
    [[ "$WIP_PUSH" -eq 0 ]] || echo "WIP-push owner: easypost-sandbox"
    echo
fi

to_remove=() removal_repos=() removal_bases=() removal_primaries=()
removal_urls=() removal_branches=()
repositories=() repository_ids=()
repositories_checked=0 errors=0
row_status=() row_reason=() row_size=() row_path=()
row_repo=() row_base=()
row_age=() row_age_seconds=()
row_codex=()
row_size_age=()
row_push=()
row_kib=()
status_width=6 reason_width=6 size_width=11
repo_width=10 base_width=4 size_age_width=8
age_width=3
codex_width=13
push_width=7
reclaim_kib=0 unknown_sizes=0
GREEN="" YELLOW="" CYAN="" RED="" MAGENTA="" BLUE="" GRAY="" RESET=""
if [[ -t 1 && -z "${NO_COLOR+x}" && "${TERM:-dumb}" != dumb ]]; then
    GREEN=$'\033[32m' YELLOW=$'\033[33m' CYAN=$'\033[36m' RESET=$'\033[0m'
    RED=$'\033[31m' MAGENTA=$'\033[35m' BLUE=$'\033[34m' GRAY=$'\033[90m'
fi

cache_ready=0
if [[ ! -L "$SIZE_CACHE_DIR" ]] \
    && (umask 077; mkdir -p "$SIZE_CACHE_DIR" 2>/dev/null) \
    && [[ -O "$SIZE_CACHE_DIR" && -w "$SIZE_CACHE_DIR" ]]; then
    cache_ready=1
fi

spinner_pid=""
checked_worktrees=0
scratch="$(mktemp -d "${TMPDIR:-/tmp}/worktree-cleanup.XXXXXX")"

stop_spinner() {
    if [[ -n "$spinner_pid" ]]; then
        kill "$spinner_pid" 2>/dev/null || true
        wait "$spinner_pid" 2>/dev/null || true
        spinner_pid=""
        printf '\r\033[K' >&2
    fi
}
# Invoked by the EXIT trap.
# shellcheck disable=SC2329
cleanup() {
    stop_spinner
    rm -r -- "$scratch"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

start_spinner() {
    [[ -t 2 && "${TERM:-dumb}" != dumb ]] || return 0
    stop_spinner
    local progress="$*"
    printf '\r\033[K%s' "$*" >&2
    (
        frames=( '|' '/' '-' $'\\' )
        i=0
        while :; do
            printf '\r\033[K%s%s%s %s' "$CYAN" "${frames[i%4]}" "$RESET" "$progress" >&2
            i=$(( i + 1 ))
            sleep 0.2
        done
    ) &
    spinner_pid=$!
}

check_worktree() {
    if [[ -n "$TARGET_WORKTREE" ]]; then
        [[ "$1" == "$TARGET_WORKTREE" ]] || return 0
        target_seen=1
    fi
    [[ "$1" == "$PRIMARY_WORKTREE" ]] && return 0
    checked_worktrees=$(( checked_worktrees + 1 ))
    start_spinner "Scanning repositories $repositories_checked/${#repositories[@]}; worktrees checked: $checked_worktrees..."
    evaluate "$@"
}

human_size() {
    awk -v kib="$1" 'BEGIN {
        split("KiB MiB GiB TiB PiB", units, " ")
        i = 1
        while (kib >= 1024 && i < 5) { kib /= 1024; i++ }
        printf "%.1f %s", kib, units[i]
    }'
}

human_age() {
    local seconds="$1" prefix=""
    if (( seconds < 0 )); then
        prefix="in "
        seconds=$(( -seconds ))
    fi
    if (( seconds >= 31536000 )); then
        printf '%s%sy %sd' "$prefix" "$(( seconds / 31536000 ))" "$(( seconds % 31536000 / 86400 ))"
    elif (( seconds >= 86400 )); then
        printf '%s%sd %sh' "$prefix" "$(( seconds / 86400 ))" "$(( seconds % 86400 / 3600 ))"
    elif (( seconds >= 3600 )); then
        printf '%s%sh %sm' "$prefix" "$(( seconds / 3600 ))" "$(( seconds % 3600 / 60 ))"
    elif (( seconds >= 60 )); then
        printf '%s%sm %ss' "$prefix" "$(( seconds / 60 ))" "$(( seconds % 60 ))"
    else
        printf '%s%ss' "$prefix" "$seconds"
    fi
}

size_cache_file() {
    local key
    CACHE_FILE=""
    [[ "$cache_ready" -eq 1 ]] || return 0
    if key="$(printf '%s' "$1" | git hash-object --stdin 2>/dev/null)" \
        && [[ "$key" =~ ^[0-9a-f]{40,64}$ ]]; then
        CACHE_FILE="$SIZE_CACHE_DIR/$key"
    fi
}

measure_size() {
    local path="$1" canonical identity="" when kib version saved_at saved_identity saved_kib extra elapsed temp
    MEASURED_KIB="" MEASURED_AGE="-"
    canonical="$(cd "$path" 2>/dev/null && pwd -P)" || canonical="$path"
    size_cache_file "$canonical"
    if [[ ! -d "$path" ]]; then
        [[ -z "$CACHE_FILE" ]] || rm -f -- "$CACHE_FILE" 2>/dev/null || true
        return 0
    fi
    # GNU and BSD stat both follow links, so aliases share the canonical entry.
    if ! identity="$(stat -L -c '%d:%i:%W' "$canonical" 2>/dev/null)"; then
        identity="$(stat -L -f '%d:%i:%B' "$canonical" 2>/dev/null)" || identity=""
    fi
    when="$(date +%s)"
    if [[ "$REFRESH" -eq 0 && -n "$identity" && -n "$CACHE_FILE" \
        && -f "$CACHE_FILE" && ! -L "$CACHE_FILE" ]] \
        && IFS=' ' read -r version saved_at saved_identity saved_kib extra 2>/dev/null < "$CACHE_FILE" \
        && [[ "$version" == v1 && "$saved_identity" == "$identity" && -z "$extra" \
        && "$saved_at" =~ ^[0-9]{1,12}$ && "$saved_kib" =~ ^[0-9]{1,15}$ ]]; then
        elapsed=$(( when - 10#$saved_at ))
        if (( elapsed >= 0 && elapsed < SIZE_CACHE_SECONDS )); then
            MEASURED_KIB=$(( 10#$saved_kib ))
            if (( elapsed < 60 )); then
                MEASURED_AGE="cached ${elapsed}s"
            else
                MEASURED_AGE="cached $(( elapsed / 60 ))m"
            fi
            return 0
        fi
    fi
    # A failed refresh must not leave a previously valid estimate reusable.
    [[ -z "$CACHE_FILE" ]] || rm -f -- "$CACHE_FILE" 2>/dev/null || true
    if kib="$(du -sk "$canonical" 2>/dev/null)" && [[ "${kib%%[[:space:]]*}" =~ ^[0-9]+$ ]]; then
        MEASURED_KIB="${kib%%[[:space:]]*}"
        MEASURED_AGE="fresh"
        # Cache writes are optional and atomic; a failed write never affects cleanup.
        if [[ -n "$identity" && -n "$CACHE_FILE" && ! -L "$CACHE_FILE" && ! -d "$CACHE_FILE" ]] \
            && temp="$(mktemp "$SIZE_CACHE_DIR/.size.XXXXXX" 2>/dev/null)"; then
            if ! printf 'v1 %s %s %s\n' "$when" "$identity" "$MEASURED_KIB" > "$temp" \
                || ! mv -f -- "$temp" "$CACHE_FILE" 2>/dev/null; then
                rm -f -- "$temp" 2>/dev/null || true
            fi
        fi
    fi
    return 0
}

add_row() {
    local size="$3" repo="${5:-${REPOSITORY:-$4}}" base="${6:-${BASE_BRANCH:--}}" size_age="${7:--}" push="${8:--}" kib="${9:-}"
    local age_seconds="${10:-}" age="-"
    local codex
    match_codex_sessions "$4" "${#row_status[@]}"
    codex="$CODEX_SESSION"
    [[ -z "$age_seconds" ]] || age="$(human_age "$age_seconds")"
    [[ "$repo" != "$ROOT"/* ]] || repo="${repo#"$ROOT"/}"
    if [[ "$size" == - ]]; then
        measure_size "$4"
        size_age="$MEASURED_AGE"
        kib="$MEASURED_KIB"
        if [[ -n "$MEASURED_KIB" ]]; then
            size="$(human_size "$MEASURED_KIB")"
        elif [[ -d "$4" ]]; then
            size="unknown"
        fi
    fi
    row_status+=("$1") row_reason+=("$2") row_size+=("$size") row_path+=("$4")
    row_repo+=("$repo") row_base+=("$base")
    row_age+=("$age") row_age_seconds+=("$age_seconds")
    row_codex+=("$codex")
    row_size_age+=("$size_age")
    row_push+=("$push")
    row_kib+=("$kib")
    (( ${#push} > push_width )) && push_width=${#push}
    (( ${#age} > age_width )) && age_width=${#age}
    (( ${#codex} > codex_width )) && codex_width=${#codex}
    (( ${#size_age} > size_age_width )) && size_age_width=${#size_age}
    (( ${#repo} > repo_width )) && repo_width=${#repo}
    (( ${#base} > base_width )) && base_width=${#base}
    (( ${#1} > status_width )) && status_width=${#1}
    (( ${#2} > reason_width )) && reason_width=${#2}
    (( ${#size} > size_width )) && size_width=${#size}
    return 0
}

load_codex_sessions() {
    local directory="${CODEX_HOME:-$HOME/.codex}" database="" file version newest=-1
    local cwd title id updated archived normalized decoded i found
    local seen_cwds=() canonical_keys=()
    codex_metadata="absent"
    : > "$scratch/codex-sessions"
    for file in "$directory"/state_*.sqlite; do
        [[ -f "$file" ]] || continue
        version="${file##*/state_}" version="${version%.sqlite}"
        [[ "$version" =~ ^[0-9]{1,6}$ ]] || continue
        if (( 10#$version > newest )); then
            newest=$(( 10#$version ))
            database="$file"
        fi
    done
    [[ -n "$database" ]] || return 0
    codex_metadata="unavailable"
    command -v sqlite3 >/dev/null 2>&1 || return 0
    # Hex keeps tabs/newlines in titles from becoming record delimiters.
    # Modern Codex stores the sidebar title in name; older schemas use title.
    if ! sqlite3 -readonly -noheader -separator $'\t' "$database" \
        "SELECT hex(rtrim(cwd, '/')), hex(coalesce(nullif(trim(name), ''), title)),
                hex(id), updated_at, archived
         FROM threads WHERE source NOT LIKE '%subagent%'
         ORDER BY updated_at DESC, id ASC;" > "$scratch/codex-raw" 2>/dev/null; then
        if ! sqlite3 -readonly -noheader -separator $'\t' "$database" \
            "SELECT hex(rtrim(cwd, '/')), hex(title), hex(id), updated_at, archived
             FROM threads WHERE source NOT LIKE '%subagent%'
             ORDER BY updated_at DESC, id ASC;" > "$scratch/codex-raw" 2>/dev/null; then
            return 0
        fi
    fi
    while IFS=$'\t' read -r cwd title id updated archived; do
        found=-1
        for (( i=0; i<${#seen_cwds[@]}; i++ )); do
            [[ "${seen_cwds[i]}" != "$cwd" ]] || { found="$i"; break; }
        done
        if [[ "$found" -lt 0 ]]; then
            decode_hex "$cwd" || continue
            decoded="$DECODED_HEX"
            normalized="$(canonical_codex_path "$decoded")"
            normalized="$(encode_hex "$normalized")"
            seen_cwds+=("$cwd") canonical_keys+=("$normalized")
        else
            normalized="${canonical_keys[found]}"
        fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$cwd" "$normalized" "$title" "$id" \
            "$updated" "$archived" >> "$scratch/codex-sessions"
    done < "$scratch/codex-raw"
    codex_metadata="available"
}

encode_hex() {
    printf '%s' "$1" | od -An -v -tx1 | tr -d ' \n' | tr 'a-f' 'A-F'
}

decode_hex() {
    local encoded="$1" escapes=""
    [[ "$encoded" =~ ^([0-9A-Fa-f]{2})*$ ]] || return 1
    while [[ -n "$encoded" ]]; do
        escapes+="\\x${encoded:0:2}"
        encoded="${encoded:2}"
    done
    printf -v DECODED_HEX '%b' "$escapes"
}

canonical_codex_path() {
    local original="$1" path="$1" suffix="" physical
    [[ "$path" == /* ]] || { printf '%s' "$original"; return 0; }
    # Resolve the closest existing parent for archived or removed worktrees.
    while [[ ! -d "$path" && "$path" != / ]]; do
        suffix="/${path##*/}$suffix"
        path="${path%/*}"
        [[ -n "$path" ]] || path="/"
    done
    if ! physical="$(cd "$path" 2>/dev/null && pwd -P)"; then
        printf '%s' "$original"
    elif [[ -n "$suffix" ]]; then
        printf '%s%s' "${physical%/}" "$suffix"
    else
        printf '%s' "$physical"
    fi
}

match_codex_sessions() {
    local path="$1" index="$2" canonical key canonical_key cwd normalized title id updated archived count=0 display
    CODEX_SESSION="-"
    [[ "$codex_metadata" != unavailable ]] || CODEX_SESSION="unavailable"
    [[ "$codex_metadata" == available ]] || return 0
    canonical="$(canonical_codex_path "$path")"
    key="$(encode_hex "${path%/}")"
    canonical_key="$(encode_hex "${canonical%/}")"
    : > "$scratch/codex-$index.data"
    while IFS=$'\t' read -r cwd normalized title id updated archived; do
        # Require a whole path boundary, never a similar directory/branch name.
        [[ "$cwd" == "$key" || "$cwd" == "$key"2F* \
            || "$normalized" == "$canonical_key" || "$normalized" == "$canonical_key"2F* ]] || continue
        decode_hex "$title" || continue
        title="$DECODED_HEX"
        decode_hex "$id" || continue
        id="$DECODED_HEX"
        [[ "$updated" =~ ^[0-9]+$ && "$archived" =~ ^[01]$ ]] || continue
        [[ -n "$title" ]] || continue
        printf '%s\0' "$id" "$title" "$updated" "$archived" >> "$scratch/codex-$index.data"
        if [[ "$count" -eq 0 ]]; then
            display="$(printf '%s' "$title" | LC_ALL=C tr '\t\r\n' '   ' | LC_ALL=C tr -d '\000-\010\013-\037\177')"
            [[ ${#display} -le 48 ]] || display="${display:0:45}..."
            CODEX_SESSION="$display"
        fi
        count=$(( count + 1 ))
    done < "$scratch/codex-sessions"
    (( count <= 1 )) || CODEX_SESSION+=" (+$(( count - 1 )) more)"
    return 0
}

conflict_stats() {
    local ref="$1" side="$2" record added deleted file i
    if ! git --literal-pathspecs -C "$REPOSITORY" diff --numstat -z --no-renames \
        --no-ext-diff --no-textconv "$conflict_ancestor" "$ref" -- "${conflict_paths[@]}" \
        > "$scratch/conflict-stats" 2>/dev/null; then
        return 1
    fi
    while IFS= read -r -d '' record; do
        added="${record%%$'\t'*}" record="${record#*$'\t'}"
        deleted="${record%%$'\t'*}" file="${record#*$'\t'}"
        [[ "$added" =~ ^[0-9]+$ && "$deleted" =~ ^[0-9]+$ ]] \
            || [[ "$added" == - && "$deleted" == - ]] || return 1
        for (( i=0; i<${#conflict_paths[@]}; i++ )); do
            [[ "${conflict_paths[i]}" == "$file" ]] || continue
            if [[ "$side" == head ]]; then
                conflict_head_added[i]="$added" conflict_head_deleted[i]="$deleted"
            else
                conflict_base_added[i]="$added" conflict_base_deleted[i]="$deleted"
            fi
            break
        done
    done < "$scratch/conflict-stats"
}

print_conflict_count() {
    local value="$1" color="$2" reset="$RESET"
    case "$value" in
        -) value="binary"; color="$CYAN" ;;
        '?') value="n/a"; color="$YELLOW" ;;
        0) color="" reset="" ;;
    esac
    printf '%s%8s%s' "$color" "$value" "$reset"
}

collect_conflicts() {
    local path="$1" index="${#row_status[@]}" tree file i value score shown=0 display
    local conflict_paths=() conflict_head_added=() conflict_head_deleted=()
    local conflict_base_added=() conflict_base_deleted=() conflict_ancestor="" note=""
    # --name-only --no-messages -z emits a tree OID followed by unique paths.
    # Keep NUL delimiters through parsing; filenames may contain tabs/newlines.
    exec 3< "$scratch/merge-tree"
    if ! IFS= read -r -d '' tree <&3 || [[ ! "$tree" =~ ^[0-9a-f]{40,64}$ ]]; then
        exec 3<&-
        printf '\nMerge conflicts: %s\n  File details unavailable.\n' "$path" > "$scratch/conflicts-$index.txt"
        return 0
    fi
    while IFS= read -r -d '' file <&3; do
        [[ -n "$file" ]] || continue
        conflict_paths+=("$file")
        conflict_head_added+=(0) conflict_head_deleted+=(0)
        conflict_base_added+=(0) conflict_base_deleted+=(0)
    done
    exec 3<&-
    if (( ${#conflict_paths[@]} == 0 )); then
        note="Git reported merge conflicts without a file list."
    elif ! conflict_ancestor="$(git -C "$REPOSITORY" merge-base --all "$CHECK_CONFLICT_BASE" "$CHECK_CONFLICT_HEAD" 2>/dev/null)" \
        || [[ ! "$conflict_ancestor" =~ ^[0-9a-f]{40,64}$ ]]; then
        note="Line stats unavailable: no single common ancestor."
        conflict_ancestor=""
    elif ! conflict_stats "$CHECK_CONFLICT_HEAD" head \
        || ! conflict_stats "$CHECK_CONFLICT_BASE" base; then
        note="Line stats unavailable: git diff failed."
    fi
    : > "$scratch/conflict-order"
    for (( i=0; i<${#conflict_paths[@]}; i++ )); do
        if [[ -n "$note" ]]; then
            conflict_head_added[i]="?" conflict_head_deleted[i]="?"
            conflict_base_added[i]="?" conflict_base_deleted[i]="?"
        fi
        score=0
        for value in "${conflict_head_added[i]}" "${conflict_head_deleted[i]}" \
            "${conflict_base_added[i]}" "${conflict_base_deleted[i]}"; do
            [[ ! "$value" =~ ^[0-9]+$ ]] || score=$(( score + value ))
        done
        # Merge-tree may invent a path when resolving a directory/file clash.
        # Its absence in every input is not evidence of zero changed lines.
        if [[ -z "$note" && "$score" -eq 0 && "${conflict_head_added[i]}" == 0 \
            && "${conflict_base_added[i]}" == 0 ]] \
            && ! git -C "$REPOSITORY" cat-file -e "$CHECK_CONFLICT_HEAD:${conflict_paths[i]}" 2>/dev/null \
            && ! git -C "$REPOSITORY" cat-file -e "$CHECK_CONFLICT_BASE:${conflict_paths[i]}" 2>/dev/null \
            && ! git -C "$REPOSITORY" cat-file -e "$conflict_ancestor:${conflict_paths[i]}" 2>/dev/null; then
            conflict_head_added[i]="?" conflict_head_deleted[i]="?"
            conflict_base_added[i]="?" conflict_base_deleted[i]="?"
        fi
        printf '%s\t%s\n' "$score" "$i" >> "$scratch/conflict-order"
    done
    LC_ALL=C sort -t $'\t' -k1,1nr -k2,2n "$scratch/conflict-order" > "$scratch/conflict-sorted"
    printf '%s\0' "${#conflict_paths[@]}" "$CHECK_CONFLICT_HEAD" "$CHECK_CONFLICT_BASE" \
        "$conflict_ancestor" "$note" > "$scratch/conflicts-$index.data"
    {
        printf '\n%sMerge conflicts:%s %s\n' "$RED" "$RESET" "$path"
        printf '  HEAD vs %s; +/- lines since the common ancestor.\n' "$BASE_BRANCH"
        [[ -z "$note" ]] || printf '  %s\n' "$note"
        printf '  %s%8s  %8s  %8s  %8s  %s%s\n' "$CYAN" "HEAD +" "HEAD -" "BASE +" "BASE -" FILE "$RESET"
        while IFS=$'\t' read -r score i; do
            (( shown < CONFLICT_FILES )) || break
            display="${conflict_paths[i]}"
            [[ ! "$display" =~ [[:cntrl:]] ]] || printf -v display '%q' "$display"
            printf '  '
            print_conflict_count "${conflict_head_added[i]}" "$GREEN"
            printf '  '
            print_conflict_count "${conflict_head_deleted[i]}" "$RED"
            printf '  '
            print_conflict_count "${conflict_base_added[i]}" "$GREEN"
            printf '  '
            print_conflict_count "${conflict_base_deleted[i]}" "$RED"
            printf '  %s\n' "$display"
            printf '%s\0' "${conflict_paths[i]}" "${conflict_head_added[i]}" \
                "${conflict_head_deleted[i]}" "${conflict_base_added[i]}" \
                "${conflict_base_deleted[i]}" >> "$scratch/conflicts-$index.data"
            shown=$(( shown + 1 ))
        done < "$scratch/conflict-sorted"
        printf '  Showing %s of %s conflicting files' "$shown" "${#conflict_paths[@]}"
        (( shown == ${#conflict_paths[@]} )) \
            || printf '; %s more omitted (use --conflict-files N)' "$(( ${#conflict_paths[@]} - shown ))"
        printf '.\n'
    } > "$scratch/conflicts-$index.txt"
}

print_rows() {
    printf '%s%-*s  %-*s  %-*s  %-*s  %-*s  %*s  %-*s  ' "$CYAN" "$repo_width" REPOSITORY "$base_width" BASE "$status_width" STATUS "$reason_width" REASON "$age_width" AGE "$size_width" "DISK USAGE" "$size_age_width" "SIZE AGE"
    [[ "$WIP_PUSH" -eq 0 ]] || printf '%-*s  ' "$push_width" "PUSH TO"
    printf '%-*s  ' "$codex_width" "CODEX SESSION"
    printf '%s%s\n' PATH "$RESET"
    local i color status_color unknown _unknown _kib
    # Sort numeric KiB rather than rounded display strings, preserving discovery
    # order for ties. Only reporting order changes; removal plans stay intact.
    for (( i=0; i<${#row_status[@]}; i++ )); do
        unknown=0
        [[ -n "${row_kib[i]}" ]] || unknown=1
        printf '%s\t%s\t%s\n' "$unknown" "${row_kib[i]:-0}" "$i"
    done > "$scratch/row-order"
    LC_ALL=C sort -t $'\t' -k1,1n -k2,2n -k3,3n "$scratch/row-order" > "$scratch/sorted-rows"
    while IFS=$'\t' read -r _unknown _kib i; do
        case "${row_reason[i]}" in
            merged,*) color="$GREEN" ;;
            dirty) color="$YELLOW" ;;
            "not merged") color="$MAGENTA" ;;
            locked) color="$BLUE" ;;
            "too new") color="$CYAN" ;;
            *failed|*unavailable|"unresolved conflicts"|"merge conflicts") color="$RED" ;;
            *) color="$GRAY" ;;
        esac
        status_color="$YELLOW"
        case "${row_status[i]}" in remove|wip-push) status_color="$GREEN" ;; esac
        [[ "${row_status[i]}" != error ]] || status_color="$RED"
        printf '%-*s  %-*s  %s%-*s%s  %s%-*s%s  %-*s  %*s  %-*s  ' "$repo_width" "${row_repo[i]}" "$base_width" "${row_base[i]}" "$status_color" "$status_width" "${row_status[i]}" "$RESET" "$color" "$reason_width" "${row_reason[i]}" "$RESET" "$age_width" "${row_age[i]}" "$size_width" "${row_size[i]}" "$size_age_width" "${row_size_age[i]}"
        [[ "$WIP_PUSH" -eq 0 ]] || printf '%-*s  ' "$push_width" "${row_push[i]}"
        printf '%-*s  ' "$codex_width" "${row_codex[i]}"
        printf '%s\n' "${row_path[i]}"
    done < "$scratch/sorted-rows"
    while IFS=$'\t' read -r _unknown _kib i; do
        [[ ! -f "$scratch/conflicts-$i.txt" ]] || cat "$scratch/conflicts-$i.txt"
    done < "$scratch/sorted-rows"
}

print_json() {
    local i
    : > "$scratch/json-rows"
    for (( i=0; i<${#row_status[@]}; i++ )); do
        printf '%s\0' "${row_status[i]}" "${row_reason[i]}" "${row_path[i]}" \
            "${row_repo[i]}" "${row_base[i]}" "${row_kib[i]}" "${row_size_age[i]}" \
            "${row_age_seconds[i]}" \
            "$codex_metadata" \
            >> "$scratch/json-rows"
    done
    : > "$scratch/json-repositories"
    for repo in ${repositories[@]+"${repositories[@]}"}; do
        printf '%s\0' "$repo" >> "$scratch/json-repositories"
    done
    uv run --no-project --python '>=3.11' python - "$scratch" "$ROOT" "$AGE_HOURS" "$errors" <<'PY'
import json
import os
from pathlib import Path
import sys

scratch, root = Path(sys.argv[1]), Path(sys.argv[2])
fields = (scratch / "json-rows").read_bytes().split(b"\0")[:-1]
keys = ["action", "reason", "path", "repository", "base", "size_kib", "size_age", "head_age_seconds",
        "codex_metadata"]
rows = []
for offset in range(0, len(fields), len(keys)):
    row = dict(zip(keys, [value.decode() for value in fields[offset:offset + len(keys)]]))
    row["repository"] = str(root / row["repository"])
    row["size_kib"] = int(row["size_kib"]) if row["size_kib"] else None
    row["head_age_seconds"] = int(row["head_age_seconds"]) if row["head_age_seconds"] else None
    row["codex_sessions"] = []
    codex_file = scratch / f"codex-{offset // len(keys)}.data"
    if codex_file.exists():
        sessions = [os.fsdecode(value) for value in codex_file.read_bytes().split(b"\0")[:-1]]
        for start in range(0, len(sessions), 4):
            session_id, title, updated, archived = sessions[start:start + 4]
            row["codex_sessions"].append({"id": session_id, "title": title,
                                          "updated_at": int(updated), "archived": archived == "1"})
    conflict_file = scratch / f"conflicts-{offset // len(keys)}.data"
    row["conflict_details"] = None
    if conflict_file.exists():
        details = [os.fsdecode(value) for value in conflict_file.read_bytes().split(b"\0")[:-1]]
        total, head, base, ancestor, note = details[:5]
        files = []
        def stats(added, deleted):
            return {"added": int(added) if added.isdigit() else None,
                    "deleted": int(deleted) if deleted.isdigit() else None,
                    "binary": added == "-", "available": added != "?"}
        for start in range(5, len(details), 5):
            path, ha, hd, ba, bd = details[start:start + 5]
            files.append({"path": path, "head": stats(ha, hd), "base": stats(ba, bd)})
        row["conflict_details"] = {"total_files": int(total), "omitted_files": int(total) - len(files),
                                   "head": head, "base": base, "merge_base": ancestor or None,
                                   "stats_note": note or None, "files": files}
    rows.append(row)
rows.sort(key=lambda row: (row["size_kib"] is None, row["size_kib"] or 0))
repositories = [value.decode() for value in
                (scratch / "json-repositories").read_bytes().split(b"\0")[:-1]]
report = json.dumps({"root": str(root), "age_hours": int(sys.argv[3]), "errors": int(sys.argv[4]),
                     "repositories": repositories, "worktrees": rows}, ensure_ascii=False)
# Preserve arbitrary Git filename bytes via escaped filesystem surrogates while
# emitting valid UTF-8 and keeping ordinary Unicode names readable.
print(report.encode("utf-8", errors="backslashreplace").decode("utf-8"))
PY
}

load_activity() {
    activity_ok=0
    if command -v lsof >/dev/null 2>&1 && lsof -nP -u "$(id -u)" -Fn > "$scratch/activity" 2>/dev/null; then
        activity_ok=1
    else
        stop_spinner
        echo "error: lsof activity check unavailable; eligible worktrees will be retained" >&2
        errors=$(( errors + 1 ))
    fi
}

resolve_wip_remote() {
    local path="$1" remotes remote url normalized fetch_url known entry prefix rewrite_status=0 redirected rejected_rewrite=0
    local allowed='^(https://github[.]com/|git@github[.]com:|ssh://git@github[.]com(:22)?/)easypost-sandbox/[a-z0-9][a-z0-9._-]*$'
    CHECK_PUSH_URL="" CHECK_PUSH_REMOTE=""
    if ! remotes="$(git -C "$path" remote 2>/dev/null)"; then
        CHECK_REASON="remote check failed"; return 1
    fi
    git -C "$path" config --null --get-regexp '^url[.].*[.]pushinsteadof$' \
        > "$scratch/push-rewrites" 2>/dev/null || rewrite_status=$?
    [[ "$rewrite_status" -le 1 ]] || { CHECK_REASON="push URL check failed"; return 1; }
    # Prefer origin, then any other approved remote. Query effective push URLs,
    # including pushurl/insteadOf rules; a fetch URL alone is not authorization.
    while IFS= read -r remote; do
        [[ -n "$remote" ]] || continue
        if ! url="$(git -C "$path" remote get-url --push --all -- "$remote" 2>/dev/null)"; then
            continue
        fi
        normalized="$(printf '%s' "$url" | tr '[:upper:]' '[:lower:]')"
        # Multiple push URLs, extra path segments, and lookalike hosts fail this
        # anchored match. The literal approved URL is pinned for the actual push.
        if [[ "$normalized" =~ $allowed ]]; then
            redirected=0
            # A URL may itself name a configured remote with a different pushurl.
            while IFS= read -r known; do
                [[ "$known" != "$url" ]] || redirected=1
            done <<< "$remotes"
            # Reject applicable pushInsteadOf rules rather than reinterpret their
            # precedence: literal pushes must not undergo a second URL rewrite.
            while IFS= read -r -d '' entry; do
                prefix="${entry#*$'\n'}"
                [[ "$url" != "$prefix"* ]] || redirected=1
            done < "$scratch/push-rewrites"
            # Git expands URL rewrite rules again when given a literal URL.
            # Require both publication and verification to keep this destination.
            if ! fetch_url="$(git -C "$path" ls-remote --get-url -- "$url" 2>/dev/null)"; then
                CHECK_REASON="push URL check failed"; return 1
            fi
            if [[ "$fetch_url" != "$url" || "$redirected" -eq 1 ]]; then
                rejected_rewrite=1
                continue
            fi
            CHECK_PUSH_URL="$url" CHECK_PUSH_REMOTE="$remote"
            return 0
        fi
    done <<< "origin
$remotes"
    CHECK_REASON="no easypost-sandbox push remote"
    [[ "$rejected_rewrite" -eq 0 ]] || CHECK_REASON="push URL rewrites elsewhere"
    return 1
}

inspect_worktree() {
    local path="$1" locked="$2" saved_head="${3:-}" head top status commit_ts merge_status=0 ignored open_path marker marker_path key slug entry head_tree base_tree branch branch_head conflict_base
    CHECK_REASON=""
    CHECK_DIRTY=0 CHECK_PUSH_URL="" CHECK_PUSH_REMOTE="" CHECK_WIP_BRANCH=""
    CHECK_MERGE="merged"
    [[ "$path" == "$PRIMARY_WORKTREE" ]] && { CHECK_REASON="primary"; return 1; }
    # The configured Treehouse pool keeps these slots warm between tasks.
    # Its own return/prune commands own their lifecycle, including idle slots.
    if [[ "$path" == "$PRIMARY_WORKTREE"/.worktrees/.treehouse/* ]]; then
        CHECK_REASON="reserved Treehouse pool"; return 1
    fi
    [[ "$locked" -eq 0 ]] || { CHECK_REASON="locked"; return 1; }
    if [[ "$path" == *\\* || "$path" =~ [[:cntrl:]] ]]; then
        CHECK_REASON="unsupported activity path"; return 1
    fi
    [[ -d "$path" ]] || { CHECK_REASON="missing directory"; return 1; }
    if ! top="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)" || [[ "$top" != "$path" ]]; then
        CHECK_REASON="checkout check failed"; return 1
    fi
    if ! marker_path="$(git -C "$path" rev-parse --path-format=absolute --git-path locked 2>/dev/null)"; then
        CHECK_REASON="lock check failed"; return 1
    fi
    [[ ! -e "$marker_path" && ! -L "$marker_path" ]] || { CHECK_REASON="locked"; return 1; }
    if ! head="$(git -C "$path" rev-parse --verify HEAD 2>/dev/null)" \
        || ! status="$(git -C "$path" ls-files --unmerged 2>/dev/null)"; then
        CHECK_REASON="index check failed"; return 1
    fi
    [[ -z "$status" ]] || { CHECK_REASON="unresolved conflicts"; return 1; }
    # Status and even ordinary worktree removal can overlook tracked edits
    # hidden by these flags. Retain the checkout without changing its index.
    if ! git -C "$path" ls-files -v -z > "$scratch/index-flags" 2>/dev/null; then
        CHECK_REASON="index flag check failed"; return 1
    fi
    while IFS= read -r -d '' entry; do
        if [[ "$entry" == [a-zS]\ * ]]; then
            CHECK_REASON="hidden index flags"; return 1
        fi
    done < "$scratch/index-flags"
    if [[ -n "$saved_head" && "$head" != "$saved_head" ]]; then
        CHECK_REASON="HEAD changed after snapshot"; return 1
    fi
    for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_START rebase-merge rebase-apply sequencer index.lock; do
        if ! marker_path="$(git -C "$path" rev-parse --path-format=absolute --git-path "$marker" 2>/dev/null)"; then
            CHECK_REASON="operation check failed"; return 1
        fi
        [[ ! -e "$marker_path" && ! -L "$marker_path" ]] || { CHECK_REASON="Git operation in progress"; return 1; }
    done
    if [[ "$WIP_PUSH" -eq 1 ]]; then
        resolve_wip_remote "$path" || return 1
        if ! key="$(printf '%s' "$path" | git hash-object --stdin 2>/dev/null)" \
            || [[ ! "$key" =~ ^[0-9a-f]{40,64}$ ]]; then
            CHECK_REASON="recovery branch check failed"; return 1
        fi
        slug="$(printf '%s' "${path##*/}" | LC_ALL=C tr -cs '[:alnum:]_-' '-')"
        CHECK_WIP_BRANCH="wip/cleanup/${slug:0:24}-${scratch##*.}-${key:0:8}"
    else

        git -C "$REPOSITORY" merge-base --is-ancestor "$head" "$BASE_BRANCH" 2>/dev/null || merge_status=$?
        if [[ "$merge_status" -ne 0 ]]; then
            [[ "$merge_status" -eq 1 ]] || { CHECK_REASON="merge check failed"; return 1; }
            # Tree equality cannot be influenced by a custom merge driver.
            # A named branch retains non-ancestor history after squash/rebase.
            if [[ "$INTEGRATED" -eq 1 ]] \
                && head_tree="$(git -C "$REPOSITORY" rev-parse "$head^{tree}")" \
                && base_tree="$(git -C "$REPOSITORY" rev-parse "$BASE_BRANCH^{tree}")" \
                && [[ "$head_tree" == "$base_tree" ]] \
                && branch="$(git -C "$path" symbolic-ref --quiet HEAD)" \
                && [[ "$branch" == refs/heads/* ]] \
                && branch_head="$(git -C "$path" rev-parse --verify "$branch^{commit}")" \
                && [[ "$branch_head" == "$head" ]]; then
                CHECK_MERGE="changes integrated"
            else
                merge_status=0
                if ! conflict_base="$(git -C "$REPOSITORY" rev-parse --verify "$BASE_BRANCH^{commit}" 2>/dev/null)"; then
                    CHECK_REASON="merge check failed"; return 1
                fi
                git -C "$REPOSITORY" merge-tree --write-tree --name-only --no-messages -z \
                    "$conflict_base" "$head" > "$scratch/merge-tree" 2>/dev/null || merge_status=$?
                case "$merge_status" in
                    0) CHECK_REASON="not merged" ;;
                    1) CHECK_REASON="merge conflicts"
                       CHECK_CONFLICT_HEAD="$head" CHECK_CONFLICT_BASE="$conflict_base" ;;
                    *) CHECK_REASON="merge check failed" ;;
                esac
                return 1
            fi
        fi
    fi

    if ! commit_ts="$(git -C "$REPOSITORY" log -1 --format=%ct "$head" 2>/dev/null)" \
        || [[ ! "$commit_ts" =~ ^[0-9]+$ ]]; then
        CHECK_REASON="history check failed"; return 1
    fi
    CHECK_AGE=$(( NOW - commit_ts ))
    if [[ -z "$saved_head" ]] && (( CHECK_AGE < AGE_SECONDS )); then
        CHECK_REASON="too new"; return 1
    fi

    if ! status="$(git -C "$path" status --porcelain --untracked-files=all 2>/dev/null)"; then
        CHECK_REASON="status check failed"; return 1
    fi
    if [[ -n "$status" ]]; then
        CHECK_DIRTY=1
        if [[ "$WIP_PUSH" -eq 0 || -n "$saved_head" ]]; then
            CHECK_REASON="dirty"; return 1
        fi
    fi
    if ! git -C "$path" ls-files --others --ignored --exclude-standard --directory -z \
        > "$scratch/ignored" 2>/dev/null; then
        CHECK_REASON="ignored-file check failed"; return 1
    fi
    while IFS= read -r -d '' ignored; do
        case "$ignored" in
            node_modules/*|*/node_modules/*|.venv/*|*/.venv/*|target/*|*/target/*|\
            .next/*|*/.next/*|__pycache__/*|*/__pycache__/*|.pytest_cache/*|*/.pytest_cache/*|\
            .mypy_cache/*|*/.mypy_cache/*|.ruff_cache/*|*/.ruff_cache/*) ;;
            *) CHECK_REASON="ignored files"; return 1 ;;
        esac
    done < "$scratch/ignored"
    # A later candidate may become busy while earlier worktrees are removed.
    [[ "$RECHECK" -eq 0 ]] || load_activity
    [[ "$activity_ok" -eq 1 ]] || { CHECK_REASON="activity unavailable"; return 1; }
    while IFS= read -r open_path; do
        [[ "$open_path" == n/* ]] || continue
        open_path="${open_path#n}"
        case "$open_path" in
            "$path"|"$path"/*) CHECK_REASON="active process"; return 1 ;;
        esac
    done < "$scratch/activity"
    return 0
}

save_wip_worktree() {
    local path="$1" url="$2" branch="$3" ref="refs/heads/$3" dirty="$CHECK_DIRTY" saved_head remote_ref
    [[ "$CHECK_PUSH_URL" == "$url" ]] || { CHECK_REASON="push destination changed"; return 1; }
    echo "Preserving $path on $CHECK_PUSH_REMOTE/$branch"
    # A new branch preserves the original branch and detached HEAD. Never reuse
    # or overwrite a local/remote recovery ref from an earlier cleanup attempt.
    if ! git -C "$path" switch -c "$branch"; then
        CHECK_REASON="recovery branch creation failed"; return 1
    fi
    if [[ "$dirty" -eq 1 ]]; then
        if ! git -C "$path" add -A -- . \
            || ! git -C "$path" commit -m 'chore(wip): preserve work before worktree cleanup'; then
            CHECK_REASON="WIP commit failed"; return 1
        fi
    fi
    if ! saved_head="$(git -C "$path" rev-parse --verify HEAD 2>/dev/null)"; then
        CHECK_REASON="snapshot check failed"; return 1
    fi
    # Hooks can change working files. Recheck cleanliness, locks, operations,
    # ignored artifacts, and processes both before and after publication.
    if ! inspect_worktree "$path" 0 "$saved_head"; then
        return 1
    fi
    [[ "$CHECK_PUSH_URL" == "$url" ]] || { CHECK_REASON="push destination changed"; return 1; }
    # Publish exactly the snapshot, with an empty lease requiring a new ref.
    # Explicit URL/refspec and flags avoid configured mirror, tag, or submodule
    # pushes. Git hooks and authentication run normally.
    if ! git -C "$path" push --no-mirror --no-follow-tags --recurse-submodules=no \
        --force-with-lease="$ref:" -- "$url" "$saved_head:$ref"; then
        CHECK_REASON="WIP push failed"; return 1
    fi
    if ! remote_ref="$(git -C "$path" ls-remote --exit-code --refs -- "$url" "$ref")" \
        || [[ "$remote_ref" != "$saved_head"$'\t'"$ref" ]]; then
        CHECK_REASON="remote snapshot verification failed"; return 1
    fi
    if ! inspect_worktree "$path" 0 "$saved_head"; then
        return 1
    fi
    [[ "$CHECK_PUSH_URL" == "$url" ]] || { CHECK_REASON="push destination changed"; return 1; }
    return 0
}

evaluate() {
    local path="$1" locked="$2" head="${3:-}" commit_ts age_seconds=""
    if [[ -n "$head" ]] \
        && commit_ts="$(git -C "$REPOSITORY" log -1 --format=%ct "$head" 2>/dev/null)" \
        && [[ "$commit_ts" =~ ^[0-9]+$ ]]; then
        age_seconds=$(( NOW - commit_ts ))
    fi
    if ! inspect_worktree "$path" "$locked"; then
        [[ "$CHECK_REASON" != "merge conflicts" ]] || collect_conflicts "$path"
        add_row skip "$CHECK_REASON" - "$path" "$REPOSITORY" "${BASE_BRANCH:--}" - - "" "$age_seconds"
        case "$CHECK_REASON" in *failed|*unavailable) errors=$(( errors + 1 )) ;; esac
        return 0
    fi
    local size
    measure_size "$path"
    if [[ -n "$MEASURED_KIB" ]]; then
        size="$(human_size "$MEASURED_KIB")"
        reclaim_kib=$(( reclaim_kib + MEASURED_KIB ))
    else
        size="unknown"
        unknown_sizes=$(( unknown_sizes + 1 ))
    fi
    if [[ "$WIP_PUSH" -eq 1 ]]; then
        local state="push HEAD"
        [[ "$CHECK_DIRTY" -eq 0 ]] || state="commit WIP"
        add_row wip-push "$state, $(( CHECK_AGE / 3600 ))h old" "$size" "$path" "$REPOSITORY" "${BASE_BRANCH:--}" "$MEASURED_AGE" "$CHECK_PUSH_REMOTE/$CHECK_WIP_BRANCH" "$MEASURED_KIB" "$CHECK_AGE"
    else
        add_row remove "$CHECK_MERGE, $(( CHECK_AGE / 3600 ))h old" "$size" "$path" "$REPOSITORY" "$BASE_BRANCH" "$MEASURED_AGE" "-" "$MEASURED_KIB" "$CHECK_AGE"
    fi
    to_remove+=("$path")
    removal_repos+=("$REPOSITORY")
    removal_bases+=("$BASE_BRANCH")
    removal_primaries+=("$PRIMARY_WORKTREE")
    removal_urls+=("$CHECK_PUSH_URL") removal_branches+=("$CHECK_WIP_BRANCH")
}

add_repository() {
    local repo="$1" common known first
    if ! common="$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
        || ! common="$(cd "$common" && pwd -P)"; then
        add_row error "invalid repository" n/a "$repo" "$repo" "-"
        errors=$(( errors + 1 ))
        return 0
    fi
    for known in ${repository_ids[@]+"${repository_ids[@]}"}; do
        [[ "$known" != "$common" ]] || return 0
    done
    if ! git -C "$repo" worktree list --porcelain -z > "$scratch/discovered-worktrees" \
        || ! IFS= read -r -d '' first < "$scratch/discovered-worktrees" \
        || [[ "$first" != worktree\ * || ! -d "${first#worktree }" ]]; then
        add_row error "primary checkout unavailable" n/a "$repo" "$repo" "-"
        errors=$(( errors + 1 ))
        return 0
    fi
    repository_ids+=("$common")
    repositories+=("${first#worktree }")
}

scan_repository() {
    local REPOSITORY="$1" BASE_BRANCH="$REQUESTED_BASE" PRIMARY_WORKTREE="" candidate path="" head="" locked=0 line
    repositories_checked=$(( repositories_checked + 1 ))
    start_spinner "Scanning repositories $repositories_checked/${#repositories[@]}; worktrees checked: $checked_worktrees..."
    if [[ -z "$BASE_BRANCH" ]]; then
        BASE_BRANCH="$(git -C "$REPOSITORY" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
        if [[ -z "$BASE_BRANCH" ]]; then
            for candidate in main master; do
                if git -C "$REPOSITORY" show-ref --verify --quiet "refs/heads/$candidate"; then
                    BASE_BRANCH="$candidate"
                    break
                fi
            done
        fi
    fi
    if [[ -z "$BASE_BRANCH" ]] || ! git -C "$REPOSITORY" rev-parse --verify "$BASE_BRANCH^{commit}" >/dev/null 2>&1; then
        if [[ "$WIP_PUSH" -eq 0 ]]; then
            add_row error "no base ref; use -b" n/a "$REPOSITORY"
            errors=$(( errors + 1 ))
            return 0
        fi
        BASE_BRANCH=""
    fi
    if ! git -C "$REPOSITORY" worktree list --porcelain -z > "$scratch/worktrees"; then
        add_row error "worktree listing failed" n/a "$REPOSITORY"
        errors=$(( errors + 1 ))
        return 0
    fi
    while IFS= read -r -d '' line; do
        if [[ -z "$line" ]]; then
            [[ -z "$path" ]] || check_worktree "$path" "$locked" "$head"
            path="" head="" locked=0
            continue
        fi
        case "$line" in
            worktree\ *)
                path="${line#worktree }"
                [[ -n "$PRIMARY_WORKTREE" ]] || PRIMARY_WORKTREE="$path"
                ;;
            locked*) locked=1 ;;
            HEAD\ *) head="${line#HEAD }" ;;
        esac
    done < "$scratch/worktrees"
    [[ -z "$path" ]] || check_worktree "$path" "$locked" "$head"
}

load_codex_sessions
start_spinner "Checking process activity..."
load_activity
start_spinner "Discovering repositories..."
if [[ "$SCAN_TREE" -eq 0 ]]; then
    add_repository "$ROOT"
else
    if ! find "$ROOT" \
        -type d \( -name node_modules -o -name .venv -o -name venv \
        -o -name target -o -name dist -o -name build -o -name .next \
        -o -name .worktrees -o -name .claude -o -name .codex \
        -o -name .cache -o -name __pycache__ \) -prune \
        -o -type d -exec test -e '{}/.git' \; -print0 -prune \
        > "$scratch/repositories"; then
        stop_spinner
        echo "error: some directories could not be scanned under $ROOT" >&2
        errors=$(( errors + 1 ))
    fi
    while IFS= read -r -d '' repo; do
        start_spinner "Discovering repositories: ${#repositories[@]} found..."
        add_repository "$repo"
    done < "$scratch/repositories"
fi
for repo in ${repositories[@]+"${repositories[@]}"}; do
    scan_repository "$repo"
done
if [[ -n "$TARGET_WORKTREE" && "$target_seen" -eq 0 ]]; then
    add_row error "not a registered worktree" n/a "$TARGET_WORKTREE"
    errors=$(( errors + 1 ))
fi
stop_spinner
if [[ "$JSON" -eq 1 ]]; then
    print_json
    exit $(( errors > 0 ))
fi
print_rows
echo
echo "Repositories checked: $repositories_checked"
echo "Worktrees checked: $checked_worktrees"

if [[ ${#to_remove[@]} -eq 0 ]]; then
    echo "Nothing to remove."
    exit $(( errors > 0 ))
fi

printf 'Estimated reclaimable space (eligible worktrees): %s%s%s' "$GREEN" "$(human_size "$reclaim_kib")" "$RESET"
if (( unknown_sizes > 0 )); then
    printf ' (plus %s worktree(s) with unknown size)' "$unknown_sizes"
fi
printf '\n'

if [[ $APPLY -eq 0 ]]; then
    echo "${#to_remove[@]} worktree(s) would be removed. Re-run with -y to remove."
    exit $(( errors > 0 ))
fi

removed=0
RECHECK=1
for (( i=0; i<${#to_remove[@]}; i++ )); do
    path="${to_remove[i]}"
    REPOSITORY="${removal_repos[i]}"
    BASE_BRANCH="${removal_bases[i]}"
    PRIMARY_WORKTREE="${removal_primaries[i]}"
    NOW=$(date +%s)
    start_spinner "Rechecking removal $(( i + 1 ))/${#to_remove[@]}..."
    if ! inspect_worktree "$path" 0; then
        stop_spinner
        echo "Retaining $path: $CHECK_REASON"
        case "$CHECK_REASON" in *failed|*unavailable) errors=$(( errors + 1 )) ;; esac
        continue
    fi
    stop_spinner
    if [[ "$WIP_PUSH" -eq 1 ]] \
        && ! save_wip_worktree "$path" "${removal_urls[i]}" "${removal_branches[i]}"; then
        echo "Retaining $path: $CHECK_REASON" >&2
        errors=$(( errors + 1 ))
        continue
    fi
    echo "Removing $path"
    if git -C "$REPOSITORY" worktree remove "$path"; then
        removed=$(( removed + 1 ))
    else
        echo "error: removal failed for $path; continuing" >&2
        errors=$(( errors + 1 ))
    fi
done
printf 'Removed %s worktree(s).\n' "$removed"
exit $(( errors > 0 ))
