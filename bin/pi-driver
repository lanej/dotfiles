#!/bin/sh
# Run the compiled driver when this checkout has one.
set -eu

launcher=$0
while [ -L "$launcher" ]; do
    target=$(readlink "$launcher")
    case $target in
        /*) launcher=$target ;;
        *) launcher=${launcher%/*}/$target ;;
    esac
done
if ! package=$(CDPATH='' cd -P -- "${launcher%/*}/../pi/daily-driver" && pwd); then
    printf '%s\n' 'Could not locate the Pi driver package.' >&2
    exit 1
fi

compiled=$package/.aot/pi-driver
if [ "${PI_DRIVER_USE_SOURCE:-0}" != 1 ] && [ -x "$compiled" ]; then
    exec "$compiled" "$@"
fi

if ! command -v bun >/dev/null 2>&1; then
    printf '%s\n' 'Bun is required to run the Pi driver from source.' >&2
    exit 1
fi
if [ ! -f "$package/node_modules/commander/package.json" ]; then
    printf '%s\n' "Run bun install --frozen-lockfile --ignore-scripts in $package first." >&2
    exit 1
fi
exec bun "$package/cli.ts" "$@"
