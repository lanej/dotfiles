#!/usr/bin/env python3
"""Expose shared role instructions and Builder guidance to Pi, preserving local files."""

import argparse
import json
from pathlib import Path
import re
import sys


MARKER = "---\n# Generated by dotfiles sync-pi-resources.\n"
START = "<!-- dotfiles:pi-builder:start -->"
END = "<!-- dotfiles:pi-builder:end -->"
GUIDANCE = f"""{START}
# Default software guidance: Builder

For software design, implementation, modification, debugging, and review, read `~/.local/share/software-standards/builder/references/instructions.md` and follow the Builder skill, architecture standard, and construction policy it identifies.
{END}
"""


def with_guidance(original, path):
    if (original.count(START) != original.count(END)
            or original.count(START) > 1
            or START in original and original.index(START) > original.index(END)):
        raise ValueError(f"malformed managed guidance block: {path}")
    if START in original:
        before, rest = original.split(START, 1)
        _, after = rest.split(END, 1)
        return before + GUIDANCE.rstrip("\n") + after
    return GUIDANCE + "\n" + original


def template(source):
    description = f"Use the shared {source.stem} role in this Pi conversation"
    return (MARKER + f"description: {json.dumps(description)}\n"
            'argument-hint: "<task>"\n---\n\n'
            f"Read the shared role instructions at {json.dumps(str(source))} and use them for the task below. "
            "This is role guidance in the current conversation, not a separate agent. "
            "Claude frontmatter does not select a Pi model or enforce tool permissions; "
            "honor the role's intended limits with the available tools and report any unavailable capabilities.\n\n"
            "Task: $ARGUMENTS\n")


def sync(source, home):
    source = source.resolve()
    agents = source / "agents"
    if not agents.is_dir():
        raise ValueError(f"missing shared agent tree: {agents}")
    standard = home / ".local/share/software-standards/builder/references/instructions.md"
    if not standard.is_file():
        raise ValueError("Builder is not installed; run make pi-config")
    directory = home / ".pi/agent"
    prompts = directory / "prompts"
    if prompts.is_symlink():
        raise ValueError(f"preserving linked prompt directory: {prompts}")
    guidance = directory / "AGENTS.md"
    for name in ("AGENTS.override.md", "AGENTS.md", "AGENTS.MD", "CLAUDE.md", "CLAUDE.MD"):
        candidate = directory / name
        if candidate.exists() or candidate.is_symlink():
            guidance = candidate
            break
    if guidance.is_symlink():
        raise ValueError(f"preserving linked instructions: {guidance}")
    original = guidance.read_text() if guidance.exists() else ""
    updated = with_guidance(original, guidance)
    templates = {}
    for path in sorted(agents.glob("*.md")):
        if not path.is_file():
            print(f"sync-pi-resources: unavailable source {path}, skipping", file=sys.stderr)
            continue
        if not re.fullmatch(r"[A-Za-z0-9_-]+", path.stem):
            raise ValueError(f"invalid prompt name: {path.stem}")
        templates[f"dotfiles-{path.stem}.md"] = template(path)

    prompts.mkdir(parents=True, exist_ok=True)
    for name, content in templates.items():
        target = prompts / name
        if target.is_symlink() or (target.exists() and
                                  (not target.is_file() or not target.read_text().startswith(MARKER))):
            print(f"sync-pi-resources: preserving local prompt {target}", file=sys.stderr)
            continue
        if not target.exists() or target.read_text() != content:
            target.write_text(content)
    for target in prompts.glob("dotfiles-*.md"):
        if (target.name not in templates and not target.is_symlink()
                and target.is_file() and target.read_text().startswith(MARKER)):
            target.unlink()
    if updated != original:
        guidance.write_text(updated)
    print(f"sync-pi-resources: shared roles in {prompts}; guidance in {guidance}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path, default=Path(__file__).resolve().parents[1] / "ai")
    parser.add_argument("--home", type=Path, default=Path.home())
    args = parser.parse_args()
    try:
        sync(args.source.expanduser().absolute(), args.home.expanduser().absolute())
    except (OSError, ValueError) as error:
        parser.exit(1, f"sync-pi-resources: {error}\n")


if __name__ == "__main__":
    main()
