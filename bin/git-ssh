#!/bin/sh
# A disconnected agent can leave a socket behind. Select the session's agent
# for this child even when the caller retains an old, socket-shaped path.
if [ -r "$HOME/.local/bin/fix-ssh" ] && { [ -n "$SSH_CONNECTION" ] || [ -n "$TMUX" ]; }; then
	# shellcheck disable=SC1091
	. "$HOME/.local/bin/fix-ssh"
fi
# WHY: GIT_SSH_ARGS is the existing space-separated argument interface.
# shellcheck disable=SC2086
exec /usr/bin/ssh $GIT_SSH_ARGS "$@"
