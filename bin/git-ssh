#!/bin/sh
if [ -r "$HOME/.local/bin/fix-ssh" ] && [ -n "$SSH_CONNECTION" ] && [ ! -S "$SSH_AUTH_SOCK" ]; then
	# shellcheck disable=SC1091
	. "$HOME/.local/bin/fix-ssh"
fi
# WHY: GIT_SSH_ARGS is the existing space-separated argument interface.
# shellcheck disable=SC2086
exec /usr/bin/ssh $GIT_SSH_ARGS "$@"
