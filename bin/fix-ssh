#!/bin/sh
# Source this file to refresh the calling shell's forwarded agent.
_dotfiles_fix_ssh() {
    [ -n "${SSH_CONNECTION:-}" ] || return 0
    # WHY: An unforwarded login must not borrow another login's agent.
    [ -n "${SSH_AUTH_SOCK:-}" ] || return 0
    _dotfiles_ssh_agent_directory="$HOME/.ssh/dotfiles-agent"
    _dotfiles_ssh_agent_link="$_dotfiles_ssh_agent_directory/agent.sock"

    # WHY: Only a fresh SSH login may publish; mux panes inherit old environments.
    if [ -z "${TMUX:-}" ] && [ -z "${ZELLIJ:-}" ] &&
       [ -S "${SSH_AUTH_SOCK:-}" ] && [ ! -L "$SSH_AUTH_SOCK" ] && [ -O "$SSH_AUTH_SOCK" ]; then
        if [ -L "$HOME/.ssh" ] || { [ -e "$HOME/.ssh" ] && [ ! -O "$HOME/.ssh" ]; }; then
            printf '%s\n' 'fix-ssh: refusing unsafe ~/.ssh directory' >&2
            return 1
        fi
        (umask 077; mkdir -p "$HOME/.ssh") || return 1
        if [ -L "$_dotfiles_ssh_agent_directory" ] || { [ -e "$_dotfiles_ssh_agent_directory" ] && [ ! -O "$_dotfiles_ssh_agent_directory" ]; }; then
            printf '%s\n' 'fix-ssh: refusing unsafe forwarded-agent directory' >&2
            return 1
        fi
        (umask 077; mkdir -p "$_dotfiles_ssh_agent_directory") || return 1
        chmod 700 "$_dotfiles_ssh_agent_directory" || return 1
        if [ -d "$_dotfiles_ssh_agent_link" ] || { [ -e "$_dotfiles_ssh_agent_link" ] && [ ! -L "$_dotfiles_ssh_agent_link" ]; }; then
            printf '%s\n' 'fix-ssh: refusing to replace unmanaged agent.sock' >&2
            return 1
        fi
        _dotfiles_ssh_temporary=$(mktemp -d "$_dotfiles_ssh_agent_directory/.refresh.XXXXXX") || return 1
        if ! ln -s "$SSH_AUTH_SOCK" "$_dotfiles_ssh_temporary/agent.sock" || ! mv -f "$_dotfiles_ssh_temporary/agent.sock" "$_dotfiles_ssh_agent_link"; then
            rm -rf "$_dotfiles_ssh_temporary"
            return 1
        fi
        rmdir "$_dotfiles_ssh_temporary" || return 1
    fi

    if [ ! -L "$_dotfiles_ssh_agent_directory" ] && [ -O "$_dotfiles_ssh_agent_directory" ] &&
       [ -L "$_dotfiles_ssh_agent_link" ] && [ -S "$_dotfiles_ssh_agent_link" ] && [ -O "$_dotfiles_ssh_agent_link" ]; then
        export SSH_AUTH_SOCK="$_dotfiles_ssh_agent_link"
    elif [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
        _dotfiles_ssh_value=$(tmux show-environment SSH_AUTH_SOCK 2>/dev/null) || return 0
        case "$_dotfiles_ssh_value" in
            SSH_AUTH_SOCK=*)
                _dotfiles_ssh_value=${_dotfiles_ssh_value#SSH_AUTH_SOCK=}
                if [ -S "$_dotfiles_ssh_value" ] && [ -O "$_dotfiles_ssh_value" ]; then
                    export SSH_AUTH_SOCK="$_dotfiles_ssh_value"
                fi
                ;;
        esac
    fi
}
_dotfiles_fix_ssh
_dotfiles_ssh_status=$?
unset -f _dotfiles_fix_ssh
unset _dotfiles_ssh_agent_directory _dotfiles_ssh_agent_link _dotfiles_ssh_temporary _dotfiles_ssh_value
# NOTE: Keep the caller's error status without exiting a shell that sources us.
return "$_dotfiles_ssh_status" 2>/dev/null || exit "$_dotfiles_ssh_status"
