#!/usr/bin/env bash
# Source this file before launching programs so they inherit the stable agent.
_dotfiles_fix_ssh() {
    [ -n "${SSH_CONNECTION:-}" ] || return 0
    # Partial shell-only installations keep the incoming agent until the native
    # helper is installed. Do not start a different local agent on a remote host.
    [ -x "$HOME/.local/bin/zellij-agent" ] || return 0
    # sshd invokes ~/.ssh/rc through the user's shell. Preserve its original
    # input before noninteractive shell startup selects the stable path.
    if [ -z "${DOTFILES_SSH_INCOMING_SOCK+x}" ]; then
        export DOTFILES_SSH_INCOMING_SOCK="${SSH_AUTH_SOCK:-}"
    fi
    _dotfiles_ssh_value=$("$HOME/.local/bin/zellij-agent" init) || return
    if [ -n "$_dotfiles_ssh_value" ]; then
        export SSH_AUTH_SOCK="$_dotfiles_ssh_value"
    fi
}
_dotfiles_fix_ssh
_dotfiles_ssh_status=$?
unset -f _dotfiles_fix_ssh
unset _dotfiles_ssh_value
# Keep the caller's error status without exiting a shell that sources us.
# shellcheck disable=SC2317 # Used when executed rather than sourced.
return "$_dotfiles_ssh_status" 2>/dev/null || exit "$_dotfiles_ssh_status"
