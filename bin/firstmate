#!/usr/bin/env bash
set -euo pipefail

firstmate_root=${FIRSTMATE_HOME:-"$HOME/src/firstmate"}

usage() {
	printf '%s\n' \
		'Usage: firstmate [command] [arguments]' \
		'  start [agent arguments]       Start or attach (the default).' \
		'  attach [backend options]     Attach to the running captain.' \
		'  stop                         Stop only the selected Firstmate session.' \
		'  reload                       Reload tmux; validate Zellij live configuration.' \
		'  tmux [options] command ...    Run commands on the Firstmate server.' \
		'  zellij command ...           Run commands on the Firstmate session.' \
		'  help                         Show this help.' \
		'FM_BACKEND selects tmux or zellij; otherwise config/backend is used (default: tmux).' \
		'FM_PRIMARY_HARNESS selects codex or pi; otherwise ~/.config/firstmate/primary-harness is used.' \
		'FIRSTMATE_HOME overrides ~/src/firstmate.' \
		'FIRSTMATE_TMUX_SOCKET overrides the tmux socket name (default: firstmate).' \
		'FM_ZELLIJ_SESSION overrides the Zellij session name (default: firstmate).'
}

require_checkout() {
	[[ -x "$firstmate_root/bin/fm-session-start.sh" ]] || {
		printf 'Firstmate checkout missing: %s\n' "$firstmate_root" >&2
		exit 1
	}
}

select_primary() {
	primary_harness=${FM_PRIMARY_HARNESS:-}
	if [[ -z "$primary_harness" && -f "$HOME/.config/firstmate/primary-harness" ]]; then
		primary_harness=$(awk 'NF {gsub(/^[[:space:]]+|[[:space:]]+$/, ""); print; exit}' "$HOME/.config/firstmate/primary-harness")
	fi
	primary_harness=${primary_harness:-codex}
}

require_primary() {
	case "$primary_harness" in
		codex|pi) ;;
		*) printf 'Unsupported Firstmate primary harness: %s (use codex or pi)\n' "$primary_harness" >&2; exit 2 ;;
	esac
	command -v "$primary_harness" >/dev/null || {
		printf 'Firstmate primary executable is missing: %s. Install it and retry.\n' "$primary_harness" >&2
		[[ "$primary_harness" != pi ]] || printf '%s\n' 'Pi requires version 1.4.0 or newer: BOOTSTRAP_PI=1 bash bootstrap.sh' >&2
		exit 1
	}
	[[ "$primary_harness" == pi ]] || return 0
	local version major minor extension
	version=$(pi --version) || { printf '%s\n' 'Cannot read the Pi version; repair the Pi installation and retry.' >&2; exit 1; }
	if [[ ! "$version" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
		printf 'Cannot verify Pi release version: %s. Install Pi 1.4.0 or newer.\n' "$version" >&2
		exit 1
	fi
	major=$((10#${BASH_REMATCH[1]}))
	minor=$((10#${BASH_REMATCH[2]}))
	if (( major < 1 || (major == 1 && minor < 4) )); then
		printf 'Pi %s is too old; install Pi 1.4.0 or newer.\n' "$version" >&2
		exit 1
	fi
	for extension in fm-primary-pi-watch fm-primary-turnend-guard fm-branch-supervision; do
		[[ -r "$firstmate_root/.pi/extensions/$extension.ts" ]] || {
			printf 'Firstmate checkout lacks .pi/extensions/%s.ts: %s\n' "$extension" "$firstmate_root" >&2
			printf '%s\n' 'Update that Firstmate checkout deliberately, or select an updated checkout with FIRSTMATE_HOME.' >&2
			exit 1
		}
	done
}

tmux_exec() {
	command -v tmux >/dev/null || { printf '%s\n' 'tmux is missing. Install it before starting or attaching to Firstmate.' >&2; exit 1; }
	# Do not carry the caller's pane identity into a different multiplexer.
	exec env -u TMUX -u TMUX_PANE -u ZELLIJ -u ZELLIJ_PANE_ID -u ZELLIJ_SESSION_NAME tmux \
		-f "$HOME/.config/firstmate/tmux.conf" \
		-L "${FIRSTMATE_TMUX_SOCKET:-firstmate}" "$@"
}

zellij_exec() {
	exec env -u TMUX -u TMUX_PANE -u ZELLIJ -u ZELLIJ_PANE_ID -u ZELLIJ_SESSION_NAME \
		zellij --config "$HOME/.config/zellij/config.kdl" "$@"
}

case ${1:-start} in
	help|-h|--help) usage; exit 0 ;;
esac

# Match upstream's explicit choices without its unrelated runtime auto-detection.
backend=${FM_BACKEND:-}
if [[ -z "$backend" && -f "$firstmate_root/config/backend" ]]; then
	backend=$(awk 'NF {gsub(/[[:space:]]/, ""); print; exit}' "$firstmate_root/config/backend")
fi
backend=${backend:-tmux}
case "$backend" in
	tmux) ;;
	zellij)
		export FM_ZELLIJ_SESSION=${FM_ZELLIJ_SESSION:-firstmate}
		# Upstream targets use session:pane; ':' and path characters are not names.
		[[ "$FM_ZELLIJ_SESSION" =~ ^[[:alnum:]_][[:alnum:]_.-]*$ ]] || {
			printf 'Invalid Firstmate Zellij session name: %s\n' "$FM_ZELLIJ_SESSION" >&2
			exit 2
		}
		;;
	*) printf 'Unsupported Firstmate launcher backend: %s (use tmux or zellij)\n' "$backend" >&2; exit 2 ;;
esac
export FM_BACKEND=$backend

case ${1:-start} in
	attach)
		shift
		if [[ "$backend" == zellij ]]; then
			zellij_exec attach "$FM_ZELLIJ_SESSION" "$@"
		fi
		tmux_exec attach-session -t =firstmate "$@"
		;;
	stop)
		[[ $# == 1 ]] || { usage >&2; exit 2; }
		if [[ "$backend" == zellij ]]; then
			zellij_exec kill-session "$FM_ZELLIJ_SESSION"
		fi
		tmux_exec kill-session -t =firstmate
		;;
	reload)
		[[ $# == 1 ]] || { usage >&2; exit 2; }
		if [[ "$backend" == zellij ]]; then
			zellij --config "$HOME/.config/zellij/config.kdl" setup --check
			printf '%s\n' 'Zellij watches this configuration automatically. Creation-only settings and layouts apply to new panes or sessions.'
			exit 0
		fi
		tmux_exec source-file "$HOME/.config/firstmate/tmux.conf"
		;;
	tmux|zellij)
		[[ "$1" == "$backend" ]] || { printf 'Selected backend is %s; set FM_BACKEND to change it.\n' "$backend" >&2; exit 2; }
		shift
		[[ $# != 0 ]] || { usage >&2; exit 2; }
		if [[ "$backend" == zellij ]]; then
			zellij_exec --session "$FM_ZELLIJ_SESSION" "$@"
		fi
		tmux_exec "$@"
		;;
	--inside)
		shift
		require_checkout
		select_primary
		require_primary
		cd "$firstmate_root"
		export FM_HOME="$PWD"
		if [[ "$primary_harness" == pi ]]; then
			unset FM_CODEX_WATCH_CHECKPOINT
			export FM_PI_HARNESS=pi
			exec codex "$@"
		fi
		export FM_CODEX_WATCH_CHECKPOINT=45
		exec codex --approve-for-me "$@"
		;;
	start)
		if [[ $# != 0 ]]; then shift; fi
		;;
esac

# Preserve direct agent arguments as a shorthand for "firstmate start".
require_checkout
firstmate_root=$(cd "$firstmate_root" && pwd -P)
export FIRSTMATE_HOME="$firstmate_root" FM_HOME="$firstmate_root"

# The selected primary applies only to a new captain. An existing tmux
# captain remains attachable if the configured executable is later removed.
if [[ "$backend" == tmux ]] && env -u TMUX -u TMUX_PANE -u ZELLIJ -u ZELLIJ_PANE_ID -u ZELLIJ_SESSION_NAME \
	tmux -L "${FIRSTMATE_TMUX_SOCKET:-firstmate}" has-session -t =firstmate 2>/dev/null; then
	tmux_exec attach-session -t =firstmate
fi
select_primary

launcher=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
if [[ "$backend" == zellij ]]; then
	[[ -r "$firstmate_root/bin/backends/zellij.sh" ]] || { printf '%s\n' 'Update the Firstmate checkout: its Zellij backend is missing.' >&2; exit 1; }
	command -v jq >/dev/null || { printf '%s\n' 'Firstmate Zellij tasks require jq; run bootstrap.sh first.' >&2; exit 1; }
	cd "$firstmate_root"
	# The initial command runs only when the session is created. Do not probe a
	# half-started server with list-sessions/list-panes (Zellij issue #5632).
	# Primary prerequisites are checked by --inside only for a new captain.
	zellij_exec attach --create "$FM_ZELLIJ_SESSION" -- env \
		"FIRSTMATE_HOME=$firstmate_root" "FM_BACKEND=zellij" "FM_ZELLIJ_SESSION=$FM_ZELLIJ_SESSION" \
		"FM_PRIMARY_HARNESS=$primary_harness" "PATH=$PATH" \
		"$launcher" --inside "$@"
fi
require_primary
tmux_exec new-session -A \
	-s firstmate -n captain -c "$firstmate_root" env \
	"FIRSTMATE_HOME=$firstmate_root" "FM_BACKEND=tmux" "FM_PRIMARY_HARNESS=$primary_harness" "PATH=$PATH" \
	"$launcher" --inside "$@"
