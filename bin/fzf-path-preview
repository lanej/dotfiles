#!/bin/sh
# Preview filesystem candidates shared by fzf widgets, completion, and directory history.
set -eu

target=${1:-}
[ -n "$target" ] || exit 0

if [ -d "$target" ]; then
    if command -v eza >/dev/null 2>&1; then
        # PERF: Bound recursion while retaining a compact Git status column.
        exec env -u LS_COLORS -u EZA_COLORS \
            EZA_CONFIG_DIR="${EZA_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/eza}" \
            eza --tree --long --git --no-permissions --no-filesize --no-user --no-time \
            --level=2 --all --ignore-glob=.git \
            --group-directories-first --icons=always --color=always -- "$target"
    fi
    exec ls -Ap -- "$target"
elif [ -f "$target" ]; then
    if command -v bat >/dev/null 2>&1; then
        exec bat --theme=Nord --color=always --style=numbers --paging=never --line-range=:200 -- "$target"
    fi
    exec head -n 200 -- "$target"
fi
