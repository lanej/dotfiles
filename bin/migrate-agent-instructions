#!/usr/bin/env bash
# Share repository guidance between Codex and Claude.
# Compatible with Bash 3.2 and standard macOS/Linux utilities.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: migrate-agent-instructions [--dry-run] [--merge] [directory]

Move CLAUDE.md guidance to AGENTS.md and create a relative CLAUDE.md
symlink. Back up an existing AGENTS.md before replacing it.
Use --merge to preserve differing guidance from both files.
Review tool-specific paths and commands before committing.
EOF
}

die() {
    printf 'Migration stopped: %s\n' "$*" >&2
    exit 1
}

dry_run=false
merge=false
directory=.
have_directory=false
while (($#)); do
    case "$1" in
        --dry-run) dry_run=true ;;
        --merge) merge=true ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) die "unknown option: $1" ;;
        *)
            $have_directory && die "expected one directory"
            directory=$1
            have_directory=true
            ;;
    esac
    shift
done
if (($#)); then
    $have_directory && die "expected one directory"
    (($# == 1)) || die "expected one directory"
    directory=$1
fi
cd -- "$directory" || die "cannot open directory: $directory"
root=$PWD

if [[ -L CLAUDE.md ]]; then
    if [[ -f AGENTS.md && CLAUDE.md -ef AGENTS.md ]]; then
        printf '%s: already shared\n' "$root"
        exit 0
    fi
    die "CLAUDE.md is an unexpected or broken symlink"
fi
[[ -f CLAUDE.md ]] || die "no regular CLAUDE.md found"
[[ ! -L AGENTS.md ]] || die "AGENTS.md is a symlink; resolve it before migration"
[[ ! -e AGENTS.md || -f AGENTS.md ]] || die "AGENTS.md is not a regular file"
[[ ! -L .gitignore ]] || die ".gitignore is a symlink; resolve it before migration"
[[ ! -e .gitignore || -f .gitignore ]] || die ".gitignore is not a regular file"

different=false
if [[ -f AGENTS.md ]] && LC_ALL=C grep -q '[^[:space:]]' AGENTS.md \
    && ! cmp -s AGENTS.md CLAUDE.md; then
    # Memory-only files are backed up, rather than merged into shared guidance.
    if ! awk '
        { text = text $0 "\n" }
        END {
            sub(/^[[:space:]]+/, "", text)
            sub(/[[:space:]]+$/, "", text)
            copy = text
            count = gsub(/<claude-mem-context>/, "", copy)
            exit !(text ~ /^<claude-mem-context>/ &&
                   text ~ /<\/claude-mem-context>$/ && count == 1)
        }
    ' AGENTS.md; then
        different=true
        $merge || die "AGENTS.md has different guidance; review it and use --merge to preserve both"
    fi
fi

scratch=$(mktemp -d "${TMPDIR:-/tmp}/agent-instructions.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT
# Keep the source file's permissions in the shared file.
cp -p CLAUDE.md "$scratch/AGENTS.md"
{
    if $different; then
        cat AGENTS.md
        printf '\n\n'
    fi
    awk '
        !heading && $0 == "# CLAUDE.md" {
            print "# AGENTS.md"; heading = 1; next
        }
        !intro && $0 == "This file provides guidance to Claude Code (claude.ai/code) when working with code in this repository." {
            print "This file provides shared guidance to Claude Code and Codex when working with code in this repository."
            intro = 1; next
        }
        { print }
    ' CLAUDE.md
} > "$scratch/AGENTS.md"

update_ignore=false
if [[ -f .gitignore ]]; then
    cp -p .gitignore "$scratch/gitignore"
    awk '
        {
            rule = $0
            sub(/^[[:space:]]+/, "", rule)
            sub(/[[:space:]]+$/, "", rule)
            if (rule != "AGENTS.md" && rule != "/AGENTS.md" &&
                rule != "CLAUDE.md" && rule != "/CLAUDE.md" &&
                rule != "# claude-mem context injection") print
        }
    ' .gitignore > "$scratch/gitignore"
    cmp -s .gitignore "$scratch/gitignore" || update_ignore=true
fi

backup=AGENTS.md.pre-migration
if [[ -f AGENTS.md ]]; then
    index=1
    while [[ -e $backup || -L $backup ]]; do
        backup=AGENTS.md.pre-migration.$index
        index=$((index + 1))
    done
    printf 'Back up %s/AGENTS.md to %s/%s\n' "$root" "$root" "$backup"
fi
printf 'Move guidance to %s/AGENTS.md; link CLAUDE.md -> AGENTS.md\n' "$root"
if $update_ignore; then
    printf 'Remove instruction-file ignore rules from %s/.gitignore\n' "$root"
fi
$dry_run && exit 0

[[ ! -f AGENTS.md ]] || cp -p AGENTS.md "$backup"
cp -p "$scratch/AGENTS.md" AGENTS.md
ln -s AGENTS.md "$scratch/CLAUDE.md"
mv -f "$scratch/CLAUDE.md" CLAUDE.md
if $update_ignore; then
    cp -p "$scratch/gitignore" .gitignore
fi
printf 'Review the guidance for tool-specific paths and commands before committing.\n'
