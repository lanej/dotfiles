#!/usr/bin/env python3
"""Share repository guidance between Codex and Claude without duplicating it."""

import argparse
from pathlib import Path
import shutil
import sys


def migrate(root, dry_run=False, merge=False):
    claude = root / "CLAUDE.md"
    agents = root / "AGENTS.md"
    if claude.is_symlink():
        if claude.resolve() == agents.resolve() and agents.is_file():
            print(f"{root}: already shared")
            return
        raise ValueError("CLAUDE.md is an unexpected or broken symlink")
    if not claude.is_file():
        raise ValueError("no regular CLAUDE.md found")
    if agents.is_symlink():
        raise ValueError("AGENTS.md is a symlink; resolve it before migration")

    source = claude.read_text()
    existing = agents.read_text() if agents.exists() else ""
    memory_only = (
        existing.strip().startswith("<claude-mem-context>")
        and existing.strip().endswith("</claude-mem-context>")
        and existing.count("<claude-mem-context>") == 1
    )
    if existing.strip() and existing != source and not memory_only and not merge:
        raise ValueError(
            "AGENTS.md has different guidance; review it and use --merge to preserve both"
        )

    content = source.replace("# CLAUDE.md\n", "# AGENTS.md\n", 1)
    content = content.replace(
        "This file provides guidance to Claude Code (claude.ai/code) "
        "when working with code in this repository.",
        "This file provides shared guidance to Claude Code and Codex "
        "when working with code in this repository.",
        1,
    )
    if merge and existing.strip() and existing != source and not memory_only:
        content = existing.rstrip() + "\n\n" + content

    ignore = root / ".gitignore"
    ignore_content = ignore.read_text() if ignore.exists() else None
    updated_ignore = ignore_content
    if ignore_content is not None:
        updated_ignore = "".join(
            line for line in ignore_content.splitlines(keepends=True)
            if line.strip() not in {
                "AGENTS.md", "/AGENTS.md", "CLAUDE.md", "/CLAUDE.md",
                "# claude-mem context injection",
            }
        )
    backup = root / "AGENTS.md.pre-migration"
    if agents.exists():
        index = 1
        while backup.exists() or backup.is_symlink():
            backup = root / f"AGENTS.md.pre-migration.{index}"
            index += 1
        print(f"Back up {agents} to {backup}")
    print(f"Move guidance to {agents}; link CLAUDE.md -> AGENTS.md")
    if updated_ignore != ignore_content:
        print(f"Remove instruction-file ignore rules from {ignore}")
    if dry_run:
        return
    if agents.exists():
        shutil.copy2(agents, backup)
    agents.write_text(content)
    claude.unlink()
    claude.symlink_to("AGENTS.md")
    if updated_ignore != ignore_content:
        ignore.write_text(updated_ignore)
    print("Review the guidance for tool-specific paths and commands before committing.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("directory", nargs="?", default=".", type=Path)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument(
        "--merge", action="store_true",
        help="preserve differing AGENTS.md guidance ahead of CLAUDE.md guidance",
    )
    args = parser.parse_args()
    try:
        migrate(args.directory.resolve(), args.dry_run, args.merge)
    except (OSError, UnicodeError, ValueError) as error:
        print(f"Migration stopped: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
