#!/usr/bin/env bash
# Mechanical worker for the bugfix-dispatcher skill. Subcommands after `start`
# take the fixer session's <id> and read everything else from the state file
# written at `start` time — see ~/.local/state/bugfix-dispatcher/<id>.json.
# XDG_STATE_HOME, not XDG_CACHE_HOME: this is recovery state, not disposable
# cache — losing it means losing the ability to recover in-flight work.
#
# This script pushes to `main` unattended on the easypost-sandbox allowlist,
# so it uses strict mode rather than this repo's usual fail-soft bin/ style.
set -euo pipefail

STATE_DIR="$HOME/.local/state/bugfix-dispatcher"
SRC_DIR="$HOME/src"
mkdir -p "$STATE_DIR"

usage() {
  echo "Usage: bugfix-worker <start|check|verify|finish|unlock|recover> ..." >&2
  exit 1
}

agent_record() {
  # Print the claude agents --json record for $1 (an id), or nothing.
  claude agents --json 2>/dev/null | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for o in data:
    if o.get('id') == '$1':
        print(json.dumps(o))
        break
"
}

state_field() {
  # state_field <state_file> <key>
  python3 -c "import json; print(json.load(open('$1')).get('$2', ''))"
}

cmd="${1:-}"; shift || true

case "$cmd" in
  start)
    repo="${1:?repo required}"; slug="${2:?slug required}"; prompt_file="${3:?prompt file required}"
    repo_path="$SRC_DIR/$repo"

    [ -d "$repo_path/.git" ] || { echo "ERROR: $repo_path is not a git repo" >&2; exit 1; }

    origin_url="$(git -C "$repo_path" remote get-url origin 2>/dev/null || true)"
    if ! printf '%s' "$origin_url" | grep -qi "easypost-sandbox"; then
      echo "ERROR: $repo is not in the easypost-sandbox allowlist (origin: $origin_url)" >&2
      exit 1
    fi

    lock_dir="$repo_path/.git/bugfix.lock"
    if ! mkdir "$lock_dir" 2>/dev/null; then
      echo "BUSY: $repo already has a fix in flight ($lock_dir exists)" >&2
      exit 2
    fi

    [ -f "$prompt_file" ] || { rmdir "$lock_dir" 2>/dev/null || true; echo "ERROR: prompt file $prompt_file not found" >&2; exit 1; }
    prompt_content="$(cat "$prompt_file")"

    session_name="bugfix-${repo}-${slug}"
    launch_output="$(cd "$repo_path" && claude -w "$slug" --bg -n "$session_name" --permission-mode bypassPermissions "$prompt_content" 2>&1)" || {
      rmdir "$lock_dir" 2>/dev/null || true
      echo "ERROR: launch failed: $launch_output" >&2
      exit 1
    }

    id="$(printf '%s\n' "$launch_output" | grep -oE '· [a-f0-9]{6,} ·' | head -1 | tr -d ' ·')"
    if [ -z "$id" ]; then
      rmdir "$lock_dir" 2>/dev/null || true
      echo "ERROR: could not parse session id from launch output: $launch_output" >&2
      exit 1
    fi

    cat > "$STATE_DIR/$id.json" <<EOF
{"repo":"$repo","slug":"$slug","lockPath":"$lock_dir","sessionName":"$session_name"}
EOF
    echo "$id"
    ;;

  check)
    id="${1:?id required}"
    record="$(agent_record "$id")"
    if [ -z "$record" ]; then
      echo '{"result":"unknown"}'
      exit 0
    fi
    # Empirically confirmed (2026-09-03, two controlled A/B tests): `state`
    # does NOT reliably become "done" for a resident --bg session that
    # finishes a turn without actually exiting — it stays "working" even
    # after visible completion (confirmed via `claude logs` + a stuck-idle
    # `status`). The real signal is `status`: "idle" means the turn has
    # ended either way; `state: blocked` is what distinguishes "stuck
    # waiting for input" from "genuinely done for now." Do not trust `state`
    # alone or assume a "done" value will ever appear.
    status="$(printf '%s' "$record" | python3 -c "import json,sys; print(json.load(sys.stdin).get('status',''))")"
    state="$(printf '%s' "$record" | python3 -c "import json,sys; print(json.load(sys.stdin).get('state',''))")"
    if [ "$status" != "idle" ]; then
      echo '{"result":"working"}'
    elif [ "$state" = "blocked" ]; then
      echo '{"result":"blocked"}'
    else
      echo '{"result":"done"}'
    fi
    ;;

  verify)
    id="${1:?id required}"
    state_file="$STATE_DIR/$id.json"
    [ -f "$state_file" ] || { echo "ERROR: no state for $id" >&2; exit 1; }

    record="$(agent_record "$id")"
    [ -n "$record" ] || { echo "ERROR: no live agent record for $id" >&2; exit 1; }
    cwd="$(printf '%s' "$record" | python3 -c "import json,sys; print(json.load(sys.stdin).get('cwd',''))")"
    [ -n "$cwd" ] && [ -d "$cwd" ] || { echo "ERROR: worktree cwd '$cwd' not found for $id" >&2; exit 1; }

    # Exclude bugs/ from both checks below — it always appears in the diff
    # (the bug-report commit) and its slug can coincidentally contain
    # "test"/"spec" (e.g. a report titled "smoketest"), which would
    # otherwise false-positive the repro-test-touched heuristic.
    changed_paths="$(git -C "$cwd" diff --name-only origin/main...HEAD 2>/dev/null | grep -v '^bugs/' || true)"
    risky_paths="$(printf '%s\n' "$changed_paths" | grep -E '(^|/)\.github/|\.env|Dockerfile|\.gitlab-ci|\.circleci/' || true)"
    # Real test-file conventions only: a tests/spec directory, or a
    # test_*/*_test.*/*.test.*/*_spec.* filename — not a bare substring match.
    test_touched="$(printf '%s\n' "$changed_paths" | grep -iE '(^|/)(tests?|specs?)/|(^|/)test_[^/]+$|_test\.[^/]+$|\.test\.[^/]+$|_spec\.[^/]+$' || true)"

    suite_pass="false"
    log_file="/tmp/bugfix-verify-$id.log"
    # A fresh git worktree never inherits build output (e.g. a compiled
    # binary from `bun build --compile`), which is gitignored — so if the
    # repo's test script depends on one (e.g. a CLI/acceptance suite that
    # shells out to a compiled binary), it fails with a false "regression"
    # in every worktree regardless of the fix's correctness. Build first
    # when a build script exists.
    if [ -f "$cwd/package.json" ] && grep -q '"build"' "$cwd/package.json"; then
      ( cd "$cwd" && npm run build ) >"$log_file" 2>&1 || true
    fi
    # `set -e` would otherwise abort the script on a failing (expected!) test
    # run, so every branch here is explicitly `|| true`-guarded.
    if [ -f "$cwd/package.json" ] && grep -q '"test"' "$cwd/package.json"; then
      { ( cd "$cwd" && npm test ) >>"$log_file" 2>&1 && suite_pass="true"; } || true
    elif [ -f "$cwd/Makefile" ] && grep -qE '^test:' "$cwd/Makefile"; then
      { ( cd "$cwd" && make test ) >"$log_file" 2>&1 && suite_pass="true"; } || true
    elif [ -f "$cwd/justfile" ] && grep -qE '^test( |:)' "$cwd/justfile"; then
      { ( cd "$cwd" && just test ) >"$log_file" 2>&1 && suite_pass="true"; } || true
    else
      echo "WARN: no recognized test command in $cwd — cannot verify suite" >&2
    fi

    python3 -c "
import json
print(json.dumps({
    'cwd': '''$cwd''',
    'suitePass': $( [ "$suite_pass" = "true" ] && echo True || echo False ),
    'testTouched': bool('''$test_touched'''.strip()),
    'riskyPaths': [p for p in '''$risky_paths'''.strip().splitlines() if p],
    'logFile': '''$log_file''',
}))
"
    ;;

  finish)
    id="${1:?id required}"; action="${2:?merge|pr required}"
    state_file="$STATE_DIR/$id.json"
    [ -f "$state_file" ] || { echo "ERROR: no state for $id" >&2; exit 1; }
    repo="$(state_field "$state_file" repo)"
    slug="$(state_field "$state_file" slug)"
    repo_path="$SRC_DIR/$repo"

    record="$(agent_record "$id")"
    cwd="$(printf '%s' "$record" | python3 -c "import json,sys; print(json.load(sys.stdin).get('cwd',''))" 2>/dev/null || true)"

    case "$action" in
      merge)
        [ -n "$cwd" ] || { echo "ERROR: no cwd for $id, cannot push" >&2; exit 1; }
        git -C "$cwd" push origin HEAD:main
        # Best-effort post-merge install: some tool repos install a compiled
        # binary (e.g. to ~/.local/bin) that a plain `git push` to main does
        # not refresh — the fix wouldn't actually take effect in daily use
        # until reinstalled. Convention: run `just install` / `make install`
        # if the repo defines one. Run it from the worktree (which already
        # has the fixed, tested code checked out) rather than the primary
        # checkout, whose sync below is best-effort and may fail/diverge.
        # Never fails finish merge — surfaces as a warning only.
        if [ -f "$cwd/justfile" ] && grep -qE '^install( |:)' "$cwd/justfile"; then
          if ! install_output="$(cd "$cwd" && just install 2>&1)"; then
            echo "WARN: post-merge 'just install' failed for $repo — install manually: $install_output" >&2
          fi
        elif [ -f "$cwd/Makefile" ] && grep -qE '^install:' "$cwd/Makefile"; then
          if ! install_output="$(cd "$cwd" && make install 2>&1)"; then
            echo "WARN: post-merge 'make install' failed for $repo — install manually: $install_output" >&2
          fi
        fi
        # Empirically confirmed (2026-09-03): `claude rm` deliberately REFUSES
        # to delete a worktree with unpushed commits — "kept <id> — worktree
        # has commits that are not pushed anywhere" — rather than erroring or
        # silently failing. That refusal is a real data-loss guard, so never
        # force past it here: by this point the push above already succeeded,
        # so a refusal now means something unexpected (partial/failed push
        # that still exited 0, or a genuine edge case) and should surface as
        # a warning for the dispatcher skill to escalate, not be overridden.
        if ! rm_output="$(claude rm "$id" 2>&1)"; then
          echo "WARN: claude rm $id did not complete cleanly after a successful push: $rm_output" >&2
        elif printf '%s' "$rm_output" | grep -qi '^kept'; then
          echo "WARN: claude rm $id refused despite a successful push — investigate before assuming cleanup: $rm_output" >&2
        fi
        # Sync the primary checkout's local main forward, best-effort — never fails finish merge.
        if [ -d "$repo_path/.git" ]; then
          branch="$(git -C "$repo_path" symbolic-ref --short -q HEAD || true)"
          if [ "$branch" = "main" ]; then
            if git -C "$repo_path" fetch origin && git -C "$repo_path" merge --ff-only origin/main; then
              :
            else
              echo "WARN: primary-checkout sync of $repo_path failed (fetch or non-ff-only) — sync manually" >&2
            fi
          else
            echo "WARN: $repo_path not on main (branch=$branch) — skipped primary-checkout sync" >&2
          fi
        fi
        ;;
      pr)
        [ -n "$cwd" ] || { echo "ERROR: no cwd for $id, cannot push" >&2; exit 1; }
        branch="bugfix/$slug"
        git -C "$cwd" push origin "HEAD:$branch"
        # `gh pr create --fill` computes its title/body defaults from a local
        # diff against origin/main, which requires that remote-tracking ref
        # to actually be fetched in this worktree — a fixer worktree can sit
        # for a while without ever fetching, so origin/main may be missing
        # or stale by the time we get here. Fetch first so this doesn't fail.
        git -C "$cwd" fetch origin main
        # The worktree's own local branch is named worktree-<slug> (set by
        # `claude -w`), not $branch — we only push HEAD to $branch on the
        # remote, we never check it out locally. `gh pr create --fill` needs
        # a local ref named exactly $branch to diff against, so create one
        # pointing at HEAD (no checkout needed, the worktree stays as-is).
        git -C "$cwd" branch -f "$branch" HEAD
        ( cd "$cwd" && gh pr create --fill --head "$branch" )
        claude stop "$id" || true
        ;;
      *)
        echo "Usage: bugfix-worker finish <id> merge|pr" >&2; exit 1 ;;
    esac
    ;;

  unlock)
    id="${1:?id required}"
    state_file="$STATE_DIR/$id.json"
    [ -f "$state_file" ] || exit 0
    lock_path="$(state_field "$state_file" lockPath)"
    [ -n "$lock_path" ] && rmdir "$lock_path" 2>/dev/null || true
    rm -f "$state_file"
    ;;

  recover)
    # Run once at dispatcher startup (including after a restart) to find
    # in-flight work orphaned by the previous dispatcher instance dying —
    # e.g. Josh restarting the session mid-fix. For each cached state file:
    # if its session is still alive, it's resumable (the fixer keeps running
    # independently of the dispatcher; just re-subscribe and continue from
    # `check`). If the session is gone, it's truly orphaned — release the
    # lock and remove the state file, but leave any worktree/branch alone
    # for manual inspection rather than deleting real work.
    found_any=false
    shopt -s nullglob
    for f in "$STATE_DIR"/*.json; do
      found_any=true
      id="$(basename "$f" .json)"
      repo="$(state_field "$f" repo)"
      slug="$(state_field "$f" slug)"
      session_name="$(state_field "$f" sessionName)"
      if [ -n "$(agent_record "$id")" ]; then
        printf '{"id":"%s","result":"resumable","repo":"%s","slug":"%s","sessionName":"%s"}\n' \
          "$id" "$repo" "$slug" "$session_name"
      else
        lock_path="$(state_field "$f" lockPath)"
        [ -n "$lock_path" ] && rmdir "$lock_path" 2>/dev/null || true
        rm -f "$f"
        printf '{"id":"%s","result":"orphaned_cleaned","repo":"%s","slug":"%s","sessionName":"%s"}\n' \
          "$id" "$repo" "$slug" "$session_name"
      fi
    done
    shopt -u nullglob
    [ "$found_any" = false ] && echo '{"result":"none"}'
    ;;

  *)
    usage
    ;;
esac
