#!/usr/bin/env bash
# PreToolUse:ExitWorktree — restore tmux window title to the main repo name

[[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]] || exit 0

# At ExitWorktree time we're still inside the worktree; the main worktree is
# the first entry from git worktree list.
main_path=$(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2; exit}')
name=$(basename "${main_path:-$(git rev-parse --show-toplevel 2>/dev/null)}")

if [[ -n "$name" ]]; then
    tmux rename-window -t "$TMUX_PANE" "$name" 2>/dev/null || true
    tmux set-window-option -t "$TMUX_PANE" automatic-rename on 2>/dev/null || true
fi

exit 0
