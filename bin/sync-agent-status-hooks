#!/usr/bin/env python3
"""Let the broker own cosmetic activity delivery instead of direct Paseo calls."""
import json
from pathlib import Path
import subprocess
import tempfile
import os


def write_atomic(path, data):
    path = path.resolve()
    mode = path.stat().st_mode & 0o777
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as output:
        temporary = Path(output.name)
        try:
            output.write(json.dumps(data, indent=2) + "\n")
            output.flush()
            os.fchmod(output.fileno(), mode)
            temporary.replace(path)
        finally:
            temporary.unlink(missing_ok=True)


def main():
    home = Path.home()
    paseo_home = Path(os.environ.get("PASEO_HOME", str(home / ".paseo"))).expanduser()
    config = paseo_home / "config.json"
    if config.exists():
        data = json.loads(config.read_text())
        daemon = data.get("daemon", {})
        if daemon.get("enableTerminalAgentHooks") is True:
            daemon["enableTerminalAgentHooks"] = False
            write_atomic(config, data)
            try:
                environment = {key: value for key, value in os.environ.items() if key != "PASEO_HOST"}
                subprocess.run(["paseo", "reload", "--home", str(paseo_home), "--json"],
                               env=environment, check=True, timeout=5,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except (OSError, subprocess.SubprocessError):
                # The persisted switch also prevents reinstall on the next boot.
                pass
    codex_home = Path(os.environ.get("CODEX_HOME", str(home / ".codex"))).expanduser()
    claude_home = Path(os.environ.get("CLAUDE_CONFIG_DIR", str(home / ".claude"))).expanduser()
    for provider, config in (("codex", codex_home / "hooks.json"),
                             ("claude", claude_home / "settings.json")):
        if not config.exists():
            continue
        data = json.loads(config.read_text())
        changed = False
        for event, groups in data.get("hooks", {}).items():
            for group in groups:
                original = group.get("hooks", [])
                kept = [hook for hook in original if not (
                    "PASEO_TERMINAL_ID" in hook.get("command", "")
                    and "PASEO_HOOK_CLI" in hook.get("command", "")
                    and f"hooks {provider} {event}" in hook.get("command", ""))]
                if kept != original:
                    group["hooks"] = kept
                    changed = True
        if changed:
            for event, groups in data["hooks"].items():
                data["hooks"][event] = [group for group in groups if group.get("hooks")]
            write_atomic(config, data)


if __name__ == "__main__":
    main()
