#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["tomlkit>=0.13,<1"]
# ///
"""Install Codex approval and interaction defaults and selected integration policies."""
import argparse
import copy
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import tomllib

import tomlkit


DEFAULTS = {
    "approval_policy": "on-request",
    "approvals_reviewer": "auto_review",
    "sandbox_mode": "workspace-write",
}
DEFAULT_QUESTION_FEATURE = "default_mode_request_user_input"
GITHUB_APP = "connector_76869538009648d5b282a4bb21c3d157"
GITHUB_PLUGINS = ("github@openai-curated", "github@openai-curated-remote")
DISABLED_APPS = {
    "gmail": "connector_2128aebfecb84f64a069897515042a44",
    "google-calendar": "connector_947e0d954944416db111db556030eea6",
    "google-drive": "connector_5f3c8c41a1e54ad7a76272c89e2554fa",
    "slack": "asdk_app_69a1d78e929881919bba0dbda1f6436d",
    "plugin-management": "connector_openai_plugin_management",
    "openai-platform": "connector_2de447f3f15448ebab48783d7e4f5d81",
}
DISABLED_PLUGINS = (
    "gmail@openai-curated-remote",
    "google-calendar@openai-curated",
    "google-calendar@openai-curated-remote",
    "google-drive@openai-curated",
    "google-drive@openai-curated-remote",
    "slack@openai-curated",
    "browser@openai-bundled",
    "plugin-management@openai-curated-remote",
    "openai-developers@openai-curated-remote",
)
OCTO_START = "# BEGIN dotfiles Octo Manager rules\n"
OCTO_END = "# END dotfiles Octo Manager rules\n"


def supports_default_questions():
    try:
        result = subprocess.run(
            ["codex", "features", "list"], capture_output=True, text=True, timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0 and any(
        len(columns) >= 3 and columns[0] == DEFAULT_QUESTION_FEATURE and columns[1] != "removed"
        for columns in map(str.split, result.stdout.splitlines())
    )


def octo_rules(root):
    path = root / "rules/octo-manager.rules"
    if path.is_symlink():
        path = path.resolve(strict=True)
    original = path.read_text() if path.exists() else ""
    commands = [
        [["actions", "tracked", "tracking", "submission", "submissions",
          "inbox", "message", "chains", "references", "dependencies",
          "get", "events", "read", "ack", "acknowledge-message", "record-activity"]],
        ["pr", ["list", "show", "participants", "instructions", "validate"]],
        ["agent", ["list", "status", "inbox"]],
        ["action", ["list", "show"]],
        ["publication", ["list", "show"]],
        ["job", ["show", "events"]],
        ["activity", ["list", "record"]],
        ["chain", ["list", "show"]],
        ["dependency", "list"],
        ["reference", "list"],
        ["messages", ["list", "inspect", "show", "ack"]],
        ["assessment", "show"],
        ["issue", ["list", "show"]],
        ["history", ["submissions", "submission", "policy"]],
        ["repair", "list"],
        ["conflict", ["list", "show"]],
    ]
    launchers = ["octo-manager", str(Path.home() / ".local/bin/octo-manager")]
    block = OCTO_START + (
        "# Inspection, delivery receipts, acknowledgments, and caller activity reports only.\n"
        "# Publication, merge authority, repairs, and service controls are not allowed here.\n"
    )
    for command in commands:
        pattern = json.dumps([launchers, *command])
        block += f'prefix_rule(pattern={pattern}, decision="allow")\n'
    block += OCTO_END
    if OCTO_START in original or OCTO_END in original:
        if (original.count(OCTO_START) != 1 or original.count(OCTO_END) != 1
                or original.index(OCTO_START) > original.index(OCTO_END)):
            raise ValueError(f"malformed managed Octo rules block: {path}")
        start = original.index(OCTO_START)
        end = original.index(OCTO_END) + len(OCTO_END)
        updated = original[:start] + block + original[end:]
    else:
        separator = "\n" if original and not original.endswith("\n") else ""
        updated = original + separator + block
    return path, original, updated


def write_if_changed(path, original, updated):
    if updated == original:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = path.stat().st_mode & 0o777 if path.exists() else 0o600
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(
                mode="w", dir=path.parent, prefix=".permissions-", delete=False) as output:
            temporary = Path(output.name)
            output.write(updated)
        temporary.chmod(mode)
        if (path.read_text() if path.exists() else "") != original:
            raise ValueError(f"Codex configuration changed during installation: {path}")
        temporary.replace(path)
    finally:
        if temporary and temporary.exists():
            temporary.unlink()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--github-enabled", choices=("true", "false"), required=True)
    parser.add_argument("--easypost", choices=("true", "false"), required=True)
    parser.add_argument("--theme", help="Select the installed Codex syntax theme")
    args = parser.parse_args()
    github_enabled = args.github_enabled == "true"
    root = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))).expanduser()
    path = root / "config.toml"
    if path.is_symlink():
        path = path.resolve(strict=True)
    original = path.read_text() if path.exists() else ""
    config = tomllib.loads(original)
    rules = octo_rules(root)
    root.mkdir(parents=True, exist_ok=True)
    expected = copy.deepcopy(config)
    expected.update(DEFAULTS)
    if args.theme is not None:
        expected.setdefault("tui", {})["theme"] = args.theme
    features = config.get("features", {})
    enable_questions = (
        isinstance(features, dict)
        and DEFAULT_QUESTION_FEATURE not in features
        and supports_default_questions()
    )
    if enable_questions:
        expected.setdefault("features", {})[DEFAULT_QUESTION_FEATURE] = True
    app_access = {GITHUB_APP: github_enabled}
    plugin_access = dict.fromkeys(GITHUB_PLUGINS, github_enabled)
    if args.easypost == "true":
        app_access.update(dict.fromkeys(DISABLED_APPS.values(), False))
        plugin_access.update(dict.fromkeys(DISABLED_PLUGINS, False))
    for app, enabled in app_access.items():
        expected.setdefault("apps", {}).setdefault(app, {})["enabled"] = enabled
    for plugin, enabled in plugin_access.items():
        expected.setdefault("plugins", {}).setdefault(plugin, {})["enabled"] = enabled
    if config == expected:
        write_if_changed(*rules)
        return

    document = tomlkit.parse(original)
    document.update(DEFAULTS)
    if args.theme is not None:
        document.setdefault("tui", tomlkit.table())["theme"] = args.theme
    if enable_questions:
        document.setdefault("features", tomlkit.table())[DEFAULT_QUESTION_FEATURE] = True
    apps = document.setdefault("apps", tomlkit.table())
    for app, enabled in app_access.items():
        apps.setdefault(app, tomlkit.table())["enabled"] = enabled
    plugins = document.setdefault("plugins", tomlkit.table())
    for plugin, enabled in plugin_access.items():
        plugins.setdefault(plugin, tomlkit.table())["enabled"] = enabled
    updated = tomlkit.dumps(document)
    if tomllib.loads(updated) != expected:
        raise ValueError("could not preserve unrelated Codex configuration")

    write_if_changed(path, original, updated)
    write_if_changed(*rules)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as error:
        print(f"sync-codex-permissions: {error}", file=sys.stderr)
        sys.exit(1)
