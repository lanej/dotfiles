#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["tomlkit>=0.13,<1"]
# ///
"""Install approval defaults and host-specific GitHub access in Codex."""
import copy
import os
from pathlib import Path
import socket
import sys
import tempfile
import tomllib

import tomlkit


DEFAULTS = {
    "approval_policy": "on-request",
    "approvals_reviewer": "auto_review",
    "sandbox_mode": "workspace-write",
}
GITHUB_APP = "connector_76869538009648d5b282a4bb21c3d157"
GITHUB_PLUGINS = ("github@openai-curated", "github@openai-curated-remote")


def main():
    root = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))).expanduser()
    path = root / "config.toml"
    if path.is_symlink():
        path = path.resolve(strict=True)
    original = path.read_text() if path.exists() else ""
    config = tomllib.loads(original)
    hostname = os.environ.get("CODEX_HOSTNAME") or socket.gethostname()
    github_enabled = "easypost" not in hostname.casefold()
    expected = copy.deepcopy(config)
    expected.update(DEFAULTS)
    expected.setdefault("apps", {}).setdefault(GITHUB_APP, {})["enabled"] = github_enabled
    for plugin in GITHUB_PLUGINS:
        expected.setdefault("plugins", {}).setdefault(plugin, {})["enabled"] = github_enabled
    if config == expected:
        return

    document = tomlkit.parse(original)
    document.update(DEFAULTS)
    apps = document.setdefault("apps", tomlkit.table())
    apps.setdefault(GITHUB_APP, tomlkit.table())["enabled"] = github_enabled
    plugins = document.setdefault("plugins", tomlkit.table())
    for plugin in GITHUB_PLUGINS:
        plugins.setdefault(plugin, tomlkit.table())["enabled"] = github_enabled
    updated = tomlkit.dumps(document)
    if tomllib.loads(updated) != expected:
        raise ValueError("could not preserve unrelated Codex configuration")

    path.parent.mkdir(parents=True, exist_ok=True)
    mode = path.stat().st_mode & 0o777 if path.exists() else 0o600
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(
                mode="w", dir=path.parent, prefix=".permissions-", delete=False) as output:
            temporary = Path(output.name)
            output.write(updated)
        temporary.chmod(mode)
        if (path.read_text() if path.exists() else "") != original:
            raise ValueError("Codex configuration changed during installation")
        temporary.replace(path)
    finally:
        if temporary and temporary.exists():
            temporary.unlink()


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as error:
        print(f"sync-codex-permissions: {error}", file=sys.stderr)
        sys.exit(1)
