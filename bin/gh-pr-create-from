#!/usr/bin/env python3
"""Open a GitHub PR from a pull-request-writer description file.

Usage: gh-pr-create-from <file> [gh pr create args, e.g. --draft --base main --head b]
       gh-pr-create-from --check <file> [--draft]   # validate only, open nothing

The file is the agent's output: title on line 1, a blank line, then the body.
The file is checked before `gh` runs, so every PR opened this way meets the
parts of the spec a script can check. Title and body come only from the file.
"""
import re
import subprocess
import sys
import tempfile

LOCAL_PATH = re.compile(
    r"(?<![\w.])(?:/Users/|/home/\w|~/|/tmp/|/private/(?:var|tmp)/|/var/folders/)"
    r"|\blocalhost\b|127\.0\.0\.1|file://"
)
SCREENSHOT_TODO = re.compile(r"TODO:\s*attach", re.IGNORECASE)
OWNED_FLAGS = {"--title", "-t", "--body", "-b", "--body-file", "-F", "--fill", "-f",
               "--fill-first", "--fill-verbose", "--template", "-T", "--web", "-w"}


def problems(text, gh_args):
    lines = text.split("\n")
    title, body = lines[0].strip(), "\n".join(lines[2:]).strip()
    found = []
    if not title:
        found.append("line 1 must be the PR title")
    elif title.startswith("#"):
        found.append("title must be plain text, not a markdown heading")
    elif len(title) > 72:
        found.append(f"title is {len(title)} characters; keep it under 72")
    if len(lines) < 3 or lines[1].strip():
        found.append("line 2 must be blank, with the body starting on line 3")
    if not body:
        found.append("body is empty")
    for match in sorted({m.group(0) for m in LOCAL_PATH.finditer(text)}):
        found.append(f"references a local-only location reviewers can't open: {match!r}")
    if SCREENSHOT_TODO.search(text) and "--draft" not in gh_args and "-d" not in gh_args:
        found.append("has an unresolved screenshot TODO; attach it, or open with --draft")
    owned = sorted(OWNED_FLAGS.intersection(a.split("=")[0] for a in gh_args))
    if owned:
        found.append(f"{', '.join(owned)} would override the description file; drop them")
    return title, body, found


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    check_only = argv[1] == "--check"
    if check_only:
        argv = argv[1:]
        if len(argv) < 2:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    path, gh_args = argv[1], argv[2:]
    try:
        text = open(path, encoding="utf-8").read()
    except OSError as err:
        print(f"gh-pr-create-from: cannot read {path}: {err.strerror}", file=sys.stderr)
        return 1
    title, body, found = problems(text, gh_args)
    if found:
        print(f"gh-pr-create-from: {path} is not ready to open as a PR:", file=sys.stderr)
        for item in found:
            print(f"  - {item}", file=sys.stderr)
        print("Fix the description (pull-request-writer agent) and rerun.", file=sys.stderr)
        return 1
    if check_only:
        return 0
    with tempfile.NamedTemporaryFile("w", suffix=".md", encoding="utf-8") as body_file:
        body_file.write(body + "\n")
        body_file.flush()
        return subprocess.run(["gh", "pr", "create", "--title", title,
                               "--body-file", body_file.name, *gh_args]).returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv))
