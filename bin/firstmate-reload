#!/usr/bin/env bash
set -euo pipefail

if [[ $# != 0 ]]; then
	printf '%s\n' 'Usage: firstmate-reload' \
		'Reload the shared tmux configuration on the Firstmate server.'
	[[ $1 == --help ]] || exit 2
	exit 0
fi

helper_dir=$(cd "$(dirname "$0")" && pwd)
exec "$helper_dir/firstmate-tmux" source-file "$HOME/.config/firstmate/tmux.conf"
