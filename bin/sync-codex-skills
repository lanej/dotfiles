#!/usr/bin/env python3
"""Expose dotfiles skills to Codex, including symlinked and lowercase entrypoints."""

import argparse
import platform
from pathlib import Path
import shutil
import sys


def remove(path):
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)


def link(source, destination):
    if destination.is_symlink() and destination.readlink() == source:
        return
    remove(destination)
    destination.symlink_to(source, target_is_directory=source.is_dir())


def sync(source, home):
    cache = home / ".codex/dotfiles-skills"
    destination = home / ".agents/skills/dotfiles"
    if destination.is_symlink():
        if destination.resolve() != cache.resolve():
            raise ValueError(f"{destination} already points to another skill tree")
    elif destination.exists():
        raise ValueError(f"{destination} already contains local skills")
    if not source.is_dir():
        print(f"sync-codex-skills: no skill tree at {source}, skipping", file=sys.stderr)
        return

    cache.mkdir(parents=True, exist_ok=True)
    shared = set()
    for folder in sorted(source.iterdir()):
        if folder.is_symlink() and not folder.exists():
            print(f"sync-codex-skills: unavailable source {folder}, skipping", file=sys.stderr)
            continue
        if not folder.is_dir():
            continue
        if platform.system() != "Darwin" and folder.name == "problem-definition-contract":
            continue
        children = list(folder.iterdir())
        entrypoints = sorted(
            (p for p in children if p.name.casefold() == "skill.md" and p.is_file()),
            key=lambda p: p.name != "SKILL.md",
        )
        if not entrypoints:
            continue
        entrypoint = entrypoints[0]
        installed = cache / folder.name
        if entrypoint.name == "SKILL.md" and not entrypoint.is_symlink():
            link(folder, installed)
        else:
            # Codex follows directory links, but skips file links and requires
            # the exact SKILL.md filename, even on case-insensitive filesystems.
            if installed.is_symlink():
                installed.unlink()
            installed.mkdir(exist_ok=True)
            target = installed / "SKILL.md"
            if target.is_symlink():
                target.unlink()
            shutil.copyfile(entrypoint, target)
            resources = {p.name for p in children if p.name.casefold() != "skill.md"}
            for child in installed.iterdir():
                if child.name != "SKILL.md" and child.name not in resources:
                    remove(child)
            for child in children:
                if child.name in resources:
                    link(child, installed / child.name)
        shared.add(folder.name)

    for child in cache.iterdir():
        if child.name not in shared:
            remove(child)
    destination.parent.mkdir(parents=True, exist_ok=True)
    link(cache, destination)
    print(f"sync-codex-skills: shared {len(shared)} skills in {destination}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path, default=Path(__file__).resolve().parents[1] / "claude/skills")
    parser.add_argument("--home", type=Path, default=Path.home())
    args = parser.parse_args()
    try:
        sync(args.source.expanduser().absolute(), args.home.expanduser().absolute())
    except (OSError, ValueError) as error:
        parser.exit(1, f"sync-codex-skills: {error}\n")


if __name__ == "__main__":
    main()
