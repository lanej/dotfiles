#!/usr/bin/env python3
"""Expose dotfiles skills to Codex, including symlinked and lowercase entrypoints."""

import argparse
import json
import platform
from pathlib import Path
import shutil
import sys
import tempfile


def remove(path):
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)


def link(source, destination):
    if destination.is_symlink() and destination.readlink() == source:
        return
    remove(destination)
    destination.symlink_to(source, target_is_directory=source.is_dir())


def portable_names(source):
    manifest = source / "portable-workflows.json"
    if not manifest.is_file():
        return set()
    names = json.loads(manifest.read_text())
    if (not isinstance(names, list) or not all(isinstance(name, str) for name in names)
            or len(set(names)) != len(names)):
        raise ValueError(f"{manifest}: expected a unique list of skill directory names")
    for name in names:
        if not name or name in {".", ".."} or Path(name).name != name or not (source / name / "SKILL.md").is_file():
            raise ValueError(f"{manifest}: missing or invalid portable skill {name!r}")
    return set(names)


def copy_package(source, destination):
    """Materialize portable resources before replacing a managed installation."""
    with tempfile.TemporaryDirectory(prefix="workflow-install-", dir=destination.parent.parent) as scratch:
        staged = Path(scratch) / destination.name
        shutil.copytree(source, staged, symlinks=False,
                        ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))
        remove(destination)
        staged.rename(destination)


def sync(source, home, only=None):
    cache = home / ".codex/dotfiles-skills"
    destination = home / ".agents/skills/dotfiles"
    if destination.is_symlink():
        if destination.resolve() != cache.resolve():
            raise ValueError(f"{destination} already points to another skill tree")
    elif destination.exists():
        raise ValueError(f"{destination} already contains local skills")
    if not source.is_dir():
        print(f"sync-codex-skills: no skill tree at {source}, skipping", file=sys.stderr)
        return

    portable = portable_names(source)
    if only is not None:
        for name in only:
            if Path(name).name != name or not (source / name / "SKILL.md").is_file():
                raise ValueError(f"unknown selected skill {name!r}")
        # Portable workflows share relative resources and install as one group.
        if only & portable:
            only = only | portable
    cache.mkdir(parents=True, exist_ok=True)
    shared = set()
    for folder in sorted(source.iterdir()):
        if only is not None and folder.name not in only:
            continue
        if folder.is_symlink() and not folder.exists():
            print(f"sync-codex-skills: unavailable source {folder}, skipping", file=sys.stderr)
            continue
        if not folder.is_dir():
            continue
        if platform.system() != "Darwin" and folder.name == "problem-definition-contract":
            continue
        # Builder also has a standalone, tool-neutral installation.
        if folder.name == "builder":
            package = home / ".local/share/software-standards" / folder.name
            if (package / ".dotfiles-managed").is_file():
                folder = package
        children = list(folder.iterdir())
        entrypoints = sorted(
            (p for p in children if p.name.casefold() == "skill.md" and p.is_file()),
            key=lambda p: p.name != "SKILL.md",
        )
        if not entrypoints:
            continue
        entrypoint = entrypoints[0]
        installed = cache / folder.name
        if folder.name in portable:
            copy_package(folder, installed)
        elif entrypoint.name == "SKILL.md" and not entrypoint.is_symlink():
            link(folder, installed)
        else:
            # Codex follows directory links, but skips file links and requires
            # the exact SKILL.md filename, even on case-insensitive filesystems.
            if installed.is_symlink():
                installed.unlink()
            installed.mkdir(exist_ok=True)
            target = installed / "SKILL.md"
            if target.is_symlink():
                target.unlink()
            shutil.copyfile(entrypoint, target)
            resources = {p.name for p in children if p.name.casefold() != "skill.md"}
            for child in installed.iterdir():
                if child.name != "SKILL.md" and child.name not in resources:
                    remove(child)
            for child in children:
                if child.name in resources:
                    link(child, installed / child.name)
        shared.add(folder.name)

    for child in cache.iterdir():
        if only is None and child.name not in shared:
            remove(child)
    destination.parent.mkdir(parents=True, exist_ok=True)
    link(cache, destination)
    print(f"sync-codex-skills: shared {len(shared)} skills in {destination}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path, default=Path(__file__).resolve().parents[1] / "ai/skills")
    parser.add_argument("--home", type=Path, default=Path.home())
    parser.add_argument("--only", nargs="+", help="refresh named skills without pruning others; portable workflows refresh together")
    args = parser.parse_args()
    try:
        sync(args.source.expanduser().absolute(), args.home.expanduser().absolute(),
             set(args.only) if args.only else None)
    except (OSError, ValueError, shutil.Error) as error:
        parser.exit(1, f"sync-codex-skills: {error}\n")


if __name__ == "__main__":
    main()
