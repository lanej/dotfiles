#!/usr/bin/env python3
"""Direct PR publication to Octo's recorded writer and publication checks."""
import json
import re
import sys

RAW_CREATE = re.compile(
    r"(?:^|[;&|(\n]|\$\()\s*(?:\w+=\S*\s+)*(?:command\s+|env\s+(?:\w+=\S*\s+)*)?"
    r"(?:[^\s;&|()]*/)?gh\s+pr\s+(?:create|new)\b(?P<rest>[^;&|\n]*)"
)
REASON = (
    "Publish through `octo-manager submit-pr`; gh-pr-create-from has been retired. "
    "Octo owns the dedicated writer, publication checks, and tracking. Read "
    "~/.files/docs/octo-pr-submission.md. Use the actual calling session identity; "
    "if Octo does not support this harness, report that limitation rather than "
    "inventing a Codex identity or falling back to raw publication."
)
RETIRED_CREATE = re.compile(
    r"(?:^|[;&|(\n]|\$\()\s*(?:\w+=\S*\s+)*(?:command\s+|env\s+(?:\w+=\S*\s+)*)?"
    r"(?:[^\s;&|()]*/)?gh-pr-create-from(?=\s|$)"
)


def main():
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        return 0
    command = (payload.get("tool_input") or {}).get("command") or ""
    denied = RETIRED_CREATE.search(command) is not None
    for match in RAW_CREATE.finditer(command):
        if re.search(r"(?:^|\s)(?:--help|-h)\b", match.group("rest")):
            continue
        denied = True
    if denied:
        json.dump({"hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": REASON,
        }}, sys.stdout)
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
