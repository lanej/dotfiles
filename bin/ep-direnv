#!/usr/bin/env python3
"""Local direnv setup for legacy EasyPost repositories; no application values stored here."""
import fcntl
import json
import hashlib
import os
from pathlib import Path
import re
import shutil
import shlex
import subprocess
import sys

GENERATED = '# Generated by ep-direnv; application configuration stays in .env* files.\nuse easypost_legacy\n'
HOOKS = '''applypatch-msg pre-applypatch post-applypatch pre-commit pre-merge-commit prepare-commit-msg commit-msg post-commit pre-rebase post-checkout post-merge pre-push pre-receive update proc-receive post-receive post-update reference-transaction push-to-checkout pre-auto-gc post-rewrite sendemail-validate fsmonitor-watchman p4-changelist p4-prepare-changelist p4-post-changelist p4-pre-submit post-index-change'''.split()


def git(*args, cwd=None, check=True):
    return subprocess.run(['git', *args], cwd=cwd, text=True, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, check=check)


def values(config, key):
    result = git('config', '--file', str(config), '--get-all', key, check=False)
    return result.stdout.splitlines() if result.returncode == 0 else []


def replace(config, key, items):
    git('config', '--file', str(config), '--unset-all', key, check=False)
    for item in items:
        git('config', '--file', str(config), '--add', key, item)


def location(directory):
    root = Path(git('rev-parse', '--show-toplevel', cwd=directory).stdout.strip())
    common = Path(git('rev-parse', '--path-format=absolute', '--git-common-dir', cwd=root).stdout.strip())
    return root, common


def tracked(root, name):
    # --no-checkout worktrees can have no index yet; HEAD is still authoritative.
    return (git('ls-files', '--error-unmatch', '--', name, cwd=root, check=False).returncode == 0
            or git('cat-file', '-e', 'HEAD:' + name, cwd=root, check=False).returncode == 0)


def qualifies(root):
    origin = git('remote', 'get-url', 'origin', cwd=root, check=False).stdout.strip()
    return bool(re.fullmatch(r'(?:https?://github\.com/|ssh://git@github\.com/|git@github\.com:)easypost/[^/]+/?', origin, re.I)) and tracked(root, '.env')


def configs(common):
    yield common / 'config'
    yield common / 'config.worktree'
    yield from (common / 'worktrees').glob('*/config.worktree')


def save(statefile, state):
    temporary = statefile.with_suffix('.tmp')
    temporary.write_text(json.dumps(state, indent=2) + '\n')
    temporary.replace(statefile)


def install_hooks(root, common, statefile, state):
    dispatcher = str(statefile.parent / 'hooks')
    effective = git('config', '--get', 'core.hooksPath', cwd=root, check=False).stdout.strip()
    if effective == '/dev/null':
        return
    if state is None:
        # Capture the inherited effective path before installing the local override.
        inherited = git('-c', 'extensions.worktreeConfig=false', 'config', '--get', 'core.hooksPath', cwd=root, check=False)
        state = {'inherited': inherited.stdout.rstrip('\n') if inherited.returncode == 0 else str(common / 'hooks'), 'configs': {}}
    hooks = Path(dispatcher)
    hooks.mkdir(exist_ok=True)
    executable = str(Path(__file__).resolve())
    for name in HOOKS:
        hook = hooks / name
        content = '#!/bin/sh\nexec ' + shlex.quote(executable) + ' hook ' + shlex.quote(name) + ' "$@"\n'
        if not hook.exists() or hook.read_text() != content:
            temporary = hook.with_suffix('.tmp')
            temporary.write_text(content)
            temporary.chmod(0o755)
            temporary.replace(hook)
    worktree_config = git('config', '--bool', '--get', 'extensions.worktreeConfig', cwd=root, check=False).stdout.strip() == 'true'
    for config in configs(common):
        if config != common / 'config' and not worktree_config:
            continue
        if not config.exists():
            continue
        key = str(config)
        prior = values(config, 'core.hooksPath')
        if prior in (['/dev/null'], [dispatcher]):
            continue
        if key in state['configs']:
            continue  # Never overwrite a subsequent user change.
        if config == common / 'config' or prior:
            state['configs'][key] = prior
            save(statefile, state)  # Save before selecting our hooks.
            replace(config, 'core.hooksPath', [dispatcher])



def approve_generated(envrc):
    """Write only the known content's approval, never hash mutable checkout content.

    direnv has no content-bound allow CLI. Its content-addressed approval format
    is verified in upstream internal/cmd/rc.go for 2.35.0 and 2.38.2. Restrict
    automatic approval to those versions; unknown versions fail closed.
    """
    version = subprocess.check_output(['direnv', 'version'], text=True).strip()
    if version not in ('2.35.0', '2.38.2'):
        print('ep-direnv: unsupported direnv version; automatic approval supports 2.35.0 and 2.38.2', file=sys.stderr)
        raise ValueError('unsupported direnv approval format; approve manually')
    data = Path(os.environ.get('XDG_DATA_HOME') or str(Path.home() / '.local/share')) / 'direnv'
    # Use the lexical absolute path as direnv's fileHash does; do not resolve
    # a concurrently substituted .envrc symlink.
    path = str(envrc.absolute()) + '\n'
    digest = hashlib.sha256((path + GENERATED).encode()).hexdigest()
    allow = data / 'allow'
    allow.mkdir(parents=True, exist_ok=True)
    marker = allow / digest
    if not marker.exists():
        with marker.open('x') as out:
            out.write(path)
    # An explicit block remains owned by the user; never remove its deny entry.


def ensure(root, common, statefile, state):
    if not qualifies(root):
        return
    envrc = root / '.envrc'
    if not tracked(root, '.envrc') and not envrc.is_symlink():
        if not envrc.exists():
            try:
                with envrc.open('x') as out:
                    out.write(GENERATED)
            except FileExistsError:
                pass
        if envrc.is_file() and envrc.read_text() == GENERATED:
            exclude = common / 'info' / 'exclude'
            exclude.parent.mkdir(exist_ok=True)
            text = exclude.read_text() if exclude.exists() else ''
            if '/.envrc' not in text.splitlines():
                with exclude.open('a') as out:
                    out.write('\n/.envrc\n')
            approve_generated(envrc)
    install_hooks(root, common, statefile, state)


def forward(name, args):
    common = Path(git('rev-parse', '--path-format=absolute', '--git-common-dir').stdout.strip())
    statefile = common / 'ep-direnv' / 'state.json'
    state = json.loads(statefile.read_text())
    gitdir = Path(git('rev-parse', '--absolute-git-dir', ).stdout.strip())
    worktree = state['configs'].get(str(gitdir / 'config.worktree'), [])
    local = state['configs'].get(str(common / 'config'), [])
    original = (worktree or local or [state['inherited']])[-1]
    hook = Path(original).expanduser() / name  # Relative paths retain the invoking Git cwd.
    status = 0
    if hook.is_file() and os.access(hook, os.X_OK):
        status = subprocess.run([str(hook.absolute()), *args]).returncode
        if status < 0:
            status = 128 - status
    if name == 'post-checkout':
        root = Path(git('rev-parse', '--show-toplevel').stdout.strip())
        setup = subprocess.run([str(Path(__file__).resolve()), 'ensure', str(root)], stdin=subprocess.DEVNULL)
        if setup.returncode:
            print('ep-direnv: post-checkout setup failed', file=sys.stderr)
            status = status or setup.returncode
    return status


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else 'ensure'
    if action == 'hook':
        return forward(sys.argv[2], sys.argv[3:])
    if action not in ('ensure', 'uninstall') or len(sys.argv) > 3:
        raise ValueError('usage: ep-direnv ensure|uninstall [directory]')
    directory = sys.argv[2] if len(sys.argv) > 2 else '.'
    try:
        root, common = location(directory)
    except subprocess.CalledProcessError:
        return 0  # Normal shell entry outside a non-bare checkout.
    if action == 'ensure' and not qualifies(root):
        return 0
    owned = common / 'ep-direnv'
    if action == 'uninstall' and not owned.exists():
        return 0
    owned.mkdir(exist_ok=True)
    with (owned / 'lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        statefile = owned / 'state.json'
        state = json.loads(statefile.read_text()) if statefile.exists() else None
        if action == 'ensure':
            ensure(root, common, statefile, state)
        elif state:
            dispatcher = str(owned / 'hooks')
            for config, prior in state['configs'].items():
                if Path(config).exists() and values(config, 'core.hooksPath') == [dispatcher]:
                    replace(config, 'core.hooksPath', prior)
            # Retain forwarding state if a later configuration still refers to it.
            if not any(dispatcher in values(c, 'core.hooksPath') for c in configs(common) if c.exists()):
                shutil.rmtree(owned / 'hooks')
                statefile.unlink()
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        # Never relay subprocess output: application configuration can contain secrets.
        print('ep-direnv: setup failed (' + type(error).__name__ + ')', file=sys.stderr)
        sys.exit(1)
