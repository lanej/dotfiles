#!/usr/bin/env bash
# Attach to or create a named session, defaulting to main.
set -eu

if [ -n "${ZELLIJ:-}" ]; then
	printf '%s\n' 'zj: already inside Zellij; detach before attaching to another session.' >&2
	exit 1
fi

[ "$#" -gt 0 ] || set -- main
# Refresh only the selected session. Keep the client's raw socket because its
# session manager may create another server with the inherited environment.
if [ -n "${SSH_CONNECTION:-}" ] && [ -n "${SSH_AUTH_SOCK:-}" ]; then
	case "$1" in
		-*) ;;
		*)
			agent_helper="$(dirname "$0")/zellij-agent"
			if [ -x "$agent_helper" ]; then
				"$agent_helper" refresh "$1" >/dev/null 2>&1 || :
			fi
			;;
	esac
fi
if [ -n "${SSH_CONNECTION:-}" ] && [ -z "${TMUX:-}" ] && [ -t 1 ]; then
	# WHY: Kitty cannot distinguish remote Zellij from an ordinary application's
	# title. Announce the host outside the mux, which consumes pane OSC messages.
	host=$(hostname -s)
	marker=$(printf '%s/%s/%s' "$host" "$$" "$RANDOM" | base64 | tr -d '\n')
	printf '\033]1337;SetUserVar=dotfiles_zellij=%s\007' "$marker"
	trap 'printf "\033]1337;SetUserVar=dotfiles_zellij\007"' EXIT
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 143' TERM
	zellij attach --create "$@"
else
	exec zellij attach --create "$@"
fi
