#!/usr/bin/env bash
# Attach to or create a named session, defaulting to main.
set -eu

if [ -n "${ZELLIJ:-}" ]; then
	printf '%s\n' 'zj: already inside Zellij; detach before attaching to another session.' >&2
	exit 1
fi

[ "$#" -gt 0 ] || set -- main
# Refresh only the selected session. Keep the client's raw socket because its
# session manager may create another server with the inherited environment.
if [ -n "${SSH_CONNECTION:-}" ] && [ -n "${SSH_AUTH_SOCK:-}" ]; then
	case "$1" in
		-*) ;;
		*)
			agent_helper="$(dirname "$0")/zellij-agent"
			if [ -x "$agent_helper" ]; then
				if ! "$agent_helper" refresh "$1" >/dev/null 2>&1 &&
				   [ -S "$SSH_AUTH_SOCK" ] && [ ! -L "$SSH_AUTH_SOCK" ] &&
				   [ -O "$SSH_AUTH_SOCK" ]; then
					# Restored servers do not exist until attach starts them.
					# Bound the retry worker so a failed attach leaves no daemon.
					(
						deadline=$((SECONDS + 5))
						while [ "$SECONDS" -lt "$deadline" ]; do
							sleep 0.2
							"$agent_helper" refresh "$1" >/dev/null 2>&1 && exit 0
						done
						printf '%s\n' 'zj: forwarded SSH agent refresh failed; reconnect with agent forwarding enabled.' >&2
					) </dev/null &
				fi
			fi
			;;
	esac
fi
exec zellij attach --create "$@"
