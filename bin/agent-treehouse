#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# dependencies = ["websockets==15.0.1", "psutil==7.2.2"]
# ///
"""Compatibility entrypoint for outstanding agent worktree ownership records."""
from pathlib import Path
import runpy

adapter = Path(__file__).resolve().with_name("agent-worktree")
if __name__ == "__main__":
    runpy.run_path(str(adapter), run_name="__main__")
else:
    globals().update(runpy.run_path(str(adapter)))
