#!/usr/bin/env bash
# PreToolUse:EnterWorktree — rename tmux window to the incoming worktree name

[[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]] || exit 0

payload=$(cat)

name=$(printf '%s' "$payload" | jq -r '
  .tool_input.name // .tool_input.path // empty
' 2>/dev/null || true)

# path form: use basename
[[ -n "$name" ]] && name=$(basename "$name")

if [[ -n "$name" ]]; then
    tmux rename-window -t "$TMUX_PANE" "$name" 2>/dev/null || true
fi

exit 0
