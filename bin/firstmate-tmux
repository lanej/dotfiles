#!/usr/bin/env bash
set -euo pipefail

if [[ $# == 0 || ${1:-} == --help ]]; then
	printf '%s\n' \
		'Usage: firstmate-tmux [tmux options] command [arguments]' \
		'Run tmux commands on the dedicated Firstmate server.' \
		'FIRSTMATE_TMUX_SOCKET overrides the socket name (default: firstmate).'
	[[ $# != 0 ]] || exit 2
	exit 0
fi

# Clear the caller's tmux identity, including when invoked from another server.
exec env -u TMUX -u TMUX_PANE tmux \
	-f "$HOME/.config/firstmate/tmux.conf" \
	-L "${FIRSTMATE_TMUX_SOCKET:-firstmate}" "$@"
