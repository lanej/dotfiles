#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Update selected projects through verified, project-owned activation."""

import argparse
from contextlib import ExitStack
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tomllib
import uuid

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "scripts"))
from project_update_activation import (IncompleteActivation, native, original_restored,
                                       reconcile_sessions, verified)
from project_update_operations import (acquire, operation_path, private_directory,
                                      read_json, state_root, wait_result, write_json)

ACTIONS = ("status", "pull", "build", "restart", "clean", "update", "verify", "wait")


def run(args, cwd, capture=False):
    result = subprocess.run(args, cwd=cwd, text=True, check=True,
                            stdout=subprocess.PIPE if capture else sys.stderr,
                            stderr=subprocess.PIPE if capture else None)
    return result.stdout.strip() if capture else ""


def git(path, *args):
    return run(["git", "-C", str(path), *args], path, capture=True)


def load_projects(config):
    data = tomllib.loads(config.read_text())
    projects = data.get("projects", {})
    if not projects:
        raise ValueError(f"No projects registered in {config}")
    for name, project in projects.items():
        if not isinstance(project, dict) or not isinstance(project.get("path"), str):
            raise ValueError(f"{name}: expected a project path")
        command = project.get("command")
        if not isinstance(command, list) or not command or not all(isinstance(x, str) and x for x in command):
            raise ValueError(f"{name}: command must be a nonempty argv array")
        if not isinstance(project.get("pull_sources", False), bool):
            raise ValueError(f"{name}: pull_sources must be a boolean")
        repository = project.get("repository")
        if repository is not None and (not isinstance(repository, str) or not repository.strip()
                                       or repository.startswith("-")):
            raise ValueError(f"{name}: repository must be a nonempty Git clone URL or path")
        dependencies = project.get("depends_on", [])
        if not isinstance(dependencies, list) or not all(isinstance(x, str) for x in dependencies):
            raise ValueError(f"{name}: depends_on must be an array of project names")
        if project.get("lifecycle", "service") not in ("service", "consumer", "terminal", "stateless"):
            raise ValueError(f"{name}: invalid lifecycle class")
        if type(project.get("automatic_restart", True)) is not bool:
            raise ValueError(f"{name}: automatic_restart must be a boolean")
        if project.get("automatic_restart") is False and project.get("lifecycle") != "terminal":
            raise ValueError(f"{name}: manual restart policy requires a terminal lifecycle")
        configured_path = Path(project["path"].replace("{dotfiles}", str(ROOT))).expanduser().absolute()
        project["configured_path"] = str(configured_path)
        project["path"] = configured_path.resolve()
        project["name"] = name
        project["command"] = [x.replace("{dotfiles}", str(ROOT)).replace("{python}", sys.executable) for x in command]
        if "remote" in project and (not isinstance(project["remote"], str) or not project["remote"] or project["remote"].startswith("-")):
            raise ValueError(f"{name}: invalid remote name")
    return projects


def result_code(results):
    return 1 if any(row["outcome"] == "failed" for row in results) else (
        3 if any(row["outcome"] != "ok" for row in results) else 0)


def failure(row, error):
    pending = isinstance(error, (IncompleteActivation, subprocess.TimeoutExpired))
    row.update(outcome="incomplete" if pending else "failed",
               reason="checkpoint-or-effect-outcome-unknown" if isinstance(error, subprocess.TimeoutExpired) else str(error))
    row["error"] = row["reason"]
    if isinstance(error, IncompleteActivation) and error.targets is not None:
        row["targets"] = error.targets
    if isinstance(error, subprocess.CalledProcessError) and error.stderr:
        row["error"] += ": " + error.stderr.strip()[-2000:]


def ordered(names, projects):
    """Respect prerequisites within the service/consumer/terminal ordering."""
    result, visiting = [], set()
    rank = {"stateless": 0, "service": 1, "consumer": 2, "terminal": 3}
    def visit(name):
        if name in visiting:
            raise ValueError(f"Activation dependency cycle at {name}")
        if name in result:
            return
        visiting.add(name)
        for dependency in projects[name].get("depends_on", []):
            if dependency not in projects:
                raise ValueError(f"{name}: unknown prerequisite {dependency}")
            if dependency in names:
                visit(dependency)
        visiting.remove(name)
        result.append(name)
    for name in sorted(names, key=lambda name: rank[projects[name].get("lifecycle", "service")]):
        visit(name)
    return result


def affected_projects(names, projects):
    affected = list(names)
    while True:
        consumers = [name for name, project in projects.items() if name not in affected
                     and any(dependency in affected for dependency in project.get("depends_on", []))]
        terminal_owners = [dependency for name in affected
                           if projects[name].get("lifecycle") == "terminal"
                           and not projects[name].get("activation_deferred")
                           for dependency in projects[name].get("depends_on", [])
                           if dependency not in affected and projects[dependency].get("lifecycle") == "consumer"]
        additions = list(dict.fromkeys([*consumers, *terminal_owners]))
        if not additions:
            return affected
        affected.extend(additions)


def reconcile_previous(name, project, directory):
    """Reconcile issued effects, never a preflight that made no native call."""
    blockers = {}
    for previous in state_root().iterdir():
        if previous == directory or not previous.is_dir() or not (previous / "intent.json").is_file():
            continue
        private_directory(previous)
        intent = read_json(previous / "intent.json")
        owner = intent.get("projects", {}).get(name)
        if owner is None or Path(owner["path"]) != project["path"]:
            continue
        state_path = previous / ("result.json" if (previous / "result.json").exists() else "progress.json")
        state = read_json(state_path)
        row = next((value for value in state["results"] if value["project"] == name), None)
        if row is None or (row["outcome"] == "ok" and row.get("phase") == "verified"):
            continue
        settled = {value["target"] for value in row.get("target_results", [])
                   if value.get("phase") == "verified" or value.get("recovered_original") is True}
        reconciled = previous / f"{name}-reconciled.json"
        if reconciled.is_file():
            settled.update(value["target"] for value in read_json(reconciled)["targets"])
        journal = previous / "evidence"
        unresolved, restart_requested = set(), set()
        if journal.is_dir():
            for path in journal.iterdir():
                attempt = read_json(path)
                if attempt.get("project") != name or attempt.get("action") not in ("checkpoint", "restart", "restore"):
                    continue
                target = attempt.get("target")
                if attempt.get("action") == "restart":
                    restart_requested.add(target)
                if target in settled:
                    continue
                response = attempt.get("response", {}).get("targets", [])
                if (attempt.get("state") == "observed" and attempt.get("action") == "checkpoint"
                        and response and all(value.get("checkpoint", {}).get("state") == "refused" for value in response)):
                    continue
                unresolved.add(target)
        if not unresolved:
            continue
        frozen_path = previous / f"{name}-inventory.json"
        if not frozen_path.is_file():
            for target in unresolved:
                blockers[target] = f"previous-update-outcome-unknown: {previous.name}"
            continue
        before = read_json(frozen_path)["targets"]
        restoration_path = previous / "restoration-plan.json"
        if restoration_path.is_file():
            before = read_json(restoration_path).get(name, {"targets": before})["targets"]
        observed = []
        phases = {value["target"]: value.get("phase") for value in row.get("target_results", [])}
        for target in before:
            if None not in unresolved and target["target"] not in unresolved:
                continue
            try:
                after = native({**project, "target": target["target"]}, "inventory", directory)
                try:
                    reconcile_sessions([target], after, restored=True)
                    complete, reason = verified(after)
                    if not complete:
                        raise IncompleteActivation(reason, after)
                except IncompleteActivation:
                    if (phases.get(target["target"]) != "original-restoration-requested"
                            or None in restart_requested or target["target"] in restart_requested
                            or len(after) != 1 or after[0]["target"] != target["target"]):
                        raise
                    original_restored(target, after[0], previous.name)
                    after[0]["recovered_original"] = True
                observed.extend(after)
            except (OSError, ValueError, IncompleteActivation, subprocess.SubprocessError) as error:
                blockers[target["target"]] = f"previous-update-not-restored: {previous.name}: {error}"
        if observed:
            old = read_json(reconciled)["targets"] if reconciled.is_file() else []
            combined = {target["target"]: target for target in [*old, *observed]}
            write_json(reconciled, {"targets": list(combined.values()), "observed_by": directory.name})
    return blockers


def activate(names, projects, rows, directory, save):
    from project_update_coordinator import activate_targets
    activate_targets(names, projects, rows, directory, save, ordered(names, projects), failure)


def execute(action, names, projects, fetch=False, directory=None):
    rows = {name: {"project": name, "completed": [], "outcome": "ok"} for name in names}
    affected = affected_projects(names, projects) if action in ("update", "restart") else names
    for name in affected:
        if name not in rows:
            rows[name] = {"project": name, "completed": [], "outcome": "ok",
                          "participation": "dependent-recovery"}
    if directory is not None:
        for row in rows.values():
            row.update(run_id=directory.name, recovery_path=str(directory))
    def save():
        if directory is not None:
            write_json(directory / "progress.json", {"results": list(rows.values())})
    save()
    pulled = {}
    with ExitStack() as locks:
        if action not in ("status", "verify") or fetch:
            cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "dotfiles/project-update"
            cache.mkdir(parents=True, exist_ok=True)
            for path in sorted({projects[name]["path"] for name in affected}):
                key = hashlib.sha256(os.fsencode(path)).hexdigest()
                locks.enter_context(acquire(cache / f"{key}.lock", private=False))
        if directory is not None:
            for name in affected:
                try:
                    rows[name]["previous_target_blockers"] = reconcile_previous(name, projects[name], directory)
                except (OSError, ValueError, IncompleteActivation, subprocess.SubprocessError) as error:
                    failure(rows[name], error)
            save()
        steps = ("pull", "build") if action == "update" else (() if action == "restart" else (action,))
        # Stage the whole selection before any checkpoint or replacement.
        for step in steps:
            for name in names:
                project, row = projects[name], rows[name]
                if row["outcome"] != "ok":
                    continue
                path = project["path"]
                try:
                    if step == "pull":
                        ensure_checkout(path, project)
                    if not path.is_dir():
                        raise ValueError(f"Checkout not found: {path}")
                    if step == "build" and project.get("build_deferred"):
                        row["staging"] = "deferred"
                        save()
                        continue
                    print(f"{name}: {step}", file=sys.stderr, flush=True)
                    if step == "status":
                        row.update(status(path, project, fetch))
                    elif step == "verify":
                        row["targets"] = native(project, "verify")
                        complete, reason = verified(row["targets"])
                        if not complete:
                            raise IncompleteActivation(reason)
                    elif step == "pull":
                        key = (path, project.get("remote"))
                        if key not in pulled:
                            try:
                                pull(path, project)
                                pulled[key] = None
                            except (OSError, ValueError, subprocess.SubprocessError) as error:
                                pulled[key] = error
                        if pulled[key] is not None:
                            raise pulled[key]
                        if project.get("pull_sources", False):
                            run([*project["command"], "pull"], path)
                    else:
                        run([*project["command"], step], path)
                    row["completed"].append(step)
                except (OSError, ValueError, IncompleteActivation, subprocess.SubprocessError) as error:
                    failure(row, error)
                save()
        if action in ("update", "restart"):
            activate(affected, projects, rows, directory, save)
    return {"exit_code": result_code(rows.values()), "results": list(rows.values())}


def coordinator(directory, lock_fd):
    with os.fdopen(lock_fd, "w"):
        os.umask(0o077)
        intent = read_json(directory / "intent.json")
        projects = intent["projects"]
        for project in projects.values():
            project["path"] = Path(project["path"])
        try:
            result = execute(intent["action"], intent["names"], projects, directory=directory)
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            rows = read_json(directory / "progress.json")["results"]
            for row in rows:
                failure(row, error)
            result = {"exit_code": result_code(rows), "results": rows}
        write_json(directory / "result.json", result)
    return result["exit_code"]


def detached(action, names, projects):
    run_id = str(uuid.uuid4())
    directory = private_directory(state_root() / run_id)
    lock = acquire(directory / "coordinator.lock")
    try:
        write_json(directory / "intent.json", {
            "action": action, "names": names,
            "projects": {name: {**project, "path": str(project["path"])} for name, project in projects.items()}})
        write_json(directory / "progress.json", {"results": [
            {"project": name, "completed": [], "outcome": "ok", "run_id": run_id,
             "recovery_path": str(directory)} for name in names]})
        private_directory(directory / "checkpoints")
        with (directory / "coordinator.log").open("x") as log:
            os.chmod(directory / "coordinator.log", 0o600)
            child = subprocess.Popen([sys.executable, str(Path(__file__).resolve()),
                                      "--coordinate", str(directory), str(lock.fileno())],
                                     stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                                     start_new_session=True, pass_fds=(lock.fileno(),))
        print(f"project-update: run {run_id}; recover with project-update wait {run_id}", file=sys.stderr, flush=True)
    finally:
        lock.close()
    result = wait_result(directory)
    child.wait()
    return result


def remote_for(path, project):
    remotes = git(path, "remote").splitlines()
    remote = project.get("remote", "upstream" if "upstream" in remotes else "origin")
    if remote not in remotes:
        raise ValueError(f"No {remote} remote in {path}")
    return remote


def refresh(path, remote):
    head = git(path, "ls-remote", "--symref", remote, "HEAD")
    refs = [line.split()[1] for line in head.splitlines() if line.startswith("ref: refs/heads/")]
    if len(refs) != 1:
        raise ValueError(f"Cannot resolve default branch of {remote}")
    branch = refs[0].removeprefix("refs/heads/")
    target = f"refs/remotes/{remote}/{branch}"
    git(path, "fetch", remote, f"refs/heads/{branch}:{target}")
    return branch, target


def ensure_checkout(path, project):
    configured = Path(project.get("configured_path", str(path)))
    for component in (configured, *configured.parents):
        if component.is_symlink() and not component.exists():
            raise ValueError(f"Preserving dangling symlink in configured checkout path: {component}")
    if path.exists() or path.is_symlink():
        if not path.is_dir() or Path(git(path, "rev-parse", "--show-toplevel")).resolve() != path:
            raise ValueError(f"Preserving existing path that is not a checkout: {path}")
        return
    repository = project.get("repository")
    if repository is None:
        raise ValueError(f"Checkout not found: {path}; configure repository to allow cloning")
    # Reserve the destination before Git writes; a concurrent creator must win
    # without its files being replaced. Failed clones remain available to inspect.
    path.parent.mkdir(parents=True, exist_ok=True)
    path.mkdir()
    print(f"{project['name']}: clone {repository} into {path}", file=sys.stderr, flush=True)
    try:
        run(["git", "clone", "--origin", project.get("remote", "origin"), "--", repository, str(path)], path.parent)
    except subprocess.SubprocessError as error:
        raise ValueError(f"Clone failed; inspect reserved checkout before retrying: {path}") from error


def pull(path, project):
    for operation in ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "rebase-merge", "rebase-apply", "sequencer", "BISECT_START"):
        location = Path(git(path, "rev-parse", "--git-path", operation))
        if not location.is_absolute():
            location = path / location
        if location.exists():
            raise ValueError(f"{path}: unfinished Git operation ({operation}); reconcile manually")
    remote = remote_for(path, project)
    branch, target = refresh(path, remote)
    current = git(path, "symbolic-ref", "--quiet", "--short", "HEAD")
    if current != branch:
        raise ValueError(f"{path}: switch to {branch} explicitly; current branch is {current}")
    ancestor = subprocess.run(["git", "-C", str(path), "merge-base", "--is-ancestor", "HEAD", target])
    if ancestor.returncode:
        raise ValueError(f"{path}: local commits or diverged history; reconcile manually")
    git(path, "merge", "--ff-only", "--no-autostash", target)


def status(path, project, fetch):
    remote = remote_for(path, project)
    target = None
    if fetch:
        _, target = refresh(path, remote)
    else:
        result = subprocess.run(["git", "-C", str(path), "symbolic-ref", "--quiet", f"refs/remotes/{remote}/HEAD"], text=True, capture_output=True)
        if result.returncode == 0:
            target = result.stdout.strip()
    revision = None
    if target:
        revision = git(path, "rev-parse", "--verify", target)
    runtime = json.loads(run([*project["command"], "status"], path, capture=True))
    return {"path": str(path), "checkout_revision": git(path, "rev-parse", "HEAD"),
            "dirty": bool(git(path, "status", "--porcelain", "--untracked-files=all")),
            "upstream_ref": target, "upstream_revision": revision,
            "upstream_freshness": "fetched-now" if fetch else "cached-or-unknown",
            "runtime": runtime}


def main():
    if len(sys.argv) == 4 and sys.argv[1] == "--coordinate":
        return coordinator(Path(sys.argv[2]), int(sys.argv[3]))
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=ACTIONS)
    parser.add_argument("projects", nargs="*")
    parser.add_argument("--all", action="store_true", help="select every registered project")
    parser.add_argument("--config", type=Path, help="replace the bundled project registry")
    parser.add_argument("--fetch", action="store_true", help="refresh upstream while inspecting status")
    parser.add_argument("--dry-run", action="store_true", help="print the actions without running them")
    parser.add_argument("--restart-zellij", action="store_true",
                        help="explicitly request Zellij session replacement (currently unsupported)")
    args = parser.parse_args()
    if args.action == "wait":
        if len(args.projects) != 1 or args.all or args.fetch or args.dry_run or args.config or args.restart_zellij:
            parser.error("wait requires exactly one RUN_ID")
        try:
            uuid.UUID(args.projects[0])
            if str(uuid.UUID(args.projects[0])) != args.projects[0]:
                raise ValueError()
        except ValueError:
            parser.error("RUN_ID must be a complete operation UUID")
        result = wait_result(operation_path(args.projects[0]))
        print(json.dumps(result["results"], indent=2))
        return result["exit_code"]
    if args.all == bool(args.projects):
        parser.error("select project names or --all")
    if args.fetch and args.action != "status":
        parser.error("--fetch applies only to status")
    if args.restart_zellij and args.action not in ("update", "restart"):
        parser.error("--restart-zellij applies only to update or restart")
    try:
        projects = load_projects(args.config or ROOT / "config/project-updates.toml")
    except (OSError, ValueError, tomllib.TOMLDecodeError) as error:
        parser.error(str(error))
    names = list(projects) if args.all else list(dict.fromkeys(args.projects))
    unknown = set(names) - projects.keys()
    if unknown:
        parser.error("unknown projects: " + ", ".join(sorted(unknown)))
    if args.action in ("update", "restart"):
        for name, project in projects.items():
            project["activation_deferred"] = (
                not project.get("automatic_restart", True)
                and not (name == "zellij" and args.restart_zellij))
            project["build_deferred"] = (
                args.all and name == "zellij" and project["activation_deferred"])
        if args.restart_zellij and "zellij" not in affected_projects(names, projects):
            parser.error("--restart-zellij requires Zellij in the affected selection")
    steps = ("pull", "build", "inventory", "checkpoint", "restart", "restore", "verify") if args.action == "update" else (
        ("inventory", "checkpoint", "restart", "restore", "verify") if args.action == "restart" else (args.action,))
    try:
        ordered(names, projects)
    except ValueError as error:
        parser.error(str(error))
    if args.dry_run:
        print(json.dumps([{ "project": name, "path": str(projects[name]["path"]),
                            "steps": list(("pull", "inventory") if projects[name].get("build_deferred")
                                          else ("pull", "build", "inventory")
                                          if args.action == "update" else ("inventory",))
                            if projects[name].get("activation_deferred") else list(steps),
                            **({"activation": "deferred"} if projects[name].get("activation_deferred") else {}),
                            "command": projects[name]["command"]} for name in names], indent=2))
        return 0
    result = detached(args.action, names, projects) if args.action in ("update", "restart") else execute(
        args.action, names, projects, args.fetch)
    print(json.dumps(result["results"], indent=2))
    return result["exit_code"]


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, tomllib.TOMLDecodeError) as error:
        sys.exit(f"project-update: {error}")
