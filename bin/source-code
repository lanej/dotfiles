def git(root: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    env = dict(os.environ)
    for name in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_COMMON_DIR"):
        env.pop(name, None)
    executable = shutil.which("git")
    if executable is None:
        raise ValueError("Git is required")
    # Only constructed Git argv reaches this boundary; no shell is involved.
    result = subprocess.run(  # noqa: S603 -- fixed Git executable and constructed argv
        [executable, "-C", str(root), *args],
        capture_output=True,
        text=True,
        env=env,
    )
    if check and result.returncode:
        raise ValueError(result.stderr.strip() or "Git command failed")
    return result


def digest(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def file_entry(data: bytes, executable: bool = False) -> Snapshot:
    return {"kind": "file", "sha256": digest(data), "executable": executable}


def inspect(root: Path, relative: str) -> Snapshot | None:
    """Never follow a destination symlink, including an ancestor directory."""
    path = root / relative
    parent = path.parent
    while parent != root:
        if parent.is_symlink() or (parent.exists() and not parent.is_dir()):
            raise ValueError(f"preserving non-directory or linked parent: {parent}")
        parent = parent.parent
    if path.is_symlink():
        return {"kind": "link", "target": os.readlink(path)}
    if path.is_file():
        return file_entry(path.read_bytes(), bool(path.stat().st_mode & 0o111))
    if path.exists():
        raise ValueError(f"preserving non-file destination: {path}")
    return None


def allowed_path(relative: str) -> bool:
    path = PurePosixPath(relative)
    if (
        not re.fullmatch(r"[A-Za-z0-9._/-]+", relative)
        or path.is_absolute()
        or ".." in path.parts
        or str(path) != relative
    ):
        return False
    if relative in (
        "octo-manager.toml",
        ".github/pull_request_template.md",
        ".agents/templates/pull_request_template.md",
        GO_STRICT,
        GO_BASELINE,
        *GO_FILES,
        TS_BASELINE,
        TS_LOCK,
        POLICY,
        LIFECYCLE_RUNNER,
        LIFECYCLE_PLAN,
        VERSIONS,
        GUIDANCE,
        PROJECT_GUIDANCE,
        HOST_RULE,
        *TS_FILES,
        *PY_FILES,
        *PROTO_FILES,
    ):
        return True
    return any(
        (relative == f".agents/skills/{skill}" or relative.startswith(f".agents/skills/{skill}/"))
        or relative == f".claude/skills/{skill}"
        for skill in MANAGED_SKILLS
    )


def read_state(root: Path) -> tuple[Manifest, Snapshot | None]:
    snapshot = inspect(root, STATE)
    if snapshot is None:
        return {"version": 1, "files": {}}, snapshot
    if snapshot["kind"] != "file":
        raise ValueError(f"preserving linked manifest: {root / STATE}")
    state = json.loads((root / STATE).read_text())
    if (
        not isinstance(state, dict)
        or type(state.get("version")) is not int
        or state["version"] != 1
        or not isinstance(state.get("files"), dict)
    ):
        raise ValueError(f"unrecognized manifest: {root / STATE}")
    for profile in ("go_profile", "typescript_profile", "python_profile", "protobuf_profile"):
        if profile in state and type(state[profile]) is not bool:
            raise ValueError(f"invalid manifest {profile}")
    if "mode" in state and state["mode"] not in ("tracked", "local"):
        raise ValueError("invalid manifest mode")
    if state.get("skill_storage", "copied") not in ("linked", "copied"):
        raise ValueError("invalid manifest skill storage")
    if state.get("skill_storage") == "linked":
        source = state.get("skill_source")
        if not isinstance(source, str) or not Path(source).is_absolute():
            raise ValueError("invalid canonical skill source")
    if "octo_config_sha256" in state and (
        not isinstance(state["octo_config_sha256"], str)
        or not re.fullmatch(r"[a-f0-9]{64}", state["octo_config_sha256"])
    ):
        raise ValueError("invalid Octo configuration fingerprint")
    if "go_rollout" in state and state["go_rollout"] not in ("strict", "ratchet"):
        raise ValueError("invalid manifest Go rollout")
    if "go_legacy" in state and state["go_legacy"] is not None and not isinstance(state["go_legacy"], str):
        raise ValueError("invalid manifest legacy config path")
    if "kind" in state and state["kind"] not in KINDS:
        raise ValueError("invalid manifest project kind")
    for name, choices in (("authority", AUTHORITIES), ("adoption", ADOPTIONS)):
        if name in state and state[name] not in choices:
            raise ValueError(f"invalid manifest {name}")
    if "stage" in state and state["stage"] not in STAGES:
        raise ValueError("invalid manifest lifecycle stage")
    if "policy_version" in state and (
        not isinstance(state["policy_version"], str) or not VERSION_RE.fullmatch(state["policy_version"])
    ):
        raise ValueError("invalid manifest policy version")
    if "skill_versions" in state:
        pins = state["skill_versions"]
        if not isinstance(pins, dict) or not all(
            name in MANAGED_SKILLS and isinstance(value, str) and VERSION_RE.fullmatch(value)
            for name, value in pins.items()
        ):
            raise ValueError("invalid manifest skill versions")
    if "skills" in state and (
        not isinstance(state["skills"], list) or not all(name in MANAGED_SKILLS for name in state["skills"])
    ):
        raise ValueError("invalid manifest skill selection")
    if "agents" in state and state["agents"] not in ("codex", "both"):
        raise ValueError("invalid manifest agent selection")
    if "pr_template" in state and state["pr_template"] not in ("none", "local", "github"):
        raise ValueError("invalid manifest template selection")
    if "detect_languages" in state and not isinstance(state["detect_languages"], bool):
        raise ValueError("invalid manifest language detection setting")
    for path, entry in state["files"].items():
        if not allowed_path(path) or not isinstance(entry, dict):
            raise ValueError(f"invalid managed path in manifest: {path}")
        if entry.get("kind") == "file":
            valid = (
                set(entry) == {"kind", "sha256", "executable"}
                and isinstance(entry["sha256"], str)
                and re.fullmatch(r"[a-f0-9]{64}", entry["sha256"])
                and isinstance(entry["executable"], bool)
            )
        else:
            valid = (
                entry.get("kind") == "link"
                and set(entry) == {"kind", "target"}
                and (
                    path.startswith(".claude/skills/")
                    and entry.get("target") == f"../../.agents/skills/{Path(path).name}"
                    or state.get("skill_storage") == "linked"
                    and (
                        path == f".agents/skills/{Path(path).name}"
                        and Path(path).name in MANAGED_SKILLS
                        and (
                            entry.get("target") == str(Path(state["skill_source"]) / Path(path).name)
                            or Path(path).name in MATURITY_SKILLS
                            and entry.get("target")
                            == str(
                                selected_skill_directory(
                                    Path(state["skill_source"]), Path(path).name, state.get("stage", "beta")
                                )
                            )
                        )
                        or path == ".agents/skills/source-code-lifecycle"
                        and entry.get("target")
                        == str(
                            Path(state["skill_source"])
                            / ".maturity-profiles"
                            / state.get("stage", "beta")
                            / "source-code-lifecycle"
                        )
                        or path == ".agents/skills/testing"
                        and entry.get("target")
                        == str(
                            Path(state["skill_source"]) / ".testing-profiles" / state.get("stage", "beta") / "testing"
                        )
                        or canonical_package_link(path, entry.get("target"), Path(state["skill_source"]))
                        or path == VERSIONS
                        and entry.get("target") == str(Path(state["skill_source"]) / "source-code-versions.json")
                    )
                )
            )
        if not valid:
            raise ValueError(f"invalid managed entry in manifest: {path}")
    return cast(Manifest, state), snapshot


def load_configuration(args: Arguments) -> None:
    """Validate authored intent, leaving installed state and the file untouched."""
    if getattr(args, "skills_dir", None):
        if args.config is not None:
            raise ValueError("--config cannot be combined with --skills-dir")
        return
    args.config_applied = set()
    args.cli_values = {
        key: getattr(args, key)
        for key in (
            "mode",
            "skill_storage",
            "stage",
            "kind",
            "authority",
            "adoption",
            "skills",
            "go",
            "go_rollout",
            "typescript",
            "typescript_rollout",
            "typescript_project",
            "python",
            "protobuf",
            "python_path",
            "agents",
            "pr_template",
            "detect_languages",
            "policy_version",
        )
        if getattr(args, key, None) is not None
    }
    requested = args.repo.expanduser().resolve()
    found = git(requested, "rev-parse", "--show-toplevel", check=False)
    root = Path(found.stdout.strip()).resolve() if found.returncode == 0 else requested
    path = args.config.expanduser().resolve() if args.config is not None else root / "source-code.toml"
    if not path.exists():
        if args.config is not None:
            raise ValueError(f"configuration file does not exist: {path}")
        args.config_path, args.config_values = None, {}
        return
    with path.open("rb") as stream:
        data = tomllib.load(stream)
    allowed = {
        "schema_version",
        "stage",
        "kind",
        "authority",
        "adoption",
        "mode",
        "skill_storage",
        "skills",
        "agents",
        "pr_template",
        "detect_languages",
        "policy_version",
        "checks",
    }
    unknown = set(data) - allowed
    if unknown:
        raise ValueError("unknown configuration keys: " + ", ".join(sorted(unknown)))
    if type(data.get("schema_version")) is not int or data["schema_version"] != 1:
        raise ValueError("configuration requires schema_version = 1")
    choices = {
        "stage": STAGES,
        "kind": KINDS,
        "authority": AUTHORITIES,
        "adoption": ADOPTIONS,
        "mode": ("tracked", "shadow", "local"),
        "skill_storage": ("linked", "copied"),
        "agents": ("codex", "both"),
        "pr_template": ("none", "local", "github"),
    }
    values = {}
    for key, options in choices.items():
        if key in data:
            if not isinstance(data[key], str) or data[key] not in options:
                raise ValueError(f"invalid configuration {key}; expected one of {', '.join(options)}")
            values[key] = data[key]
    if "detect_languages" in data:
        if type(data["detect_languages"]) is not bool:
            raise ValueError("configuration detect_languages must be a boolean")
        values["detect_languages"] = data["detect_languages"]
    if "policy_version" in data:
        if not isinstance(data["policy_version"], str) or not VERSION_RE.fullmatch(data["policy_version"]):
            raise ValueError("configuration policy_version must be a semantic version")
        values["policy_version"] = data["policy_version"]
    if "skills" in data:
        skills = data["skills"]
        if (
            not isinstance(skills, list)
            or not skills
            or not all(isinstance(name, str) and name in MANAGED_SKILLS for name in skills)
            or len(set(skills)) != len(skills)
        ):
            raise ValueError("configuration skills must be a nonempty array of unique supported skill names")
        values["skills"] = ",".join(skills)
    checks = data.get("checks", {})
    if not isinstance(checks, dict) or set(checks) - {"go", "typescript", "python", "protobuf"}:
        raise ValueError("configuration checks accepts only go, typescript, python, and protobuf tables")
    for language, fields in checks.items():
        allowed_fields = (
            {"enabled"}
            if language == "protobuf"
            else (
                {"enabled", "paths"}
                if language == "python"
                else {"enabled", "rollout"} | ({"projects"} if language == "typescript" else set())
            )
        )
        if not isinstance(fields, dict) or set(fields) - allowed_fields:
            raise ValueError(f"invalid checks.{language} keys")
        if "enabled" in fields:
            if type(fields["enabled"]) is not bool:
                raise ValueError(f"checks.{language}.enabled must be a boolean")
            values[language] = fields["enabled"]
        if "rollout" in fields:
            if fields["rollout"] not in ("strict", "ratchet"):
                raise ValueError(f"checks.{language}.rollout must be strict or ratchet")
            values[f"{language}_rollout"] = fields["rollout"]
        if "paths" in fields:
            paths = fields["paths"]
            if (
                not isinstance(paths, list)
                or not paths
                or not all(
                    isinstance(name, str)
                    and name
                    and not PurePosixPath(name).is_absolute()
                    and ".." not in PurePosixPath(name).parts
                    for name in paths
                )
                or len(set(paths)) != len(paths)
            ):
                raise ValueError("checks.python.paths must be unique repository-relative paths")
            values["python_path"] = paths
        if "projects" in fields:
            projects = fields["projects"]
            if (
                not isinstance(projects, list)
                or not projects
                or not all(
                    isinstance(name, str)
                    and re.fullmatch(r"[A-Za-z0-9._/-]+", name)
                    and not PurePosixPath(name).is_absolute()
                    and ".." not in PurePosixPath(name).parts
                    for name in projects
                )
                or len(set(projects)) != len(projects)
            ):
                raise ValueError("checks.typescript.projects must be unique repository-relative paths")
            values["typescript_project"] = projects
        if fields.get("enabled") is False and set(fields) - {"enabled"}:
            raise ValueError(f"checks.{language} cannot disable checks while selecting rollout or projects")
    args.config_path, args.config_values = path, values
    if args.command != "validate":
        disabled_cli = {
            language for language in ("go", "typescript", "python", "protobuf") if getattr(args, language) is False
        }
        for key, value in values.items():
            if any(key.startswith(language + "_") for language in disabled_cli):
                continue
            if getattr(args, key) is None:
                setattr(args, key, value)
                args.config_applied.add(key)
        for language in ("go", "typescript", "python", "protobuf"):
            if getattr(args, language) is False and (
                getattr(args, f"{language}_rollout", None)
                or language == "typescript"
                and args.typescript_project
                or language == "python"
                and args.python_path
            ):
                raise ValueError(f"cannot disable {language} checks while selecting rollout or projects")
    effective_policy = values.get("policy_version") if args.command == "validate" else args.policy_version
    if (
        effective_policy
        and effective_policy != read_versions(SOURCE / "ai/skills/source-code-versions.json")["policy_version"]
    ):
        raise ValueError("configuration requests a policy version not shipped by this source")
    if args.command != "explain":
        print(f"Configuration: {path}")
        print("  Configured intent: " + json.dumps(values, sort_keys=True))


def config_exclude_text(original: str, relative: str | None, private: bool) -> str:
    """Keep authored configuration separate from managed generated artifacts."""
    if relative is None:
        return original
    # Git ignore syntax needs escaping even though the path is not shell code.
    if "\n" in relative or "\r" in relative:
        raise ValueError("private configuration path cannot contain line breaks")
    escaped = "".join("\\" + char if char in "*?[]\\!# " else char for char in relative)
    rule = "/" + escaped
    marker = "# source-code private configuration"
    owned = marker + "\n" + rule + "\n"
    if not private:
        return original.replace(owned, "")
    if rule in original.splitlines():
        return original
    return original + ("\n" if original and not original.endswith("\n") else "") + owned


def configuration_drift(args: Arguments, state: Manifest, root: Path) -> list[str]:
    warnings = []
    mapping = {name: name + "_profile" for name in ("go", "typescript", "python", "protobuf")}
    for key, desired in args.config_values.items():
        if key == "skills":
            expected = complete_skills(
                set(cast(str, desired).split(",")),
                bool(args.config_values.get("stage")),
                cast(str | None, args.config_values.get("kind", state.get("kind"))),
            )
            if not expected <= set(state.get("skills", [])):
                warnings.append("configuration skills are not installed; run setup or upgrade")
            continue
        if key == "python_path":
            policy_path = root / ".python-quality.json"
            installed = json.loads(policy_path.read_text()) if policy_path.is_file() else {}
            actual = installed.get("paths")
        elif key in ("typescript_rollout", "typescript_project"):
            policy_path = root / ".typescript-quality.json"
            installed = json.loads(policy_path.read_text()) if policy_path.is_file() else {}
            actual = installed.get("rollout" if key == "typescript_rollout" else "projects")
        else:
            actual = state.get(mapping.get(key, key), False if key in mapping else None)
        if key == "mode" and desired == "shadow":
            desired = "local"
        if actual != desired:
            warnings.append(
                f"configuration {key} differs from installed state: {actual!r} -> {desired!r}; run setup or upgrade"
            )
    return warnings


def read_versions(path: Path) -> Registry:
    versions = json.loads(path.read_text())
    if (
        not isinstance(versions, dict)
        or type(versions.get("schema_version")) is not int
        or versions["schema_version"] != 1
    ):
        raise ValueError(f"unsupported skill version registry: {path}")
    skills = versions.get("skills")
    if not isinstance(skills, dict) or not skills or not set(skills) <= set(MANAGED_SKILLS):
        raise ValueError(f"invalid skill versions: {path}")
    for version in [versions.get("policy_version"), *skills.values()]:
        if not isinstance(version, str) or not VERSION_RE.fullmatch(version):
            raise ValueError(f"invalid semantic version in {path}")
    return cast(Registry, versions)


def version_key(version: str) -> tuple[int, int, int, int, tuple[tuple[int, int, str], ...]]:
    core, _, prerelease = version.partition("-")
    suffix = (
        tuple((0, int(part), "") if part.isdigit() else (1, 0, part) for part in prerelease.split("."))
        if prerelease
        else ()
    )
    major, minor, patch = (int(part) for part in core.split("."))
    return major, minor, patch, int(not prerelease), suffix


def project_router() -> str:
    return (
        "<!-- Generated by source-code; regenerate with setup or upgrade. -->\n"
        "# Project instruction router\n\n"
        "Read these files in order, using paths relative to the repository root:\n\n"
        "1. Read `AGENTS.md` if it exists for authored project instructions.\n"
        f"2. Read [the generated source-code policy]({PROJECT_GUIDANCE}) for the configured lifecycle, skills, and checks.\n\n"
        "Preserve the authored project requirements and all more-specific repository instructions. The generated policy does not waive existing gates or grant publication authority.\n"
    )


def project_guidance(policy: Policy) -> str:
    linked = policy.get("skill_storage") == "linked"
    rows = "\n".join(
        f"| {name} | {'canonical' if linked else version} |" for name, version in sorted(policy["skills"].items())
    )
    project_policy = (
        "Read the installed project policy at `.agents/skills/source-code-lifecycle/SKILL.md` first, then "
        if "source-code-lifecycle" in policy["skills"]
        else "Then "
    )
    gates = ", ".join(f"`python3 scripts/check-source-code.py {name}`" for name in policy["languages"])
    gate_guidance = (
        f"Run the installed generated gates: {gates}."
        if gates
        else "No generated language gate is installed; follow existing repository commands and the selected language skills."
    )
    kind = policy.get("kind")
    kind_guidance = (
        f"Project kind: **{kind}**. Kind selects usage guidance, not architecture or additional generated test commands.\n\n"
        if kind
        else ""
    )
    tooling = ""
    if policy.get("authority") is not None or policy.get("adoption") is not None:
        tooling = (
            f"Authority: **{policy.get('authority', 'unspecified')}**. Tool adoption: **{policy.get('adoption', 'unspecified')}**. "
            "Preserve authored project requirements and the task's authority.\n\n"
        )
    return (
        "<!-- Generated by source-code from resolved configuration; regenerate with setup or upgrade. -->\n"
        "# Source-code project guidance\n\n"
        f"Policy version: **{policy['policy_version']}**. Schema version: **{policy['schema_version']}**.\n\n"
        + kind_guidance
        + tooling
        + "Paths in this policy are relative to the repository root. Before applying this policy, read the repository's `AGENTS.md` if it exists. Preserve its requirements and all more-specific repository instructions. This override adds project policy; it does not waive existing gates.\n\n"
        + (
            "Shared references follow the canonical source immediately; configured entrypoints are rendered at setup. Run setup or upgrade after source or configuration changes to refresh them. Read `.agents/source-code-versions.json` for live versions; recorded versions describe setup time, not pins. Keep the canonical checkout available.\n\n"
            if linked
            else "This summary lists the installed skill pins.\n\n"
        )
        + "| Skill | Version |\n| --- | --- |\n"
        + rows
        + "\n\n"
        + project_policy
        + "load the installed skills relevant to the task. Preserve existing repository instructions and required gates.\n\n"
        "Use `source-code validate` to check packages and pins. Use `source-code upgrade --dry-run` to review available updates before applying them. "
        + gate_guidance
        + "\n\n"
        + "The generated `AGENTS.override.md` routes agents to this policy and the authored project instructions. Other hosts should read that router explicitly when their native instruction discovery does not load it.\n"
    )


def complete_skills(skills: Iterable[str], explicit_stage: bool = False, kind: str | None = None) -> set[str]:
    skills = {RENAMED_SKILLS.get(name, name) for name in skills}
    if "ship" in skills:
        skills.add("git")
    if skills & {"data-pipeline", "ui-acceptance", "ui-review"}:
        skills.add("architecture")
    if "ui-review" in skills:
        skills.add("ui-acceptance")
    if kind == "library":
        skills.add("library-code-comments")
    if "typescript" in skills:
        skills.add("javascript")
    if skills & {"go", "typescript", "javascript", "python", "rust", "protobuf"}:
        skills.add("library-code-comments")
    if "library-code-comments" in skills:
        skills.add("code-comments")
    if skills & set(CORE_SKILLS) or explicit_stage or kind is not None:
        skills.update(CORE_SKILLS)
    if "git" in skills:
        skills.update({"pull-request", "ship"})
    return skills


def detect_languages(root: Path, state: Manifest | None = None) -> Detection:
    spec = importlib.util.spec_from_file_location("source_code_languages", SOURCE / "scripts/source_code_languages.py")
    if spec is None or spec.loader is None:
        raise ValueError("source-code module loader is unavailable")
    module = importlib.util.module_from_spec(spec)
    previous_bytecode = sys.dont_write_bytecode
    try:
        sys.dont_write_bytecode = True
        spec.loader.exec_module(module)
    finally:
        sys.dont_write_bytecode = previous_bytecode
    state = read_state(root)[0] if state is None else state
    managed = set(state["files"])
    if not managed and (root / POLICY).is_file():
        portable = json.loads((root / POLICY).read_text())
        if isinstance(portable, dict) and portable.get("skill_storage") == "linked":
            # A clone retains generated runtime files but has no local manifest.
            # Those files are not evidence of application languages.
            managed.update({LIFECYCLE_RUNNER, LIFECYCLE_PLAN})
            for language, artifacts in (
                ("go", GO_FILES),
                ("typescript", TS_FILES),
                ("python", PY_FILES),
                ("protobuf", PROTO_FILES),
            ):
                if language in portable.get("languages", []):
                    managed.update(artifacts)
    return cast(
        Detection,
        module.detect(root, SOURCE / "ai/skills/source-code-lifecycle/references/languages.json", managed),
    )


def artifact_owner(path: str) -> str | None:
    if path.startswith(".agents/skills/"):
        return Path(path).parts[2]
    if path.startswith(".claude/skills/"):
        return Path(path).name
    if path in GO_FILES or path == GO_STRICT:
        return "go"
    if path in TS_FILES:
        return "typescript"
    if path in PY_FILES:
        return "python"
    if path in PROTO_FILES:
        return "protobuf"
    if path in {POLICY, VERSIONS, GUIDANCE, PROJECT_GUIDANCE, HOST_RULE, LIFECYCLE_RUNNER, LIFECYCLE_PLAN}:
        return "source-code-lifecycle"
    if path in {".github/pull_request_template.md", ".agents/templates/pull_request_template.md"}:
        return "pull-request"
    return None


def canonical_package_link(path: str, target: object, source: Path) -> bool:
    parts = Path(path).parts
    if len(parts) < 4 or parts[:2] != (".agents", "skills") or parts[2] not in CONFIGURED_SKILLS:
        return False
    if not isinstance(target, str):
        return False
    try:
        relative = Path(target).relative_to(source)
    except ValueError:
        return False
    if not relative.parts or ".." in relative.parts:
        return False
    return bool(
        relative.parts[0] == parts[2]
        or len(relative.parts) > 3
        and relative.parts[0] == ".maturity-profiles"
        and relative.parts[1] in STAGES
        and relative.parts[2] == parts[2]
    )


def selected_skill_directory(source: Path, name: str, stage: str) -> Path:
    if name in MATURITY_SKILLS:
        return source / ".maturity-profiles" / stage / name
    return source / name


def package(
    skills: Sequence[str],
    agents: set[str],
    template: str,
    go_profile: bool = False,
    typescript_profile: bool = False,
    python_profile: bool = False,
    protobuf_profile: bool = False,
    skill_source: Path | None = None,
    stage: str = "beta",
) -> tuple[dict[str, Snapshot], dict[str, bytes]]:
    """Assemble from canonical sources; only installation paths are adapted."""
    files: dict[str, Snapshot] = {}
    payloads: dict[str, bytes] = {}

    def add(destination: str, source: Path, replacements: Sequence[tuple[str, str]] = ()) -> None:
        if not allowed_path(destination):
            raise ValueError(f"unsupported package path: {destination}")
        if source.is_symlink() or not source.is_file():
            raise ValueError(f"missing or linked package source: {source}")
        if (
            skill_source is not None
            and not replacements
            and canonical_package_link(destination, str(source), skill_source)
        ):
            files[destination] = {"kind": "link", "target": str(source)}
            return
        data = source.read_bytes()
        for old, new in replacements:
            data = data.replace(old.encode(), new.encode())
        files[destination] = file_entry(data, bool(source.stat().st_mode & 0o111))
        payloads[destination] = data

    for skill in skills:
        directory = (skill_source or SOURCE / "ai/skills") / skill
        selected = selected_skill_directory(skill_source or SOURCE / "ai/skills", skill, stage)
        entrypoint = selected / "SKILL.md"
        if entrypoint.is_symlink() or not entrypoint.is_file():
            raise ValueError(f"missing or linked skill entrypoint: {entrypoint}")
        render_skill_template(
            entrypoint.read_text(), dict.fromkeys(SKILL_TEMPLATE_BLOCKS.get(skill, ()), ""), str(entrypoint)
        )
        if skill_source is not None and skill not in CONFIGURED_SKILLS:
            directory = selected
            if directory.is_symlink() or not (directory / "SKILL.md").is_file():
                raise ValueError(f"missing or linked canonical skill: {directory}")
            files[f".agents/skills/{skill}"] = {"kind": "link", "target": str(directory)}
            if "claude" in agents:
                files[f".claude/skills/{skill}"] = {"kind": "link", "target": f"../../.agents/skills/{skill}"}
            continue
        if not (directory / "SKILL.md").is_file():
            raise ValueError(f"missing skill: {directory}")
        if skill in MATURITY_SKILLS:
            add(f".agents/skills/{skill}/SKILL.md", selected / "SKILL.md")
        for source in sorted(directory.rglob("*")):
            relative = source.relative_to(directory)
            if skill in MATURITY_SKILLS and relative == Path("SKILL.md"):
                continue
            if "__pycache__" in relative.parts or source.suffix == ".pyc":
                continue
            if skill == "code-comments" and str(relative) == "references/standard.md":
                add(
                    ".agents/skills/code-comments/references/standard.md",
                    SOURCE / "docs/conventional-code-comments.md",
                    [
                        ("../ai/skills/code-comments/SKILL.md", "../SKILL.md"),
                        (
                            "../ai/skills/library-code-comments/SKILL.md",
                            "https://github.com/lanej/dotfiles/blob/master/ai/skills/library-code-comments/SKILL.md",
                        ),
                        (
                            "repository-bootstrap.md",
                            "https://github.com/lanej/dotfiles/blob/master/docs/repository-bootstrap.md",
                        ),
                    ],
                )
                continue
            if source.is_symlink():
                raise ValueError(f"linked package source is not portable: {source}")
            if not source.is_file():
                continue
            replacements = []
            if skill == "git":
                replacements = [
                    ("../../../docs/verification.md", "references/verification.md"),
                    ("../../../docs/octo-pr-submission.md", "references/octo-pr-submission.md"),
                    ("../../../docs/pull-requests.md", "../pull-request/references/docs/pull-requests.md"),
                ]
            if skill == "git" and str(relative) == "references/review.md":
                replacements = [("../../../../docs/pull-requests.md", "pull-requests.md")]
            if skill == "builder" and str(relative) == "references/instructions.md":
                replacements = [
                    ("~/.local/share/software-standards/builder/SKILL.md", "../SKILL.md"),
                    ("~/.local/share/software-standards/builder/references/", ""),
                ]
            if skill == "octo-manager" and relative == Path("SKILL.md"):
                replacements = [("../../../docs/octo-pr-submission.md", "references/submission.md")]
            if skill == "pull-request":
                replacements = [
                    ("../../agents/", "references/"),
                    ("../../../docs/octo-pr-submission.md", "references/octo-pr-submission.md"),
                ]
            add(f".agents/skills/{skill}/{relative}", source, replacements)
        if skill == "pull-request":
            add(".agents/skills/pull-request/references/octo-pr-submission.md", SOURCE / "docs/octo-pr-submission.md")
            for name in ("pull-request-writer.md", "github-pr-writer.md"):
                add(
                    f".agents/skills/pull-request/references/{name}",
                    SOURCE / "ai/agents" / name,
                    [("~/.files/docs/", "docs/"), ("~/.files/ai/agents/", "")],
                )
            for name in PR_DOCS:
                add(
                    f".agents/skills/pull-request/references/docs/{name}",
                    SOURCE / "docs" / name,
                    [("../ai/agents/", "../")],
                )
        if skill == "git":
            add(".agents/skills/git/references/verification.md", SOURCE / "docs/verification.md")
            add(
                ".agents/skills/git/references/pull-requests.md",
                SOURCE / "docs/pull-requests.md",
                [
                    (
                        "conventional-pull-requests.md",
                        "https://github.com/lanej/dotfiles/blob/master/docs/conventional-pull-requests.md",
                    ),
                    (
                        "../ai/agents/github-pr-writer.md",
                        "https://github.com/lanej/dotfiles/blob/master/ai/agents/github-pr-writer.md",
                    ),
                ],
            )
        if skill == "octo-manager":
            add(".agents/skills/octo-manager/references/submission.md", SOURCE / "docs/octo-pr-submission.md")
        if "claude" in agents:
            files[f".claude/skills/{skill}"] = {"kind": "link", "target": f"../../.agents/skills/{skill}"}
    if template != "none":
        template_directory = ".github" if template == "github" else ".agents/templates"
        add(f"{template_directory}/pull_request_template.md", SOURCE / "ai/templates/pull_request_template.md")
    if go_profile:
        for destination, name in GO_FILES.items():
            replacements = (
                [("bash scripts/check-go.sh", "python3 scripts/check-source-code.py go")]
                if name == "go-quality.yml"
                else ()
            )
            add(destination, SOURCE / "ai/skills/go/assets" / name, replacements)
    if typescript_profile:
        for destination, name in TS_FILES.items():
            add(destination, SOURCE / "ai/skills/typescript/assets" / name)
    if python_profile:
        for destination, name in PY_FILES.items():
            add(destination, SOURCE / "ai/skills/python/assets" / name)
    if protobuf_profile:
        for destination, name in PROTO_FILES.items():
            add(destination, SOURCE / "ai/skills/protobuf/assets" / name)
    return files, payloads


def template_conflicts(root: Path) -> list[str]:
    found = []
    for directory in (root, root / "docs", root / ".github"):
        if directory.is_dir():
            for path in directory.iterdir():
                if (
                    path.name.lower() == "pull_request_template"
                    or path.name.lower().startswith("pull_request_template.")
                ) and path != root / ".github/pull_request_template.md":
                    found.append(str(path.relative_to(root)))
    return found


def validate_octo_issues(config: object) -> None:
    """An invalid issues section also invalidates Octo's repository merge policy."""
    booleans = {
        "auto_implement",
        "auto_publish",
        "proceed_under_assumptions",
        "auto_follow_ups",
        "clarification_timeout_disabled",
    }
    integers = {"clarification_timeout_ms": (0, 604800000), "max_concurrency": (1, 10)}
    if not isinstance(config, dict) or set(config) - booleans - integers.keys() - {"profiles"}:
        raise ValueError("invalid Octo issues configuration")
    for key in booleans & config.keys():
        if type(config[key]) is not bool:
            raise ValueError(f"Octo issues.{key} must be a boolean")
    for key, (minimum, maximum) in integers.items():
        if key in config and (type(config[key]) is not int or not minimum <= config[key] <= maximum):
            raise ValueError(f"Octo issues.{key} must be an integer from {minimum} to {maximum}")
    profiles = config.get("profiles")
    if not isinstance(profiles, dict) or set(profiles) != {"investigation", "implementation", "verification"}:
        raise ValueError("Octo issues.profiles requires investigation, implementation, and verification")
    for role, profile in profiles.items():
        if not isinstance(profile, dict) or set(profile) - {"harness", "model", "instructions", "timeout_ms"}:
            raise ValueError(f"invalid Octo issues.profiles.{role}")
        for field in ("harness", "model"):
            if not isinstance(profile.get(field), str) or not profile[field]:
                raise ValueError(f"Octo issues.profiles.{role}.{field} must be a nonempty string")
        instruction = profile.get("instructions", "")
        if not isinstance(instruction, str) or len(instruction.encode("utf-16-le")) > 8000:
            raise ValueError(f"invalid Octo issues.profiles.{role}.instructions")
        timeout = profile.get("timeout_ms", 1000)
        if type(timeout) is not int or not 1000 <= timeout <= 86400000:
            raise ValueError(f"Octo issues.profiles.{role}.timeout_ms must be an integer from 1000 to 86400000")


def render_skill_template(template: str, blocks: Mapping[str, str], source: str) -> str:
    """Replace each named placeholder with its resolved project guidance."""
    marker = re.compile(r"<!--\s*/?source-code:")
    pattern = re.compile(r"^<!-- source-code:([a-z-]+) -->$", re.MULTILINE)
    seen = set()
    for match in pattern.finditer(template):
        name = match[1]
        if name not in blocks or name in seen:
            raise ValueError(f"invalid or duplicate skill template placeholder {name}: {source}")
        seen.add(name)
    if seen != blocks.keys() or marker.search(pattern.sub("", template)):
        raise ValueError(
            f"missing or malformed skill template placeholder: {source}; expected {', '.join(sorted(blocks))}"
        )
    return pattern.sub(lambda match: blocks[match[1]].strip(), template)


def inline_skill_reference(text: str) -> str:
    """Move a references/ fragment into SKILL.md without changing its resource targets."""

    def rebase(match: re.Match[str]) -> str:
        target = match[1]
        if re.match(r"(?:[a-zA-Z][a-zA-Z0-9+.-]*:|/|#)", target):
            return match[0]
        return "](" + posixpath.normpath("references/" + target)

    text = re.sub(r"\]\(([^\s)]+)", rebase, text.strip())
    return re.sub(r"^(#{1,5}) ", r"#\1 ", text, flags=re.MULTILINE)


def configure_skill_packages(
    root: Path,
    resolved: PolicySelection,
    state: Manifest,
    files: dict[str, Snapshot],
    payloads: dict[str, bytes],
) -> Snapshot | None:
    """Resolve project choices before exposing skills to either agent host."""
    source = Path(resolved["skill_source"]) if resolved["skill_storage"] == "linked" else SOURCE / "ai/skills"
    rendered: set[str] = set()

    def reference(skill: str, variant: str) -> str:
        origin = source / skill / "references" / variant
        if origin.is_symlink() or not origin.is_file():
            raise ValueError(f"missing or linked policy source: {origin}")
        return inline_skill_reference(origin.read_text())

    def render(skill: str, blocks: Mapping[str, str]) -> None:
        if skill not in SKILL_TEMPLATE_BLOCKS or blocks.keys() != set(SKILL_TEMPLATE_BLOCKS[skill]):
            raise ValueError(f"skill renderer does not match its declared placeholders: {skill}")
        destination = f".agents/skills/{skill}/SKILL.md"
        template = (
            payloads[destination].decode()
            if destination in payloads
            else Path(files[destination]["target"]).read_text()
        )
        data = render_skill_template(template, blocks, destination).encode()
        files[destination] = file_entry(data)
        payloads[destination] = data
        rendered.add(skill)

    def finish(snapshot: Snapshot | None = None) -> Snapshot | None:
        missing = (resolved["skills"] & CONFIGURED_SKILLS) - rendered
        if missing:
            raise ValueError("configured skills have no renderer: " + ", ".join(sorted(missing)))
        return snapshot

    def omit(skill: str, names: Iterable[str]) -> None:
        for name in names:
            destination = f".agents/skills/{skill}/references/{name}"
            files.pop(destination, None)
            payloads.pop(destination, None)

    for skill, fragment in SHARED_GUIDANCE.items():
        if skill in resolved["skills"] and SKILL_TEMPLATE_BLOCKS[skill] == ("shared-guidance",):
            render(skill, {"shared-guidance": reference(skill, fragment)})
            omit(skill, [fragment])

    if "source-code-lifecycle" in resolved["skills"]:
        skill = "source-code-lifecycle"
        refs = source / skill / "references"
        policies = [reference(skill, f"kind-{resolved['kind'] or 'unspecified'}.md")]
        for field in ("authority", "adoption"):
            value = resolved[field]
            if value is None:
                continue
            policies.append(reference(skill, f"{field}-{value}.md"))
        render(skill, {"project-policy": "\n\n".join(policies)})
        omit(
            skill,
            (path.name for path in refs.glob("*.md") if path.name.startswith(("authority-", "adoption-", "kind-"))),
        )
        if resolved["adoption"] == "hold":
            omit(skill, ["tool-catalog.md"])

    for language in ("go", "typescript", "python", "protobuf"):
        if language not in resolved["skills"]:
            continue
        active = (
            resolved[language + "_profile"]
            or {
                "go": "scripts/check-go.sh",
                "typescript": "scripts/check-typescript.mjs",
                "python": "scripts/check-python.py",
                "protobuf": "scripts/check-protobuf.py",
            }[language]
            in state["files"]
        )
        verification = [reference(language, "profile-installed.md" if active else "profile-uninstalled.md")]
        if active and language in {"go", "typescript"}:
            setting = f".{language}-quality.json"
            settings = (
                json.loads(payloads[setting]) if setting in payloads else json.loads((root / setting).read_text())
            )
            rollout = settings.get("rollout")
            if rollout not in {"strict", "ratchet"}:
                raise ValueError(f"invalid {language} rollout for installed guidance")
            verification.append(reference(language, f"rollout-{rollout}.md"))
        shared = SHARED_GUIDANCE[language]
        render(language, {"verification": "\n\n".join(verification), "shared-guidance": reference(language, shared)})
        omit(
            language,
            [
                shared,
                "profile-installed.md",
                "profile-uninstalled.md",
                "rollout-strict.md",
                "rollout-ratchet.md",
            ],
        )

    if "octo-manager" not in resolved["skills"]:
        return finish()
    snapshot = inspect(root, "octo-manager.toml")
    if snapshot is not None and snapshot["kind"] != "file":
        raise ValueError("preserving linked or non-file octo-manager.toml")
    data = (
        (root / "octo-manager.toml").read_bytes()
        if snapshot
        else (source / "octo-manager/assets/octo-manager.toml").read_bytes()
    )
    if snapshot is not None and digest(data) != snapshot["sha256"]:
        raise ValueError("Octo configuration changed while preparing guidance; retry")
    if len(data) > 65536:
        raise ValueError("Octo policy exceeds 64 KiB")
    config = tomllib.loads(data.decode())
    if type(config.get("schema_version")) is not int or config["schema_version"] != 1:
        raise ValueError("octo-manager.toml requires schema_version = 1")
    unknown = set(config) - {"schema_version", "issues", "merging", "notifications"}
    if unknown:
        raise ValueError("unknown Octo configuration keys: " + ", ".join(sorted(unknown)))
    if "issues" in config:
        validate_octo_issues(config["issues"])
    merging = config.get("merging", {})
    if not isinstance(merging, dict) or set(merging) - {"auto_merge"}:
        raise ValueError("invalid Octo merging configuration")
    mode = merging.get("auto_merge", False)
    if type(mode) is not bool and mode != "project_stage":
        raise ValueError("invalid Octo auto_merge policy")
    enabled = mode if type(mode) is bool else resolved["stage"] in {"research", "alpha"}
    automation = reference("octo-manager", "auto-merge-enabled.md" if enabled else "auto-merge-disabled.md")
    notifications = config.get("notifications", {})
    if not isinstance(notifications, dict) or set(notifications) - {"instructions"}:
        raise ValueError("invalid Octo notification configuration")
    instructions = notifications.get("instructions", {})
    if not isinstance(instructions, dict) or not all(isinstance(value, str) for value in instructions.values()):
        raise ValueError("invalid Octo notification instructions")
    defaults = json.loads((source / "octo-manager/assets/notification-defaults.json").read_text())
    if not set(instructions) <= defaults.keys():
        raise ValueError("unknown Octo notification instruction state")
    followup = "## Configured notification follow-up\n\nUse the section matching the current notification state. Preserve installed project guidance and existing task authority; delivery and acknowledgment do not establish owner assessment or resolution.\n"
    for name, instruction in {**defaults, **instructions}.items():
        if len(instruction.encode()) > 1000:
            raise ValueError("Octo notification instruction exceeds 1000 UTF-8 bytes")
        followup += f"\n### {name}\n\n{instruction or 'No default follow-up instruction is enabled for this state.'}\n"
    followup += "\nFor a state without a configured instruction, inspect the current action evidence and report the missing follow-up; do not invent instructions.\n"
    evidence = reference("octo-manager", "automation.md")
    render("octo-manager", {"automation": automation + "\n\n" + followup + "\n\n" + evidence})
    omit(
        "octo-manager",
        [
            "auto-merge-enabled.md",
            "auto-merge-disabled.md",
            "automation.md",
        ],
    )
    return finish(snapshot)


def go_adoption(root: Path, state: Manifest, rollout: str | None) -> tuple[str, str | None]:
    """Resolve adoption intent without parsing YAML or provisioning dependencies."""
    candidates = [name for name in GO_CONFIGS if inspect(root, name) is not None]
    if len(candidates) > 1:
        raise ValueError(
            "multiple existing Go lint configurations; select one before merging: " + ", ".join(candidates)
        )
    legacy = state.get("go_legacy")
    if candidates:
        name = candidates[0]
        actual = inspect(root, name)
        if actual is None or actual["kind"] != "file":
            raise ValueError(f"preserving linked or non-file Go lint configuration: {name}")
        if name != ".golangci.yml" or actual != state["files"].get(name):
            legacy = name
    if legacy and legacy not in candidates:
        raise ValueError(f"previous Go lint configuration is missing: {legacy}")
    if rollout is None:
        rollout = state.get("go_rollout")
    if rollout is None:
        old_source = git(root, "ls-files", "--", "*.go", check=False).stdout.strip()
        rollout = "ratchet" if legacy or old_source else "strict"
    if rollout not in ("strict", "ratchet"):
        raise ValueError("invalid saved Go rollout")
    return rollout, legacy


def bun_ci_setup(root: Path) -> str | None:
    entry = inspect(root, "package.json")
    if entry is None or entry["kind"] != "file":
        return None
    project = json.loads((root / "package.json").read_text())
    manager = project.get("packageManager", "")
    if not isinstance(manager, str) or not manager.startswith("bun@"):
        return None
    version = manager.removeprefix("bun@")
    if not VERSION_RE.fullmatch(version):
        raise ValueError("Bun CI requires an exact packageManager version, such as bun@1.4.4")
    return f"      - uses: oven-sh/setup-bun@v2\n        with:\n          bun-version: '{version}'\n"


def go_configuration(
    root: Path, state: Manifest, rollout: str | None, desired: dict[str, Snapshot], payloads: dict[str, bytes]
) -> tuple[str, str | None, tuple[str, Snapshot | None] | None]:
    """Layer the profile beside project policy rather than rewriting it."""
    rollout, legacy = go_adoption(root, state, rollout)
    setup = bun_ci_setup(root)
    if setup is not None:
        workflow_path = ".github/workflows/go-quality.yml"
        workflow = payloads[workflow_path].decode()
        workflow = workflow.replace(
            "      - run: python3 scripts/check-source-code.py go\n",
            setup + "      - run: bun install --frozen-lockfile --ignore-scripts\n"
            "      - run: python3 scripts/check-source-code.py go\n",
        )
        payloads[workflow_path] = workflow.encode()
        desired[workflow_path] = file_entry(payloads[workflow_path])
    settings = {"version": 1, "rollout": rollout, "config": ".golangci.yml", "legacy": None}
    snapshot = None
    if legacy:
        if legacy.endswith(".toml"):
            raise ValueError(
                "Go config merging supports YAML and JSON; convert the existing TOML config first or use --no-go"
            )
        helper = SOURCE / "ai/skills/go/assets/go-quality.py"
        command = [sys.executable, str(helper)]
        if importlib.util.find_spec("yaml") is None:
            uv = shutil.which("uv")
            if not uv:
                raise ValueError("merging Go YAML requires PyYAML or uv; dotfiles bootstrap provides uv")
            command = [uv, "run", "--no-project", "--with", "PyYAML==6.0.3", "python", str(helper)]
        result = subprocess.run(  # noqa: S603 -- owned configuration parser with constructed argv
            [
                *command,
                "merge",
                "--existing",
                str(root / legacy),
                "--profile",
                str(SOURCE / "ai/skills/go/assets/golangci.yml"),
            ],
            capture_output=True,
            text=True,
        )
        if result.returncode:
            raise ValueError(result.stderr.strip() or "Go configuration merge failed")
        payloads.pop(".golangci.yml")
        desired.pop(".golangci.yml")
        data = result.stdout.encode()
        payloads[GO_STRICT] = data
        desired[GO_STRICT] = file_entry(data)
        snapshot = (legacy, inspect(root, legacy))
        settings["config"] = GO_STRICT
        settings["legacy"] = {"path": legacy, "sha256": digest((root / legacy).read_bytes())}
    data = (json.dumps(settings, indent=2) + "\n").encode()
    payloads[".go-quality.json"] = data
    desired[".go-quality.json"] = file_entry(data)
    return rollout, legacy, snapshot


def typescript_configuration(
    root: Path, args: Arguments, desired: dict[str, Snapshot], payloads: dict[str, bytes]
) -> tuple[str, dict[str, Snapshot | None]]:
    """Preserve executable project configs; run their original gates separately."""
    original_paths = ["package.json"]
    package_entry = inspect(root, "package.json")
    if not package_entry or package_entry["kind"] != "file":
        raise ValueError("TypeScript adoption requires a regular package.json; initialize the project first")
    project = json.loads((root / "package.json").read_text())
    setup = bun_ci_setup(root)
    if setup is not None:
        workflow_path = ".github/workflows/typescript-quality.yml"
        workflow = payloads[workflow_path].decode()
        if (root / "go.mod").is_file():
            setup += "      - uses: actions/setup-go@v6\n        with:\n          go-version-file: go.mod\n"
        workflow = workflow.replace(
            "      - run: npm ci\n",
            setup + "      - run: bun install --frozen-lockfile --ignore-scripts\n",
        )
        payloads[workflow_path] = workflow.encode()
        desired[workflow_path] = file_entry(payloads[workflow_path])
    scripts = project.get("scripts", {})
    if not isinstance(scripts, dict):
        raise ValueError("package.json scripts must be an object")
    settings_path = ".typescript-quality.json"
    existing = inspect(root, settings_path)
    if existing:
        if existing["kind"] != "file":
            raise ValueError("preserving linked TypeScript quality policy")
        settings = json.loads((root / settings_path).read_text())
        if not isinstance(settings, dict) or settings.get("version") != 1:
            raise ValueError("invalid existing TypeScript quality policy")
    else:
        settings = json.loads(payloads[settings_path])
        manager = project.get("packageManager", "").split("@", 1)[0]
        if not manager:
            locks = [("pnpm", "pnpm-lock.yaml"), ("yarn", "yarn.lock"), ("npm", "package-lock.json")]
            found = [name for name, lock in locks if (root / lock).exists()]
            if len(found) > 1:
                raise ValueError("multiple package managers; declare packageManager in package.json first")
            manager = found[0] if found else "npm"
        if manager not in ("npm", "pnpm", "yarn", "bun"):
            raise ValueError(
                "TypeScript command defaults support npm, pnpm, yarn, or bun; configure the project explicitly"
            )
        configs = [path for path in root.iterdir() if path.name.startswith(("eslint.config.", ".eslintrc"))]
        if (configs or "eslintConfig" in project) and not scripts.get("lint"):
            raise ValueError("existing ESLint policy needs a non-mutating package.json lint script before adoption")
        legacy = []
        for name in ("lint", "typecheck", "check-types"):
            if scripts.get(name):
                if re.search(r"--(?:fix|write)(?:[=\s]|$)", scripts[name]):
                    raise ValueError(f"{name} is a mutating gate; provide a check-only script before adoption")
                legacy.append([manager, "run", name])
        audit = [manager, "audit", "--audit-level=high"]
        if manager == "bun":
            audit = ["bun", "audit"]
        if manager == "yarn":
            audit = ["yarn", "npm", "audit", "--severity", "high", "--recursive"]
            if project.get("packageManager", "").startswith("yarn@1."):
                raise ValueError(
                    "Yarn Classic needs an explicit audit adapter; migrate or configure policy before adoption"
                )
        settings["commands"] = {"legacy": legacy, "test": [manager, "run", "test"], "audit": audit}
        old_source = git(root, "ls-files", "--", "*.ts", "*.tsx", "*.mts", "*.cts", check=False).stdout.strip()
        settings["rollout"] = "ratchet" if old_source else "strict"
    if args.typescript_project:
        settings["projects"] = args.typescript_project
    if args.typescript_rollout:
        settings["rollout"] = args.typescript_rollout
    resolved_rollout = settings.get("rollout")
    if not isinstance(resolved_rollout, str) or resolved_rollout not in ("strict", "ratchet"):
        raise ValueError("invalid TypeScript rollout")
    projects = settings.get("projects")
    if not isinstance(projects, list) or not projects:
        raise ValueError("select at least one TypeScript project")
    for name in projects:
        if (
            not isinstance(name, str)
            or not re.fullmatch(r"[A-Za-z0-9._/-]+", name)
            or PurePosixPath(name).is_absolute()
            or ".." in PurePosixPath(name).parts
        ):
            raise ValueError("TypeScript projects must be repository-relative paths")
        entry = inspect(root, name)
        if not entry or entry["kind"] != "file":
            raise ValueError(f"missing or linked TypeScript project: {name}")
        original_paths.append(name)
    data = (
        (root / settings_path).read_bytes()
        if existing and not args.typescript_project and not args.typescript_rollout
        else (json.dumps(settings, indent=2) + "\n").encode()
    )
    payloads[settings_path] = data
    desired[settings_path] = file_entry(data)
    return resolved_rollout, {name: inspect(root, name) for name in original_paths}


def python_configuration(root: Path, args: Arguments, desired: dict[str, Snapshot], payloads: dict[str, bytes]) -> None:
    path = ".python-quality.json"
    entry = inspect(root, path)
    if entry and entry["kind"] != "file":
        raise ValueError("preserving linked Python quality policy")
    settings = json.loads((root / path).read_text()) if entry else json.loads(payloads[path])
    if not isinstance(settings, dict) or type(settings.get("version")) is not int or settings["version"] != 1:
        raise ValueError("invalid Python quality policy")
    if args.python_path:
        settings["paths"] = args.python_path
    paths = settings.get("paths")
    if (
        not isinstance(paths, list)
        or not paths
        or not all(
            isinstance(name, str)
            and name
            and not PurePosixPath(name).is_absolute()
            and ".." not in PurePosixPath(name).parts
            and (
                ((root / name).exists() and (root / name).resolve().is_relative_to(root))
                or name == "."
                and args.init
                and not root.exists()
            )
            for name in paths
        )
    ):
        raise ValueError("Python paths must exist inside the repository")
    commands = settings.get("commands")
    if (
        not isinstance(commands, dict)
        or set(commands) != {"test", "legacy"}
        or not isinstance(commands["legacy"], list)
    ):
        raise ValueError("Python commands must contain test and legacy")
    for command in [commands["test"], *commands["legacy"]]:
        if not isinstance(command, list) or not command or not all(isinstance(arg, str) and arg for arg in command):
            raise ValueError("Python test/legacy commands must be nonempty argv arrays")
    data = (json.dumps(settings, indent=2) + "\n").encode()
    payloads[path] = data
    desired[path] = file_entry(data)


def protobuf_configuration(root: Path, desired: dict[str, Snapshot], payloads: dict[str, bytes]) -> None:
    path = ".protobuf-quality.json"
    current = inspect(root, path)
    if current is None:
        return
    if current["kind"] != "file":
        raise ValueError("preserving linked Protobuf quality policy")
    data = (root / path).read_bytes()
    settings = json.loads(data)
    if (
        not isinstance(settings, dict)
        or set(settings) != {"version", "against"}
        or type(settings["version"]) is not int
        or settings["version"] != 1
        or settings["against"] is not None
        and (not isinstance(settings["against"], str) or not settings["against"].strip())
    ):
        raise ValueError("invalid Protobuf quality policy")
    payloads[path] = data
    desired[path] = file_entry(data)


def exclude_text(original: str, paths: set[str]) -> str:
    """Replace only our block, preserving all unrelated ignore rules."""
    if (
        original.count(START) != original.count(END)
        or original.count(START) > 1
        or (START in original and original.index(START) > original.index(END))
    ):
        raise ValueError("malformed repo-bootstrap block in Git info/exclude")
    if paths and START in original:
        # info/exclude is shared by linked worktrees. Another local installation
        # may own additional paths that are absent from this worktree's manifest.
        existing = original.split(START, 1)[1].split(END, 1)[0].splitlines()
        for line in existing:
            if not line:
                continue
            if not line.startswith("/") or not (allowed_path(line[1:]) or line[1:] == STATE):
                raise ValueError("unrecognized rule in repo-bootstrap exclusion block")
            paths = paths | {line[1:]}
    block = ""
    if paths:
        block = START + "\n" + "\n".join("/" + path for path in sorted(paths)) + "\n" + END + "\n"
    if START in original:
        before, rest = original.split(START, 1)
        _, after = rest.split(END, 1)
        if after.startswith("\n"):
            after = after[1:]
        return before + block + after
    return original + ("\n" if original and not original.endswith("\n") else "") + block


def seed_file(path: Path, data: bytes) -> None:
    """Publish a complete seed without replacing an authored or concurrent file."""
    descriptor, temporary = tempfile.mkstemp(prefix=".octo-seed-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(data)
        os.chmod(temporary, 0o644)
        try:
            os.link(temporary, path)
        except FileExistsError:
            pass
    finally:
        os.unlink(temporary)


def atomic_file(path: Path, data: bytes, executable: bool = False) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=".repo-bootstrap-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(data)
        os.chmod(temporary, 0o755 if executable else 0o644)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def check_visibility(root: Path, paths: set[str], exclusions: str, mode: str) -> None:
    """Evaluate Git's real ignore precedence against the proposed exclude file."""
    if not paths:
        return
    with tempfile.TemporaryDirectory(prefix="repo-bootstrap-ignore-") as temporary:
        metadata = Path(temporary)
        git(metadata, "init", "--bare", "--quiet")
        (metadata / "info/exclude").write_text(exclusions)
        worktree = root
        linked_parent = any(
            (root / parent).is_symlink()
            for relative in paths
            for parent in PurePosixPath(relative).parents
            if str(parent) != "."
        )
        if not worktree.exists() or linked_parent:
            # Git refuses pathspecs below existing symlinks during a link-to-copy
            # migration. Evaluate the planned layout with the same ignore rules.
            worktree = metadata / "preview"
            worktree.mkdir()
            ignores = {".gitignore"}
            for relative in paths:
                ignores.update(str(parent / ".gitignore") for parent in PurePosixPath(relative).parents)
            for name in ignores:
                source = root / name
                if any(parent.is_symlink() for parent in source.parents if parent.is_relative_to(root)):
                    continue
                if source.is_file() and not source.is_symlink():
                    destination = worktree / name
                    destination.parent.mkdir(parents=True, exist_ok=True)
                    destination.write_bytes(source.read_bytes())
        command = ["--git-dir", str(metadata), "--work-tree", str(worktree)]
        # Preserve effective repository overrides as well as global defaults.
        for key in ("core.excludesFile", "core.ignoreCase"):
            value = git(root, "config", "--path" if key == "core.excludesFile" else "--get", key, check=False)
            if value.returncode == 0:
                command += ["-c", f"{key}={value.stdout.strip()}"]
        ignored = git(worktree, *command, "check-ignore", "--no-index", "--", *sorted(paths), check=False)
        if ignored.returncode not in (0, 1):
            raise ValueError(ignored.stderr.strip())
        ignored_paths = set(ignored.stdout.splitlines())
        if mode == "tracked" and ignored_paths:
            raise ValueError(
                "tracked installation is ignored by existing Git rules:\n"
                + ignored.stdout
                + "Adjust those rules explicitly or use --mode local."
            )
        if mode == "local" and paths - ignored_paths:
            raise ValueError(
                "Git rules prevent local exclusion of:\n  "
                + "\n  ".join(sorted(paths - ignored_paths))
                + "\nAdjust the conflicting negation rules explicitly; no files were installed."
            )


def metadata_directory(root: Path) -> Path:
    directory = Path(git(root, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip())
    if directory.is_symlink() or not directory.is_dir():
        raise ValueError(f"preserving linked or invalid Git metadata: {directory}")
    return directory


def recorded_skill_names(state: Manifest) -> set[str]:
    return set(state.get("skills", [])) | {
        Path(name).parts[2]
        for name in state["files"]
        if name.startswith(".agents/skills/") and (name.endswith("/SKILL.md") or len(Path(name).parts) == 3)
    }


def recorded_skills(state: Manifest) -> set[str]:
    return {RENAMED_SKILLS.get(name, name) for name in recorded_skill_names(state)}


def resolve_policy(root: Path, args: Arguments, state: Manifest) -> ResolvedPolicy:
    """Resolve selections once for installation, upgrades, and inspection."""
    storage = args.skill_storage or state.get("skill_storage", "copied" if state["files"] else "linked")
    source = str(SOURCE / "ai/skills") if args.skill_storage else state.get("skill_source", str(SOURCE / "ai/skills"))
    mode = args.mode or state.get("mode", "tracked" if state["files"] else "local")
    if mode == "shadow":
        mode = "local"
    if mode not in ("tracked", "local"):
        raise ValueError("invalid mode in manifest")
    selected = args.skills
    if selected is None:
        selected = ",".join(state.get("skills", DEFAULT_SKILLS))
    selected = ",".join(RENAMED_SKILLS.get(name, name) for name in selected.split(","))
    skills = set(selected.split(","))
    unknown = skills - set(SKILLS)
    if unknown:
        raise ValueError("unknown skills: " + ", ".join(sorted(unknown)))
    detect_enabled = args.detect_languages if args.detect_languages is not None else state.get("detect_languages", True)
    detection = detect_languages(root, state) if detect_enabled else {"languages": [], "skills": [], "evidence": {}}
    if not detect_enabled and (root / POLICY).is_file():
        previous = json.loads((root / POLICY).read_text())
        previous_detection = previous.get("detection", {}) if isinstance(previous, dict) else {}
        roots = previous_detection.get("protobuf_roots") if isinstance(previous_detection, dict) else None
        if roots is not None:
            if not isinstance(roots, list) or not all(isinstance(name, str) for name in roots):
                raise ValueError("invalid recorded Protobuf roots")
            detection["protobuf_roots"] = roots
    skills.update(detection["skills"])
    go_profile = (
        args.go
        if args.go is not None
        else (bool(args.go_rollout) or state.get("go_profile", False) or (root / "go.mod").is_file())
    )
    if go_profile:
        skills.add("go")
    typescript_profile = (
        args.typescript
        if args.typescript is not None
        else (bool(args.typescript_rollout or args.typescript_project) or state.get("typescript_profile", False))
    )
    if typescript_profile:
        skills.add("typescript")
    python_profile = (
        args.python if args.python is not None else (bool(args.python_path) or state.get("python_profile", False))
    )
    if python_profile:
        skills.add("python")
    protobuf_profile = (
        args.protobuf
        if args.protobuf is not None
        else state.get("protobuf_profile", "protobuf" in detection["languages"])
    )
    if protobuf_profile:
        skills.add("protobuf")
    kind = args.kind or state.get("kind")
    authority = args.authority or state.get("authority")
    adoption = args.adoption or state.get("adoption")
    for name, value, choices in (("authority", authority, AUTHORITIES), ("adoption", adoption, ADOPTIONS)):
        if value is not None and value not in choices:
            raise ValueError(f"invalid {name}: {value}")
        if value is None and args.command in {"setup", "upgrade"}:
            raise ValueError(
                f"{name} must be selected explicitly with --{name} or source-code.toml before setup or upgrade"
            )
    if args.stage is not None and args.stage != state.get("stage", "beta"):
        skills.update(recorded_skills(state) & set(MATURITY_SKILLS))
    skills.update(RENAMED_SKILLS[name] for name in recorded_skill_names(state) if name in RENAMED_SKILLS)
    skills = complete_skills(
        skills, bool(args.stage) and args.stage != state.get("stage"), kind if kind != state.get("kind") else None
    )
    if any(
        value != state.get(name)
        for name, value in (
            ("stage", args.stage or state.get("stage", "beta")),
            ("kind", kind),
            ("authority", authority),
            ("adoption", adoption),
        )
    ):
        skills.update(recorded_skills(state) & CONFIGURED_SKILLS)
    if "octo-manager" in recorded_skills(state):
        octo = inspect(root, "octo-manager.toml")
        if octo is None or octo.get("sha256") != state.get("octo_config_sha256"):
            skills.add("octo-manager")
    if storage != state.get("skill_storage", "copied"):
        skills |= recorded_skills(state)
    if not skills <= set(SKILLS):
        raise ValueError("language detection selected unsupported skills")
    stage = args.stage or state.get("stage", "beta")
    if stage not in STAGES:
        raise ValueError(f"invalid lifecycle stage: {stage}")
    agent_selection = args.agents or state.get("agents", "both")
    agents = {"codex", "claude"} if agent_selection == "both" else {"codex"}
    template = args.pr_template or state.get("pr_template") or ("local" if mode == "local" else "github")
    if go_profile and args.go_rollout == "ratchet" and args.pr_template is None:
        template = "none"
    if typescript_profile and args.typescript_rollout == "ratchet" and args.pr_template is None:
        template = "none"

    def origin(name: str, state_key: str | None = None, detail: str = "built-in default") -> dict[str, object]:
        if name in args.cli_values:
            return {"source": "cli", "key": name}
        if name in args.config_applied:
            return {"source": "toml", "key": name, "path": str(args.config_path)}
        if (state_key or name) in state:
            return {"source": "saved", "key": state_key or name}
        return {"source": "default", "detail": detail}

    origins: dict[str, object] = {
        name: origin(name)
        for name in (
            "mode",
            "skill_storage",
            "stage",
            "kind",
            "authority",
            "adoption",
            "agents",
            "pr_template",
            "detect_languages",
        )
    }
    skill_origins: dict[str, list[dict[str, object]]] = {}
    origins["skills"] = skill_origins
    base_origin = origin("skills")
    for name in skills:
        sources: list[dict[str, object]] = []
        if name in selected.split(","):
            sources.append(base_origin)
        if name in detection["skills"]:
            sources.append({"source": "detection", "evidence": detection["evidence"].get(name, [])})
        if (
            name == "go"
            and go_profile
            or name == "typescript"
            and typescript_profile
            or name == "python"
            and python_profile
            or name == "protobuf"
            and protobuf_profile
        ):
            sources.append({"source": "dependency", "detail": name + " check profile"})
        if not sources:
            sources.append({"source": "dependency", "detail": "required by selected skills or policy transition"})
        skill_origins[name] = sources
    for name, rollout_key, saved_key, evidence in (
        ("go", "go_rollout", "go_profile", "root go.mod"),
        ("typescript", "typescript_rollout", "typescript_profile", "explicit TypeScript adoption"),
        ("python", "python_path", "python_profile", "explicit Python adoption"),
        ("protobuf", "protobuf", "protobuf_profile", "explicit Protobuf adoption"),
    ):
        flag_origin = origin(name, saved_key)
        if getattr(args, name) is None and (
            getattr(args, rollout_key) or name == "typescript" and args.typescript_project
        ):
            flag_origin = {"source": "dependency", "detail": "requested rollout or project selection"}
        elif getattr(args, name) is None and name == "go" and not state.get(saved_key) and (root / "go.mod").is_file():
            flag_origin = {"source": "detection", "detail": evidence}
        if name == "protobuf" and args.protobuf is None and saved_key not in state and protobuf_profile:
            flag_origin = {"source": "detection", "evidence": detection["evidence"]["protobuf"]}
        origins[f"checks.{name}.selected"] = flag_origin
    if args.pr_template is None and (
        go_profile and args.go_rollout == "ratchet" or typescript_profile and args.typescript_rollout == "ratchet"
    ):
        origins["pr_template"] = {"source": "dependency", "detail": "ratchet adoption omits a new template"}
    return {
        "mode": mode,
        "skill_storage": storage,
        "skill_source": source if storage == "linked" else "",
        "skills": skills,
        "stage": stage,
        "kind": kind,
        "authority": authority,
        "adoption": adoption,
        "go_profile": go_profile,
        "typescript_profile": typescript_profile,
        "python_profile": python_profile,
        "protobuf_profile": protobuf_profile,
        "detect_enabled": detect_enabled,
        "detection": detection,
        "agent_selection": agent_selection,
        "agents": agents,
        "template": template,
        "origins": origins,
    }


def storage_migration(root: Path, state: Manifest, storage: str, desired: Mapping[str, Snapshot]) -> set[str]:
    """Remove only unchanged owned artifacts; never follow a linked directory."""
    changing_storage = storage != state.get("skill_storage", "copied")
    names = recorded_skill_names(state)
    if not changing_storage:
        names &= RENAMED_SKILLS.keys() | {
            name
            for name in CONFIGURED_SKILLS
            if f".agents/skills/{name}" in state["files"] and f".agents/skills/{name}/SKILL.md" in desired
        }
    removals: set[str] = set()
    for name in names:
        relative = f".agents/skills/{name}"
        directory = root / relative
        removals.update(path for path in state["files"] if path.startswith(relative + "/"))
        if relative in state["files"] and state["files"][relative]["kind"] == "link":
            actual = inspect(root, relative)
            if actual is not None and actual != state["files"].get(relative):
                raise ValueError(f"preserving changed skill link: {relative}")
            removals.add(relative)
        else:
            if directory.is_symlink():
                raise ValueError(f"preserving linked skill directory: {relative}")
            for child in directory.rglob("*"):
                path = child.relative_to(root).as_posix()
                if child.is_dir() and not child.is_symlink():
                    removals.add(path)
                    continue
                expected = state["files"].get(path)
                if expected is None or inspect(root, path) != expected:
                    raise ValueError(f"preserving customized or unmanaged skill content: {path}")
                removals.add(path)
            removals.add(relative)
        if name in RENAMED_SKILLS:
            alias = f".claude/skills/{name}"
            actual = inspect(root, alias)
            if actual is not None and actual != state["files"].get(alias):
                raise ValueError(f"preserving changed skill link: {alias}")
            if alias in state["files"]:
                removals.add(alias)
    for path, expected in state["files"].items():
        parts = Path(path).parts
        if len(parts) < 4 or parts[:2] != (".agents", "skills") or parts[2] not in CONFIGURED_SKILLS:
            continue
        if f".agents/skills/{parts[2]}/SKILL.md" not in desired or path in removals:
            continue
        if path not in desired:
            if inspect(root, path) != expected:
                raise ValueError(f"preserving customized policy content: {path}")
            removals.add(path)
    if changing_storage and VERSIONS in state["files"]:
        if inspect(root, VERSIONS) != state["files"][VERSIONS]:
            raise ValueError(f"preserving customized registry: {VERSIONS}")
        removals.add(VERSIONS)
    return removals


def install(args: Arguments) -> None:
    requested = args.repo.expanduser().resolve()
    result = git(requested, "rev-parse", "--show-toplevel", check=False)
    initializing = result.returncode != 0
    if initializing:
        if (
            (requested / ".git").exists()
            or (requested / ".git").is_symlink()
            or git(requested, "rev-parse", "--is-bare-repository", check=False).stdout.strip() == "true"
        ):
            raise ValueError(
                "target has existing Git metadata but is not a working tree; inspect it before initialization"
            )
        if not args.init:
            raise ValueError("target is not a Git working tree; use --init to create one")
        ancestor = requested.parent
        while not ancestor.exists() and ancestor != ancestor.parent:
            ancestor = ancestor.parent
        containing = git(ancestor, "rev-parse", "--show-toplevel", check=False)
        if containing.returncode == 0:
            raise ValueError(
                f"target is inside {containing.stdout.strip()}; refusing to initialize a nested repository"
            )
        if requested.exists() and not requested.is_dir():
            raise ValueError(f"target is not a directory: {requested}")
        root = requested
    else:
        root = Path(result.stdout.strip()).resolve()
        if args.init and root != requested:
            raise ValueError(f"target is already inside {root}; refusing to initialize a nested repository")
    state, state_before = read_state(root)
    if args.inherited_state is not None and state_before is None:
        state = args.inherited_state.copy()
        state["files"] = {}
    old_pins = state.get("skill_versions", {})
    snapshot = inspect(root, POLICY)
    if not old_pins and snapshot is not None:
        if snapshot["kind"] == "file":
            try:
                old_policy = json.loads((root / POLICY).read_text())
                old_pins = old_policy.get("skills", {}) if isinstance(old_policy, dict) else {}
            except ValueError:
                old_pins = {}
    if not isinstance(old_pins, dict):
        raise ValueError("invalid installed skill version pins")
    if not all(
        name in MANAGED_SKILLS and isinstance(version, str) and VERSION_RE.fullmatch(version)
        for name, version in old_pins.items()
    ):
        raise ValueError("invalid installed skill version pins")
    old_pins = {name: version for name, version in old_pins.items() if name not in RENAMED_SKILLS}
    resolved = resolve_policy(root, args, state)
    mode, skills, stage, kind = resolved["mode"], resolved["skills"], resolved["stage"], resolved["kind"]
    go_profile, typescript_profile, python_profile = (
        resolved["go_profile"],
        resolved["typescript_profile"],
        resolved["python_profile"],
    )
    detect_enabled, detection = resolved["detect_enabled"], resolved["detection"]
    agent_selection, agents, template = resolved["agent_selection"], resolved["agents"], resolved["template"]
    protobuf_profile = resolved["protobuf_profile"]
    storage = resolved["skill_storage"]
    skill_source = Path(resolved["skill_source"]) if storage == "linked" else None
    desired, payloads = package(
        sorted(skills),
        agents,
        template,
        go_profile,
        typescript_profile,
        python_profile,
        protobuf_profile,
        skill_source,
        stage,
    )
    versions = read_versions((skill_source or SOURCE / "ai/skills") / "source-code-versions.json")
    pins: dict[str, str] = {}
    languages: list[str] = []
    if skills:
        if args.policy_version and args.policy_version != versions["policy_version"]:
            raise ValueError(f"requested policy {args.policy_version}; this source ships {versions['policy_version']}")
        plans_version = json.loads((SOURCE / "ai/skills/source-code-lifecycle/references/stages.json").read_text())[
            "policy_version"
        ]
        if plans_version != versions["policy_version"]:
            raise ValueError("source policy version and lifecycle command-plan version disagree")
        languages = [
            name
            for name, active, entry in (
                ("go", go_profile, "scripts/check-go.sh"),
                ("typescript", typescript_profile, "scripts/check-typescript.mjs"),
                ("python", python_profile, "scripts/check-python.py"),
                ("protobuf", protobuf_profile, "scripts/check-protobuf.py"),
            )
            if active or entry in state["files"]
        ]
        for name, active, entry, asset, needs_upgrade in (
            ("go", go_profile, "scripts/check-go.sh", "go/assets/check-go.sh", stage in {"research", "alpha"}),
            (
                "typescript",
                typescript_profile,
                "scripts/check-typescript.mjs",
                "typescript/assets/check-typescript.mjs",
                stage == "alpha",
            ),
            (
                "python",
                python_profile,
                "scripts/check-python.py",
                "python/assets/check-python.py",
                stage in {"research", "alpha"},
            ),
        ):
            if name in languages and not active and needs_upgrade:
                installed = inspect(root, entry)
                if not installed or installed.get("sha256") != digest((SOURCE / "ai/skills" / asset).read_bytes()):
                    raise ValueError(
                        f"{stage} requires an updated {name} runner; rerun setup with --{name} or retain beta/full checks"
                    )
        retained_skills = recorded_skills(state)
        policy_changed = (
            state.get("policy_version") is not None and state["policy_version"] != versions["policy_version"]
        )
        retained_languages = [
            ("go", go_profile, "scripts/check-go.sh"),
            ("typescript", typescript_profile, "scripts/check-typescript.mjs"),
            ("python", python_profile, "scripts/check-python.py"),
            ("protobuf", protobuf_profile, "scripts/check-protobuf.py"),
        ]
        if policy_changed and (
            not retained_skills <= skills
            or any(path in state["files"] and not active for _, active, path in retained_languages)
        ):
            raise ValueError(
                "policy version changes require a complete upgrade of retained skills and language runtimes; rerun upgrade without a subset or language opt-outs"
            )
        for name, active, path in retained_languages:
            if (
                name in skills
                and path in state["files"]
                and not active
                and old_pins.get(name) != versions["skills"].get(name)
            ):
                raise ValueError(
                    f"upgrading the {name} version requires updating its retained runtime; rerun with --{name}"
                )
        if not skills <= set(versions["skills"]):
            raise ValueError("source version registry does not cover the selected skills")
        unknown_retained = retained_skills - skills - set(old_pins)
        if unknown_retained:
            raise ValueError(
                "retained skills have no version pins; use source-code upgrade to version the complete installation"
            )
        pins = {
            name: old_pins.get(name, versions["skills"][name])
            if storage == "linked"
            else versions["skills"][name]
            if name in skills
            else old_pins[name]
            for name in sorted(skills | retained_skills)
        }
        required_kind_skills = {"source-code-lifecycle"} if kind is not None else set()
        if kind == "library":
            required_kind_skills.add("library-code-comments")
        if not required_kind_skills <= pins.keys():
            raise ValueError(
                "project kind requires missing guidance; include the lifecycle and kind skills or run a complete upgrade"
            )
        installed_versions = {**versions, "skills": pins}
        policy: Policy = {
            "schema_version": 1,
            "policy_version": versions["policy_version"],
            "stage": stage,
            "languages": languages,
            "skills": pins,
            "detection": {"enabled": detect_enabled, **detection},
            **({"skill_storage": "linked"} if storage == "linked" else {}),
        }
        if kind is not None:
            policy["kind"] = kind
        policy["authority"] = cast(str, resolved["authority"])
        policy["adoption"] = cast(str, resolved["adoption"])
        resources = [
            (POLICY, (json.dumps(policy, indent=2) + "\n").encode()),
            (VERSIONS, (json.dumps(installed_versions, indent=2) + "\n").encode()),
            (GUIDANCE, project_router().encode()),
            (PROJECT_GUIDANCE, project_guidance(policy).encode()),
        ]
        if skill_source is not None:
            desired[VERSIONS] = {"kind": "link", "target": str(skill_source / "source-code-versions.json")}
            resources = [(path, data) for path, data in resources if path != VERSIONS]
        if "source-code-lifecycle" in skills:
            resources.append(
                (
                    LIFECYCLE_RUNNER,
                    (SOURCE / "ai/skills/source-code-lifecycle/assets/check-source-code.py").read_bytes(),
                )
            )
        if "source-code-lifecycle" in skills and (storage == "linked" or LIFECYCLE_PLAN in state["files"]):
            resources.append(
                (LIFECYCLE_PLAN, (SOURCE / "ai/skills/source-code-lifecycle/references/stages.json").read_bytes())
            )
        for path, data in resources:
            desired[path] = file_entry(data)
            payloads[path] = data
        if "claude" in agents:
            data = b"# Source-code project policy\n\nRead `AGENTS.override.md` in the repository root and follow its selected project skills. Preserve existing repository instructions and gates.\n"
            desired[HOST_RULE] = file_entry(data)
            payloads[HOST_RULE] = data
    ts_rollout: str | None = None
    ts_snapshots: dict[str, Snapshot | None] = {}
    if typescript_profile:
        ts_rollout, ts_snapshots = typescript_configuration(root, args, desired, payloads)
    rollout, legacy, legacy_snapshot = None, None, None
    if go_profile:
        rollout, legacy, legacy_snapshot = go_configuration(root, state, args.go_rollout, desired, payloads)
    if python_profile:
        python_configuration(root, args, desired, payloads)
    if protobuf_profile:
        protobuf_configuration(root, desired, payloads)
    if template == "github":
        conflicts = template_conflicts(root)
        if conflicts:
            raise ValueError(
                "existing PR template(s): "
                + ", ".join(conflicts)
                + "; choose --pr-template local or none, or reconcile them manually"
            )

    if "octo-manager" in skills:
        data = (SOURCE / "ai/skills/octo-manager/assets/octo-manager.toml").read_bytes()
        desired["octo-manager.toml"] = file_entry(data)
        payloads["octo-manager.toml"] = data

    octo_snapshot = configure_skill_packages(root, resolved, state, desired, payloads)
    removals = storage_migration(root, state, storage, desired)
    managed = {path: entry for path, entry in state["files"].items() if path not in removals}
    if legacy:
        managed.pop(legacy, None)
    changes, snapshots, conflicts, skipped = [], dict(ts_snapshots), [], []
    if "octo-manager" in skills:
        snapshots["octo-manager.toml"] = octo_snapshot
    if legacy_snapshot:
        snapshots[legacy_snapshot[0]] = legacy_snapshot[1]
    for relative, expected in sorted(desired.items()):
        actual = (
            None
            if any(relative == path or relative.startswith(path + "/") for path in removals)
            else inspect(root, relative)
        )
        if not any(relative.startswith(path + "/") for path in removals):
            if relative not in removals:
                snapshots.setdefault(relative, inspect(root, relative))
        if relative == "octo-manager.toml":
            managed.pop(relative, None)
            if actual is None:
                changes.append((relative, expected, False))
            elif actual["kind"] != "file":
                raise ValueError("preserving linked or non-file octo-manager.toml")
            continue
        if actual == expected:
            managed[relative] = expected
            continue
        conflict = actual is not None and actual != managed.get(relative)
        if actual and actual["kind"] != expected["kind"]:
            conflict = True
        if conflict:
            if actual is None:
                raise ValueError("destination disappeared while resolving a conflict; retry")
            owner = artifact_owner(relative)
            if owner and args.conflict == "skip":
                policy_changed = (
                    owner == "source-code-lifecycle" and state.get("policy_version") != versions["policy_version"]
                )
                if (
                    old_pins.get(owner) != pins.get(owner)
                    or policy_changed
                    or owner in CONFIGURED_SKILLS
                    or owner in MATURITY_SKILLS
                    and state.get("stage") != stage
                ):
                    raise ValueError(
                        f"cannot change the {owner} version or maturity while skipping locally modified content at {relative}; reconcile it or use --conflict replace"
                    )
            if relative in {POLICY, GUIDANCE, PROJECT_GUIDANCE, VERSIONS, HOST_RULE} and args.conflict != "replace":
                label = "lifecycle policy" if relative == POLICY else "policy artifact"
                raise ValueError(
                    f"preserving locally modified {label}: {root / relative}; reconcile it or use --conflict replace"
                )
            if args.conflict == "skip":
                skipped.append(relative)
                continue
            # Never replace symlinks, even under --conflict replace.
            if args.conflict != "replace" or actual["kind"] == "link" or expected["kind"] == "link":
                conflicts.append(relative)
                continue
        changes.append((relative, expected, conflict))
        managed[relative] = expected
    if conflicts:
        raise ValueError(
            "preserving existing or locally modified paths:\n  "
            + "\n  ".join(conflicts)
            + "\nChoose --conflict skip, or --conflict replace to back up and replace regular files."
        )
    if args.hydration:
        tracked_paths = set(git(root, "ls-files", "-z").stdout.split("\0"))
        unsafe = [path for path, _, _ in changes if path in tracked_paths or snapshots.get(path) is not None]
        if unsafe or removals:
            raise ValueError(
                "worktree hydration preserves existing files; run an explicit setup/upgrade: "
                + ", ".join(sorted(set(unsafe) | removals))
            )
    paths = set(managed) | {STATE}
    if "octo-manager" in skills:
        paths.add("octo-manager.toml")
    local_paths = (
        (
            {path for path in managed if path.startswith((".agents/skills/", ".claude/skills/"))}
            | ({VERSIONS, HOST_RULE} & set(managed))
            | {STATE}
        )
        if storage == "linked"
        else set()
    )
    if go_profile and rollout == "ratchet":
        paths.add(GO_BASELINE)
    if typescript_profile:
        paths.add(TS_LOCK)
        if ts_rollout == "ratchet":
            paths.add(TS_BASELINE)
    visible_paths = paths | {legacy} if mode == "tracked" and legacy else paths
    tracked = set()
    metadata = root / ".git"
    if initializing:
        exclude = root / ".git/info/exclude"
        old_exclude = ""
    else:
        metadata = metadata_directory(root)
        exclude = metadata / "info/exclude"
        exclude_entry = inspect(metadata, "info/exclude")
        if exclude_entry and exclude_entry["kind"] != "file":
            raise ValueError(f"preserving linked or non-file Git exclude: {exclude}")
        old_exclude = exclude.read_text() if exclude.exists() else ""
        if any(replacing for _, _, replacing in changes):
            inspect(metadata, "repo-bootstrap/backups/.probe")
        tracked = set(git(root, "ls-files", "-z").stdout.split("\0"))
        if "octo-manager.toml" in tracked:
            paths.discard("octo-manager.toml")
            visible_paths.discard("octo-manager.toml")
        hidden_paths = paths if mode == "local" else local_paths
        if mode == "local" or storage == "linked":
            hidden_paths = hidden_paths | removals
        hidden_tracked = hidden_paths & tracked
        if hidden_tracked:
            raise ValueError(
                "local mode cannot hide tracked files: "
                + ", ".join(sorted(hidden_tracked))
                + "; keep tracked mode or explicitly remove them from the index first"
            )
    generated_config: bytes | None = None
    if skill_source is not None and args.config_path is None:
        config_path = root / "source-code.toml"
        if config_path.exists() or config_path.is_symlink():
            raise ValueError(f"preserving existing configuration: {config_path}")
        rows = ["schema_version = 1"]
        selections: dict[str, object] = {
            "stage": stage,
            "authority": resolved["authority"],
            "adoption": resolved["adoption"],
            "mode": mode,
            "skill_storage": storage,
            "skills": sorted(pins),
            "agents": agent_selection,
            "pr_template": template,
            "detect_languages": detect_enabled,
        }
        if kind is not None:
            selections["kind"] = kind
        rows.extend(f"{key} = {json.dumps(value, ensure_ascii=False)}" for key, value in selections.items())
        for language, enabled, settings_path in (
            ("go", go_profile, ".go-quality.json"),
            ("typescript", typescript_profile, ".typescript-quality.json"),
            ("python", python_profile, ".python-quality.json"),
            ("protobuf", protobuf_profile, ".protobuf-quality.json"),
        ):
            if not enabled and getattr(args, language) is None:
                continue
            rows.extend(["", f"[checks.{language}]", f"enabled = {str(enabled).lower()}"])
            settings = json.loads(payloads[settings_path]) if settings_path in payloads else {}
            if enabled:
                for key in ("rollout", "projects", "paths"):
                    if key in settings:
                        rows.append(f"{key} = {json.dumps(settings[key], ensure_ascii=False)}")
        generated_config = ("\n".join(rows) + "\n").encode()
    relative_config = "source-code.toml" if generated_config is not None else None
    if args.config_path is not None:
        try:
            relative_config = args.config_path.relative_to(root).as_posix()
        except ValueError:
            relative_config = None
    private_config = mode == "local" and relative_config is not None and relative_config not in tracked
    new_exclude = config_exclude_text(
        exclude_text(old_exclude, paths if mode == "local" else local_paths), relative_config, private_config
    )
    check_visibility(
        root, visible_paths if mode == "local" else visible_paths - tracked - local_paths, new_exclude, mode
    )
    if mode == "tracked" and local_paths:
        check_visibility(root, local_paths, new_exclude, "local")
    revision = git(SOURCE, "rev-parse", "HEAD", check=False).stdout.strip() or "unknown"
    new_state: Manifest = {
        "version": 1,
        "mode": mode,
        "skill_storage": storage,
        **({"skill_source": str(skill_source)} if skill_source is not None else {}),
        "source_revision": revision,
        "go_profile": go_profile,
        "files": managed,
    }
    if skills:
        new_state["authority"] = cast(str, resolved["authority"])
        new_state["adoption"] = cast(str, resolved["adoption"])
        new_state["stage"] = stage
        new_state["policy_version"] = versions["policy_version"]
        new_state["skills"] = sorted(pins)
        new_state["skill_versions"] = pins
        new_state["agents"] = agent_selection
        new_state["pr_template"] = template
        if kind is not None:
            new_state["kind"] = kind
        new_state["detect_languages"] = detect_enabled
    elif "stage" in state:
        new_state["stage"] = state["stage"]
        new_state["policy_version"] = state["policy_version"]
    if go_profile:
        if rollout is None:
            raise ValueError("Go rollout was not resolved")
        new_state["go_rollout"] = rollout
        new_state["go_legacy"] = legacy
    else:
        if "go_rollout" in state:
            new_state["go_rollout"] = state["go_rollout"]
        if "go_legacy" in state:
            new_state["go_legacy"] = state["go_legacy"]
    if typescript_profile or "typescript_profile" in state:
        new_state["typescript_profile"] = typescript_profile
    if python_profile or "python_profile" in state:
        new_state["python_profile"] = python_profile
    if args.protobuf is not None or protobuf_profile or "protobuf_profile" in state:
        new_state["protobuf_profile"] = protobuf_profile
    if "octo-manager" in skills:
        new_state["octo_config_sha256"] = (
            octo_snapshot["sha256"] if octo_snapshot else digest(payloads["octo-manager.toml"])
        )
    elif "octo_config_sha256" in state:
        new_state["octo_config_sha256"] = state["octo_config_sha256"]
    state_data = (json.dumps(new_state, indent=2, sort_keys=True, ensure_ascii=False) + "\n").encode()
    state_changed = state_before != file_entry(state_data)

    print(f"source-code setup: {root} ({mode})")
    print(
        f"  Skill storage: {storage}"
        + (
            f"; follows {skill_source} (canonical edits affect every linked repository)"
            if skill_source
            else " (portable pinned packages)"
        )
    )
    if generated_config is not None:
        print("  create source-code.toml (portable project selections)")
    for relative in sorted(removals):
        print(f"  remove unchanged managed content: {relative}")
    print("  Detected language guidance: " + (", ".join(detection["languages"]) or "none"))
    if getattr(args, "config_path", None):
        effective = policy_view(root, resolved, state, versions["policy_version"], rollout, ts_rollout, payloads, pins)
        print("  Effective configuration: " + json.dumps(effective, sort_keys=True))
    if skills:
        previous = state.get("stage", "beta (legacy full checks)")
        print(f"  Lifecycle: {previous} -> {stage}; policy {versions['policy_version']}")
        for name in ("authority", "adoption"):
            print(f"  {name.capitalize()}: {state.get(name, 'unspecified')} -> {resolved[name]}")
        if kind is not None:
            print(f"  Kind: {state.get('kind', 'unspecified')} -> {kind}")
        for name, version in pins.items():
            print(f"  Skill {name}: {old_pins.get(name, 'unversioned')} -> {version}")
        plans = json.loads((SOURCE / "ai/skills/source-code-lifecycle/references/stages.json").read_text())["stages"]
        for language in languages:
            before = plans[state.get("stage", "beta")][language]
            after = plans[stage][language]
            print(f"  {language} checks: {json.dumps(before)} -> {json.dumps(after)}")
    if go_profile:
        print(f"  Go rollout: {rollout}" + (f"; preserve {legacy}, merge into {GO_STRICT}" if legacy else ""))
    if typescript_profile:
        print(f"  TypeScript rollout: {ts_rollout}; preserve project configs and package dependencies")
    for relative, _, replacing in changes:
        print(f"  {'replace (backup)' if replacing else 'install/update'} {relative}")
    for relative in skipped:
        print(f"  skipped local content: {relative}")
    if new_exclude != old_exclude:
        print(f"  update local exclusions: {exclude}")
    if state_changed:
        print(f"  update {STATE}")
    if not changes and not removals and generated_config is None and not state_changed and new_exclude == old_exclude:
        print("  already current")
    if args.dry_run:
        print("  preview only; no files changed")
        return

    if initializing:
        root.mkdir(parents=True, exist_ok=True)
        git(root, "init", "--quiet")
        metadata = metadata_directory(root)
        exclude_entry = inspect(metadata, "info/exclude")
        if exclude_entry and exclude_entry["kind"] != "file":
            raise ValueError(f"preserving linked Git exclude: {exclude}")
        # git init may supply a template's existing exclude file.
        old_exclude = exclude.read_text() if exclude.exists() else ""
        new_exclude = config_exclude_text(
            exclude_text(old_exclude, paths if mode == "local" else local_paths), relative_config, private_config
        )
        check_visibility(root, visible_paths - local_paths if mode == "tracked" else visible_paths, new_exclude, mode)
        if local_paths:
            check_visibility(root, local_paths, new_exclude, "local")
    for relative, before in snapshots.items():
        if inspect(root, relative) != before:
            raise ValueError(f"destination changed during planning; retry after reviewing: {relative}")
    if inspect(root, STATE) != state_before:
        raise ValueError("manifest changed during planning; retry after reviewing")
    if (exclude.read_text() if exclude.exists() else "") != old_exclude:
        raise ValueError("Git exclusions changed during planning; retry after reviewing")

    if storage_migration(root, state, storage, desired) != removals:
        raise ValueError("managed skills changed during migration planning")
    for relative in sorted(removals, key=lambda value: len(Path(value).parts), reverse=True):
        destination = root / relative
        if destination.is_dir() and not destination.is_symlink():
            destination.rmdir()
        elif destination.exists() or destination.is_symlink():
            destination.unlink()
    backup = None
    for relative, expected, replacing in changes:
        destination = root / relative
        if replacing:
            if backup is None:
                inspect(metadata, "repo-bootstrap/backups/.probe")
                backup_root = metadata / "repo-bootstrap/backups"
                backup_root.mkdir(parents=True, exist_ok=True)
                backup = Path(tempfile.mkdtemp(prefix="replace-", dir=backup_root))
                print(f"  preserving replaced files in {backup}")
            atomic_file(backup / relative, destination.read_bytes(), bool(destination.stat().st_mode & 0o111))
        destination.parent.mkdir(parents=True, exist_ok=True)
        if relative == "octo-manager.toml":
            seed_file(destination, payloads[relative])
        elif expected["kind"] == "link":
            if destination.is_symlink():
                destination.unlink()
            destination.symlink_to(expected["target"], target_is_directory=True)
        else:
            atomic_file(destination, payloads[relative], expected["executable"])
    if new_exclude != old_exclude:
        atomic_file(exclude, new_exclude.encode())
    if generated_config is not None:
        config_path = root / "source-code.toml"
        if config_path.exists() or config_path.is_symlink():
            raise ValueError("configuration appeared during planning; preserving it")
        atomic_file(config_path, generated_config)
    if state_changed:
        atomic_file(root / STATE, state_data)
    print("  installed; no files staged, committed, or published")
    if go_profile and rollout == "ratchet" and not (root / GO_BASELINE).exists():
        print("  next: bash scripts/check-go.sh baseline (one-time adoption, committed Go source only)")
    if typescript_profile:
        print("  next: node scripts/check-typescript.mjs tools (explicit dependency installation)")
        if ts_rollout == "ratchet" and not (root / TS_BASELINE).exists():
            print("  then: node scripts/check-typescript.mjs baseline (committed TypeScript source only)")


def prepare_upgrade(args: Arguments) -> None:
    if args.init:
        raise ValueError("upgrade requires an existing installation; use setup --init for a new project")
    root = Path(git(args.repo.expanduser().resolve(), "rev-parse", "--show-toplevel").stdout.strip())
    state, snapshot = read_state(root)
    if snapshot is None:
        raise ValueError("no source-code installation manifest; use source-code setup first")
    if args.skills is None:
        saved = state.get("skills") or sorted(
            {
                Path(path).parts[2]
                for path in state["files"]
                if path.startswith(".agents/skills/") and (path.endswith("/SKILL.md") or len(Path(path).parts) == 3)
            }
        )
        if not saved:
            raise ValueError("installation has no recorded skills; select them explicitly with --skills")
        args.skills = ",".join(saved)
    if args.agents is None:
        args.agents = state.get("agents") or (
            "both" if any(path.startswith(".claude/skills/") for path in state["files"]) else "codex"
        )
    if args.pr_template is None:
        args.pr_template = state.get("pr_template") or (
            "github"
            if ".github/pull_request_template.md" in state["files"]
            else "local"
            if ".agents/templates/pull_request_template.md" in state["files"]
            else "none"
        )
    if args.go is None:
        args.go = bool(args.go_rollout) or state.get("go_profile", False)
    if args.typescript is None:
        args.typescript = bool(args.typescript_rollout or args.typescript_project) or state.get(
            "typescript_profile", False
        )
    if args.python is None:
        args.python = bool(args.python_path) or state.get("python_profile", False)
    resolved = resolve_policy(root, args, state)
    skills = resolved["skills"]
    available = read_versions(SOURCE / "ai/skills/source-code-versions.json")
    pins = state.get("skill_versions", {})
    for name in skills:
        if name not in available["skills"]:
            raise ValueError(f"source registry has no version for {name}")
        if name in pins and version_key(available["skills"][name]) < version_key(pins[name]):
            raise ValueError(
                f"upgrade would downgrade {name} from {pins[name]} to {available['skills'][name]}; use a newer source checkout"
            )
    if state.get("policy_version") and version_key(available["policy_version"]) < version_key(state["policy_version"]):
        raise ValueError("upgrade would downgrade the installed policy; use a newer source checkout")
    findings = skill_findings(
        [selected_skill_directory(SOURCE / "ai/skills", name, resolved["stage"]) for name in sorted(skills)]
    )
    errors = [f"{item['path']}: {message}" for item in findings for message in item["errors"]]
    warnings = [f"{item['path']}: {message}" for item in findings for message in item["warnings"]]
    if errors or args.strict and warnings:
        raise ValueError("upgrade source validation failed:\n" + "\n".join(errors + warnings))
    for message in warnings:
        print(f"WARNING: {message}")
    print(f"Validated {len(findings)} source skill packages before upgrade")


def skill_findings(folders: Sequence[Path]) -> list[Finding]:
    helper = SOURCE / "ai/skills/skill-authoring/scripts/validate.py"
    command = [sys.executable, str(helper)]
    if importlib.util.find_spec("yaml") is None:
        uv = shutil.which("uv")
        if not uv:
            raise ValueError("skill validation requires PyYAML or uv; dotfiles bootstrap provides uv")
        command = [uv, "run", "--script", str(helper)]
    result = subprocess.run([*command, "--json", *map(str, folders)], capture_output=True, text=True)  # noqa: S603 -- owned package validator
    try:
        findings = json.loads(result.stdout)
    except ValueError as error:
        raise ValueError(result.stderr.strip() or "skill validator did not return findings") from error
    if result.returncode and not any(item["errors"] for item in findings):
        raise ValueError(result.stderr.strip() or "skill validator failed")
    return cast(list[Finding], findings)


def validate_project(args: Arguments) -> int:
    root = args.repo.expanduser().resolve()
    if args.skills_dir:
        directory = args.skills_dir.expanduser().resolve()
    else:
        found = git(root, "rev-parse", "--show-toplevel", check=False)
        if found.returncode == 0:
            root = Path(found.stdout.strip()).resolve()
        elif not getattr(args, "config_path", None):
            raise ValueError(found.stderr.strip() or "target is not a Git working tree")
        directory = root / ".agents/skills"
    if not directory.is_dir():
        if not args.skills_dir and getattr(args, "config_path", None) and inspect(root, STATE) is None:
            print(
                "Validated TOML configuration only; no source-code installation exists (installed packages not checked)"
            )
            return 0
        raise ValueError(f"no skill directory: {directory}")
    folders = (
        [directory]
        if (directory / "SKILL.md").is_file()
        else sorted(
            path
            for path in directory.iterdir()
            if path.is_dir() and not path.name.startswith(".") and path.name != "__pycache__"
        )
    )
    if not folders:
        raise ValueError(f"no SKILL.md packages found: {directory}")
    findings = skill_findings([folder.resolve() for folder in folders])
    errors: list[str] = []
    warnings: list[str] = []
    for finding in findings:
        errors.extend(f"{finding['path']}: {message}" for message in finding["errors"])
        warnings.extend(f"{finding['path']}: {message}" for message in finding["warnings"])
    if not args.skills_dir:
        state, snapshot = read_state(root)
        if snapshot is not None:
            warnings.extend(configuration_drift(args, state, root))
            if "octo-manager" in recorded_skills(state):
                octo = inspect(root, "octo-manager.toml")
                if octo is None or octo.get("sha256") != state.get("octo_config_sha256"):
                    warnings.append("Octo configuration differs from installed guidance; run setup or upgrade")
        if snapshot is None:
            warnings.append("no installation manifest; only skill structure was checked")
        else:
            for path, expected in state["files"].items():
                actual = inspect(root, path)
                if actual is None:
                    errors.append(f"missing installed file: {path}")
                elif actual["kind"] != expected["kind"] or expected["kind"] == "link" and actual != expected:
                    errors.append(f"installed path kind or link target differs from its manifest: {path}")
                elif actual != expected:
                    warnings.append(f"locally customized installed file: {path}")
            try:
                if not (root / POLICY).is_file() or not (root / VERSIONS).is_file():
                    raise ValueError("installation predates version pins; run source-code upgrade")
                policy = json.loads((root / POLICY).read_text())
                versions = read_versions(root / VERSIONS)
                if (
                    not isinstance(policy, dict)
                    or type(policy.get("schema_version")) is not int
                    or policy["schema_version"] != 1
                    or policy.get("stage") not in STAGES
                ):
                    raise ValueError("invalid lifecycle policy schema or stage")
                if "kind" in policy and policy["kind"] not in KINDS:
                    raise ValueError("invalid installed project kind")
                if policy.get("kind") != state.get("kind"):
                    raise ValueError("policy kind and install manifest disagree")
                if policy.get("kind") is not None and "source-code-lifecycle" not in policy.get("skills", {}):
                    raise ValueError("project kind requires installed lifecycle guidance")
                if policy.get("kind") == "library" and "library-code-comments" not in policy.get("skills", {}):
                    raise ValueError("library kind requires caller documentation guidance")
                linked = state.get("skill_storage") == "linked"
                if policy.get("skill_storage", "copied") != state.get("skill_storage", "copied"):
                    raise ValueError("policy storage and install manifest disagree")
                if linked:
                    expected_registry = str(Path(state["skill_source"]) / "source-code-versions.json")
                    if inspect(root, VERSIONS) != {"kind": "link", "target": expected_registry}:
                        raise ValueError("canonical version registry link is missing or redirected")
                    for name in recorded_skills(state):
                        link = root / ".agents/skills" / name
                        if not (link / "SKILL.md").is_file():
                            raise ValueError(f"missing canonical skill target: {name}")
                if policy.get("policy_version") != versions["policy_version"]:
                    raise ValueError("policy pin and installed version registry disagree")
                for name, choices in (("authority", AUTHORITIES), ("adoption", ADOPTIONS)):
                    if name not in policy:
                        if policy["policy_version"] == "1.0.0":
                            warnings.append(f"missing {name}; select it on the next setup or upgrade")
                        else:
                            raise ValueError(f"missing installed {name}")
                    elif policy[name] not in choices:
                        raise ValueError(f"invalid installed {name}")
                    if policy.get(name) != state.get(name):
                        raise ValueError(f"policy {name} and install manifest disagree")
                supported = read_versions(SOURCE / "ai/skills/source-code-versions.json")["policy_version"]
                if policy["policy_version"] not in {"1.0.0", supported}:
                    raise ValueError(
                        f"validator supports policy {supported}; use the source-code version matching the installed policy"
                    )
                pins = policy.get("skills")
                if not isinstance(pins, dict) or not pins:
                    raise ValueError("missing skill version pins; run source-code upgrade")
                managed = {
                    Path(path).parts[2]
                    for path in state["files"]
                    if path.startswith(".agents/skills/") and (path.endswith("/SKILL.md") or len(Path(path).parts) == 3)
                }
                if set(pins) != managed:
                    raise ValueError("skill version pins and installed manifest disagree")
                if state.get("skill_versions") != pins:
                    raise ValueError("skill version pins and install manifest disagree")
                expected_languages = {
                    name
                    for name, path in (
                        ("go", "scripts/check-go.sh"),
                        ("typescript", "scripts/check-typescript.mjs"),
                        ("python", "scripts/check-python.py"),
                        ("protobuf", "scripts/check-protobuf.py"),
                    )
                    if path in state["files"]
                }
                if not isinstance(policy.get("languages"), list) or sorted(policy["languages"]) != sorted(
                    expected_languages
                ):
                    raise ValueError("installed languages and lifecycle policy disagree")
                for name, version in pins.items():
                    if name not in versions["skills"] or not linked and versions["skills"].get(name) != version:
                        raise ValueError(f"{name}: pin {version} differs from installed release registry")
                if (root / GUIDANCE).read_text() != project_router():
                    raise ValueError(f"{GUIDANCE} is stale or customized; reconcile with setup or upgrade")
                if (root / PROJECT_GUIDANCE).read_text() != project_guidance(cast(Policy, policy)):
                    raise ValueError(f"{PROJECT_GUIDANCE} is stale or customized; reconcile with setup or upgrade")
                if state.get("stage") != policy["stage"] or state.get("policy_version") != policy["policy_version"]:
                    raise ValueError("policy stage/version and install manifest disagree")
                label = "linked" if linked else "pinned"
                print(f"Policy {policy['policy_version']}; stage {policy['stage']}; {len(pins)} {label} skills")
                if linked:
                    print(f"Canonical skills: {state['skill_source']}")
                    for name in sorted(pins):
                        print(f"  {name}: {versions['skills'][name]} (live)")
                print(f"Instructions: {GUIDANCE} routes to authored AGENTS.md and the selected project skills")
            except (OSError, ValueError, TypeError, KeyError) as error:
                errors.append(str(error))
    for message in errors:
        print(f"ERROR: {message}", file=sys.stderr)
    for message in warnings:
        print(f"WARNING: {message}")
    print(
        f"Validated {len(folders)} skill packages: {len(errors)} errors, {len(warnings)} warnings (structural checks; behavior not evaluated)"
    )
    return int(bool(errors) or bool(args.strict and warnings))


def policy_view(
    root: Path,
    resolved: PolicySelection,
    state: Manifest,
    policy_version: str | None,
    go_rollout: str | None = None,
    ts_rollout: str | None = None,
    payloads: dict[str, bytes] | None = None,
    pins: Mapping[str, str | None] | None = None,
) -> PolicyView:
    """Represent effective selections without confusing retention with removal."""
    payloads = payloads or {}
    view: PolicyView = {
        "mode": resolved["mode"],
        "skill_storage": resolved["skill_storage"],
        "skill_source": resolved["skill_source"],
        "stage": resolved["stage"],
        "kind": resolved["kind"],
        "authority": resolved["authority"],
        "adoption": resolved["adoption"],
        "policy_version": policy_version,
        "skills": sorted(resolved["skills"] | recorded_skills(state)),
        "agents": resolved["agent_selection"],
        "pr_template": resolved["template"],
        "detect_languages": resolved["detect_enabled"],
        "checks": {},
        "skill_versions": {},
    }
    view["skill_versions"] = {
        name: (pins if pins is not None else state.get("skill_versions", {})).get(name) for name in view["skills"]
    }
    if resolved["skill_storage"] == "linked":
        live = read_versions(Path(resolved["skill_source"]) / "source-code-versions.json")
        view["skill_versions"] = {name: live["skills"].get(name) for name in view["skills"]}
    for language, runner, rollout, settings_name in (
        ("go", "scripts/check-go.sh", go_rollout, ".go-quality.json"),
        ("typescript", "scripts/check-typescript.mjs", ts_rollout, ".typescript-quality.json"),
        ("python", "scripts/check-python.py", None, ".python-quality.json"),
        ("protobuf", "scripts/check-protobuf.py", None, ".protobuf-quality.json"),
    ):
        selected = {
            "go": resolved["go_profile"],
            "typescript": resolved["typescript_profile"],
            "python": resolved["python_profile"],
            "protobuf": resolved["protobuf_profile"],
        }[language]
        recorded = runner in state["files"]
        settings = {}
        if settings_name in payloads:
            settings = json.loads(payloads[settings_name])
        elif recorded and (root / settings_name).is_file():
            settings = json.loads((root / settings_name).read_text())
        if not isinstance(settings, dict):
            raise ValueError(f"invalid recorded {language} profile settings")
        item: CheckView = {
            "enabled": selected or recorded,
            "selected": selected,
            "action": ("update" if recorded else "install") if selected else ("retain" if recorded else "absent"),
            "rollout": rollout or settings.get("rollout"),
        }
        if language == "typescript":
            item["projects"] = settings.get("projects", [])
        if language == "python":
            item["paths"] = settings.get("paths", [])
        view["checks"][language] = item
    return view


def recorded_policy(root: Path, state: Manifest, snapshot: Snapshot | None) -> PolicyView | None:
    if snapshot is None:
        return None
    policy = {}
    if (root / POLICY).exists():
        policy = json.loads((root / POLICY).read_text())
        if not isinstance(policy, dict):
            raise ValueError("invalid recorded project policy")
    for name, choices in (("stage", STAGES), ("kind", KINDS), ("authority", AUTHORITIES), ("adoption", ADOPTIONS)):
        if name in policy and policy[name] not in choices:
            raise ValueError(f"invalid recorded policy {name}")
    if policy.get("stage", state.get("stage")) != state.get("stage") or policy.get(
        "kind", state.get("kind")
    ) != state.get("kind"):
        raise ValueError("recorded policy and manifest disagree; run validate")
    for name in ("authority", "adoption"):
        if policy.get(name) != state.get(name):
            raise ValueError(f"recorded policy {name} and manifest disagree; run validate")
    resolved: PolicySelection = {
        "mode": state.get("mode", "tracked"),
        "skill_storage": state.get("skill_storage", "copied"),
        "skill_source": state.get("skill_source", ""),
        "stage": state.get("stage", "beta"),
        "kind": state.get("kind"),
        "authority": state.get("authority"),
        "adoption": state.get("adoption"),
        "skills": recorded_skills(state),
        "agent_selection": state.get("agents", "codex"),
        "template": state.get("pr_template", "none"),
        "detect_enabled": state.get("detect_languages", True),
        "go_profile": state.get("go_profile", False),
        "typescript_profile": state.get("typescript_profile", False),
        "python_profile": state.get("python_profile", False),
        "protobuf_profile": state.get("protobuf_profile", False),
    }
    pins = policy.get("skills", state.get("skill_versions", {}))
    if not isinstance(pins, dict) or any(
        name not in MANAGED_SKILLS or not isinstance(version, str) or not VERSION_RE.fullmatch(version)
        for name, version in pins.items()
    ):
        raise ValueError("invalid recorded skill pins")
    if state.get("skill_versions") is not None and pins != state["skill_versions"]:
        raise ValueError("recorded skill pins and manifest disagree; run validate")
    if resolved["skill_storage"] == "linked":
        registry = read_versions(root / VERSIONS)
        pins = {name: registry["skills"][name] for name in recorded_skills(state)}
    view = policy_view(root, resolved, state, state.get("policy_version"), pins=pins)
    for item in view["checks"].values():
        item.pop("action")
    return view


def explain_policy(args: Arguments) -> int:
    requested = args.repo.expanduser().resolve()
    if not requested.is_dir():
        raise ValueError(f"project directory does not exist: {requested}")
    found = git(requested, "rev-parse", "--show-toplevel", check=False)
    root = Path(found.stdout.strip()).resolve() if found.returncode == 0 else requested
    state, snapshot = read_state(root)
    installed = recorded_policy(root, state, snapshot)
    resolved = resolve_policy(root, args, state)
    versions = read_versions(SOURCE / "ai/skills/source-code-versions.json")
    if args.policy_version and args.policy_version != versions["policy_version"]:
        raise ValueError(f"requested policy {args.policy_version}; this source ships {versions['policy_version']}")
    desired, payloads = package(
        sorted(resolved["skills"]),
        resolved["agents"],
        resolved["template"],
        resolved["go_profile"],
        resolved["typescript_profile"],
        resolved["python_profile"],
        resolved["protobuf_profile"],
        Path(resolved["skill_source"]) if resolved["skill_storage"] == "linked" else None,
        resolved["stage"],
    )
    go_rollout, ts_rollout = None, None
    if resolved["go_profile"]:
        go_rollout, legacy = go_adoption(root, state, args.go_rollout)
    if resolved["typescript_profile"]:
        ts_rollout, _ = typescript_configuration(root, args, desired, payloads)
    if resolved["python_profile"]:
        python_configuration(root, args, desired, payloads)
    if resolved["protobuf_profile"]:
        protobuf_configuration(root, desired, payloads)
    configure_skill_packages(root, resolved, state, desired, payloads)
    installed_pins = installed["skill_versions"] if installed is not None else {}
    pins = {
        name: versions["skills"][name] if name in resolved["skills"] else installed_pins.get(name)
        for name in resolved["skills"] | recorded_skills(state)
    }
    view = policy_view(root, resolved, state, versions["policy_version"], go_rollout, ts_rollout, payloads, pins)
    selected = sorted(resolved["skills"])
    retained = sorted(recorded_skills(state) - resolved["skills"])
    origins = resolved["origins"]
    for name in retained:
        cast(dict[str, list[dict[str, object]]], origins["skills"])[name] = [
            {"source": "saved", "detail": "retained outside the selected update subset"}
        ]
    origins["skill_versions"] = {name: {"source": "source" if name in resolved["skills"] else "saved"} for name in pins}
    origins["policy_version"] = (
        {"source": "cli", "key": "policy_version"}
        if "policy_version" in args.cli_values
        else {"source": "toml", "path": str(args.config_path), "key": "policy_version"}
        if "policy_version" in args.config_applied
        else {"source": "source", "detail": "installed command's version registry"}
    )
    for language in ("go", "typescript"):
        name = language + "_rollout"
        if name in args.cli_values:
            source = {"source": "cli", "key": name}
        elif name in args.config_applied:
            source = {"source": "toml", "key": name, "path": str(args.config_path)}
        elif (
            state.get(name) is not None
            or (root / (".go-quality.json" if language == "go" else ".typescript-quality.json")).exists()
        ):
            source = {"source": "saved", "detail": "recorded profile settings"}
        else:
            source = {"source": "default", "detail": "profile adoption rules"}
        origins[f"checks.{language}.rollout"] = source
    origins["checks.python.paths"] = (
        {"source": "cli", "key": "python_path"}
        if "python_path" in args.cli_values
        else {"source": "toml", "key": "python_path", "path": str(args.config_path)}
        if "python_path" in args.config_applied
        else {"source": "saved"}
        if snapshot and ".python-quality.json" in state["files"]
        else {"source": "default"}
    )
    origins["checks.typescript.projects"] = (
        {"source": "cli", "key": "typescript_project"}
        if "typescript_project" in args.cli_values
        else {"source": "toml", "key": "typescript_project", "path": str(args.config_path)}
        if "typescript_project" in args.config_applied
        else {"source": "saved"}
        if snapshot and ".typescript-quality.json" in state["files"]
        else {"source": "default"}
    )
    differences = []

    def compare(wanted: Mapping[str, object], actual: object, prefix: str = "") -> None:
        for key, value in wanted.items():
            if key == "action":
                continue
            field = prefix + key
            previous = actual.get(key) if isinstance(actual, dict) else None
            if isinstance(value, dict):
                compare(value, previous, field + ".")
            elif value != previous:
                differences.append({"field": field, "desired": value, "installed": previous})

    compare(view, installed)
    warnings = [
        "Recorded installation is metadata, not an integrity or readiness check; use validate and project checks.",
        "Inspection resolves policy; install conflicts and profile content are not validated. Use setup --dry-run before applying.",
    ]
    if installed is not None and any(value is None for value in installed["skill_versions"].values()):
        warnings.append(
            "Some recorded skills have no version pins; upgrade is needed to version the legacy installation."
        )
    for name in ("authority", "adoption"):
        if view[name] is None:
            warnings.append(f"No {name} selected; setup or upgrade requires an explicit selection.")
    if snapshot is None:
        warnings.append("No source-code installation is recorded; no files or Git metadata were created.")
    result = {
        "schema_version": 1,
        "repository": str(root),
        "configuration": str(args.config_path) if args.config_path else None,
        "desired": view,
        "installed": installed,
        "selection": {"skills": selected, "retained_skills": retained},
        "origins": origins,
        "differences": differences,
        "warnings": warnings,
    }
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(f"Source-code policy: {root}")
        print(f"Configuration: {result['configuration'] or 'none (saved selections and defaults)'}")
        print("Field | Desired | Recorded installation | Origin")
        for name in (
            "stage",
            "kind",
            "authority",
            "adoption",
            "mode",
            "policy_version",
            "agents",
            "pr_template",
            "detect_languages",
        ):
            value = cast(Mapping[str, object], installed).get(name) if installed is not None else None
            print(
                f"{name} | {json.dumps(cast(Mapping[str, object], view)[name])} | {json.dumps(value)} | {json.dumps(origins[name])}"
            )
        print("Skills selected for update: " + ", ".join(selected))
        print("Skills retained: " + (", ".join(retained) or "none"))
        for name in view["skills"]:
            previous = installed["skill_versions"].get(name) if installed is not None else None
            print(
                f"skill {name} | {json.dumps(view['skill_versions'][name])} | {json.dumps(previous)} | {json.dumps(cast(dict[str, object], origins['skills'])[name])}"
            )
        for language, profile in view["checks"].items():
            previous_check = installed["checks"].get(language) if installed is not None else None
            print(
                f"{language} checks | {json.dumps(profile, sort_keys=True)} | {json.dumps(previous_check, sort_keys=True)} | {json.dumps(origins[f'checks.{language}.selected'])}"
            )
        for field in differences:
            print(f"Difference {field['field']}: {json.dumps(field['installed'])} -> {json.dumps(field['desired'])}")
        for warning in warnings:
            print("Note: " + warning)
    return 0


def hydrate_worktree(args: Arguments) -> None:
    """Recreate local installation artifacts without claiming another checkout's files."""
    root = Path(git(args.repo.expanduser().resolve(), "rev-parse", "--show-toplevel").stdout.strip()).resolve()
    args.repo = root
    index = Path(git(root, "rev-parse", "--path-format=absolute", "--git-path", "index").stdout.strip())
    if not index.exists():
        return  # --no-checkout has no branch files/configuration to hydrate yet.
    state, snapshot = read_state(root)
    if snapshot is not None and all(inspect(root, path) is not None for path in state["files"]):
        return
    # The common directory identifies the primary checkout even when invoked from
    # another linked checkout; no mutable guidance directory is shared between them.
    entries = git(root, "worktree", "list", "--porcelain", "-z").stdout.split("\0")
    primary = next((Path(item.removeprefix("worktree ")) for item in entries if item.startswith("worktree ")), root)
    inherited, inherited_snapshot = read_state(primary)
    if snapshot is None:
        args.inherited_state = inherited if inherited_snapshot is not None else None
    if not (root / "source-code.toml").exists():
        if (primary / "source-code.toml").is_file():
            args.config = primary / "source-code.toml"
        elif snapshot is None and inherited_snapshot is None:
            return
    load_configuration(args)
    selection = resolve_policy(root, args, state if snapshot is not None else inherited)
    if selection["authority"] is None or selection["adoption"] is None:
        raise ValueError(
            "worktree hydration requires recorded authority and adoption; run source-code setup explicitly"
        )
    args.hydration = True
    install(args)


def main() -> None:
    command = argparse.ArgumentParser(description="Manage source-code standards and repository setup.")
    subcommands = command.add_subparsers(dest="command", required=True)
    parser = subcommands.add_parser(
        "setup", help="install or update repository guidance and checks", description=__doc__
    )
    explain_parser = subcommands.add_parser(
        "explain", help="show desired policy, recorded installation, and origins without writes"
    )
    add_install_arguments(explain_parser, inspection=True)
    explain_parser.add_argument("--json", action="store_true", help="emit one versioned JSON object")
    upgrade_parser = subcommands.add_parser("upgrade", help="update an existing installation to this source's versions")
    hydration_parser = subcommands.add_parser(
        "hydrate", help="restore missing worktree guidance from project selections without replacing existing files"
    )
    hydration_parser.add_argument("--repo", type=Path, default=Path.cwd())
    hydration_parser.add_argument("--dry-run", action="store_true")
    validation_parser = subcommands.add_parser(
        "validate", help="check skill best practices, version pins, and installed integrity"
    )
    validation_parser.add_argument("--repo", type=Path, default=Path.cwd())
    validation_parser.add_argument(
        "--config", type=Path, help="authored TOML configuration (relative to invocation directory)"
    )
    validation_parser.add_argument(
        "--skills-dir", type=Path, help="check a skill or skill tree without requiring an installation"
    )
    validation_parser.add_argument(
        "--strict", action="store_true", help="treat best-practice and customization warnings as failures"
    )
    skill_parser = subcommands.add_parser(
        "skill", help="print the source-code management skill as Markdown for agent discovery"
    )
    skill_parser.add_argument(
        "--topic",
        choices=("inspection", "setup", "validation"),
        help="print one management reference instead of the entrypoint",
    )
    detection_parser = subcommands.add_parser(
        "detect", help="inspect language evidence without installing guidance or checks"
    )
    detection_parser.add_argument("--repo", type=Path, default=Path.cwd())
    detection_parser.add_argument("--json", action="store_true")
    add_install_arguments(parser, require_policy=True)
    add_install_arguments(upgrade_parser)
    upgrade_parser.add_argument(
        "--strict", action="store_true", help="reject best-practice warnings in the upgrade source"
    )
    args = command.parse_args(namespace=Arguments())
    try:
        if args.command == "hydrate":
            hydrate_worktree(args)
            command.exit(0)
        if args.command == "skill":
            package = SOURCE / "ai/skills/source-code"
            skill_path = package / "references" / f"{args.topic}.md" if args.topic else package / "SKILL.md"
            if not skill_path.is_file():
                raise ValueError(f"management skill is unavailable: {skill_path}; restore the source-code installation")
            sys.stdout.buffer.write(skill_path.read_bytes())
            command.exit(0)
        if args.command != "detect":
            load_configuration(args)
        if args.command == "explain":
            command.exit(explain_policy(args))
        if args.command == "validate":
            command.exit(validate_project(args))
        if args.command == "detect":
            requested = args.repo.expanduser().resolve()
            found = git(requested, "rev-parse", "--show-toplevel", check=False)
            root = Path(found.stdout.strip()) if found.returncode == 0 else requested
            if not root.is_dir():
                raise ValueError(f"project directory does not exist: {root}")
            detection = detect_languages(root)
            if args.json:
                print(json.dumps(detection, indent=2))
            else:
                for language, paths in detection["evidence"].items():
                    print(f"{language}: {', '.join(json.dumps(path, ensure_ascii=False) for path in paths)}")
                if not detection["languages"]:
                    print("No supported language evidence found")
            command.exit(0)
        if args.command == "upgrade":
            prepare_upgrade(args)
        install(args)
    except (OSError, ValueError) as error:
        suffix = (
            ""
            if args.command in {"validate", "detect", "skill", "explain"}
            else "No existing conflicts were overwritten without explicit replacement. If an I/O error interrupted installation, inspect the reported paths before retrying.\n"
        )
        command.exit(1, f"source-code {args.command}: {error}\n{suffix}")


def add_install_arguments(
    parser: argparse.ArgumentParser, inspection: bool = False, require_policy: bool = False
) -> None:
    parser.add_argument("--repo", type=Path, default=Path.cwd(), help="repository path (default: current directory)")
    parser.add_argument(
        "--config",
        type=Path,
        help="authored TOML configuration (default: source-code.toml at repository root; explicit relative paths use invocation directory)",
    )
    if not inspection:
        parser.add_argument("--init", action="store_true", help="create a Git repository if the target is not one")
    parser.add_argument(
        "--mode",
        choices=("tracked", "local", "shadow"),
        help="shareable files or local Git exclusions; shadow aliases local (default: previous mode, else shadow)",
    )
    parser.add_argument(
        "--skill-storage",
        choices=("linked", "copied"),
        help="linked canonical skills or portable pinned copies (default: saved storage; new installations use linked)",
    )
    parser.add_argument(
        "--skills",
        help="comma-separated skill names (default: saved selection, else core and repository publication guidance): "
        + ", ".join(SKILLS),
    )
    parser.add_argument(
        "--go",
        action=argparse.BooleanOptionalAction,
        default=None,
        help="install Go correctness checks (default: root go.mod or previously installed); --no-go keeps existing checks",
    )
    parser.add_argument(
        "--go-rollout",
        choices=("strict", "ratchet"),
        help="whole-project strictness or grandfather existing findings (default: ratchet for existing code/config)",
    )
    parser.add_argument(
        "--go-retrofit",
        dest="go_rollout",
        action="store_const",
        const="ratchet",
        help="prepare merged Go policy and a one-time shrinking baseline",
    )
    parser.add_argument(
        "--typescript",
        action=argparse.BooleanOptionalAction,
        default=None,
        help="install TypeScript correctness checks (opt-in, retained on subsequent runs)",
    )
    parser.add_argument(
        "--typescript-rollout",
        choices=("strict", "ratchet"),
        help="strict new projects or a shrinking legacy diagnostic baseline",
    )
    parser.add_argument(
        "--typescript-retrofit",
        dest="typescript_rollout",
        action="store_const",
        const="ratchet",
        help="preserve TypeScript project policy and prepare a shrinking baseline",
    )
    parser.add_argument(
        "--typescript-project",
        action="append",
        metavar="TSCONFIG",
        help="repository-relative leaf tsconfig (repeat for multiple projects)",
    )
    parser.add_argument(
        "--agents",
        choices=("codex", "both"),
        help="Codex skills only, or add Claude aliases (default: saved selection, else both)",
    )
    parser.add_argument(
        "--pr-template",
        choices=("github", "local", "none"),
        help="GitHub default, local drafting template, or omit (default follows mode)",
    )
    if not inspection:
        parser.add_argument(
            "--conflict",
            choices=("fail", "skip", "replace"),
            default="fail",
            help="existing/edited file policy; replace saves backups, never replaces symlinks",
        )
        parser.add_argument("--dry-run", action="store_true", help="show the complete plan without writes")
    parser.add_argument(
        "--protobuf",
        action=argparse.BooleanOptionalAction,
        default=None,
        help="install strict Protobuf checks (default: detected schemas or saved selection; --no-protobuf retains existing files)",
    )
    parser.add_argument(
        "--python",
        action=argparse.BooleanOptionalAction,
        default=None,
        help="install strict Python correctness checks (opt-in; --no-python retains existing files)",
    )
    parser.add_argument(
        "--python-path",
        action="append",
        help="repository-relative Python file or directory, repeatable including extensionless scripts",
    )
    parser.add_argument(
        "--kind", choices=KINDS, help="software usage kind (default: saved kind, else unspecified; never inferred)"
    )
    parser.add_argument(
        "--authority",
        choices=AUTHORITIES,
        required=require_policy,
        help="project authority (required on every setup; upgrade uses configured or saved selection)",
    )
    parser.add_argument(
        "--adoption",
        choices=ADOPTIONS,
        required=require_policy,
        help="tool adoption (required on every setup; upgrade uses configured or saved selection); backfill requires a scoped migration task",
    )
    parser.add_argument(
        "--stage", choices=STAGES, help="lifecycle assurance level (default: previous stage, else beta/full checks)"
    )
    parser.add_argument(
        "--policy-version",
        help="require the policy version shipped by this installed source; no implicit version fetching",
    )
    parser.add_argument(
        "--detect-languages",
        action=argparse.BooleanOptionalAction,
        default=None,
        help="select matching language guidance (default: saved choice, else enabled); check profiles remain explicit",
    )


if __name__ == "__main__":
    main()
