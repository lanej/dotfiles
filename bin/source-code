try:
    import tomllib
    from typing import NotRequired, Required
except ImportError:
    raise SystemExit(
        "source-code requires Python 3.11 or newer; use the workstation Python installed by dotfiles bootstrap"
    ) from None


# Decoded JSON is validated at I/O boundaries before being narrowed to these models.
class Snapshot(TypedDict):
    kind: str
    sha256: NotRequired[str]
    executable: NotRequired[bool]
    target: NotRequired[str]


class Manifest(TypedDict, total=False):
    version: Required[int]
    files: Required[dict[str, Snapshot]]
    mode: str
    skill_storage: str
    skill_source: str
    stage: str
    kind: str
    authority: str
    adoption: str
    policy_version: str
    skill_versions: dict[str, str]
    skills: list[str]
    agents: str
    pr_template: str
    detect_languages: bool
    source_revision: str
    go_profile: bool
    typescript_profile: bool
    python_profile: bool
    protobuf_profile: bool
    go_rollout: str
    go_legacy: str | None
    octo_config_sha256: str


class Registry(TypedDict):
    schema_version: int
    policy_version: str
    skills: dict[str, str]


class Detection(TypedDict):
    languages: list[str]
    skills: list[str]
    evidence: dict[str, list[str]]
    protobuf_roots: NotRequired[list[str]]


class Policy(TypedDict):
    schema_version: int
    policy_version: str
    stage: str
    kind: NotRequired[str]
    authority: NotRequired[str]
    adoption: NotRequired[str]
    languages: list[str]
    skills: dict[str, str]
    detection: dict[str, object]
    skill_storage: NotRequired[str]


class PolicySelection(TypedDict):
    mode: str
    skill_storage: str
    skill_source: str
    skills: set[str]
    stage: str
    kind: str | None
    authority: str | None
    adoption: str | None
    go_profile: bool
    typescript_profile: bool
    python_profile: bool
    protobuf_profile: bool
    detect_enabled: bool
    agent_selection: str
    agents: NotRequired[set[str]]
    template: str


class ResolvedPolicy(PolicySelection):
    detection: Detection
    origins: dict[str, object]


class CheckView(TypedDict):
    enabled: bool
    selected: bool
    action: NotRequired[str]
    rollout: str | None
    projects: NotRequired[list[str]]
    paths: NotRequired[list[str]]


class PolicyView(TypedDict):
    mode: str
    skill_storage: str
    skill_source: str
    stage: str
    kind: str | None
    authority: str | None
    adoption: str | None
    policy_version: str | None
    skills: list[str]
    skill_versions: dict[str, str | None]
    agents: str
    pr_template: str
    detect_languages: bool
    checks: dict[str, CheckView]


class Finding(TypedDict):
    path: str
    errors: list[str]
    warnings: list[str]


class Arguments(argparse.Namespace):
    command: str
    repo: Path
    config: Path | None = None
    config_path: Path | None = None
    config_values: dict[str, object]
    config_applied: set[str]
    cli_values: dict[str, object]
    skills_dir: Path | None = None
    topic: str | None = None
    init: bool = False
    mode: str | None = None
    skill_storage: str | None = None
    skills: str | None = None
    go: bool | None = None
    go_rollout: str | None = None
    typescript: bool | None = None
    typescript_rollout: str | None = None
    typescript_project: list[str] | None = None
    python: bool | None = None
    protobuf: bool | None = None
    python_path: list[str] | None = None
    agents: str | None = None
    pr_template: str | None = None
    conflict: str = "fail"
    dry_run: bool = False
    kind: str | None = None
    authority: str | None = None
    adoption: str | None = None
    stage: str | None = None
    policy_version: str | None = None
    detect_languages: bool | None = None
    strict: bool = False
    json: bool = False
    hydration: bool = False
    inherited_state: Manifest | None = None


