#!/usr/bin/env python3
"""Install and update source-code standards, skills, and checks in a Git repository."""

import argparse
import hashlib
import importlib.util
import json
import os
from pathlib import Path, PurePosixPath
import re
import shutil
import subprocess
import sys
import tempfile
try:
    import tomllib
except ImportError:
    raise SystemExit("source-code requires Python 3.11 or newer; use the workstation Python installed by dotfiles bootstrap")


SOURCE = Path(__file__).resolve().parents[1]
DEFAULT_SKILLS = ("builder", "architecture", "pr-writer")
CORE_SKILLS = ("builder", "architecture", "data-change-planning", "git", "testing", "source-code-lifecycle", "code-comments")
SKILLS = DEFAULT_SKILLS + ("go", "typescript", "code-comments", "library-code-comments", "testing", "source-code-lifecycle", "data-change-planning", "git", "gh-pr-stack", "github-actions", "javascript", "just", "python", "rust")
STAGES = ("research", "alpha", "beta", "production")
KINDS = ("service", "library", "tool")
POLICY = ".source-code.json"
LIFECYCLE_RUNNER = "scripts/check-source-code.py"
VERSIONS = ".agents/source-code-versions.json"
GUIDANCE = "AGENTS.override.md"
HOST_RULE = ".claude/rules/source-code.md"
VERSION_RE = re.compile(r"\d+\.\d+\.\d+(?:-[a-zA-Z0-9.-]+)?")
GO_FILES = {
    ".golangci.yml": "golangci.yml",
    "scripts/check-go.sh": "check-go.sh",
    ".github/workflows/go-quality.yml": "go-quality.yml",
    "scripts/go-quality.py": "go-quality.py",
    ".go-quality.json": "go-quality.json",
}
TS_FILES = {
    "scripts/check-typescript.mjs": "check-typescript.mjs",
    ".typescript-quality/eslint.config.mjs": "eslint.config.mjs",
    ".typescript-quality/biome.json": "biome.json",
    ".typescript-quality/tsconfig.strict.json": "tsconfig.strict.json",
    ".typescript-quality/package.json": "package.json",
    ".typescript-quality/.gitignore": "gitignore",
    ".typescript-quality.json": "typescript-quality.json",
    ".github/workflows/typescript-quality.yml": "typescript-quality.yml",
}
TS_BASELINE = ".typescript-quality-baseline.json"
TS_LOCK = ".typescript-quality/package-lock.json"
GO_CONFIGS = (".golangci.yml", ".golangci.yaml", ".golangci.json", ".golangci.toml")
GO_STRICT = ".golangci.strict.json"
GO_BASELINE = ".go-quality-baseline.json"
STATE = ".agents/repo-bootstrap.json"
START = "# dotfiles repo-bootstrap: start"
END = "# dotfiles repo-bootstrap: end"
PR_DOCS = ("conventional-pull-requests.md", "pull-requests.md",
           "f-pattern-scanning-quick-reference.md", "f-pattern-scanning.md",
           "diagrams-and-charts.md")


def git(root, *args, check=True):
    env = dict(os.environ)
    for name in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_COMMON_DIR"):
        env.pop(name, None)
    result = subprocess.run(["git", "-C", str(root), *args],
                            capture_output=True, text=True, env=env)
    if check and result.returncode:
        raise ValueError(result.stderr.strip() or "Git command failed")
    return result


def digest(data):
    return hashlib.sha256(data).hexdigest()


def file_entry(data, executable=False):
    return {"kind": "file", "sha256": digest(data), "executable": executable}


def inspect(root, relative):
    """Never follow a destination symlink, including an ancestor directory."""
    path = root / relative
    parent = path.parent
    while parent != root:
        if parent.is_symlink() or (parent.exists() and not parent.is_dir()):
            raise ValueError(f"preserving non-directory or linked parent: {parent}")
        parent = parent.parent
    if path.is_symlink():
        return {"kind": "link", "target": os.readlink(path)}
    if path.is_file():
        return file_entry(path.read_bytes(), bool(path.stat().st_mode & 0o111))
    if path.exists():
        raise ValueError(f"preserving non-file destination: {path}")
    return None


def allowed_path(relative):
    path = PurePosixPath(relative)
    if (not re.fullmatch(r"[A-Za-z0-9._/-]+", relative) or path.is_absolute()
            or ".." in path.parts or str(path) != relative):
        return False
    if relative in (".github/pull_request_template.md",
                    ".agents/templates/pull_request_template.md", GO_STRICT, GO_BASELINE, *GO_FILES,
                    TS_BASELINE, TS_LOCK, POLICY, LIFECYCLE_RUNNER, VERSIONS, GUIDANCE, HOST_RULE, *TS_FILES):
        return True
    return any(relative.startswith(f".agents/skills/{skill}/")
               or relative == f".claude/skills/{skill}" for skill in SKILLS)


def read_state(root):
    snapshot = inspect(root, STATE)
    if snapshot is None:
        return {"version": 1, "files": {}}, snapshot
    if snapshot["kind"] != "file":
        raise ValueError(f"preserving linked manifest: {root / STATE}")
    state = json.loads((root / STATE).read_text())
    if not isinstance(state, dict) or type(state.get("version")) is not int or state["version"] != 1 or not isinstance(state.get("files"), dict):
        raise ValueError(f"unrecognized manifest: {root / STATE}")
    if "kind" in state and state["kind"] not in KINDS:
        raise ValueError("invalid manifest project kind")
    if "stage" in state and state["stage"] not in STAGES:
        raise ValueError("invalid manifest lifecycle stage")
    if "policy_version" in state and (not isinstance(state["policy_version"], str) or not VERSION_RE.fullmatch(state["policy_version"])):
        raise ValueError("invalid manifest policy version")
    if "skill_versions" in state:
        pins = state["skill_versions"]
        if not isinstance(pins, dict) or not all(name in SKILLS and isinstance(value, str) and VERSION_RE.fullmatch(value) for name, value in pins.items()):
            raise ValueError("invalid manifest skill versions")
    if "skills" in state and (not isinstance(state["skills"], list) or not all(name in SKILLS for name in state["skills"])):
        raise ValueError("invalid manifest skill selection")
    if "agents" in state and state["agents"] not in ("codex", "both"):
        raise ValueError("invalid manifest agent selection")
    if "pr_template" in state and state["pr_template"] not in ("none", "local", "github"):
        raise ValueError("invalid manifest template selection")
    if "detect_languages" in state and not isinstance(state["detect_languages"], bool):
        raise ValueError("invalid manifest language detection setting")
    for path, entry in state["files"].items():
        if not allowed_path(path) or not isinstance(entry, dict):
            raise ValueError(f"invalid managed path in manifest: {path}")
        if entry.get("kind") == "file":
            valid = (set(entry) == {"kind", "sha256", "executable"}
                     and isinstance(entry["sha256"], str)
                     and re.fullmatch(r"[a-f0-9]{64}", entry["sha256"])
                     and isinstance(entry["executable"], bool))
        else:
            valid = (set(entry) == {"kind", "target"}
                     and path.startswith(".claude/skills/")
                     and entry.get("target") == f"../../.agents/skills/{Path(path).name}")
        if not valid:
            raise ValueError(f"invalid managed entry in manifest: {path}")
    return state, snapshot


def load_configuration(args):
    """Validate authored intent, leaving installed state and the file untouched."""
    if getattr(args, "skills_dir", None):
        if args.config is not None:
            raise ValueError("--config cannot be combined with --skills-dir")
        return
    requested = args.repo.expanduser().resolve()
    found = git(requested, "rev-parse", "--show-toplevel", check=False)
    root = Path(found.stdout.strip()).resolve() if found.returncode == 0 else requested
    path = args.config.expanduser().resolve() if args.config is not None else root / "source-code.toml"
    if not path.exists():
        if args.config is not None:
            raise ValueError(f"configuration file does not exist: {path}")
        args.config_path, args.config_values = None, {}
        return
    with path.open("rb") as stream:
        data = tomllib.load(stream)
    allowed = {"schema_version", "stage", "kind", "mode", "skills", "agents", "pr_template", "detect_languages", "policy_version", "checks"}
    unknown = set(data) - allowed
    if unknown:
        raise ValueError("unknown configuration keys: " + ", ".join(sorted(unknown)))
    if type(data.get("schema_version")) is not int or data["schema_version"] != 1:
        raise ValueError("configuration requires schema_version = 1")
    choices = {"stage": STAGES, "kind": KINDS, "mode": ("tracked", "shadow", "local"), "agents": ("codex", "both"), "pr_template": ("none", "local", "github")}
    values = {}
    for key, options in choices.items():
        if key in data:
            if not isinstance(data[key], str) or data[key] not in options:
                raise ValueError(f"invalid configuration {key}; expected one of {', '.join(options)}")
            values[key] = data[key]
    if "detect_languages" in data:
        if type(data["detect_languages"]) is not bool:
            raise ValueError("configuration detect_languages must be a boolean")
        values["detect_languages"] = data["detect_languages"]
    if "policy_version" in data:
        if not isinstance(data["policy_version"], str) or not VERSION_RE.fullmatch(data["policy_version"]):
            raise ValueError("configuration policy_version must be a semantic version")
        values["policy_version"] = data["policy_version"]
    if "skills" in data:
        skills = data["skills"]
        if not isinstance(skills, list) or not skills or not all(isinstance(name, str) and name in SKILLS for name in skills) or len(set(skills)) != len(skills):
            raise ValueError("configuration skills must be a nonempty array of unique supported skill names")
        values["skills"] = ",".join(skills)
    checks = data.get("checks", {})
    if not isinstance(checks, dict) or set(checks) - {"go", "typescript"}:
        raise ValueError("configuration checks accepts only go and typescript tables")
    for language, fields in checks.items():
        allowed_fields = {"enabled", "rollout"} | ({"projects"} if language == "typescript" else set())
        if not isinstance(fields, dict) or set(fields) - allowed_fields:
            raise ValueError(f"invalid checks.{language} keys")
        if "enabled" in fields:
            if type(fields["enabled"]) is not bool:
                raise ValueError(f"checks.{language}.enabled must be a boolean")
            values[language] = fields["enabled"]
        if "rollout" in fields:
            if fields["rollout"] not in ("strict", "ratchet"):
                raise ValueError(f"checks.{language}.rollout must be strict or ratchet")
            values[f"{language}_rollout"] = fields["rollout"]
        if "projects" in fields:
            projects = fields["projects"]
            if not isinstance(projects, list) or not projects or not all(isinstance(name, str) and re.fullmatch(r"[A-Za-z0-9._/-]+", name) and not PurePosixPath(name).is_absolute() and ".." not in PurePosixPath(name).parts for name in projects) or len(set(projects)) != len(projects):
                raise ValueError("checks.typescript.projects must be unique repository-relative paths")
            values["typescript_project"] = projects
        if fields.get("enabled") is False and set(fields) - {"enabled"}:
            raise ValueError(f"checks.{language} cannot disable checks while selecting rollout or projects")
    args.config_path, args.config_values = path, values
    if args.command != "validate":
        disabled_cli = {language for language in ("go", "typescript") if getattr(args, language) is False}
        for key, value in values.items():
            if any(key.startswith(language + "_") for language in disabled_cli):
                continue
            if getattr(args, key) is None:
                setattr(args, key, value)
        for language in ("go", "typescript"):
            if getattr(args, language) is False and (getattr(args, f"{language}_rollout") or language == "typescript" and args.typescript_project):
                raise ValueError(f"cannot disable {language} checks while selecting rollout or projects")
    effective_policy = values.get("policy_version") if args.command == "validate" else args.policy_version
    if effective_policy and effective_policy != read_versions(SOURCE / "ai/skills/source-code-versions.json")["policy_version"]:
        raise ValueError("configuration requests a policy version not shipped by this source")
    print(f"Configuration: {path}")
    print("  Configured intent: " + json.dumps(values, sort_keys=True))


def config_exclude_text(original, relative, private):
    """Keep authored configuration separate from managed generated artifacts."""
    if relative is None:
        return original
    # Git ignore syntax needs escaping even though the path is not shell code.
    if "\n" in relative or "\r" in relative:
        raise ValueError("private configuration path cannot contain line breaks")
    escaped = "".join("\\" + char if char in "*?[]\\!# " else char for char in relative)
    rule = "/" + escaped
    marker = "# source-code private configuration"
    owned = marker + "\n" + rule + "\n"
    if not private:
        return original.replace(owned, "")
    if rule in original.splitlines():
        return original
    return original + ("\n" if original and not original.endswith("\n") else "") + owned


def configuration_drift(args, state, root):
    warnings = []
    mapping = {"go": "go_profile", "typescript": "typescript_profile"}
    for key, desired in args.config_values.items():
        if key == "skills":
            expected = complete_skills(set(desired.split(",")), bool(args.config_values.get("stage")), args.config_values.get("kind", state.get("kind")))
            if not expected <= set(state.get("skills", [])):
                warnings.append("configuration skills are not installed; run setup or upgrade")
            continue
        if key in ("typescript_rollout", "typescript_project"):
            policy_path = root / ".typescript-quality.json"
            installed = json.loads(policy_path.read_text()) if policy_path.is_file() else {}
            actual = installed.get("rollout" if key == "typescript_rollout" else "projects")
        else:
            actual = state.get(mapping.get(key, key), False if key in mapping else None)
        if key == "mode" and desired == "shadow":
            desired = "local"
        if actual != desired:
            warnings.append(f"configuration {key} differs from installed state: {actual!r} -> {desired!r}; run setup or upgrade")
    return warnings


def read_versions(path):
    versions = json.loads(path.read_text())
    if not isinstance(versions, dict) or type(versions.get("schema_version")) is not int or versions["schema_version"] != 1:
        raise ValueError(f"unsupported skill version registry: {path}")
    skills = versions.get("skills")
    if not isinstance(skills, dict) or not skills or not set(skills) <= set(SKILLS):
        raise ValueError(f"invalid skill versions: {path}")
    for version in [versions.get("policy_version"), *skills.values()]:
        if not isinstance(version, str) or not VERSION_RE.fullmatch(version):
            raise ValueError(f"invalid semantic version in {path}")
    return versions


def version_key(version):
    core, _, prerelease = version.partition("-")
    suffix = tuple((0, int(part)) if part.isdigit() else (1, part) for part in prerelease.split(".")) if prerelease else ()
    return (*map(int, core.split(".")), int(not prerelease), suffix)


def project_guidance(policy):
    rows = "\n".join(f"| {name} | {version} |" for name, version in sorted(policy["skills"].items()))
    lifecycle = "Read the installed `.agents/skills/source-code-lifecycle/SKILL.md` first, then " if "source-code-lifecycle" in policy["skills"] else "Then "
    gates = ", ".join(f"`python3 scripts/check-source-code.py {name}`" for name in policy["languages"])
    gate_guidance = f"Run the installed generated gates: {gates}." if gates else "No generated language gate is installed; follow existing repository commands and the selected language skills."
    kind = policy.get("kind")
    kind_guidance = (f"Project kind: **{kind}**. Read the installed `.agents/skills/source-code-lifecycle/references/kinds.md` for kind-specific obligations, scaled by the selected lifecycle stage. Kind selects usage guidance, not architecture or additional generated test commands.\n\n" if kind else "")
    return ("<!-- Managed by source-code setup; edit policy through setup or upgrade. -->\n"
            "# Source-code project guidance\n\n"
            f"Policy version: **{policy['policy_version']}**. Schema version: **{policy['schema_version']}**. Lifecycle stage: **{policy['stage']}**.\n\n"
            + kind_guidance +
            "Before applying this policy, read the repository's `AGENTS.md` if it exists. Preserve its requirements and all more-specific repository instructions. This override adds project policy; it does not waive existing gates.\n\n"
            "The authoritative pins and stage are in `.source-code.json`; this file is their generated summary.\n\n"
            "| Skill | Version |\n| --- | --- |\n" + rows + "\n\n"
            + lifecycle + "load the installed skills relevant to the task. Preserve existing repository instructions and required gates. A stage or version pin does not establish readiness.\n\n"
            "Use `source-code validate` to check packages and pins. Use `source-code upgrade --dry-run` to review available updates before applying them. " + gate_guidance + "\n\n"
            "This file is the generated Codex project entrypoint. Other hosts should load it explicitly when their native instruction discovery does not read AGENTS.override.md.\n")


def complete_skills(skills, explicit_stage=False, kind=None):
    skills = set(skills)
    if kind == "library":
        skills.add("library-code-comments")
    if "typescript" in skills:
        skills.add("javascript")
    if skills & {"go", "typescript", "javascript", "python", "rust"}:
        skills.add("library-code-comments")
    if "library-code-comments" in skills:
        skills.add("code-comments")
    if skills & set(CORE_SKILLS) or explicit_stage or kind is not None:
        skills.update(CORE_SKILLS)
    if "git" in skills:
        skills.add("pr-writer")
    return skills


def detect_languages(root, state=None):
    spec = importlib.util.spec_from_file_location("source_code_languages", SOURCE / "scripts/source_code_languages.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    state = read_state(root)[0] if state is None else state
    return module.detect(root, SOURCE / "ai/skills/source-code-lifecycle/references/languages.json", set(state["files"]))


def artifact_owner(path):
    if path.startswith(".agents/skills/"):
        return Path(path).parts[2]
    if path.startswith(".claude/skills/"):
        return Path(path).name
    if path in GO_FILES or path == GO_STRICT:
        return "go"
    if path in TS_FILES:
        return "typescript"
    if path in {POLICY, VERSIONS, GUIDANCE, HOST_RULE, LIFECYCLE_RUNNER}:
        return "source-code-lifecycle"
    if path in {".github/pull_request_template.md", ".agents/templates/pull_request_template.md"}:
        return "pr-writer"
    return None


def package(skills, agents, template, go_profile=False, typescript_profile=False):
    """Assemble from canonical sources; only installation paths are adapted."""
    files = {}
    payloads = {}

    def add(destination, source, replacements=()):
        if not allowed_path(destination):
            raise ValueError(f"unsupported package path: {destination}")
        if source.is_symlink() or not source.is_file():
            raise ValueError(f"missing or linked package source: {source}")
        data = source.read_bytes()
        for old, new in replacements:
            data = data.replace(old.encode(), new.encode())
        files[destination] = file_entry(data, bool(source.stat().st_mode & 0o111))
        payloads[destination] = data

    for skill in skills:
        directory = SOURCE / "ai/skills" / skill
        if not (directory / "SKILL.md").is_file():
            raise ValueError(f"missing skill: {directory}")
        for source in sorted(directory.rglob("*")):
            relative = source.relative_to(directory)
            if "__pycache__" in relative.parts or source.suffix == ".pyc":
                continue
            if skill == "code-comments" and str(relative) == "references/standard.md":
                add(".agents/skills/code-comments/references/standard.md",
                    SOURCE / "docs/conventional-code-comments.md",
                    [("../ai/skills/code-comments/SKILL.md", "../SKILL.md"),
                     ("../ai/skills/library-code-comments/SKILL.md",
                      "https://github.com/lanej/dotfiles/blob/master/ai/skills/library-code-comments/SKILL.md"),
                     ("repository-bootstrap.md",
                      "https://github.com/lanej/dotfiles/blob/master/docs/repository-bootstrap.md")])
                continue
            if source.is_symlink():
                raise ValueError(f"linked package source is not portable: {source}")
            if not source.is_file():
                continue
            replacements = []
            if skill == "git":
                replacements = [("../../../docs/verification.md", "references/verification.md"),
                                ("../../../docs/pull-requests.md", "../pr-writer/references/docs/pull-requests.md")]
            if skill == "builder" and str(relative) == "references/instructions.md":
                replacements = [("~/.local/share/software-standards/builder/SKILL.md", "../SKILL.md"),
                                ("~/.local/share/software-standards/builder/references/", "")]
            if skill == "pr-writer":
                replacements = [("../../agents/", "references/")]
            add(f".agents/skills/{skill}/{relative}", source, replacements)
        if skill == "pr-writer":
            for name in ("pull-request-writer.md", "github-pr-writer.md"):
                add(f".agents/skills/pr-writer/references/{name}", SOURCE / "ai/agents" / name,
                    [("~/.files/docs/", "docs/"), ("~/.files/ai/agents/", "")])
            for name in PR_DOCS:
                add(f".agents/skills/pr-writer/references/docs/{name}", SOURCE / "docs" / name,
                    [("../ai/agents/", "../")])
        if skill == "git":
            add(".agents/skills/git/references/verification.md", SOURCE / "docs/verification.md")
        if "claude" in agents:
            files[f".claude/skills/{skill}"] = {
                "kind": "link", "target": f"../../.agents/skills/{skill}"}
    if template != "none":
        directory = ".github" if template == "github" else ".agents/templates"
        add(f"{directory}/pull_request_template.md", SOURCE / "ai/templates/pull_request_template.md")
    if go_profile:
        for destination, name in GO_FILES.items():
            add(destination, SOURCE / "ai/skills/go/assets" / name)
    if typescript_profile:
        for destination, name in TS_FILES.items():
            add(destination, SOURCE / "ai/skills/typescript/assets" / name)
    return files, payloads


def template_conflicts(root):
    found = []
    for directory in (root, root / "docs", root / ".github"):
        if directory.is_dir():
            for path in directory.iterdir():
                if ((path.name.lower() == "pull_request_template"
                     or path.name.lower().startswith("pull_request_template."))
                        and path != root / ".github/pull_request_template.md"):
                    found.append(str(path.relative_to(root)))
    return found


def go_configuration(root, state, rollout, desired, payloads):
    """Layer the profile beside project policy rather than rewriting it."""
    candidates = [name for name in GO_CONFIGS if inspect(root, name) is not None]
    if len(candidates) > 1:
        raise ValueError("multiple existing Go lint configurations; select one before merging: " + ", ".join(candidates))
    legacy = state.get("go_legacy")
    if candidates:
        name = candidates[0]
        actual = inspect(root, name)
        if actual["kind"] != "file":
            raise ValueError(f"preserving linked or non-file Go lint configuration: {name}")
        if name != ".golangci.yml" or actual != state["files"].get(name):
            legacy = name
    if legacy and legacy not in candidates:
        raise ValueError(f"previous Go lint configuration is missing: {legacy}")
    if rollout is None:
        rollout = state.get("go_rollout")
    if rollout is None:
        old_source = git(root, "ls-files", "--", "*.go", check=False).stdout.strip()
        rollout = "ratchet" if legacy or old_source else "strict"
    if rollout not in ("strict", "ratchet"):
        raise ValueError("invalid saved Go rollout")
    settings = {"version": 1, "rollout": rollout, "config": ".golangci.yml", "legacy": None}
    snapshot = None
    if legacy:
        if legacy.endswith(".toml"):
            raise ValueError("Go config merging supports YAML and JSON; convert the existing TOML config first or use --no-go")
        helper = SOURCE / "ai/skills/go/assets/go-quality.py"
        command = [sys.executable, str(helper)]
        if importlib.util.find_spec("yaml") is None:
            uv = shutil.which("uv")
            if not uv:
                raise ValueError("merging Go YAML requires PyYAML or uv; dotfiles bootstrap provides uv")
            command = [uv, "run", "--no-project", "--with", "PyYAML==6.0.3", "python", str(helper)]
        result = subprocess.run([*command, "merge", "--existing", str(root / legacy),
                                 "--profile", str(SOURCE / "ai/skills/go/assets/golangci.yml")],
                                capture_output=True, text=True)
        if result.returncode:
            raise ValueError(result.stderr.strip() or "Go configuration merge failed")
        payloads.pop(".golangci.yml")
        desired.pop(".golangci.yml")
        data = result.stdout.encode()
        payloads[GO_STRICT] = data
        desired[GO_STRICT] = file_entry(data)
        snapshot = (legacy, inspect(root, legacy))
        settings["config"] = GO_STRICT
        settings["legacy"] = {"path": legacy, "sha256": digest((root / legacy).read_bytes())}
    data = (json.dumps(settings, indent=2) + "\n").encode()
    payloads[".go-quality.json"] = data
    desired[".go-quality.json"] = file_entry(data)
    return rollout, legacy, snapshot


def typescript_configuration(root, args, desired, payloads):
    """Preserve executable project configs; run their original gates separately."""
    original_paths = ["package.json"]
    package_entry = inspect(root, "package.json")
    if not package_entry or package_entry["kind"] != "file":
        raise ValueError("TypeScript adoption requires a regular package.json; initialize the project first")
    project = json.loads((root / "package.json").read_text())
    scripts = project.get("scripts", {})
    if not isinstance(scripts, dict):
        raise ValueError("package.json scripts must be an object")
    settings_path = ".typescript-quality.json"
    existing = inspect(root, settings_path)
    if existing:
        if existing["kind"] != "file":
            raise ValueError("preserving linked TypeScript quality policy")
        settings = json.loads((root / settings_path).read_text())
        if not isinstance(settings, dict) or settings.get("version") != 1:
            raise ValueError("invalid existing TypeScript quality policy")
    else:
        settings = json.loads(payloads[settings_path])
        manager = project.get("packageManager", "").split("@", 1)[0]
        if not manager:
            locks = [("pnpm", "pnpm-lock.yaml"), ("yarn", "yarn.lock"), ("npm", "package-lock.json")]
            found = [name for name, lock in locks if (root / lock).exists()]
            if len(found) > 1:
                raise ValueError("multiple package managers; declare packageManager in package.json first")
            manager = found[0] if found else "npm"
        if manager not in ("npm", "pnpm", "yarn"):
            raise ValueError("TypeScript command defaults support npm, pnpm, or yarn; configure the project explicitly")
        configs = [path for path in root.iterdir()
                   if path.name.startswith(("eslint.config.", ".eslintrc"))]
        if (configs or "eslintConfig" in project) and not scripts.get("lint"):
            raise ValueError("existing ESLint policy needs a non-mutating package.json lint script before adoption")
        legacy = []
        for name in ("lint", "typecheck", "check-types"):
            if scripts.get(name):
                if re.search(r"--(?:fix|write)(?:[=\s]|$)", scripts[name]):
                    raise ValueError(f"{name} is a mutating gate; provide a check-only script before adoption")
                legacy.append([manager, "run", name])
        audit = [manager, "audit", "--audit-level=high"]
        if manager == "yarn":
            audit = ["yarn", "npm", "audit", "--severity", "high", "--recursive"]
            if project.get("packageManager", "").startswith("yarn@1."):
                raise ValueError("Yarn Classic needs an explicit audit adapter; migrate or configure policy before adoption")
        settings["commands"] = {"legacy": legacy, "test": [manager, "run", "test"], "audit": audit}
        old_source = git(root, "ls-files", "--", "*.ts", "*.tsx", "*.mts", "*.cts", check=False).stdout.strip()
        settings["rollout"] = "ratchet" if old_source else "strict"
    if args.typescript_project:
        settings["projects"] = args.typescript_project
    if args.typescript_rollout:
        settings["rollout"] = args.typescript_rollout
    if settings.get("rollout") not in ("strict", "ratchet"):
        raise ValueError("invalid TypeScript rollout")
    projects = settings.get("projects")
    if not isinstance(projects, list) or not projects:
        raise ValueError("select at least one TypeScript project")
    for name in projects:
        if (not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9._/-]+", name)
                or PurePosixPath(name).is_absolute() or ".." in PurePosixPath(name).parts):
            raise ValueError("TypeScript projects must be repository-relative paths")
        entry = inspect(root, name)
        if not entry or entry["kind"] != "file":
            raise ValueError(f"missing or linked TypeScript project: {name}")
        original_paths.append(name)
    data = ((root / settings_path).read_bytes()
            if existing and not args.typescript_project and not args.typescript_rollout
            else (json.dumps(settings, indent=2) + "\n").encode())
    payloads[settings_path] = data
    desired[settings_path] = file_entry(data)
    return settings["rollout"], {name: inspect(root, name) for name in original_paths}


def exclude_text(original, paths):
    """Replace only our block, preserving all unrelated ignore rules."""
    if (original.count(START) != original.count(END) or original.count(START) > 1
            or (START in original and original.index(START) > original.index(END))):
        raise ValueError("malformed repo-bootstrap block in Git info/exclude")
    if paths and START in original:
        # info/exclude is shared by linked worktrees. Another local installation
        # may own additional paths that are absent from this worktree's manifest.
        existing = original.split(START, 1)[1].split(END, 1)[0].splitlines()
        for line in existing:
            if not line:
                continue
            if not line.startswith("/") or not (allowed_path(line[1:]) or line[1:] == STATE):
                raise ValueError("unrecognized rule in repo-bootstrap exclusion block")
            paths = paths | {line[1:]}
    block = ""
    if paths:
        block = START + "\n" + "\n".join("/" + path for path in sorted(paths)) + "\n" + END + "\n"
    if START in original:
        before, rest = original.split(START, 1)
        _, after = rest.split(END, 1)
        if after.startswith("\n"):
            after = after[1:]
        return before + block + after
    return original + ("\n" if original and not original.endswith("\n") else "") + block


def atomic_file(path, data, executable=False):
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=".repo-bootstrap-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(data)
        os.chmod(temporary, 0o755 if executable else 0o644)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def check_visibility(root, paths, exclusions, mode):
    """Evaluate Git's real ignore precedence against the proposed exclude file."""
    if not paths:
        return
    with tempfile.TemporaryDirectory(prefix="repo-bootstrap-ignore-") as temporary:
        metadata = Path(temporary)
        git(metadata, "init", "--bare", "--quiet")
        (metadata / "info/exclude").write_text(exclusions)
        worktree = root
        if not worktree.exists():
            worktree = metadata / "preview"
            worktree.mkdir()
        command = ["--git-dir", str(metadata), "--work-tree", str(worktree)]
        # Preserve effective repository overrides as well as global defaults.
        for key in ("core.excludesFile", "core.ignoreCase"):
            value = git(root, "config", "--path" if key == "core.excludesFile" else "--get", key, check=False)
            if value.returncode == 0:
                command += ["-c", f"{key}={value.stdout.strip()}"]
        ignored = git(worktree, *command, "check-ignore", "--no-index", "--", *sorted(paths), check=False)
        if ignored.returncode not in (0, 1):
            raise ValueError(ignored.stderr.strip())
        ignored_paths = set(ignored.stdout.splitlines())
        if mode == "tracked" and ignored_paths:
            raise ValueError("tracked installation is ignored by existing Git rules:\n" + ignored.stdout
                             + "Adjust those rules explicitly or use --mode local.")
        if mode == "local" and paths - ignored_paths:
            raise ValueError("Git rules prevent local exclusion of:\n  " + "\n  ".join(sorted(paths - ignored_paths))
                             + "\nAdjust the conflicting negation rules explicitly; no files were installed.")


def metadata_directory(root):
    directory = Path(git(root, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip())
    if directory.is_symlink() or not directory.is_dir():
        raise ValueError(f"preserving linked or invalid Git metadata: {directory}")
    return directory


def install(args):
    requested = args.repo.expanduser().resolve()
    result = git(requested, "rev-parse", "--show-toplevel", check=False)
    initializing = result.returncode != 0
    if initializing:
        if (requested / ".git").exists() or (requested / ".git").is_symlink() or git(requested, "rev-parse", "--is-bare-repository", check=False).stdout.strip() == "true":
            raise ValueError("target has existing Git metadata but is not a working tree; inspect it before initialization")
        if not args.init:
            raise ValueError("target is not a Git working tree; use --init to create one")
        ancestor = requested.parent
        while not ancestor.exists() and ancestor != ancestor.parent:
            ancestor = ancestor.parent
        containing = git(ancestor, "rev-parse", "--show-toplevel", check=False)
        if containing.returncode == 0:
            raise ValueError(f"target is inside {containing.stdout.strip()}; refusing to initialize a nested repository")
        if requested.exists() and not requested.is_dir():
            raise ValueError(f"target is not a directory: {requested}")
        root = requested
    else:
        root = Path(result.stdout.strip()).resolve()
        if args.init and root != requested:
            raise ValueError(f"target is already inside {root}; refusing to initialize a nested repository")
    state, state_before = read_state(root)
    old_pins = state.get("skill_versions", {})
    if not old_pins and inspect(root, POLICY) is not None:
        snapshot = inspect(root, POLICY)
        if snapshot["kind"] == "file":
            try:
                old_policy = json.loads((root / POLICY).read_text())
                old_pins = old_policy.get("skills", {}) if isinstance(old_policy, dict) else {}
            except ValueError:
                old_pins = {}
    if not isinstance(old_pins, dict):
        raise ValueError("invalid installed skill version pins")
    if not all(name in SKILLS and isinstance(version, str) and VERSION_RE.fullmatch(version)
               for name, version in old_pins.items()):
        raise ValueError("invalid installed skill version pins")
    mode = args.mode or state.get("mode", "tracked")
    if mode == "shadow":
        mode = "local"
    if mode not in ("tracked", "local"):
        raise ValueError("invalid mode in manifest")
    selected = args.skills
    if selected is None:
        selected = ",".join(state.get("skills", DEFAULT_SKILLS))
    skills = set(selected.split(","))
    unknown = skills - set(SKILLS)
    if unknown:
        raise ValueError("unknown skills: " + ", ".join(sorted(unknown)))
    detect_enabled = args.detect_languages if args.detect_languages is not None else state.get("detect_languages", True)
    detection = detect_languages(root, state) if detect_enabled else {"languages": [], "skills": [], "evidence": {}}
    skills.update(detection["skills"])
    go_profile = args.go if args.go is not None else (
        bool(args.go_rollout) or state.get("go_profile", False) or (root / "go.mod").is_file())
    if go_profile:
        skills.add("go")
    typescript_profile = args.typescript if args.typescript is not None else (
        bool(args.typescript_rollout or args.typescript_project) or state.get("typescript_profile", False))
    if typescript_profile:
        skills.add("typescript")
    kind = args.kind or state.get("kind")
    skills = complete_skills(skills, bool(args.stage) and args.stage != state.get("stage"), kind if kind != state.get("kind") else None)
    if not skills <= set(SKILLS):
        raise ValueError("language detection selected unsupported skills")
    stage = args.stage or state.get("stage", "beta")
    if stage not in STAGES:
        raise ValueError(f"invalid lifecycle stage: {stage}")
    agent_selection = args.agents or state.get("agents", "both")
    agents = {"codex", "claude"} if agent_selection == "both" else {"codex"}
    template = args.pr_template or state.get("pr_template") or ("local" if mode == "local" else "github")
    if go_profile and args.go_rollout == "ratchet" and args.pr_template is None:
        template = "none"
    if typescript_profile and args.typescript_rollout == "ratchet" and args.pr_template is None:
        template = "none"
    desired, payloads = package(sorted(skills), agents, template, go_profile, typescript_profile)
    if skills:
        versions = read_versions(SOURCE / "ai/skills/source-code-versions.json")
        if args.policy_version and args.policy_version != versions["policy_version"]:
            raise ValueError(f"requested policy {args.policy_version}; this source ships {versions['policy_version']}")
        plans_version = json.loads((SOURCE / "ai/skills/source-code-lifecycle/references/stages.json").read_text())["policy_version"]
        if plans_version != versions["policy_version"]:
            raise ValueError("source policy version and lifecycle command-plan version disagree")
        languages = [name for name, active, entry in (
            ("go", go_profile, "scripts/check-go.sh"),
            ("typescript", typescript_profile, "scripts/check-typescript.mjs"))
            if active or entry in state["files"]]
        for name, active, entry, asset, needs_upgrade in (
            ("go", go_profile, "scripts/check-go.sh", "go/assets/check-go.sh", stage in {"research", "alpha"}),
            ("typescript", typescript_profile, "scripts/check-typescript.mjs", "typescript/assets/check-typescript.mjs", stage == "alpha")):
            if name in languages and not active and needs_upgrade:
                installed = inspect(root, entry)
                if not installed or installed.get("sha256") != digest((SOURCE / "ai/skills" / asset).read_bytes()):
                    raise ValueError(f"{stage} requires an updated {name} runner; rerun setup with --{name} or retain beta/full checks")
        retained_skills = {Path(path).parts[2] for path in state["files"]
                           if path.startswith(".agents/skills/") and path.endswith("/SKILL.md")}
        policy_changed = state.get("policy_version") is not None and state["policy_version"] != versions["policy_version"]
        retained_languages = [("go", go_profile, "scripts/check-go.sh"), ("typescript", typescript_profile, "scripts/check-typescript.mjs")]
        if policy_changed and (not retained_skills <= skills or any(path in state["files"] and not active for _, active, path in retained_languages)):
            raise ValueError("policy version changes require a complete upgrade of retained skills and language runtimes; rerun upgrade without a subset or language opt-outs")
        for name, active, path in retained_languages:
            if name in skills and path in state["files"] and not active and old_pins.get(name) != versions["skills"].get(name):
                raise ValueError(f"upgrading the {name} version requires updating its retained runtime; rerun with --{name}")
        if not skills <= set(versions["skills"]):
            raise ValueError("source version registry does not cover the selected skills")
        unknown_retained = retained_skills - skills - set(old_pins)
        if unknown_retained:
            raise ValueError("retained skills have no version pins; use source-code upgrade to version the complete installation")
        pins = {name: versions["skills"][name] if name in skills else old_pins[name]
                for name in sorted(skills | retained_skills)}
        required_kind_skills = {"source-code-lifecycle"} if kind is not None else set()
        if kind == "library":
            required_kind_skills.add("library-code-comments")
        if not required_kind_skills <= pins.keys():
            raise ValueError("project kind requires missing guidance; include the lifecycle and kind skills or run a complete upgrade")
        installed_versions = {**versions, "skills": pins}
        policy = {"schema_version": 1, "policy_version": versions["policy_version"], "stage": stage, "languages": languages, "skills": pins,
                  "detection": {"enabled": detect_enabled, **detection}}
        if kind is not None:
            policy["kind"] = kind
        resources = [
            (POLICY, (json.dumps(policy, indent=2) + "\n").encode()),
            (VERSIONS, (json.dumps(installed_versions, indent=2) + "\n").encode()),
            (GUIDANCE, project_guidance(policy).encode()),
        ]
        if "source-code-lifecycle" in skills:
            resources.append((LIFECYCLE_RUNNER, (SOURCE / "ai/skills/source-code-lifecycle/assets/check-source-code.py").read_bytes()))
        for path, data in resources:
            desired[path] = file_entry(data)
            payloads[path] = data
        if "claude" in agents:
            data = ("# Source-code project policy\n\nRead `AGENTS.override.md` in the repository root and follow its pinned project skills and lifecycle stage. Preserve existing repository instructions and gates.\n").encode()
            desired[HOST_RULE] = file_entry(data)
            payloads[HOST_RULE] = data
    ts_rollout, ts_snapshots = None, {}
    if typescript_profile:
        ts_rollout, ts_snapshots = typescript_configuration(root, args, desired, payloads)
    rollout, legacy, legacy_snapshot = None, None, None
    if go_profile:
        rollout, legacy, legacy_snapshot = go_configuration(root, state, args.go_rollout, desired, payloads)
    if template == "github":
        conflicts = template_conflicts(root)
        if conflicts:
            raise ValueError("existing PR template(s): " + ", ".join(conflicts)
                             + "; choose --pr-template local or none, or reconcile them manually")

    managed = dict(state["files"])
    if legacy:
        managed.pop(legacy, None)
    changes, snapshots, conflicts, skipped = [], dict(ts_snapshots), [], []
    if legacy_snapshot:
        snapshots[legacy_snapshot[0]] = legacy_snapshot[1]
    for relative, expected in sorted(desired.items()):
        actual = inspect(root, relative)
        snapshots[relative] = actual
        if actual == expected:
            managed[relative] = expected
            continue
        conflict = actual is not None and actual != managed.get(relative)
        if actual and actual["kind"] != expected["kind"]:
            conflict = True
        if conflict:
            owner = artifact_owner(relative)
            if owner and args.conflict == "skip":
                policy_changed = owner == "source-code-lifecycle" and state.get("policy_version") != versions["policy_version"]
                if old_pins.get(owner) != pins.get(owner) or policy_changed:
                    raise ValueError(f"cannot upgrade the {owner} version while skipping locally modified content at {relative}; reconcile it or use --conflict replace")
            if relative in {POLICY, GUIDANCE, VERSIONS, HOST_RULE} and args.conflict != "replace":
                label = "lifecycle policy" if relative == POLICY else "policy artifact"
                raise ValueError(f"preserving locally modified {label}: {root / relative}; reconcile it or use --conflict replace")
            if args.conflict == "skip":
                skipped.append(relative)
                continue
            # Never replace symlinks, even under --conflict replace.
            if args.conflict != "replace" or actual["kind"] == "link" or expected["kind"] == "link":
                conflicts.append(relative)
                continue
        changes.append((relative, expected, conflict))
        managed[relative] = expected
    if conflicts:
        raise ValueError("preserving existing or locally modified paths:\n  " + "\n  ".join(conflicts)
                         + "\nChoose --conflict skip, or --conflict replace to back up and replace regular files.")
    paths = set(managed) | {STATE}
    if go_profile and rollout == "ratchet":
        paths.add(GO_BASELINE)
    if typescript_profile:
        paths.add(TS_LOCK)
        if ts_rollout == "ratchet":
            paths.add(TS_BASELINE)
    visible_paths = paths | {legacy} if mode == "tracked" and legacy else paths
    tracked = set()
    if initializing:
        exclude = root / ".git/info/exclude"
        old_exclude = ""
    else:
        metadata = metadata_directory(root)
        exclude = metadata / "info/exclude"
        exclude_entry = inspect(metadata, "info/exclude")
        if exclude_entry and exclude_entry["kind"] != "file":
            raise ValueError(f"preserving linked or non-file Git exclude: {exclude}")
        old_exclude = exclude.read_text() if exclude.exists() else ""
        if any(replacing for _, _, replacing in changes):
            inspect(metadata, "repo-bootstrap/backups/.probe")
        tracked = set(git(root, "ls-files", "-z").stdout.split("\0"))
        if mode == "local" and paths & tracked:
            raise ValueError("local mode cannot hide tracked files: " + ", ".join(sorted(paths & tracked))
                             + "; keep tracked mode or explicitly remove them from the index first")
    relative_config = None
    if getattr(args, "config_path", None):
        try:
            relative_config = args.config_path.relative_to(root).as_posix()
        except ValueError:
            relative_config = None
    private_config = mode == "local" and relative_config is not None and relative_config not in tracked
    new_exclude = config_exclude_text(exclude_text(old_exclude, paths if mode == "local" else set()), relative_config, private_config)
    check_visibility(root, visible_paths if initializing or mode == "local" else visible_paths - tracked, new_exclude, mode)
    revision = git(SOURCE, "rev-parse", "HEAD", check=False).stdout.strip() or "unknown"
    new_state = {"version": 1, "mode": mode, "source_revision": revision,
                 "go_profile": go_profile, "files": managed}
    if skills:
        new_state.update(stage=stage, policy_version=versions["policy_version"], skills=sorted(pins), skill_versions=pins, agents=agent_selection, pr_template=template)
        if kind is not None:
            new_state["kind"] = kind
        new_state["detect_languages"] = detect_enabled
    elif "stage" in state:
        new_state.update(stage=state["stage"], policy_version=state["policy_version"])
    if go_profile:
        new_state.update(go_rollout=rollout, go_legacy=legacy)
    else:
        for name in ("go_rollout", "go_legacy"):
            if name in state:
                new_state[name] = state[name]
    if typescript_profile or "typescript_profile" in state:
        new_state["typescript_profile"] = typescript_profile
    state_data = (json.dumps(new_state, indent=2, sort_keys=True, ensure_ascii=False) + "\n").encode()
    state_changed = state_before != file_entry(state_data)

    print(f"source-code setup: {root} ({mode})")
    print("  Detected language guidance: " + (", ".join(detection["languages"]) or "none"))
    if getattr(args, "config_path", None):
        effective = {"mode": mode, "stage": stage, "policy_version": versions["policy_version"], "skills": sorted(skills), "agents": agent_selection,
                     "pr_template": template, "detect_languages": detect_enabled,
                     "checks": {"go": {"enabled": go_profile}, "typescript": {"enabled": typescript_profile}}}
        if go_profile:
            effective["checks"]["go"]["rollout"] = rollout
        if typescript_profile:
            effective["checks"]["typescript"].update(rollout=ts_rollout,
                projects=json.loads(payloads[".typescript-quality.json"])["projects"])
        if kind is not None:
            effective["kind"] = kind
        print("  Effective configuration: " + json.dumps(effective, sort_keys=True))
    if skills:
        previous = state.get("stage", "beta (legacy full checks)")
        print(f"  Lifecycle: {previous} -> {stage}; policy {versions['policy_version']}")
        if kind is not None:
            print(f"  Kind: {state.get('kind', 'unspecified')} -> {kind}")
        for name, version in pins.items():
            print(f"  Skill {name}: {old_pins.get(name, 'unversioned')} -> {version}")
        plans = json.loads((SOURCE / "ai/skills/source-code-lifecycle/references/stages.json").read_text())["stages"]
        for language in languages:
            before = plans[state.get("stage", "beta")][language]
            after = plans[stage][language]
            print(f"  {language} checks: {json.dumps(before)} -> {json.dumps(after)}")
    if go_profile:
        print(f"  Go rollout: {rollout}" + (f"; preserve {legacy}, merge into {GO_STRICT}" if legacy else ""))
    if typescript_profile:
        print(f"  TypeScript rollout: {ts_rollout}; preserve project configs and package dependencies")
    for relative, _, replacing in changes:
        print(f"  {'replace (backup)' if replacing else 'install/update'} {relative}")
    for relative in skipped:
        print(f"  skipped local content: {relative}")
    if new_exclude != old_exclude:
        print(f"  update local exclusions: {exclude}")
    if state_changed:
        print(f"  update {STATE}")
    if not changes and not state_changed and new_exclude == old_exclude:
        print("  already current")
    if args.dry_run:
        print("  preview only; no files changed")
        return

    if initializing:
        root.mkdir(parents=True, exist_ok=True)
        git(root, "init", "--quiet")
        metadata = metadata_directory(root)
        exclude_entry = inspect(metadata, "info/exclude")
        if exclude_entry and exclude_entry["kind"] != "file":
            raise ValueError(f"preserving linked Git exclude: {exclude}")
        # git init may supply a template's existing exclude file.
        old_exclude = exclude.read_text() if exclude.exists() else ""
        new_exclude = config_exclude_text(exclude_text(old_exclude, paths if mode == "local" else set()), relative_config, private_config)
        check_visibility(root, visible_paths, new_exclude, mode)
    for relative, before in snapshots.items():
        if inspect(root, relative) != before:
            raise ValueError(f"destination changed during planning; retry after reviewing: {relative}")
    if inspect(root, STATE) != state_before:
        raise ValueError("manifest changed during planning; retry after reviewing")
    if (exclude.read_text() if exclude.exists() else "") != old_exclude:
        raise ValueError("Git exclusions changed during planning; retry after reviewing")

    backup = None
    for relative, expected, replacing in changes:
        path = root / relative
        if replacing:
            if backup is None:
                inspect(metadata, "repo-bootstrap/backups/.probe")
                backup_root = metadata / "repo-bootstrap/backups"
                backup_root.mkdir(parents=True, exist_ok=True)
                backup = Path(tempfile.mkdtemp(prefix="replace-", dir=backup_root))
                print(f"  preserving replaced files in {backup}")
            atomic_file(backup / relative, path.read_bytes(), bool(path.stat().st_mode & 0o111))
        path.parent.mkdir(parents=True, exist_ok=True)
        if expected["kind"] == "link":
            path.symlink_to(expected["target"], target_is_directory=True)
        else:
            atomic_file(path, payloads[relative], expected["executable"])
    if new_exclude != old_exclude:
        atomic_file(exclude, new_exclude.encode())
    if state_changed:
        atomic_file(root / STATE, state_data)
    print("  installed; no files staged, committed, or published")
    if go_profile and rollout == "ratchet" and not (root / GO_BASELINE).exists():
        print("  next: bash scripts/check-go.sh baseline (one-time adoption, committed Go source only)")
    if typescript_profile:
        print("  next: node scripts/check-typescript.mjs tools (explicit dependency installation)")
        if ts_rollout == "ratchet" and not (root / TS_BASELINE).exists():
            print("  then: node scripts/check-typescript.mjs baseline (committed TypeScript source only)")


def prepare_upgrade(args):
    if args.init:
        raise ValueError("upgrade requires an existing installation; use setup --init for a new project")
    root = Path(git(args.repo.expanduser().resolve(), "rev-parse", "--show-toplevel").stdout.strip())
    state, snapshot = read_state(root)
    if snapshot is None:
        raise ValueError("no source-code installation manifest; use source-code setup first")
    if args.skills is None:
        saved = state.get("skills") or sorted({Path(path).parts[2] for path in state["files"]
                                              if path.startswith(".agents/skills/") and path.endswith("/SKILL.md")})
        if not saved:
            raise ValueError("installation has no recorded skills; select them explicitly with --skills")
        args.skills = ",".join(saved)
    if args.agents is None:
        args.agents = state.get("agents") or ("both" if any(path.startswith(".claude/skills/") for path in state["files"]) else "codex")
    if args.pr_template is None:
        args.pr_template = state.get("pr_template") or (
            "github" if ".github/pull_request_template.md" in state["files"] else
            "local" if ".agents/templates/pull_request_template.md" in state["files"] else "none")
    if args.go is None:
        args.go = bool(args.go_rollout) or state.get("go_profile", False)
    if args.typescript is None:
        args.typescript = bool(args.typescript_rollout or args.typescript_project) or state.get("typescript_profile", False)
    skills = set(args.skills.split(","))
    detect_enabled = args.detect_languages if args.detect_languages is not None else state.get("detect_languages", True)
    if detect_enabled:
        skills.update(detect_languages(root, state)["skills"])
    if args.go:
        skills.add("go")
    if args.typescript:
        skills.add("typescript")
    kind = args.kind or state.get("kind")
    skills = complete_skills(skills, bool(args.stage) and args.stage != state.get("stage"), kind if kind != state.get("kind") else None)
    if not skills <= set(SKILLS):
        raise ValueError("upgrade selected an unknown skill")
    available = read_versions(SOURCE / "ai/skills/source-code-versions.json")
    pins = state.get("skill_versions", {})
    for name in skills:
        if name not in available["skills"]:
            raise ValueError(f"source registry has no version for {name}")
        if name in pins and version_key(available["skills"][name]) < version_key(pins[name]):
            raise ValueError(f"upgrade would downgrade {name} from {pins[name]} to {available['skills'][name]}; use a newer source checkout")
    if state.get("policy_version") and version_key(available["policy_version"]) < version_key(state["policy_version"]):
        raise ValueError("upgrade would downgrade the installed policy; use a newer source checkout")
    findings = skill_findings([SOURCE / "ai/skills" / name for name in sorted(skills)])
    errors = [f"{item['path']}: {message}" for item in findings for message in item["errors"]]
    warnings = [f"{item['path']}: {message}" for item in findings for message in item["warnings"]]
    if errors or args.strict and warnings:
        raise ValueError("upgrade source validation failed:\n" + "\n".join(errors + warnings))
    for message in warnings:
        print(f"WARNING: {message}")
    print(f"Validated {len(findings)} source skill packages before upgrade")


def skill_findings(folders):
    helper = SOURCE / "ai/skills/skill-authoring/scripts/validate.py"
    command = [sys.executable, str(helper)]
    if importlib.util.find_spec("yaml") is None:
        uv = shutil.which("uv")
        if not uv:
            raise ValueError("skill validation requires PyYAML or uv; dotfiles bootstrap provides uv")
        command = [uv, "run", "--script", str(helper)]
    result = subprocess.run([*command, "--json", *map(str, folders)], capture_output=True, text=True)
    try:
        findings = json.loads(result.stdout)
    except ValueError as error:
        raise ValueError(result.stderr.strip() or "skill validator did not return findings") from error
    if result.returncode and not any(item["errors"] for item in findings):
        raise ValueError(result.stderr.strip() or "skill validator failed")
    return findings


def validate_project(args):
    root = args.repo.expanduser().resolve()
    if args.skills_dir:
        directory = args.skills_dir.expanduser().resolve()
    else:
        found = git(root, "rev-parse", "--show-toplevel", check=False)
        if found.returncode == 0:
            root = Path(found.stdout.strip()).resolve()
        elif not getattr(args, "config_path", None):
            raise ValueError(found.stderr.strip() or "target is not a Git working tree")
        directory = root / ".agents/skills"
    if not directory.is_dir():
        if not args.skills_dir and getattr(args, "config_path", None) and inspect(root, STATE) is None:
            print("Validated TOML configuration only; no source-code installation exists (installed packages not checked)")
            return 0
        raise ValueError(f"no skill directory: {directory}")
    folders = [directory] if (directory / "SKILL.md").is_file() else sorted(
        path for path in directory.iterdir() if path.is_dir() and not path.name.startswith(".") and path.name != "__pycache__")
    if not folders:
        raise ValueError(f"no SKILL.md packages found: {directory}")
    findings = skill_findings(folders)
    errors, warnings = [], []
    for finding in findings:
        errors.extend(f"{finding['path']}: {message}" for message in finding["errors"])
        warnings.extend(f"{finding['path']}: {message}" for message in finding["warnings"])
    if not args.skills_dir:
        state, snapshot = read_state(root)
        if snapshot is not None:
            warnings.extend(configuration_drift(args, state, root))
        if snapshot is None:
            warnings.append("no installation manifest; only skill structure was checked")
        else:
            for path, expected in state["files"].items():
                actual = inspect(root, path)
                if actual is None:
                    errors.append(f"missing installed file: {path}")
                elif actual["kind"] != expected["kind"] or expected["kind"] == "link" and actual != expected:
                    errors.append(f"installed path kind or link target differs from its manifest: {path}")
                elif actual != expected:
                    warnings.append(f"locally customized installed file: {path}")
            try:
                if not (root / POLICY).is_file() or not (root / VERSIONS).is_file():
                    raise ValueError("installation predates version pins; run source-code upgrade")
                policy = json.loads((root / POLICY).read_text())
                versions = read_versions(root / VERSIONS)
                if not isinstance(policy, dict) or type(policy.get("schema_version")) is not int or policy["schema_version"] != 1 or policy.get("stage") not in STAGES:
                    raise ValueError("invalid lifecycle policy schema or stage")
                if "kind" in policy and policy["kind"] not in KINDS:
                    raise ValueError("invalid installed project kind")
                if policy.get("kind") != state.get("kind"):
                    raise ValueError("policy kind and install manifest disagree")
                if policy.get("kind") is not None and "source-code-lifecycle" not in policy.get("skills", {}):
                    raise ValueError("project kind requires installed lifecycle guidance")
                if policy.get("kind") == "library" and "library-code-comments" not in policy.get("skills", {}):
                    raise ValueError("library kind requires caller documentation guidance")
                if policy.get("policy_version") != versions["policy_version"]:
                    raise ValueError("policy pin and installed version registry disagree")
                supported = read_versions(SOURCE / "ai/skills/source-code-versions.json")["policy_version"]
                if policy["policy_version"] != supported:
                    raise ValueError(f"validator supports policy {supported}; use the source-code version matching the installed policy")
                pins = policy.get("skills")
                if not isinstance(pins, dict) or not pins:
                    raise ValueError("missing skill version pins; run source-code upgrade")
                managed = {Path(path).parts[2] for path in state["files"]
                           if path.startswith(".agents/skills/") and path.endswith("/SKILL.md")}
                if set(pins) != managed:
                    raise ValueError("skill version pins and installed manifest disagree")
                if state.get("skill_versions") != pins:
                    raise ValueError("skill version pins and install manifest disagree")
                expected_languages = {name for name, path in (("go", "scripts/check-go.sh"), ("typescript", "scripts/check-typescript.mjs")) if path in state["files"]}
                if not isinstance(policy.get("languages"), list) or sorted(policy["languages"]) != sorted(expected_languages):
                    raise ValueError("installed languages and lifecycle policy disagree")
                for name, version in pins.items():
                    if versions["skills"].get(name) != version:
                        raise ValueError(f"{name}: pin {version} differs from installed release registry")
                if (root / GUIDANCE).read_text() != project_guidance(policy):
                    raise ValueError(f"{GUIDANCE} is stale or customized; reconcile with setup or upgrade")
                if state.get("stage") != policy["stage"] or state.get("policy_version") != policy["policy_version"]:
                    raise ValueError("policy stage/version and install manifest disagree")
                print(f"Policy {policy['policy_version']}; stage {policy['stage']}; {len(pins)} pinned skills")
                print(f"Instructions: {GUIDANCE} loads existing AGENTS.md and the pinned project skills")
            except (OSError, ValueError, TypeError, KeyError) as error:
                errors.append(str(error))
    for message in errors:
        print(f"ERROR: {message}", file=sys.stderr)
    for message in warnings:
        print(f"WARNING: {message}")
    print(f"Validated {len(folders)} skill packages: {len(errors)} errors, {len(warnings)} warnings (structural checks; behavior not evaluated)")
    return int(bool(errors) or bool(args.strict and warnings))


def main():
    command = argparse.ArgumentParser(description="Manage source-code standards and repository setup.")
    subcommands = command.add_subparsers(dest="command", required=True)
    parser = subcommands.add_parser("setup", help="install or update repository guidance and checks", description=__doc__)
    upgrade_parser = subcommands.add_parser("upgrade", help="update an existing installation to this source's versions")
    validation_parser = subcommands.add_parser("validate", help="check skill best practices, version pins, and installed integrity")
    validation_parser.add_argument("--repo", type=Path, default=Path.cwd())
    validation_parser.add_argument("--config", type=Path, help="authored TOML configuration (relative to invocation directory)")
    validation_parser.add_argument("--skills-dir", type=Path, help="check a skill or skill tree without requiring an installation")
    validation_parser.add_argument("--strict", action="store_true", help="treat best-practice and customization warnings as failures")
    detection_parser = subcommands.add_parser("detect", help="inspect language evidence without installing guidance or checks")
    detection_parser.add_argument("--repo", type=Path, default=Path.cwd())
    detection_parser.add_argument("--json", action="store_true")
    add_install_arguments(parser)
    add_install_arguments(upgrade_parser)
    upgrade_parser.add_argument("--strict", action="store_true", help="reject best-practice warnings in the upgrade source")
    args = command.parse_args()
    try:
        if args.command != "detect":
            load_configuration(args)
        if args.command == "validate":
            command.exit(validate_project(args))
        if args.command == "detect":
            requested = args.repo.expanduser().resolve()
            found = git(requested, "rev-parse", "--show-toplevel", check=False)
            root = Path(found.stdout.strip()) if found.returncode == 0 else requested
            if not root.is_dir():
                raise ValueError(f"project directory does not exist: {root}")
            detection = detect_languages(root)
            if args.json:
                print(json.dumps(detection, indent=2))
            else:
                for language, paths in detection["evidence"].items():
                    print(f"{language}: {', '.join(json.dumps(path, ensure_ascii=False) for path in paths)}")
                if not detection["languages"]:
                    print("No supported language evidence found")
            command.exit(0)
        if args.command == "upgrade":
            prepare_upgrade(args)
        install(args)
    except (OSError, ValueError) as error:
        suffix = "" if args.command in {"validate", "detect"} else "No existing conflicts were overwritten without explicit replacement. If an I/O error interrupted installation, inspect the reported paths before retrying.\n"
        command.exit(1, f"source-code {args.command}: {error}\n{suffix}")


def add_install_arguments(parser):
    parser.add_argument("--repo", type=Path, default=Path.cwd(), help="repository path (default: current directory)")
    parser.add_argument("--config", type=Path, help="authored TOML configuration (default: source-code.toml at repository root; explicit relative paths use invocation directory)")
    parser.add_argument("--init", action="store_true", help="create a Git repository if the target is not one")
    parser.add_argument("--mode", choices=("tracked", "local", "shadow"), help="shareable files or local Git exclusions; shadow aliases local (default: previous mode, else tracked)")
    parser.add_argument("--skills", help="comma-separated skill names (default: saved selection, else core and PR writer): " + ", ".join(SKILLS))
    parser.add_argument("--go", action=argparse.BooleanOptionalAction, default=None,
                        help="install Go correctness checks (default: root go.mod or previously installed); --no-go keeps existing checks")
    parser.add_argument("--go-rollout", choices=("strict", "ratchet"),
                        help="whole-project strictness or grandfather existing findings (default: ratchet for existing code/config)")
    parser.add_argument("--go-retrofit", dest="go_rollout", action="store_const", const="ratchet",
                        help="prepare merged Go policy and a one-time shrinking baseline")
    parser.add_argument("--typescript", action=argparse.BooleanOptionalAction, default=None,
                        help="install TypeScript correctness checks (opt-in, retained on subsequent runs)")
    parser.add_argument("--typescript-rollout", choices=("strict", "ratchet"),
                        help="strict new projects or a shrinking legacy diagnostic baseline")
    parser.add_argument("--typescript-retrofit", dest="typescript_rollout", action="store_const", const="ratchet",
                        help="preserve TypeScript project policy and prepare a shrinking baseline")
    parser.add_argument("--typescript-project", action="append", metavar="TSCONFIG",
                        help="repository-relative leaf tsconfig (repeat for multiple projects)")
    parser.add_argument("--agents", choices=("codex", "both"), help="Codex skills only, or add Claude aliases (default: saved selection, else both)")
    parser.add_argument("--pr-template", choices=("github", "local", "none"), help="GitHub default, local drafting template, or omit (default follows mode)")
    parser.add_argument("--conflict", choices=("fail", "skip", "replace"), default="fail", help="existing/edited file policy; replace saves backups, never replaces symlinks")
    parser.add_argument("--dry-run", action="store_true", help="show the complete plan without writes")
    parser.add_argument("--kind", choices=KINDS, help="software usage kind (default: saved kind, else unspecified; never inferred)")
    parser.add_argument("--stage", choices=STAGES, help="lifecycle assurance level (default: previous stage, else beta/full checks)")
    parser.add_argument("--policy-version", help="require the policy version shipped by this installed source; no implicit version fetching")
    parser.add_argument("--detect-languages", action=argparse.BooleanOptionalAction, default=None, help="select matching language guidance (default: saved choice, else enabled); check profiles remain explicit")


if __name__ == "__main__":
    main()
