#!/bin/bash
set -euo pipefail

source_path=${BASH_SOURCE[0]}
while [ -L "$source_path" ]; do
    source_dir=$(cd -P -- "$(/usr/bin/dirname "$source_path")" && pwd)
    source_path=$(/usr/bin/readlink "$source_path")
    case "$source_path" in
        /*) ;;
        *) source_path=$source_dir/$source_path ;;
    esac
done
checkout=$(cd -P -- "$(/usr/bin/dirname "$source_path")/.." && pwd)
binary=$checkout/zellij/target/release/lane-zellij

fail() {
    printf 'zellij-image-hints: %s\n' "$1" >&2
    if [[ -t 0 && -t 1 ]]; then
        printf '\033[H\033]8;;dotfiles-hints-error\033\\Image preview update failed. Press Enter to close.\033]8;;\033\\\r'
        IFS= read -r _ || true
    fi
    exit 1
}

inputs=(
    "$checkout/zellij/Cargo.toml"
    "$checkout/zellij/Cargo.lock"
    "$checkout/zellij/cli/Cargo.toml"
    "$checkout/zellij/cli/src"
    "$checkout/zellij/protocol/Cargo.toml"
    "$checkout/zellij/protocol/src"
    "$checkout/scripts/build-zellij-helpers.sh"
    "$source_path"
)
rebuild=true
if [[ -x "$binary" ]]; then
    checked=$checkout/zellij/target/release/.lane-zellij-build-checked
    [[ -f "$checked" ]] || checked=$binary
    # Cargo can reuse the binary after a deletion, so compare to its last successful check.
    newer=$(/usr/bin/find "${inputs[@]}" -newer "$checked" -print -quit) ||
        fail "Cannot inspect the helper sources."
    [[ -n "$newer" ]] || rebuild=false
fi
if "$rebuild"; then
    command -v cargo >/dev/null 2>&1 || fail "Cargo is required to update this helper. Install Rust, then run make zellij-helpers."
    if [[ -t 0 && -t 1 ]]; then
        # Keep the cursor marker visible while Cargo runs so Kitty can wait for the build.
        printf '\033[H\033]8;;dotfiles-hints-building\033\\Updating the Zellij image helper...\033]8;;\033\\\r'
        build_log=$(/usr/bin/mktemp "${TMPDIR:-/tmp}/zellij-helper-build.XXXXXX") ||
            fail "Cannot create a temporary build log."
        if ! /bin/bash "$checkout/scripts/build-zellij-helpers.sh" >"$build_log" 2>&1; then
            /bin/cat "$build_log" >&2 || true
            /bin/rm -f "$build_log" || true
            fail "Helper build failed; the previous binary was not run."
        fi
        /bin/rm -f "$build_log" || true
    else
        printf 'zellij-image-hints: updating the native helper...\n' >&2
        /bin/bash "$checkout/scripts/build-zellij-helpers.sh" >&2 ||
            fail "Helper build failed; the previous binary was not run."
    fi
    [[ -x "$binary" ]] || fail "The build did not produce an executable helper."
fi

exec "$binary" image-hints "$@"
