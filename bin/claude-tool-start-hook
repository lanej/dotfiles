#!/usr/bin/env python3
"""Claude Code PreToolUse hook: color tmux window while a tool runs (amber), or
flag it distinctly when a plan is up for approval (ExitPlanMode)."""

import json
import os
import subprocess
import sys


def main():
    pane = os.environ.get('TMUX_PANE', '')
    if not pane or not os.environ.get('TMUX'):
        sys.exit(0)

    try:
        input_data = json.load(sys.stdin)
    except Exception:
        sys.exit(0)

    state = 'plan' if input_data.get('tool_name') == 'ExitPlanMode' else 'tool'

    try:
        subprocess.run(['tmux', 'set-option', '-w', '-t', pane, '@claude-state', state], check=False)
        subprocess.run(['tmux', 'refresh-client', '-S'], check=False)
    except Exception:
        pass


if __name__ == '__main__':
    main()
