#!/usr/bin/env python3
"""Report the nearest live multiplexer in the caller's process ancestry.

`provider` prints zellij, tmux, or none. Inspection failures exit nonzero;
inherited environment variables never establish which multiplexer owns a pane.
"""

import argparse
import os
from pathlib import Path
import subprocess
import sys


def provider():
    column = "ucomm" if sys.platform == "darwin" else "comm"
    result = subprocess.run(
        ["ps", "-axo", "pid=,ppid=," + column + "="],
        env={**os.environ, "LC_ALL": "C"}, capture_output=True, text=True,
        check=True, timeout=0.5,
    )
    processes = {}
    for line in result.stdout.splitlines():
        fields = line.split(None, 2)
        if len(fields) == 3 and fields[0].isdecimal() and fields[1].isdecimal():
            processes[int(fields[0])] = (int(fields[1]), Path(fields[2].strip()).name)
    pid = os.getppid()
    visited = set()
    while pid > 1 and len(visited) < 64:
        if pid in visited or pid not in processes:
            raise RuntimeError("Cannot establish the caller's process ancestry")
        visited.add(pid)
        parent, name = processes[pid]
        if name == "zellij":
            return "zellij"
        if name == "tmux" or name.startswith("tmux:"):
            return "tmux"
        pid = parent
    if pid > 1:
        raise RuntimeError("Multiplexer ancestry exceeds the inspection limit")
    return "none"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("query", choices=("provider",))
    parser.parse_args()
    print(provider())


if __name__ == "__main__":
    try:
        main()
    except (OSError, subprocess.SubprocessError, RuntimeError) as error:
        print(f"zellij-context: {error}", file=sys.stderr)
        sys.exit(1)
