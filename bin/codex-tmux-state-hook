#!/usr/bin/env python3
"""Feed Codex lifecycle events into the shared Claude/tmux status palette."""
import json
import os
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path

state = SourceFileLoader(
    "tmux_claude_state", str(Path(__file__).with_name("tmux-claude-state"))).load_module()

QUESTIONS = {"request_user_input", "request_user_input_async"}
WAITING_TOOL = "@codex-waiting-tool"
WAITING_ID = "@codex-waiting-id"


def resolve(event, current, waiting_tool, waiting_id):
    kind = event.get("hook_event_name", "")
    tool = event.get("tool_name", "")
    if kind == "SessionStart":
        # Automatic compaction also emits SessionStart, during a running turn.
        return None if event.get("source") == "compact" else "idle"
    if kind == "UserPromptSubmit":
        return "thinking"
    if kind == "PreToolUse":
        return "question" if tool.rsplit(".", 1)[-1] in QUESTIONS else "tool"
    if kind == "PermissionRequest":
        return "approval"
    if kind == "PostToolUse":
        # Only acknowledge the call that was waiting. Ordinary tool completions
        # leave the busy tab steady, like Claude's unwired PostToolUse.
        if (current in ("approval", "question") and tool == waiting_tool
                and (not waiting_id or event.get("tool_use_id") == waiting_id)):
            return "thinking"
        return None
    if kind == "Stop":
        return "plan" if event.get("permission_mode") == "plan" else "idle"
    if kind == "Interrupt":
        return "idle"
    if kind == "SessionEnd":
        return ""
    return None


def bell(pane):
    """Ring the originating pane, including when another window is focused."""
    tty = state.tmux("display-message", "-p", "-t", pane, "#{pane_tty}")
    if tty:
        try:
            with open(tty, "wb", buffering=0) as terminal:
                terminal.write(b"\a")
        except OSError:
            pass


def main():
    pane = os.environ.get("TMUX_PANE", "")
    if not pane or not os.environ.get("TMUX"):
        return 0
    try:
        event = json.load(sys.stdin)
    except (ValueError, OSError):
        return 0
    if not isinstance(event, dict):
        return 0

    context = state.tmux(
        "display-message", "-p", "-t", pane,
        "#{@codex-session-id}|#{@claude-state}|#{@codex-waiting-tool}|#{@codex-waiting-id}")
    if not context:
        return 0
    owner, current, waiting_tool, waiting_id = context.split("|", 3)
    kind = event.get("hook_event_name", "")
    session = event.get("session_id", "")
    if kind == "SessionStart" and session:
        state.tmux("set-option", "-p", "-t", pane, "@codex-session-id", session)
    elif owner and session != owner:
        return 0  # An old session or a subagent must not clear this session's tab.

    name = resolve(event, current, waiting_tool, waiting_id)
    if name is None:
        return 0
    values = state.style(name) if name else {option: "" for option in state.OPTIONS}
    waiting = name in ("approval", "question")
    values[WAITING_TOOL] = event.get("tool_name", "") if waiting else ""
    values[WAITING_ID] = event.get("tool_use_id", "") if waiting else ""
    state.write(pane, values)
    if kind == "SessionEnd":
        state.tmux("set-option", "-p", "-u", "-t", pane, "@codex-session-id")
    elif waiting or kind == "Stop":
        bell(pane)
    return 0


if __name__ == "__main__":
    sys.exit(main())
