#!/bin/sh
# Timestamp and enqueue cosmetic status updates; never wait for tmux.
broker="${AGENT_STATUS_BIN:-$HOME/.local/lib/agent-status/agent-status-broker}"
[ -x "$broker" ] || exit 0
tmux_context="${TMUX:-}"
tmux_socket="${tmux_context%,*,*}"
exec "$broker" send --tmux-socket "$tmux_socket" --pane "${TMUX_PANE:-}"
