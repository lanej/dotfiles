---
import catalog from '../../../design-system/catalog.json';
import theme from '../../../design-system/generated/colors.json';
import integrations from '../../../design-system/integrations.json';
import tokens from '../../../design-system/generated/tokens.json';
const sourceURL = (path: string) => `https://github.com/lanej/dotfiles/blob/master/${path}`;
const levels = ['foundation', 'atom', 'molecule', 'organism', 'template', 'interface'];
const tokenGroups = [
  ['emphasis.heading', 'Heading emphasis'], ['emphasis.git.file.', 'Git file emphasis'], ['space.', 'Terminal spacing'],
  ['symbol.separator.', 'Separators'], ['symbol.git.file.', 'Git file status'],
  ['symbol.git.hunk.', 'Git unstaged hunks'], ['symbol.git.staged_hunk.', 'Git staged hunks'],
  ['symbol.git.branch_hunk.', 'Git branch comparison'],
];
const display = (value: unknown) => value === '' ? '(empty)' : JSON.stringify(value);
const gitGroups = [['git.file.', 'File status · Starship'], ['git.hunk.', 'Unstaged hunks · Neovim'], ['git.staged_hunk.', 'Staged hunks · Neovim'], ['git.branch_hunk.', 'Branch comparison · Neovim']];
const componentTarget = (name: string) => name.includes('.git.') ? `#git-style-${name.replace(/^(symbol|emphasis)\./, '').replace(/\.(bold|dim)$/, '').replaceAll('.', '-')}` : '#component-heading';
---

<section aria-labelledby="theme-roles">
  <h2 id="theme-roles">Resolved theme roles</h2>
  <p>Resolved from the currently generated preset: <strong>{theme.theme}</strong>. <a href="#presets">Preset references</a> own their palettes and native examples.</p>
  <div class="role-grid">
    {Object.entries(theme.roles).map(([name, color]) => (
      <div class="role" id={`role-${name.replaceAll('.', '-')}`}><span class="swatch" style={{ backgroundColor: color }} aria-hidden="true"></span><code>{name}</code><span>{color}</span></div>
    ))}
  </div>
</section>

<section aria-labelledby="presentation-tokens">
  <h2 id="presentation-tokens">Presentation tokens</h2>
  <p>Inspect defaults, selected preset overrides and direct consumers. File status icons and gutter signs retain their own meanings. Native adapters own units and supported mappings.</p>
  <p>Git counts, styles and ahead/behind composition stay in Starship’s native adapter. The bundled font previews default symbols; Unicode values identify variants requiring other glyphs.</p>
  {tokenGroups.map(([prefix, title]) => (
    <details class="component token-group">
      <summary>{title}</summary>
      <div class="token-grid">
      {Object.entries(tokens.presentation).filter(([name]) => name.startsWith(prefix)).map(([name, token]) => (
        <article class="token" id={`token-${name.replaceAll('.', '-')}`}>
          <h3><code>{name}</code></h3>
          <dl>
            <dt>Type</dt><dd>{token.type}{'unit' in token ? ` · ${token.unit}` : ''}</dd>
            <dt>Default</dt><dd><code class="token-value">{display(token.value)}</code></dd>
            <dt>Override</dt><dd><code>{token.override === null ? 'None' : display(token.override)}</code></dd>
            <dt>Resolved</dt><dd><code class="token-value">{display(token.resolved)}</code></dd>
          </dl>
          {typeof token.resolved === 'string' && token.resolved !== '' && <p class="codepoints">{Array.from(token.resolved).map(c => `U+${c.codePointAt(0)!.toString(16).toUpperCase().padStart(4, '0')}`).join(' ')}</p>}
          <p>Consumers: {token.consumers.map((consumer, i) => <>{i > 0 ? ', ' : ''}<a href={consumer === 'components' ? componentTarget(name) : `#integration-${consumer}`}>{consumer}</a></>)}</p>
          {'note' in token && <p>{token.note}</p>}
        </article>
      ))}
      </div>
    </details>
  ))}
</section>

<section aria-labelledby="git-state-components">
  <h2 id="git-state-components">Git status components</h2>
  <p>A Git-state component combines a symbol, semantic foreground and supported emphasis. File status and gutter signs retain distinct meanings. Previews use the selected preset’s surface; the native terminal controls its exact dimming.</p>
  {gitGroups.map(([prefix, title]) => (
    <details class="component">
      <summary>{title}</summary>
      <div class="git-states">
    {Object.entries(tokens.git_states).filter(([name]) => name.startsWith(prefix)).map(([name, state]) => (
      <article id={`git-style-${name.replaceAll('.', '-')}`}>
        <h3><code>{name}</code></h3>
        <span class="git-preview" style={{ backgroundColor: theme.roles.surface }}>
          <span class="token-value" style={{ color: state.fg, fontWeight: state.bold ? 'bold' : 'normal', opacity: state.dim ? '.5' : '1' }}>{state.symbol || '1'}</span>
        </span>
        <p><a href={`#role-${state.color_role.slice(1).replaceAll('.', '-')}`}><code>{state.color_role}</code></a> · <code>{state.fg}</code></p>
        <p>{state.bold ? 'Bold' : 'Normal weight'} · {state.dim ? 'Dimmed' : 'Full intensity'}{state.symbol === '' ? ' · Count only' : ''}</p>
        <p>Consumer: <a href={`#integration-${state.consumer}`}>{state.consumer}</a></p>
      </article>
    ))}
      </div>
    </details>
  ))}
</section>

<section aria-labelledby="atomic-catalog">
  <h2 id="atomic-catalog">Atomic catalog</h2>
  <p>Follow a component into its building blocks or into the interfaces that use it. Code remains organized by capability.</p>
  {levels.map(level => (
    <section aria-label={level}>
      <h3>{level.charAt(0).toUpperCase() + level.slice(1)}s</h3>
      {catalog.filter(item => item.level === level).map(item => (
        <details class="component">
          <summary>{item.id} <span>{item.description}</span></summary>
          <article id={`component-${item.id}`}>
          <h4>{item.id}</h4>
          <p>{item.description}</p>
          {item.composes.length > 0 && <p>Composes: {item.composes.map((id, i) => <><a href={`#component-${id}`}>{id}</a>{i < item.composes.length - 1 ? ', ' : ''}</>)}</p>}
          <dl>{Object.entries(item.implementations).map(([host, mapping]) => <><dt>{host}</dt><dd>{mapping}</dd></>)}</dl>
          <p>Used by: {catalog.filter(consumer => consumer.composes.includes(item.id)).length ? catalog.filter(consumer => consumer.composes.includes(item.id)).map((consumer, i) => <>{i > 0 ? ', ' : ''}<a href={`#component-${consumer.id}`}>{consumer.id}</a></>) : 'Complete interface'}</p>
          <p class="sources">Source: {item.sources.map((path, i) => <>{i > 0 ? ' · ' : ''}<a href={sourceURL(path)}>{path}</a></>)}</p>
          </article>
        </details>
      ))}
    </section>
  ))}
</section>

<section aria-labelledby="integration-boundaries">
  <h2 id="integration-boundaries">Integration boundaries</h2>
  <p>Mapped settings are distinct from exercised application behavior. Coverage statements describe local verification; Linux runs are configured in CI and require an actual successful run.</p>
  {integrations.map(item => (
    <details class="component" open={item.id === 'external-color-owners'}>
      <summary>{item.id} <span>{item.mechanism}</span></summary>
      <article id={`integration-${item.id}`}>
      <h3>{item.id}</h3>
      <dl><dt>Color owner</dt><dd>{item.owner}</dd><dt>Mechanism</dt><dd>{item.mechanism}</dd><dt>Reload</dt><dd>{item.reload}</dd><dt>Coverage and gaps</dt><dd>{item.coverage}</dd></dl>
      <p class="sources">Source: {item.sources.map((path, i) => <>{i > 0 ? ' · ' : ''}<a href={sourceURL(path)}>{path}</a></>)}</p>
      </article>
    </details>
  ))}
</section>

<style>
  @font-face { font-family: 'Dotfiles Symbols'; src: url('../../../docs/design-system/symbols.woff2') format('woff2'); font-display: swap; }
  .role-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: .5rem 1.5rem; }
  .role { display: grid; grid-template-columns: 1.25rem 1fr auto; gap: .5rem; align-items: center; min-width: 0; font-size: .875rem; }
  .role code { overflow-wrap: anywhere; }
  .swatch { width: 1.25rem; height: 1.25rem; border: 1px solid var(--sl-color-gray-3); }
  .component { border-top: 1px solid var(--sl-color-gray-5); padding-block: .75rem; }
  summary { cursor: pointer; font-weight: 600; }
  summary span { display: block; font-weight: 400; margin-top: .25rem; }
  .component h4, .component h3 { margin-top: .5rem; }
  .component p { margin-top: .5rem; }
  dl { display: grid; grid-template-columns: minmax(5rem, 7rem) minmax(0, 1fr); gap: .4rem 1rem; margin-block: .75rem; }
  dt { font-weight: 600; }
  dd { margin: 0; }
  .sources { font-size: .875rem; overflow-wrap: anywhere; }
  .token-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: .5rem 1.5rem; }
  .token { margin: 0; min-width: 0; border-bottom: 1px solid var(--sl-color-gray-5); padding-block: .75rem; }
  .token code { overflow-wrap: anywhere; }
  .token h3 { font-size: 1rem; }
  .token dl { grid-template-columns: 5rem minmax(0, 1fr); row-gap: .2rem; margin-block: .5rem; }
  .token dl :is(dt, dd) { margin: 0; }
  .token-value { font-family: 'Dotfiles Symbols', monospace; }
  .codepoints { font-size: .875rem; overflow-wrap: anywhere; }
  .git-states { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr)); gap: .75rem 1.5rem; }
  .git-states article { margin: 0; border-bottom: 1px solid var(--sl-color-gray-5); padding-block: .5rem; min-width: 0; }
  .git-states code { overflow-wrap: anywhere; }
  .git-states h3 { font-size: 1rem; }
  .git-preview { display: inline-block; min-width: 2.5rem; padding: .25rem .5rem; text-align: center; }
</style>
