---
import { Icon } from '@astrojs/starlight/components';

const paths = {
  setup: 'M4 7h16M4 17h16M8 4v6M16 14v6',
  terminal: 'M4 5h16v14H4zM8 9l3 3-3 3M13 15h3',
  files: 'M3 7V5h7l2 2h9v13H3zM3 10h18',
  stack: 'M3 7l9-4 9 4-9 4zM3 12l9 4 9-4M3 17l9 4 9-4',
  radar: 'M12 3a9 9 0 1 0 9 9M12 7a5 5 0 1 0 5 5M12 12l8-8',
};
interface Props {
  title: string;
  description: string;
  href: string;
  icon: keyof typeof paths;
}
const { title, description, href, icon } = Astro.props;
---
<div class="sl-link-card navigation-card">
  <svg class="destination-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[icon]} /></svg>
  <div class="card-copy">
    <a href={href}><span class="title">{title}</span></a>
    <p class="description">{description}</p>
  </div>
  <Icon name="right-arrow" size="1.25rem" class="direction-icon" />
</div>
<style>
  .navigation-card { display: grid; grid-template-columns: 24px minmax(0, 1fr) 20px; align-items: start; column-gap: .75rem; position: relative; }
  .destination-icon { color: var(--sl-color-text-accent); margin-top: .2rem; }
  .card-copy { min-width: 0; margin: 0; }
  .title { color: var(--sl-color-white); }
  a { text-decoration: none; line-height: var(--sl-line-height-headings); }
  a::before { content: ''; position: absolute; inset: 0; }
  .description { margin: .5rem 0 0; }
  .direction-icon { color: var(--sl-color-gray-2); margin-top: .2rem; }
</style>
