{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Dotfiles configuration",
  "description": "Machine settings and reusable sets. Individual properties override selected sets. All fields are optional; omitted values inherit the base configuration.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sets": {
      "type": "array",
      "description": "Compose named sets in order, then apply this file's individual settings. Local sets are supported; existence and dependency cycles are checked at runtime.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "anyOf": [
          {
            "enum": [
              "ai",
              "base",
              "development",
              "easypost",
              "editor",
              "linux",
              "macos",
              "personal",
              "shell",
              "terminal",
              "workstation"
            ]
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "github_enabled": {
          "type": "boolean",
          "description": "Enable the Codex GitHub app and its plugins. False keeps GitHub access through gh.",
          "default": false
        }
      }
    },
    "zellij": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "description": "Runtime source: patched includes the checkout's native fixes; release uses upstream stable; main builds pinned upstream without local patches.",
          "default": "patched",
          "enum": [
            "patched",
            "release",
            "main"
          ]
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": {
          "type": "boolean",
          "description": "Enable the build bootstrap recipe.",
          "default": false
        },
        "rust": {
          "type": "boolean",
          "description": "Enable the rust bootstrap recipe.",
          "default": false
        },
        "node": {
          "type": "boolean",
          "description": "Enable the node bootstrap recipe.",
          "default": false
        },
        "go": {
          "type": "boolean",
          "description": "Enable the go bootstrap recipe.",
          "default": false
        },
        "git": {
          "type": "boolean",
          "description": "Enable the git bootstrap recipe.",
          "default": false
        },
        "zsh": {
          "type": "boolean",
          "description": "Enable the zsh bootstrap recipe.",
          "default": false
        },
        "tmux": {
          "type": "boolean",
          "description": "Enable the tmux bootstrap recipe.",
          "default": false
        },
        "zellij": {
          "type": "boolean",
          "description": "Enable the zellij bootstrap recipe.",
          "default": false
        },
        "nerd-font": {
          "type": "boolean",
          "description": "Enable the nerd-font bootstrap recipe.",
          "default": false
        },
        "btop": {
          "type": "boolean",
          "description": "Enable the btop bootstrap recipe.",
          "default": false
        },
        "fzf": {
          "type": "boolean",
          "description": "Enable the fzf bootstrap recipe.",
          "default": false
        },
        "starship": {
          "type": "boolean",
          "description": "Enable the starship bootstrap recipe.",
          "default": false
        },
        "atuin": {
          "type": "boolean",
          "description": "Enable the atuin bootstrap recipe.",
          "default": false
        },
        "skim": {
          "type": "boolean",
          "description": "Enable the skim bootstrap recipe.",
          "default": false
        },
        "git-delta": {
          "type": "boolean",
          "description": "Enable the git-delta bootstrap recipe.",
          "default": false
        },
        "glow": {
          "type": "boolean",
          "description": "Enable the glow bootstrap recipe.",
          "default": false
        },
        "bat": {
          "type": "boolean",
          "description": "Enable the bat bootstrap recipe.",
          "default": false
        },
        "fd": {
          "type": "boolean",
          "description": "Enable the fd bootstrap recipe.",
          "default": false
        },
        "eza": {
