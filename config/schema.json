        "ep-direnv": {
          "type": "boolean",
          "description": "Configure EasyPost direnv integration when withenv is available.",
          "default": false
        },
        "yabai": {
          "type": "boolean",
          "description": "Enable the yabai bootstrap recipe.",
          "default": false
