# vim swap files
.*.sw*
vim/.netrwhist
bin/mate
.ssh_config
bin/*
vim/spell
vim/plugged
vim/session
*.log
nvim/lua/local.lua
nvim/local.lua

# MCP Memory (personal context)
memory.json
.memory.json
__pycache__

# Socrates interrogation session artifacts (transient work product)
.socrates/

# Skills are ignored by default (symlinked external skills are machine-specific).
# Real, repo-owned skills are force-added: git add -f claude/skills/<name>
claude/skills/*
# Anthropic-published skills (anthropics/skills, official plugins) are never
# tracked here, even with -f: install them from the source so they stay current.
# See claude/skills/ANTHROPIC-SKILLS.md.
claude/skills/algorithmic-art/
claude/skills/brand-guidelines/
claude/skills/canvas-design/
claude/skills/doc-coauthoring/
claude/skills/docx/
claude/skills/frontend-design/
claude/skills/internal-comms/
claude/skills/mcp-builder/
claude/skills/pdf/
claude/skills/pptx/
claude/skills/skill-creator/
claude/skills/slack-gif-creator/
claude/skills/theme-factory/
claude/skills/web-artifacts-builder/
claude/skills/webapp-testing/
claude/skills/xlsx-python/

# Agents are ignored by default (some are symlinked from ~/src/ep-dotfiles).
# Real, repo-owned agents are force-added: git add -f claude/agents/<name>
claude/agents/*

# ~/.claude/{commands,workflows} are symlinked here too, so Claude Code, plugins,
# and installers write straight into the repo. Ignored by default like agents;
# version a real one with: git add -f claude/commands/<name>
claude/commands/*
claude/workflows/

# Repo-local Claude Code state (permission grants, `claude -w` worktrees, ...).
# Only the shared settings and MCP server list are tracked.
.claude/*
!.claude/settings.json
!.claude/mcp-servers.json

# Generated output: eval runs, skill-creator workspaces, packaged skills.
claude/evals/*/results/
*-workspace/
*.skill
CLAUDE.local.md
# Unexpanded shell variable paths (accidental git adds)
$HOME/
