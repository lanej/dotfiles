# vim swap files
.*.sw*
vim/.netrwhist
bin/mate
.ssh_config
bin/*
!bin/firstmate
!bin/firstmate-*
!bin/ep-direnv
!bin/epenv
!bin/epenv_test.py
vim/spell
vim/plugged
vim/session
*.log
nvim/lua/local.lua
nvim/local.lua

# MCP Memory (personal context)
memory.json
.memory.json
__pycache__

# Socrates interrogation session artifacts (transient work product)
.socrates/

# Skills are ignored by default (symlinked external skills are machine-specific).
# Real, repo-owned skills are force-added: git add -f ai/skills/<name>
ai/skills/*
# Anthropic-published skills (anthropics/skills, official plugins) are never
# tracked here, even with -f: install them from the source so they stay current.
# See ai/skills/ANTHROPIC-SKILLS.md.
ai/skills/algorithmic-art/
ai/skills/brand-guidelines/
ai/skills/canvas-design/
ai/skills/doc-coauthoring/
ai/skills/docx/
ai/skills/frontend-design/
ai/skills/internal-comms/
ai/skills/mcp-builder/
ai/skills/pdf/
ai/skills/pptx/
ai/skills/skill-creator/
ai/skills/slack-gif-creator/
ai/skills/theme-factory/
ai/skills/web-artifacts-builder/
ai/skills/webapp-testing/
ai/skills/xlsx-python/

# Agents are ignored by default (some are symlinked from ~/src/ep-dotfiles).
# Real, repo-owned agents are force-added: git add -f ai/agents/<name>
ai/agents/*

# New/experimental commands are ignored by default; version one deliberately with:
# git add -f claude/commands/<name>. (`make claude` symlinks individual entries out
# into a real ~/.claude/commands/, so this no longer fills up from plugins/installers
# writing there directly — see the `claude` Makefile target.)
claude/commands/*
claude/workflows/

# Repo-local Claude Code state (permission grants, `claude -w` worktrees, ...).
# Only the shared settings and MCP server list are tracked.
.claude/*
!.claude/settings.json
!.claude/mcp-servers.json

# Generated output: eval runs, skill-creator workspaces, packaged skills.
claude/evals/*/results/
*-workspace/
*.skill
CLAUDE.local.md
codex/AGENTS.local.md
codex/bedrock.config.toml

# Compiled binary left behind by `go build` in codex/bedrock-router/
codex/bedrock-router/bedrock-router

# Local OpenCode install (dependency tree, not source)
.opencode/

# htop search history (runtime state, not source)
sh/htop_history

# Unexpanded shell variable paths (accidental git adds)
$HOME/
