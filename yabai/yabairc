#!/bin/sh
yabai -m config layout bsp
yabai -m config top_padding    15
yabai -m config bottom_padding 15
yabai -m config left_padding   15
yabai -m config right_padding  15
yabai -m config window_gap     15

yabai -m config window_topmost on

yabai -m config window_opacity off

# Playwright's non-headless test browser (Chromium / "Google Chrome for Testing")
# calls macOS's activateIgnoringOtherApps directly. Normally that's fine and
# should pop up as usual, but if it steals focus while the current space is
# native-fullscreen (e.g. a fullscreen terminal), macOS force-switches spaces
# to reveal it -- minimize it on creation in that case only. Anchored regex
# excludes the regular "Google Chrome" app.
yabai -m rule --add app="^(Chromium|Google Chrome for Testing)$" manage=off
yabai -m signal --add event=window_created app="^(Chromium|Google Chrome for Testing)$" action="/Users/joshlane/.files/bin/yabai-suppress-fullscreen-popup \$YABAI_WINDOW_ID"
