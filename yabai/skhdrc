# Global window shortcuts. Edit config/keybindings.toml and run make generate-keybindings.
# BEGIN generated keybindings (scripts/keybindings.py)
# skhd.focus-kitty: Focus or launch Kitty.
cmd - return : sh ~/.local/bin/yabai-focus-or-launch "kitty" "/Applications/kitty.app/Contents/MacOS/kitty --single-instance -d ~"
# skhd.focus-west: Focus the window west, including floating windows.
alt - h : yabai -m window --focus west || yabai-focus-float left
# skhd.focus-south: Focus the window south, including floating windows.
alt - j : yabai -m window --focus south || yabai-focus-float down
# skhd.focus-north: Focus the window north, including floating windows.
alt - k : yabai -m window --focus north || yabai-focus-float up
# skhd.focus-east: Focus the window east, including floating windows.
alt - l : yabai -m window --focus east || yabai-focus-float right
# skhd.focus-previous: Focus the previous window.
alt - p : yabai -m window --focus prev
# skhd.focus-next: Focus the next window.
alt - n : yabai -m window --focus next
# skhd.toggle-float: Toggle floating window layout.
alt + shift - z : yabai -m window --toggle float
# skhd.toggle-zoom: Toggle fullscreen zoom within the space.
alt + shift - f : yabai -m window --toggle zoom-fullscreen
# skhd.swap-west: Swap with the window west.
alt + shift - h : yabai -m window --swap west
# skhd.swap-south: Swap with the window south.
alt + shift - j : yabai -m window --swap south
# skhd.swap-north: Swap with the window north.
alt + shift - k : yabai -m window --swap north
# skhd.swap-east: Swap with the window east.
alt + shift - l : yabai -m window --swap east
# skhd.rotate-clockwise: Rotate the space layout clockwise.
alt - r : yabai -m space --rotate 90
# skhd.rotate-counterclockwise: Rotate the space layout counterclockwise.
alt + shift - r : yabai -m space --rotate 270
# skhd.warp-north: Move the window north in the layout.
shift + cmd - k : yabai -m window --warp north
# skhd.warp-south: Move the window south in the layout.
shift + cmd - j : yabai -m window --warp south
# skhd.warp-west: Move the window west in the layout.
shift + cmd - h : yabai -m window --warp west
# skhd.warp-east: Move the window east in the layout.
shift + cmd - l : yabai -m window --warp east
# skhd.next-space: Move the window to the next space.
ctrl + shift + cmd - l : yabai -m window --space next
# skhd.previous-space: Move the window to the previous space.
ctrl + shift + cmd - h : yabai -m window --space prev
# skhd.balance-space: Balance window sizes in the space.
alt + shift - space : yabai -m space --balance
# skhd.toggle-split: Toggle the window split direction.
alt - s : yabai -m window --toggle split
# skhd.float-centered: Toggle floating and center the window.
alt + shift - c : yabai -m window --toggle float;\
	 yabai -m window --grid 8:8:1:1:6:6
# skhd.float-top-half: Toggle floating and fill the top half.
alt + shift - v : yabai -m window --toggle float;\
	 yabai -m window --grid 12:12:0:0:12:6
# skhd.float-bottom-half: Toggle floating and fill the bottom half.
alt + shift - n : yabai -m window --toggle float;\
	 yabai -m window --grid 12:12:0:6:12:6
# END generated keybindings
