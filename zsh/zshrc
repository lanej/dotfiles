# Add custom completions and site-functions to fpath (must be before compinit)
# ZSH_COMPLETIONS is set in zshenv
fpath=(
    ${ZSH_COMPLETIONS:-$HOME/.local/share/zsh/site-functions}
    ~/.zsh/completions
    /opt/homebrew/share/zsh/site-functions
    /usr/local/share/zsh/site-functions
    $fpath
)

# Load and initialize the Zsh completion system
autoload -Uz compinit
# Only regenerate completion cache once per day for faster startup
# -C: skip security check (compaudit), -u: ignore insecure directories
if [[ -n ${HOME}/.zcompdump(#qN.mh+24) ]]; then
	# Cache is older than 24 hours, regenerate it (but skip security check)
	compinit -C -u
else
	# Use cached version (skip security check for speed)
	compinit -C -u
fi

