if command -v fzf >/dev/null; then
	source <(fzf --zsh)
	
	# Helper function for dynamic preview window positioning
	__fzf_dynamic_preview_window() {
		local cols
		if [ -n "$TMUX" ]; then
			# In tmux, use tmux display-message which works in subshells
			cols=$(tmux display-message -p '#{pane_width}' 2>/dev/null || echo 80)
		else
			# Outside tmux, use tput
			cols=$(tput cols 2>/dev/null || echo 80)
		fi
		if [ "$cols" -ge 140 ]; then
			echo "right:60%:border-left:wrap"
		else
			echo "down:40%:border-top:wrap"
		fi
	}
	
	# Override fzf-cd-widget (Alt-C / Ctrl+U) with toggle for hidden dirs
	# Default: no hidden dirs, respects .gitignore/.ignore
	# Press Ctrl+U inside fzf to toggle hidden/ignored dirs on/off
	# Press Ctrl+B to load the highlighted path into the query, narrowing to it and its
	# children (e.g. jump to a parent dir, Ctrl+B to drill into it, keep narrowing, then Enter)
	fzf-cd-widget() {
		setopt localoptions pipefail no_aliases 2> /dev/null

		local cmd_normal='fd --type d --follow --exclude .git'
		local cmd_hidden='fd --type d --hidden --follow --no-ignore --exclude .git'
		local preview_window="$(__fzf_dynamic_preview_window)"

		local dir
		dir=$(
			FZF_DEFAULT_COMMAND="$cmd_normal" \
			FZF_DEFAULT_OPTS=$(__fzf_defaults "--reverse --scheme=path +m" "${FZF_ALT_C_OPTS-}") \
			FZF_DEFAULT_OPTS_FILE='' \
			fzf \
				--prompt='📁 > ' \
				--preview-window="$preview_window" \
				--bind="ctrl-u:transform:[[ \$FZF_PROMPT =~ hidden ]] && echo \"reload($cmd_normal)+change-prompt(📁 > )\" || echo \"reload($cmd_hidden)+change-prompt(📁 [hidden] > )\"" \
				--bind="ctrl-b:replace-query" \
			< /dev/tty
		)

		if [[ -z "$dir" ]]; then
			zle redisplay
			return 0
		fi
		zle push-line
		BUFFER="builtin cd -- ${(q)dir:a}"
		zle accept-line
		local ret=$?
		unset dir
		zle reset-prompt
		return $ret
	}

	fzf-directory-widget() {
		local selected_dir
		selected_dir=$(fd --type d 2>/dev/null | fzf --bind='ctrl-b:replace-query') && LBUFFER+="$selected_dir"
		let ret=$?
		zle reset-prompt
		return $ret
	}

	zzz() {
		# Ensure ZLE hands control cleanly to the TUI picker
		zle -I
		zz
		let ret=$?
		zle reset-prompt
		zle accept-line
		return $ret
	}

	# Bind the function to a key combination, e.g., Ctrl+U
	zle -N fzf-directory-widget
	bindkey '^Y' fzf-directory-widget

	if [ -r "${HOME}/.config/zsh/fzf.zsh" ]; then
		source "${HOME}/.config/zsh/fzf.zsh"

	fi

	if [ -r "${HOME}/.fzf.zsh" ]; then
		source "${HOME}/.fzf.zsh"

	fi

	# Custom fzf file widget with Ctrl+O toggle for hidden files
	fzf-file-widget-toggle() {
		setopt localoptions pipefail no_aliases 2> /dev/null
		local item
		local result
		
		# Command for non-hidden files
		local cmd_normal='fd --type f --follow --exclude .git'
		# Command for hidden files (also ignores .gitignore and .ignore files)
		local cmd_hidden='fd --type f --hidden --follow --no-ignore --exclude .git'
		
		# Dynamic preview window positioning
		local preview_window="$(__fzf_dynamic_preview_window)"
		
		# Use fzf with toggle binding that switches back and forth
		result=$(
			FZF_DEFAULT_COMMAND="$cmd_normal" \
			FZF_DEFAULT_OPTS="--height ${FZF_TMUX_HEIGHT:-40%} --min-height 20+ --bind=ctrl-z:ignore --reverse --scheme=path --tiebreak=length,pathname ${FZF_CTRL_T_OPTS-} -m --prompt='🔍 > ' --preview-window='$preview_window' \
			--bind='ctrl-o:transform:[[ \$FZF_PROMPT =~ hidden ]] && echo \"reload($cmd_normal)+change-prompt(🔍 > )\" || echo \"reload($cmd_hidden)+change-prompt(🔍 [hidden] > )\"'" \
			FZF_DEFAULT_OPTS_FILE='' \
			fzf < /dev/tty | while read -r item; do
				echo -n -E "${(q)item} "
			done
		)
		
		local ret=$?
		if [ -n "$result" ]; then
			LBUFFER="${LBUFFER}${result}"
		fi
		zle reset-prompt
		return $ret
	}

		bindkey '^U' fzf-cd-widget
		zle -N fzf-file-widget-toggle
		bindkey '^O' fzf-file-widget-toggle
		zle -N zzz
		bindkey '^B' zzz

	if [[ -r "${HOME}/.local/share/fzf-tab/fzf-tab.plugin.zsh" ]]; then
		# `source <(fzf --zsh)` above already rebound ^I to its own
		# fzf-completion widget. fzf-tab's init captures whatever ^I is
		# CURRENTLY bound to as its internal fallback engine, expecting
		# zsh's plain expand-or-complete; if it captures fzf-completion
		# instead, it skips routing through _main_complete entirely and
		# every Tab press falls through to fzf-completion's generic
		# file/path completion (context-blind, and immediate given
		# FZF_COMPLETION_TRIGGER='' below) instead of fzf-tab's real
		# context-aware completion. Restore the plain default first so
		# fzf-tab captures the right fallback; fzf-completion itself is
		# untouched and gets rebound to Ctrl+G later.
		bindkey '^I' expand-or-complete
		source "${HOME}/.local/share/fzf-tab/fzf-tab.plugin.zsh"

		zstyle ':fzf-tab:*' switch-group ',' '.'
		# disable sort when completing `git checkout`
		zstyle ':completion:*:git-checkout:*' sort false
		# set descriptions format to enable group support
		# NOTE: don't use escape sequences (like '%F{red}%d%f') here, fzf-tab will ignore them
		zstyle ':completion:*:descriptions' format '[%d]'
		# set list-colors to enable filename colorizing
		zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
		# force zsh not to show completion menu, which allows fzf-tab to capture the unambiguous prefix
		zstyle ':completion:*' menu no
		# press / on a candidate to accept it AND immediately reopen completion
		# for the next argument, without leaving the popup — lets you drill
		# through subcommand levels (e.g. `jira components<Tab>` -> select
		# components, press / -> `list`/`create`/... appear right away)
		zstyle ':fzf-tab:*' continuous-trigger '/'
		# preview directory's content with eza when completing cd
		zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
		# general-purpose preview for any other completion that resolves to a
		# real path: dir listing via eza, file contents via bat. $realpath is
		# only set by fzf-tab for path-like completions; anything else (git
		# subcommands, flags, variable names, ...) just shows no preview.
		zstyle ':fzf-tab:complete:*:*' fzf-preview '
			if [[ -d $realpath ]]; then
				eza -1 --color=always $realpath
			elif [[ -f $realpath ]]; then
				bat --color=always --style=numbers --line-range=:200 $realpath
			fi'
		# custom fzf flags
		# NOTE: fzf-tab does not follow FZF_DEFAULT_OPTS by default
		# -i makes fzf case-insensitive; no --color here so it inherits
		# fzf's own default palette, same as every other picker in this
		# config (none of them set --color explicitly either).
		zstyle ':fzf-tab:*' fzf-flags --bind=tab:accept -i --preview-window="$(__fzf_dynamic_preview_window)"
		# To make fzf-tab follow FZF_DEFAULT_OPTS.
		# NOTE: This may lead to unexpected behavior since some flags break this plugin. See Aloxaf/fzf-tab#455.
		zstyle ':fzf-tab:*' use-fzf-default-opts yes
		# switch group using `<` and `>`
		zstyle ':fzf-tab:*' switch-group '<' '>'
	fi

	# ------------------------------------------------------------------
	# Ctrl+G: recursive fzf path/dir completion, on fzf's own native
	# fzf-completion widget (defined by `source <(fzf --zsh)` above).
	# Tab / fzf-tab is untouched — this binds a separate key directly to
	# the widget fzf-tab stole `^I` from.
	# ------------------------------------------------------------------

	# Per-shell state file: lets the Ctrl+G hidden-toggle (which runs in a
	# separate process spawned later by fzf's `transform` action) recover
	# the base directory the initial fd scan was rooted at. `$$` here is
	# this interactive shell's real PID, so concurrent terminals don't collide.
	__fzf_ctrl_g_dirfile="${TMPDIR:-/tmp}/.zsh-fzf-ctrl-g-dir.$$"

	# Builds FZF_COMPLETION_{DIR,PATH}_OPTS: a --prompt plus a ctrl-g:transform
	# bind delegating to bin/fzf-ctrl-g-toggle, which reads $FZF_PROMPT (fzf's
	# own convention, same [[ $FZF_PROMPT =~ hidden ]] check fzf-cd-widget/
	# fzf-file-widget-toggle use for their own ctrl-u/ctrl-o toggles) and the
	# dirfile to print the right reload(...)+change-prompt(...) action. Ctrl+G
	# (not Ctrl+U) matches this repo's own convention: the SAME key that
	# launches a widget also toggles hidden files inside it (cf. fzf-cd-widget
	# and fzf-file-widget-toggle, both bound to their own toggle key) — it also
	# overrides fzf's built-in ctrl-g:abort default for this popup, so a second
	# Ctrl+G toggles hidden files instead of silently closing the picker. A
	# real script here (rather than inlining the fd/sed pipeline into this
	# string) avoids re-escaping a dynamic value through FZF_COMPLETION_*_OPTS's
	# own ${(Z+n+)}/${(Q)} reparsing on top of fzf's bind grammar.
	__fzf_ctrl_g_opts() {
		local icon=$1 typeflag=$2
		printf '%s' "--prompt=\"$icon > \" --bind=\"ctrl-g:transform:$HOME/.files/bin/fzf-ctrl-g-toggle '$__fzf_ctrl_g_dirfile' '$icon' '$typeflag'\""
	}

	# _fzf_compgen_path / _fzf_compgen_dir are fzf's own documented override
	# hooks: defining them replaces the native recursive walker used by
	# _fzf_path_completion / _fzf_dir_completion with fd, matching this
	# repo's fd conventions (follow symlinks, exclude .git, respect
	# .gitignore, hidden files off by default).
	_fzf_compgen_path() {
		setopt localoptions pipefail no_aliases 2> /dev/null
		print -r -- "$1" > "$__fzf_ctrl_g_dirfile" 2>/dev/null
		echo "$1"
		fd --follow --exclude .git . "$1" 2>/dev/null | sed 's@^\./@@'
	}

	_fzf_compgen_dir() {
		setopt localoptions pipefail no_aliases 2> /dev/null
		print -r -- "$1" > "$__fzf_ctrl_g_dirfile" 2>/dev/null
		fd --type d --follow --exclude .git . "$1" 2>/dev/null | sed 's@^\./@@'
	}

	# Applies to both _fzf_path_completion and _fzf_dir_completion (both
	# funnel through __fzf_generic_path_completion). --scheme=path (set
	# upstream) implies --tiebreak=pathname,length; reorder to favor the
	# shortest match first.
	export FZF_COMPLETION_OPTS='--tiebreak=length,pathname'
	export FZF_COMPLETION_DIR_OPTS="$(__fzf_ctrl_g_opts '📁' '--type d')"
	export FZF_COMPLETION_PATH_OPTS="$(__fzf_ctrl_g_opts '🔍' '')"

	# Empty trigger = show the recursive picker immediately on Ctrl+G, no
	# need to type `**` first. Global setting for the fzf-completion widget —
	# safe today only because fzf-tab owns `^I` and nothing else invokes it.
	export FZF_COMPLETION_TRIGGER=''

	# fzf-completion is zle -N'd by `source <(fzf --zsh)` above; bind it
	# directly to Ctrl+G instead of Tab.
	bindkey '^G' fzf-completion
fi

