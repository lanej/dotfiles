# Quick privacy check before starting Claude Code
alias claude-check="~/.claude/local/claude-privacy-check"

# Context switching (for future personal GCP project setup)
claude-work() {
    export ANTHROPIC_VERTEX_PROJECT_ID=easypost-platform
    export CLAUDE_CODE_USE_VERTEX=1
    echo "🏢 Claude Code → EasyPost Vertex AI (easypost-platform)"
    echo "   Privacy: MEDIUM (metadata visible to EasyPost admins)"
    echo "   Run 'claude-check' to verify logging status"
}

claude-personal() {
    export ANTHROPIC_VERTEX_PROJECT_ID=joshlane-claude-private
    export CLAUDE_CODE_USE_VERTEX=1
    echo "🔒 Claude Code → Personal Vertex AI (joshlane-claude-private)"
    echo "   Privacy: HIGH (you control all access)"
    echo "   Run 'claude-check' to verify logging status"
}

claude-bedrock() {
    local profile="EasyPostAIHubEngineering"
    local region="us-west-2"
    local token

    AWS_PROFILE="$profile" aws sts get-caller-identity >/dev/null 2>&1 \
        || aws sso login --profile "$profile" \
        || return 1

    token="$(bedrock-mantle-token "$profile" "$region")" || return 1

    echo "🟠 Claude Code → AWS Bedrock ($region, profile $profile)"
    echo "   Bearer token expires <=12h; re-run claude-bedrock to refresh"

    AWS_BEARER_TOKEN_BEDROCK="$token" AWS_REGION="$region" \
        claude --settings '{"env":{"CLAUDE_CODE_USE_BEDROCK":"1","CLAUDE_CODE_USE_VERTEX":"","ANTHROPIC_VERTEX_PROJECT_ID":"","ANTHROPIC_DEFAULT_SONNET_MODEL":"us.anthropic.claude-sonnet-5","ANTHROPIC_DEFAULT_OPUS_MODEL":"us.anthropic.claude-opus-5"}}' "$@"
}
cbd() {
    if [ "$#" -gt 0 ]; then
        echo "cbd: no arguments allowed (use claude-bedrock directly for custom flags)" >&2
        return 1
    fi
    claude-bedrock --dangerously-skip-permissions
}

claude-status() {
    local project="${ANTHROPIC_VERTEX_PROJECT_ID:-easypost-platform}"
    echo "Current project: $project"
    if [ "$project" = "easypost-platform" ]; then
        echo "Context: 🏢 Work (shared EasyPost infrastructure)"
    elif [ "$project" = "joshlane-claude-private" ]; then
        echo "Context: 🔒 Personal (private infrastructure)"
    else
        echo "Context: ⚠️  Unknown project"
    fi
}

# Default to work context
claude-work() { :; } > /dev/null 2>&1

# Override claude command with privacy-checking wrapper (if it exists)
if [ -x "$HOME/.claude/local/claude-wrapper" ]; then
    alias claude="$HOME/.claude/local/claude-wrapper"
fi

# FastEmbed cache centralization
export FASTEMBED_CACHE_DIR="$HOME/.cache/fastembed"

# Lazy load NVM - only load when nvm command is actually used
export NVM_DIR="$HOME/.nvm"
# Note: Default node version is already added to PATH in .profile (lines 94-100)
# Only load nvm when the command is actually invoked
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # Create lazy-loading wrapper for nvm
  nvm() {
    unset -f nvm
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
    nvm "$@"
  }
fi


# Google Cloud SDK - lazy loaded (see ~/.files/zsh/lazy-load.zsh)
# source /opt/homebrew/share/google-cloud-sdk/path.zsh.inc
# source /opt/homebrew/share/google-cloud-sdk/completion.zsh.inc

export PATH="$HOME/Library/TinyTeX/bin/universal-darwin:$PATH"
export PATH="/Users/joshlane/.bun/bin:$PATH"
# EIA_API_KEY is loaded from a non-versioned secrets file (e.g. ~/.env)
#
if [ -r "$HOME/.env" ]; then
  source "$HOME/.env"
fi

# Azure Functions Core Tools
export FUNCTIONS_CORE_TOOLS_TELEMETRY_OPTOUT=1
