{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "VIEWRULE_CONFIG_DIR": "/Users/joshlane/.files/claude/ui-review"
  },
  "attribution": {
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash"
    ],
    "deny": [
      "Bash(rm:-rf /)",
      "Bash(rm:-rf:/ *)",
      "Bash(sudo:rm:*)",
      "Bash(sudo:dd:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",
      "Bash(wipefs:*)",
      "Bash(diskutil:eraseDisk:*)",
      "Bash(diskutil:eraseVolume:*)",
      "Bash(diskutil:zeroDisk:*)",
      "Bash(diskutil:partitionDisk:*)",
      "Bash(asr:restore:*)",
      "Bash(dd*of=/dev/disk*)",
      "Bash(dd*of=/dev/rdisk*)",
      "Bash(csrutil:disable*)",
      "Bash(spctl:--master-disable*)",
      "Bash(security dump-keychain*)",
      "Bash(security find-generic-password*)",
      "Bash(security find-internet-password*)",
      "WebSearch",
      "WebFetch"
    ],
    "defaultMode": "auto",
    "additionalDirectories": []
  },
  "model": "claude-sonnet-5-5",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 && \"$HOME/.files/bin/claude-session-start-hook\" || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.files/bin/claude-notification-hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.files/bin/claude-worktree-create-hook"
          }
        ]
      },
      {
        "matcher": "ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.files/bin/claude-worktree-remove-hook"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.files/bin/claude-sibling-doc-check-hook"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.files/bin/claude-git-stash-guard-hook"
          },
          {
            "type": "command",
            "command": "$HOME/.files/bin/claude-pr-gate-hook"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.files/bin/claude-tmux-state-hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 && \"$HOME/.files/bin/claude-autoname-hook\" || true"
          },
          {
            "type": "command",
            "command": "$HOME/.files/bin/claude-stop-hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.files/bin/claude-tmux-state-hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.files/bin/claude-tmux-state-hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.files/bin/claude-agent-model-narration-hook"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.files/bin/claude-sandbox-bypass-narration-hook"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.files/bin/claude-statusline"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-mem@thedotmack": true,
    "frontend-design@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "viewrule@viewrule": true,
    "bigquery@easypost-sandbox": false,
    "looker@easypost-sandbox": true
  },
  "extraKnownMarketplaces": {
    "agent-plugins-for-aws": {
      "source": {
        "source": "github",
        "repo": "awslabs/agent-plugins"
      }
    },
    "viewrule": {
      "source": {
        "source": "git",
        "url": "https://github.com/lanej/viewrule.git"
      }
    },
    "easypost-sandbox": {
      "source": {
        "source": "github",
        "repo": "easypost-sandbox/claude-marketplace"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        "/tmp",
        "/private/tmp",
        "/Users/joshlane/.cache/uv"
      ]
    },
    "enableWeakerNetworkIsolation": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoCompactWindow": 600000,
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim",
  "verbose": true,
  "crossSessionInbound": "accept",
  "skillOverrides": {
    "skill-creator": "off",
    "dagster": "off",
    "data-pipeline": "off",
    "insurance-claims": "off",
    "kread": "off",
    "paseo": "off",
    "paseo-advisor": "off",
    "paseo-committee": "off",
    "paseo-handoff": "off",
    "paseo-plugin": "off",
    "presenterm": "off",
    "ruby": "off",
    "srvctl": "off",
    "xsv": "off",
    "claude-mem:babysit": "off",
    "claude-mem:cloud-sync": "off",
    "claude-mem:design-is": "off",
    "claude-mem:do": "off",
    "claude-mem:how-it-works": "off",
    "claude-mem:knowledge-agent": "off",
    "claude-mem:learn-codebase": "off",
    "claude-mem:make-plan": "off",
    "claude-mem:oh-my-issues": "off",
    "claude-mem:pathfinder": "off",
    "claude-mem:smart-explore": "off",
    "claude-mem:standup": "off",
    "claude-mem:timeline-report": "off",
    "claude-mem:version-bump": "off",
    "claude-mem:weekly-digests": "off",
    "claude-mem:what-the": "off",
    "claude-mem:wowerpoint": "off"
  }
}
