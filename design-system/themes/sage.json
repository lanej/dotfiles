{
  "name": "sage",
  "source": "https://lanej.io/",
  "palette": {
    "charcoal": "#0D1513",
    "raised": "#17231E",
    "selected": "#26352D",
    "border": "#6B8575",
    "text": "#D7DFD9",
    "snow": "#EEF1EE",
    "muted": "#A3B1A7",
    "comment": "#9CAB9F",
    "sage": "#ACC8B7",
    "teal": "#8FB9A8",
    "blue": "#95B5D3",
    "cyan": "#8CC5CC",
    "sand": "#D5C298",
    "lichen": "#B7CB91",
    "lavender": "#C4B2D9",
    "success": "#A6CD82",
    "amber": "#E8C88B",
    "rose": "#F18C96",
    "copper": "#DDA783",
    "subtle": "#909F95"
  },
  "roles": {
    "surface": "$charcoal",
    "surface.raised": "$raised",
    "surface.selected": "$selected",
    "border": "$border",
    "text": "$text",
    "text.strong": "$snow",
    "text.muted": "$muted",
    "text.inverse": "$charcoal",
    "accent": "$sage",
    "accent.secondary": "$teal",
    "focus": "$lavender",
    "status.success": "$success",
    "status.warning": "$amber",
    "status.error": "$rose",
    "status.info": "$cyan",
    "status.attention": "$copper",
    "status.idle": "$muted",
    "status.off": "$subtle",
    "syntax.comment": "$comment",
    "syntax.keyword": "$blue",
    "syntax.function": "$cyan",
    "syntax.string": "$lichen",
    "syntax.type": "$sand",
    "syntax.number": "$lavender",
    "syntax.constant": "$text",
    "syntax.operator": "$blue",
    "syntax.special": "$amber",
    "syntax.variable": "$text",
    "text.subtle": "$subtle",
    "diff.add.emph.bg": {
      "mix": [
        "@surface",
        "@diff.add"
      ],
      "amount": 0.2
    },
    "diff.delete.emph.bg": {
      "mix": [
        "@surface",
        "@diff.delete"
      ],
      "amount": 0.2
    }
  },
  "ansi": [
    "$raised",
    "$rose",
    "$success",
    "$amber",
    "$blue",
    "$lavender",
    "$cyan",
    "$text",
    "$comment",
    "$rose",
    "$success",
    "$amber",
    "$blue",
    "$lavender",
    "$teal",
    "$snow"
  ]
}
