{
  "roles": {
    "diff.add": "@status.success",
    "diff.change": "@status.warning",
    "diff.delete": "@status.error",
    "diff.add.bg": {
      "mix": [
        "@surface",
        "@diff.add"
      ],
      "amount": 0.16
    },
    "diff.change.bg": {
      "mix": [
        "@surface",
        "@diff.change"
      ],
      "amount": 0.16
    },
    "diff.delete.bg": {
      "mix": [
        "@surface",
        "@diff.delete"
      ],
      "amount": 0.16
    },
    "diff.add.dim": {
      "mix": [
        "@surface",
        "@diff.add"
      ],
      "amount": 0.55
    },
    "diff.change.dim": {
      "mix": [
        "@surface",
        "@diff.change"
      ],
      "amount": 0.55
    },
    "diff.delete.dim": {
      "mix": [
        "@surface",
        "@diff.delete"
      ],
      "amount": 0.55
    },
    "selection.bg": "@surface.selected",
    "selection.fg": "@text.strong",
    "focus": "@accent",
    "match": "@status.success",
    "tab.active.bg": "@surface.selected",
    "tab.active.fg": "@accent",
    "tab.inactive.bg": "@surface",
    "tab.inactive.fg": "@text.muted",
    "keyhint": "@accent",
    "heading": "@accent",
    "link": "@accent",
    "prompt": "@accent",
    "diff.add.emph.bg": {
      "mix": [
        "@surface",
        "@diff.add"
      ],
      "amount": 0.3
    },
    "diff.delete.emph.bg": {
      "mix": [
        "@surface",
        "@diff.delete"
      ],
      "amount": 0.3
    },
    "git.file.conflicted": {
      "ansi": 1
    },
    "git.file.stashed": {
      "ansi": 7
    },
    "git.file.deleted": {
      "ansi": 1
    },
    "git.file.renamed": {
      "ansi": 6
    },
    "git.file.modified": {
      "ansi": 3
    },
    "git.file.staged": {
      "ansi": 2
    },
    "git.file.untracked": {
      "ansi": 4
    },
    "git.file.typechanged": {
      "ansi": 5
    },
    "git.file.ahead": {
      "ansi": 2
    },
    "git.file.behind": {
      "ansi": 3
    },
    "git.file.branch": {
      "ansi": 4
    }
  },
  "presentation": {
    "emphasis.heading": {
      "type": "boolean",
      "value": true,
      "note": "Glow h6 remains subdued; other heading consumers use this emphasis."
    },
    "space.inline": {
      "type": "dimension",
      "value": 1,
      "unit": "cell"
    },
    "symbol.separator.section.left": {
      "type": "string",
      "value": ""
    },
    "symbol.separator.section.right": {
      "type": "string",
      "value": ""
    },
    "symbol.separator.component.left": {
      "type": "string",
      "value": ""
    },
    "symbol.separator.component.right": {
      "type": "string",
      "value": ""
    },
    "symbol.git.file.conflicted": {
      "type": "string",
      "value": ""
    },
    "symbol.git.file.stashed": {
      "type": "string",
      "value": ""
    },
    "symbol.git.file.deleted": {
      "type": "string",
      "value": ""
    },
    "symbol.git.file.renamed": {
      "type": "string",
      "value": ""
    },
    "symbol.git.file.modified": {
      "type": "string",
      "value": ""
    },
    "symbol.git.file.staged": {
      "type": "string",
      "value": ""
    },
    "symbol.git.file.untracked": {
      "type": "string",
      "value": ""
    },
    "symbol.git.file.typechanged": {
      "type": "string",
      "value": ""
    },
    "symbol.git.file.ahead": {
      "type": "string",
      "value": ""
    },
    "symbol.git.file.behind": {
      "type": "string",
      "value": ""
    },
    "symbol.git.file.branch": {
      "type": "string",
      "value": ""
    },
    "symbol.git.hunk.add": {
      "type": "string",
      "value": "┃"
    },
    "symbol.git.hunk.change": {
      "type": "string",
      "value": "┃"
    },
    "symbol.git.hunk.delete": {
      "type": "string",
      "value": "▁"
    },
    "symbol.git.hunk.topdelete": {
      "type": "string",
      "value": "^"
    },
    "symbol.git.hunk.changedelete": {
      "type": "string",
      "value": "~"
    },
    "symbol.git.hunk.untracked": {
      "type": "string",
      "value": "┆"
    },
    "symbol.git.staged_hunk.add": {
      "type": "string",
      "value": "┃"
    },
    "symbol.git.staged_hunk.change": {
      "type": "string",
      "value": "┃"
    },
    "symbol.git.staged_hunk.delete": {
      "type": "string",
      "value": "▁"
    },
    "symbol.git.staged_hunk.topdelete": {
      "type": "string",
      "value": "▔"
    },
    "symbol.git.staged_hunk.changedelete": {
      "type": "string",
      "value": "~"
    },
    "symbol.git.branch_hunk.add": {
      "type": "string",
      "value": "│"
    },
    "symbol.git.branch_hunk.change": {
      "type": "string",
      "value": "│"
    },
    "symbol.git.branch_hunk.delete": {
      "type": "string",
      "value": "_"
    },
    "symbol.git.branch_hunk.topdelete": {
      "type": "string",
      "value": "^"
    },
    "emphasis.git.file.conflicted.bold": {
      "type": "boolean",
      "value": true
    },
    "emphasis.git.file.conflicted.dim": {
      "type": "boolean",
      "value": false
    },
    "emphasis.git.file.stashed.bold": {
      "type": "boolean",
      "value": false
    },
    "emphasis.git.file.stashed.dim": {
      "type": "boolean",
      "value": true
    },
    "emphasis.git.file.deleted.bold": {
      "type": "boolean",
      "value": false
    },
    "emphasis.git.file.deleted.dim": {
      "type": "boolean",
      "value": false
    },
    "emphasis.git.file.renamed.bold": {
      "type": "boolean",
      "value": false
    },
    "emphasis.git.file.renamed.dim": {
      "type": "boolean",
      "value": false
    },
    "emphasis.git.file.modified.bold": {
      "type": "boolean",
      "value": false
    },
    "emphasis.git.file.modified.dim": {
      "type": "boolean",
      "value": false
    },
    "emphasis.git.file.staged.bold": {
      "type": "boolean",
      "value": false
    },
    "emphasis.git.file.staged.dim": {
      "type": "boolean",
      "value": false
    },
    "emphasis.git.file.untracked.bold": {
      "type": "boolean",
      "value": false
    },
    "emphasis.git.file.untracked.dim": {
      "type": "boolean",
      "value": false
    },
    "emphasis.git.file.typechanged.bold": {
      "type": "boolean",
      "value": false
    },
    "emphasis.git.file.typechanged.dim": {
      "type": "boolean",
      "value": false
    },
    "emphasis.git.file.ahead.bold": {
      "type": "boolean",
      "value": false
    },
    "emphasis.git.file.ahead.dim": {
      "type": "boolean",
      "value": false
    },
    "emphasis.git.file.behind.bold": {
