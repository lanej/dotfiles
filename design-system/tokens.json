{
  "roles": {
    "diff.add": "@status.success",
    "diff.change": "@status.warning",
    "diff.delete": "@status.error",
    "diff.add.bg": {
      "mix": [
        "@surface",
        "@diff.add"
      ],
      "amount": 0.16
    },
    "diff.change.bg": {
      "mix": [
        "@surface",
        "@diff.change"
      ],
      "amount": 0.16
    },
    "diff.delete.bg": {
      "mix": [
        "@surface",
        "@diff.delete"
      ],
      "amount": 0.16
    },
    "diff.add.dim": {
      "mix": [
        "@surface",
        "@diff.add"
      ],
      "amount": 0.55
    },
    "diff.change.dim": {
      "mix": [
        "@surface",
        "@diff.change"
      ],
      "amount": 0.55
    },
    "diff.delete.dim": {
      "mix": [
        "@surface",
        "@diff.delete"
      ],
      "amount": 0.55
    },
    "selection.bg": "@surface.selected",
    "selection.fg": "@text.strong",
    "focus": "@accent",
    "match": "@status.success",
    "tab.active.bg": "@focus",
    "tab.active.fg": "@text.inverse",
    "tab.inactive.bg": "@surface",
    "tab.inactive.fg": "@text.muted",
    "frame.inactive.fg": {
      "mix": [
        "@surface",
        "@text"
      ],
      "amount": 0.62
    },
    "keyhint": "@accent",
    "heading": "@accent",
    "link": "@accent",
    "prompt": "@accent",
    "diff.add.emph.bg": {
      "mix": [
        "@surface",
        "@diff.add"
      ],
      "amount": 0.3
    },
    "diff.delete.emph.bg": {
      "mix": [
        "@surface",
        "@diff.delete"
      ],
      "amount": 0.3
    },
    "git.file.conflicted": {
      "ansi": 1
    },
    "git.file.stashed": {
      "ansi": 7
    },
    "git.file.deleted": {
      "ansi": 1
    },
    "git.file.renamed": {
      "ansi": 6
    },
    "git.file.modified": {
      "ansi": 3
    },
    "git.file.staged": {
      "ansi": 2
    },
    "git.file.untracked": {
      "ansi": 4
    },
    "git.file.typechanged": {
      "ansi": 5
    },
    "git.file.ahead": {
      "ansi": 2
    },
    "git.file.behind": {
      "ansi": 3
    },
    "git.file.branch": {
      "ansi": 4
    },
    "git.file.conflicted.dim": {
      "mix": [
        "@surface",
        "@git.file.conflicted"
      ],
      "amount": 0.65
    },
    "git.file.stashed.dim": {
      "mix": [
        "@surface",
        "@git.file.stashed"
      ],
      "amount": 0.65
    },
    "git.file.deleted.dim": {
      "mix": [
        "@surface",
        "@git.file.deleted"
      ],
      "amount": 0.65
    },
    "git.file.renamed.dim": {
      "mix": [
        "@surface",
        "@git.file.renamed"
      ],
      "amount": 0.65
    },
    "git.file.modified.dim": {
      "mix": [
        "@surface",
        "@git.file.modified"
      ],
      "amount": 0.65
    },
    "git.file.staged.dim": {
      "mix": [
        "@surface",
        "@git.file.staged"
      ],
      "amount": 0.65
    },
    "git.file.untracked.dim": {
      "mix": [
        "@surface",
        "@git.file.untracked"
      ],
      "amount": 0.65
    },
    "git.file.typechanged.dim": {
      "mix": [
        "@surface",
        "@git.file.typechanged"
      ],
      "amount": 0.65
    },
    "git.file.ahead.dim": {
      "mix": [
        "@surface",
        "@git.file.ahead"
      ],
      "amount": 0.65
    },
    "git.file.behind.dim": {
      "mix": [
        "@surface",
        "@git.file.behind"
      ],
      "amount": 0.65
    },
    "git.file.branch.dim": {
      "mix": [
        "@surface",
        "@git.file.branch"
      ],
      "amount": 0.65
    },
    "file.directory": "@text.muted",
    "file.executable": "@status.success",
    "file.special": "@syntax.number",
    "file.archive": "@status.attention",
    "file.project": "@status.warning"
  },
  "presentation": {
    "emphasis.heading": {
      "type": "boolean",
      "value": true,
      "note": "Glow h6 remains subdued; other heading consumers use this emphasis."
    },
    "space.inline": {
      "type": "dimension",
      "value": 1,
      "unit": "cell"
    },
    "symbol.separator.section.left": {
      "type": "string",
      "value": "",
      "ascii": ">"
    },
    "symbol.separator.section.right": {
      "type": "string",
      "value": "",
      "ascii": "<"
    },
    "symbol.separator.component.left": {
      "type": "string",
      "value": "",
      "ascii": ">"
    },
    "symbol.separator.component.right": {
      "type": "string",
      "value": "",
      "ascii": "<"
    },
    "symbol.git.file.conflicted": {
      "type": "string",
      "value": "",
      "ascii": "!"
    },
    "symbol.git.file.stashed": {
      "type": "string",
      "value": "",
      "ascii": "s"
    },
    "symbol.git.file.deleted": {
