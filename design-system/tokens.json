      "ascii": "~"
    },
    "symbol.git.hunk.delete": {
      "type": "string",
      "value": "▁",
      "ascii": "-"
    },
    "symbol.git.hunk.topdelete": {
      "type": "string",
      "value": "^",
      "ascii": "^"
    },
    "symbol.git.hunk.changedelete": {
      "type": "string",
      "value": "~",
      "ascii": "~"
    },
    "symbol.git.hunk.untracked": {
      "type": "string",
      "value": "┆",
      "ascii": "?"
    },
    "symbol.git.staged_hunk.add": {
      "type": "string",
      "value": "┃",
      "ascii": "+"
    },
    "symbol.git.staged_hunk.change": {
      "type": "string",
