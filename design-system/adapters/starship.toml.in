"$schema" = 'https://starship.rs/config-schema.json'

# Don't print a new line at the start of the prompt
add_newline = false
continuation_prompt = '[▶▶]({{color.text.muted}}) '
command_timeout = 2000

[character]
success_symbol = "[\\$](bold {{color.text.strong}})"
error_symbol = "[\\$](bold {{color.status.error}})"
vimcmd_symbol = "[](bold {{color.focus}})"

[cmd_duration]
style = "{{color.text.muted}}"

[git_status]
format = '($all_status$ahead_behind)'
conflicted = "{{git.file.conflicted}}"
stashed = "{{git.file.stashed}}"
deleted = "{{git.file.deleted}}"
renamed = "{{git.file.renamed}}"
modified = "{{git.file.modified}}"
staged = "{{git.file.staged}}"
untracked = "{{git.file.untracked}}"
typechanged = "{{git.file.typechanged}}"
ahead = "{{git.file.ahead}}"
diverged = "{{git.file.ahead.diverged}}{{git.file.behind.diverged}}"
behind = "{{git.file.behind}}"

[git_metrics]
disabled = true

[battery]
disabled = false
full_symbol = "{{symbol.battery.full}} "
charging_symbol = "{{symbol.battery.charging}} "
discharging_symbol = "{{symbol.battery.discharging}} "
unknown_symbol = "{{symbol.battery.unknown}} "
empty_symbol = "{{symbol.battery.empty}} "

[[battery.display]]
threshold = 10
style = 'bold {{color.status.error}}'

[[battery.display]]
threshold = 30
style = 'bold {{color.status.warning}}'

[git_branch]
style = "{{git.file.branch.style}}"
symbol = "{{git.file.branch.symbol}} "
format = "[$symbol$branch(:$remote_branch)]($style) "

[username]
disabled = false
format = "[$user]($style)@"
style_user = "{{color.text.muted}}"
style_root = "bold {{color.status.error}}"

[hostname]
disabled = false
ssh_symbol = "{{symbol.terminal.ssh}} "
format = "[$ssh_symbol$hostname]($style) "
style = "bold {{color.status.info}}"

[aws]
symbol = " "
disabled = true

[azure]
symbol = " "

[buf]
symbol = " "
format = "[$symbol]($style)"
style = "{{color.accent.secondary}}"

[bun]
symbol = " "
format = "[$symbol]($style)"
style = "{{color.accent.secondary}}"

[c]
symbol = " "
format = "[$symbol]($style)"
style = "{{color.accent.secondary}}"

