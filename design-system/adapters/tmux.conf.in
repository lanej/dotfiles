# Generated by scripts/theme.py.
setw -g window-status-activity-style bg={{status.warning}},fg={{surface}}
setw -g window-status-current-style  bg={{tab.active.bg}},fg={{tab.active.fg}}
setw -g window-status-last-style     bg=default,dim,fg={{accent}}
setw -g window-status-style          bg={{accent}},fg={{surface}}
setw -g window-style                 bg={{surface}}
setw -g window-active-style          bg={{surface}}
setw -g window-status-bell-style     bg={{status.attention}},fg={{surface}} # Bells request attention without implying failure


# TODO: turn off pane cycling
# Length of tmux status line
set  -g display-panes-active-colour "{{surface}}"
set  -g display-panes-colour "{{surface}}"
set  -g message-command-style bg={{surface}},fg={{accent}}
set  -g message-style bg={{surface}},fg={{accent}}
set  -g pane-active-border-style bg=default,fg={{accent}},bold
set  -g pane-border-indicators both
set  -g pane-border-style bg=default,fg={{border}}
set  -g pane-border-lines heavy
set  -g pane-border-status off
# Keep Codex's native thread identity for hook routing, but show a compact label.
set -g @codex-pane-label '#{s/^([● ]*\[[ !.]+\] Action Required [|] )?[!● ]*codex [|] [0-9a-f-]+([.][.][.]|…)? [|] ([^|]+ [|] )?(.*)$/ #{?#{@claude-glyph},#{@claude-glyph},○} · \4/:pane_title}'
set  -g pane-border-format "#{?pane_active,#[bg={{accent}}]#[fg={{surface}}],#[bg={{border}}]#[fg={{text.strong}}]} #I #{?#{!=:#{pane_title},},#{E:@codex-pane-label},#{pane_current_command}} #[bg=default]"
set  -g status "on"
set  -g status-justify left
set  -g status-left-length 30
set  -g status-right-length 150
set  -g status-style bg={{surface}},fg={{text}}
setw -g clock-mode-colour "{{accent}}"

set -g @prefix_highlight_fg "{{surface}}"
set -g @prefix_highlight_bg "{{accent}}"
set -g @prefix_highlight_copy_mode_attr "fg={{surface}},bg={{accent}}"

set -g status-left "#[fg={{surface}},bg={{accent}},bold] #S #[fg={{accent}},bg={{surface}},nobold,noitalics,nounderscore]"
# tmux-claude-sweep both ages idle windows into dormant ones and prints the
# cross-session roll-up; tmux has no timer of its own, so it rides this
# status refresh (status-interval, above).
set -g status-right "#{prefix_highlight}#[fg={{surface.raised}},bg={{surface}},nobold,noitalics,nounderscore]\
#(~/.files/bin/tmux-claude-sweep)#(~/.files/bin/tmux-ssh-status)#(~/.files/bin/tmux-battery-status)#[fg={{text}},bg={{surface.raised}}] %Y-%m-%d #[fg={{text}},bg={{surface.raised}},nobold,noitalics,nounderscore]\
#[fg={{text}},bg={{surface.raised}}] %H:%M #[fg={{accent}},bg={{surface.raised}},nobold,noitalics,nounderscore]\
#[fg={{surface}},bg={{accent}},bold] #H "

# The focused window keeps its own colour -- you are already here -- but still
# carries the state glyph, so "what is it doing" needs no second look.
set-window-option -g window-status-current-format "\
#{?window_zoomed_flag,#[bg={{status.warning}}],#[bg={{tab.active.bg}}]}\
#[fg={{surface}}]\
#{?window_zoomed_flag,#[fg={{surface}}],#[fg={{tab.active.fg}}]}#[bold] #{?#{@claude-glyph},#{@claude-glyph} ,}#I* \
 #W \
#{?window_zoomed_flag,#[fg={{status.warning}}],#[fg={{tab.active.bg}}]}\
#[bg={{surface}}]"

# The agent's state outranks tmux's own bell/activity flags: it says WHY a window
# wants you, which a flag cannot. the shared design system owns the palette, so
# this stays one branch deep however many states it grows.
set-window-option -g window-status-format "\
#[fg={{surface}},bg={{surface}},noitalics,nodim]\
#{?#{@claude-state},#[bg={{agent.bg}}]#[fg={{surface}}],#{?window_bell_flag,#[bg={{status.attention}}]#[fg={{surface}}],#{?window_activity_flag,#[bg={{status.warning}}]#[fg={{surface}}],#[fg={{surface}}]#[bg={{surface.raised}}]}}}\
#{?#{@claude-state},#[fg={{agent.fg}}#,#{@claude-attr}],#{?window_bell_flag,#[fg={{surface}}],#{?window_activity_flag,#[fg={{surface}}],#[fg={{accent}}]#[bg={{surface.raised}}]}}} #{?#{@claude-glyph},#{@claude-glyph} ,}#I #W\
#{?#{@claude-state},#[fg={{agent.bg}}]#[bg={{surface}}],#{?window_bell_flag,#[fg={{status.attention}}]#[bg={{surface}}],#{?window_activity_flag,#[fg={{status.warning}}]#[bg={{surface}}],#[fg={{surface.raised}}]#[bg={{surface}}]}}}"
