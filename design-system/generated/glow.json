{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#D7DFD9",
    "indent": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#ACC8B7",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#0D1513",
    "background_color": "#ACC8B7",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "color": "#ACC8B7",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#9CAB9F",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#ACC8B7",
    "underline": true,
    "format": "{{if not (and (ge (len .text) 4) (eq (slice .text 0 4) \"\\x1b]8;\"))}}{{.text}}{{end}}"
  },
  "link_text": {
    "color": "#ACC8B7",
    "bold": true
  },
  "image": {
    "color": "#ACC8B7",
    "underline": true
  },
  "image_text": {
    "color": "#ACC8B7",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#B7CB91",
    "background_color": "#26352D"
  },
  "code_block": {
    "color": "#D7DFD9",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#D7DFD9"
      },
      "error": {
        "color": "#0D1513",
        "background_color": "#F18C96"
      },
      "comment": {
        "color": "#9CAB9F"
      },
      "comment_preproc": {
        "color": "#95B5D3"
      },
      "keyword": {
        "color": "#95B5D3"
      },
      "keyword_reserved": {
        "color": "#95B5D3"
      },
      "keyword_namespace": {
        "color": "#95B5D3"
      },
      "keyword_type": {
        "color": "#B7BDE3"
      },
      "operator": {
        "color": "#95B5D3"
      },
      "punctuation": {
        "color": "#D7DFD9"
      },
      "name": {
        "color": "#D7DFD9"
      },
      "name_builtin": {
        "color": "#D7DFD9"
      },
      "name_tag": {
        "color": "#95B5D3"
      },
      "name_attribute": {
        "color": "#D7DFD9"
      },
      "name_class": {
        "color": "#B7BDE3",
        "underline": true,
        "bold": true
      },
      "name_constant": {},
      "name_decorator": {
        "color": "#E8C88B"
      },
      "name_exception": {},
      "name_function": {
        "color": "#8CC5CC"
      },
      "name_other": {},
      "literal": {},
      "literal_number": {
        "color": "#C4B2D9"
      },
      "literal_date": {},
      "literal_string": {
        "color": "#B7CB91"
      },
      "literal_string_escape": {
        "color": "#E8C88B"
      },
      "generic_deleted": {
        "color": "#F18C96"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#A6CD82"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#ACC8B7"
      },
      "background": {
        "background_color": "#0D1513"
      }
    }
  },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
