# Generated by scripts/theme.py.
[delta "dotfiles"]
    syntax-theme = Dotfiles
    keep-plus-minus-markers = true
    line-numbers-left-style = "#6B8575"
    line-numbers-right-style = "#6B8575"
    line-numbers-zero-style = "#909F95"
    line-numbers-minus-style = "#F18C96"
    line-numbers-plus-style = "#A6CD82"
    plus-style = syntax "#253225"
    plus-non-emph-style = syntax "#253225"
    plus-emph-style = bold syntax "#2C3A29"
    plus-empty-line-marker-style = normal "#253225"
    minus-style = syntax "#312828"
    minus-non-emph-style = syntax "#312828"
    minus-emph-style = bold syntax "#3B2D2D"
    whitespace-error-style = "#F18C96" reverse
[delta]
    line-numbers-left-style = "#6B8575"
    line-numbers-right-style = "#6B8575"
    line-numbers-zero-style = "#909F95"
    line-numbers-minus-style = "#F18C96"
    line-numbers-plus-style = "#A6CD82"
