#!/bin/sh
set -eu

version=${1:?Usage: install-pi VERSION}
case "$version" in ''|*[!0-9.]*) echo 'Invalid Pi version' >&2; exit 1 ;; esac
case $(uname -s) in Darwin) system=darwin ;; Linux) system=linux ;; *) echo 'Unsupported Pi platform' >&2; exit 1 ;; esac
case $(uname -m) in arm64|aarch64) arch=arm64 ;; x86_64|amd64) arch=x64 ;; *) echo 'Unsupported Pi architecture' >&2; exit 1 ;; esac

prefix=${2:-$HOME/.local}
share="$prefix/share/pi-standalone"
bin="$prefix/bin"
release="$share/$version/pi"
mkdir -p "$share" "$bin"
if [ ! -x "$release/pi" ]; then
    stage=$(mktemp -d "$share/.install.XXXXXX")
    trap 'rm -rf "$stage"' EXIT
    trap 'exit 1' HUP INT TERM
    archive="pi-$system-$arch.tar.gz"
    url="https://github.com/earendil-works/pi/releases/download/v$version"
    curl -fsSL "$url/$archive" -o "$stage/$archive"
    curl -fsSL "$url/SHA256SUMS" -o "$stage/SHA256SUMS"
    (
        cd "$stage"
        awk -v archive="$archive" '$2 == archive { print; count++ } END { if (count != 1) exit 1 }' SHA256SUMS > selected
        if command -v sha256sum >/dev/null 2>&1; then sha256sum -c selected
        else shasum -a 256 -c selected; fi
        mkdir extracted
        tar -xzf "$archive" -C extracted
        test "$(extracted/pi/pi --version)" = "$version"
    )
    mv "$stage/extracted" "$share/$version"
fi
test "$("$release/pi" --version)" = "$version"
if [ -d "$bin/pi" ] && [ ! -L "$bin/pi" ]; then
    echo "Pi launcher path is a directory: $bin/pi" >&2
    exit 1
fi
ln -sfn "$release/pi" "$bin/pi"
