#!/bin/sh
set -eu
version=${1:?Usage: install-beads VERSION}
case "$version" in ''|*[!0-9.]*) printf '%s\n' 'Invalid Beads version' >&2; exit 1 ;; esac
case $(uname -s) in Darwin) system=darwin ;; Linux) system=linux ;; *) printf '%s\n' 'Unsupported operating system' >&2; exit 1 ;; esac
case $(uname -m) in arm64|aarch64) architecture=arm64 ;; x86_64|amd64) architecture=amd64 ;; *) printf '%s\n' 'Unsupported architecture' >&2; exit 1 ;; esac
checksum() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
    else shasum -a 256 "$1" | awk '{print $1}'; fi
}
validate() {
    case $("$1" version) in "bd version $version "*) return 0 ;; *) return 1 ;; esac
}
destination="$HOME/.local/bin/bd"
receipt="$HOME/.local/share/beads/install-receipt"
prior_digest=
if [ -e "$destination" ] || [ -L "$destination" ]; then
    if [ -L "$destination" ] || [ ! -f "$destination" ] || [ -L "$receipt" ] || [ ! -f "$receipt" ]; then
        printf 'Refusing to replace unmanaged Beads binary: %s\n' "$destination" >&2
        exit 1
    fi
    installed_version=$(sed -n '1p' "$receipt")
    installed_digest=$(sed -n '2p' "$receipt")
    case "$installed_version" in ''|*[!0-9.]*) installed_digest=invalid ;; esac
    case "$installed_digest" in ''|*[!a-fA-F0-9]*) installed_digest=invalid ;; esac
    prior_digest=$(checksum "$destination")
    if [ "${#installed_digest}" -ne 64 ] || [ "$prior_digest" != "$installed_digest" ]; then
        printf 'Refusing to replace modified Beads binary: %s\n' "$destination" >&2
        exit 1
    fi
fi
if [ -L "$receipt" ] || { [ -e "$receipt" ] && [ ! -f "$receipt" ]; }; then
    printf 'Refusing to replace unmanaged Beads binary: %s\n' "$destination" >&2
    exit 1
fi
if [ -z "${BEADS_INSTALL_BINARY:-}" ] && [ -n "$prior_digest" ] && [ -x "$destination" ]; then
    if [ "$installed_version" = "$version" ] && validate "$destination"; then
        printf 'Using installed Beads %s\n' "$version"
        exit 0
    fi
fi
mkdir -p "$HOME/.local/bin" "${receipt%/*}"
stage=$(mktemp -d "$HOME/.local/bin/.beads.XXXXXX")
trap 'rm -rf "$stage"' EXIT HUP INT TERM
name=bd
if [ -n "${BEADS_INSTALL_BINARY:-}" ]; then
    cp "$BEADS_INSTALL_BINARY" "$stage/$name"
    cp "$BEADS_INSTALL_BINARY.sha256" "$stage/checksum"
    expected_name=$(basename "$BEADS_INSTALL_BINARY")
else
    release="https://github.com/gastownhall/beads/releases/download/v$version"
    asset="beads_${version}_${system}_${architecture}.tar.gz"
    curl -fLsS "$release/$asset" -o "$stage/archive.tar.gz"
    curl -fLsS "$release/checksums.txt" -o "$stage/checksum"
    expected=$(awk -v name="$asset" '$2 == name { hash=$1; count++ } END { if (count==1) print hash }' "$stage/checksum")
    if [ "${#expected}" -ne 64 ] || [ "$(checksum "$stage/archive.tar.gz")" != "$expected" ]; then
        printf '%s\n' 'Beads archive checksum mismatch' >&2
        exit 1
    fi
    tar -xOzf "$stage/archive.tar.gz" ./bd > "$stage/$name"
    printf '%s  %s\n' "$(checksum "$stage/$name")" "$name" > "$stage/checksum"
    expected_name=$name
fi
expected=$(awk -v name="$expected_name" '$2 == name { hash=$1; count++ } END { if (count==1) print hash }' "$stage/checksum")
case "$expected" in ''|*[!a-fA-F0-9]*) printf '%s\n' 'Invalid Beads checksum' >&2; exit 1 ;; esac
if [ "${#expected}" -ne 64 ] || [ "$(checksum "$stage/$name")" != "$expected" ]; then
    printf '%s\n' 'Beads checksum mismatch' >&2
    exit 1
fi
chmod 755 "$stage/$name"
if ! validate "$stage/$name"; then
    printf '%s\n' 'Beads binary version or platform mismatch' >&2
    exit 1
fi
if [ -n "$prior_digest" ]; then
    if [ -L "$destination" ] || [ ! -f "$destination" ] || [ "$(checksum "$destination")" != "$prior_digest" ]; then
        printf 'Refusing changed installation destination: %s\n' "$destination" >&2
        exit 1
    fi
elif [ -e "$destination" ] || [ -L "$destination" ]; then
    printf 'Refusing changed installation destination: %s\n' "$destination" >&2
    exit 1
fi
printf '%s\n%s\n' "$version" "$expected" > "$stage/receipt"
mv -f "$stage/$name" "$destination"
mv -f "$stage/receipt" "$receipt"
printf 'Installed Beads %s\n' "$version"
