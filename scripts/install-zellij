#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 0 ]; then
    printf 'Usage: %s\n' "$0" >&2
    exit 2
fi

zellij_revision=7d738ed500f973a45df0f19cc6f5b1fe478bd1f0
zellij_toolchain=1.95.0

rustup toolchain install "$zellij_toolchain" --profile minimal
# Override inherited cross-compilation settings when installing a local runtime.
zellij_host=$(rustup run "$zellij_toolchain" rustc -vV | sed -n 's/^host: //p')
if [ -z "$zellij_host" ]; then
    printf '%s\n' 'The Rust compiler did not report its host target.' >&2
    exit 1
fi

# Cargo can reuse path-dependency artifacts across git checkouts. Keep each
# runtime revision's native crates separate, even when CI restores an older cache.
export CARGO_TARGET_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/zellij/target/$zellij_revision"
export CARGO_PROFILE_RELEASE_LTO=false
export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-2}"

install_flags=(--locked)
# Installation evidence belongs with the binary, not in a restorable build cache.
install_stamp="$HOME/.local/.dotfiles-zellij-install"
install_identity="revision-target-v1:$zellij_revision"
if [ ! -x "$HOME/.local/bin/zellij" ] || [ "$(cat "$install_stamp" 2>/dev/null || true)" != "$install_identity" ]; then
    # Cargo otherwise skips an owned same-revision binary, even if it was built
    # from stale shared artifacts before revision-isolated installation existed.
    install_flags+=(--force)
else
    installed=$(rustup run "$zellij_toolchain" cargo install --list --root "$HOME/.local")
    # A successful isolated install can use Cargo's normal same-revision skip.
    if ! grep -Fxq '    zellij' <<< "$installed"; then
        install_flags+=(--force)
    fi
fi
rustup run "$zellij_toolchain" cargo install \
    --git https://github.com/lanej/zellij.git \
    --rev "$zellij_revision" \
    "${install_flags[@]}" \
    --root "$HOME/.local" \
    --target "$zellij_host" \
    --no-default-features \
    --features plugins_from_target,vendored_curl,web_server_capability \
    --bin zellij zellij

printf '%s\n' "$install_identity" > "$install_stamp"
printf '%s\n' 'Restart existing Zellij sessions to use the installed runtime.'
