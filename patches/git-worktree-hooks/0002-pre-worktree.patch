 	struct strbuf errmsg = STRBUF_INIT;
 	const char *reason = NULL;
-	int ret = 0;
+	int ret = 0, unregister_ret;
 
 	ac = parse_options(ac, av, prefix, options, git_worktree_remove_usage, 0);
 	if (ac != 1)
@@ -1505,6 +1531,12 @@ static int remove_worktree(int ac, const char **av, const char *prefix,
 		    errmsg.buf);
 	strbuf_release(&errmsg);
 
+	ret = run_pre_worktree_hook("remove", wt->id, wt->path, "");
+	if (ret) {
+		free_worktrees(worktrees);
+		return ret;
+	}
+
 	if (file_exists(wt->path)) {
 		if (!force)
 			check_clean_worktree(wt, av[0]);
@@ -1515,10 +1547,12 @@ static int remove_worktree(int ac, const char **av, const char *prefix,
 	 * continue on even if ret is non-zero, there's no going back
 	 * from here.
 	 */
-	ret |= delete_git_dir(wt->id);
+	unregister_ret = delete_git_dir(wt->id);
