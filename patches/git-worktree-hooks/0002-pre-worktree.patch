diff --git a/t/t2408-worktree-pre-hook.sh b/t/t2408-worktree-pre-hook.sh
new file mode 100755
index 0000000..bd7cb9a
--- /dev/null
+++ b/t/t2408-worktree-pre-hook.sh
@@ -0,0 +1,179 @@
+#!/bin/sh
+
+test_description='pre-worktree veto and lifecycle notifications'
+. ./test-lib.sh
+
+test_expect_success 'setup lifecycle hooks' '
+	test_create_repo gate &&
+	test_commit -C gate initial &&
+	WORKTREE_HOOK_LOG="$TRASH_DIRECTORY/events" &&
+	WORKTREE_POST_LOG="$TRASH_DIRECTORY/posts" &&
+	export WORKTREE_HOOK_LOG WORKTREE_POST_LOG REJECT_EVENT REJECT_ID WORKTREE_HOOK_TOUCH &&
+	write_script gate/.git/hooks/pre-worktree <<-\EOF_HOOK &&
+	printf "%s\n" "$@" >>"$WORKTREE_HOOK_LOG"
+	if test "$1" = remove && test -n "$WORKTREE_HOOK_TOUCH"
+	then
+		echo hook-created >"$3/hook-created"
+	fi
+	if test "$1" = "$REJECT_EVENT" &&
+	   { test -z "$REJECT_ID" || test "$2" = "$REJECT_ID"; }
+	then
+		echo "worktree policy rejected $1" >&2
+		exit 23
+	fi
+	EOF_HOOK
+	write_script gate/.git/hooks/post-worktree <<-\EOF_HOOK
+	printf "%s\n" "$1" >>"$WORKTREE_POST_LOG"
+	EOF_HOOK
+'
+
+test_expect_success 'add rejection leaves branch and checkout absent' '
+	REJECT_EVENT=add &&
+	: >"$WORKTREE_POST_LOG" &&
+	test_must_fail git -C gate worktree add -b rejected "../space checkout" &&
+	test_path_is_missing "space checkout" &&
+	test_must_fail git -C gate show-ref --verify refs/heads/rejected &&
+	test_path_is_missing gate/.git/worktrees &&
+	test_must_be_empty "$WORKTREE_POST_LOG" &&
+	printf "add\n\n\n%s\n" "$TRASH_DIRECTORY/space checkout" >expect &&
+	test_cmp expect "$WORKTREE_HOOK_LOG"
+'
+
+test_expect_success 'forced add rejection does not reset existing branch' '
+	git -C gate branch preserved &&
+	git -C gate rev-parse preserved >expect &&
+	test_commit -C gate second &&
+	test_must_fail git -C gate worktree add -f -B preserved ../rejected-reset HEAD &&
+	git -C gate rev-parse preserved >actual &&
+	test_cmp expect actual &&
+	test_path_is_missing rejected-reset
+'
+
+test_expect_success 'no-checkout and orphan additions can be rejected' '
+	test_must_fail git -C gate worktree add --no-checkout -b no-checkout ../no-checkout &&
+	test_must_fail git -C gate worktree add --orphan -b orphan ../orphan &&
+	test_path_is_missing no-checkout &&
+	test_path_is_missing orphan &&
+	test_must_fail git -C gate show-ref --verify refs/heads/no-checkout &&
+	test_must_fail git -C gate show-ref --verify refs/heads/orphan
+'
+
+test_expect_success 'accepting add emits pre and post events' '
+	REJECT_EVENT= &&
+	: >"$WORKTREE_HOOK_LOG" &&
+	git -C gate worktree add -b allowed ../allowed &&
+	test_path_is_file allowed/initial.t &&
+	printf "add\n\n\n%s\n" "$TRASH_DIRECTORY/allowed" >expect &&
+	test_cmp expect "$WORKTREE_HOOK_LOG" &&
+	echo add >expect &&
+	test_cmp expect "$WORKTREE_POST_LOG"
+'
+
+test_expect_success 'move rejection preserves checkout and registration' '
+	REJECT_EVENT=move &&
+	: >"$WORKTREE_HOOK_LOG" &&
+	: >"$WORKTREE_POST_LOG" &&
+	test_must_fail git -C gate worktree move -f ../allowed "../new space" &&
+	test_path_is_file allowed/initial.t &&
+	test_path_is_missing "new space" &&
+	git -C allowed status --porcelain >actual &&
+	test_must_be_empty actual &&
+	printf "move\nallowed\n%s\n%s\n" "$TRASH_DIRECTORY/allowed" "$TRASH_DIRECTORY/new space" >expect &&
+	test_cmp expect "$WORKTREE_HOOK_LOG" &&
+	test_must_be_empty "$WORKTREE_POST_LOG"
+'
+
+test_expect_success 'remove rejection preserves files even with force' '
+	REJECT_EVENT=remove &&
+	echo valuable >allowed/untracked &&
+	test_must_fail git -C gate worktree remove -f ../allowed &&
+	test_path_is_file allowed/untracked &&
+	test_path_is_dir gate/.git/worktrees/allowed &&
+	test_must_be_empty "$WORKTREE_POST_LOG" &&
+	rm allowed/untracked
+'
+
+test_expect_success 'accepted move and remove notify after completion' '
+	REJECT_EVENT= &&
+	git -C gate worktree move ../allowed ../moved &&
+	git -C gate worktree remove ../moved &&
+	test_path_is_missing moved &&
+	printf "move\nremove\n" >expect &&
+	test_cmp expect "$WORKTREE_POST_LOG"
+'
+
+test_expect_success 'prune rejection retains administrative entry, dry run has no hooks' '
+	git -C gate worktree add -b prunable ../prunable &&
+	git -C gate worktree add -b prune-other ../prune-other &&
+	rm -rf prunable &&
+	rm -rf prune-other &&
+	: >"$WORKTREE_HOOK_LOG" &&
+	: >"$WORKTREE_POST_LOG" &&
+	REJECT_EVENT=remove &&
+	REJECT_ID=prunable &&
+	git -C gate worktree prune -n &&
+	test_must_be_empty "$WORKTREE_HOOK_LOG" &&
+	test_must_fail git -C gate worktree prune &&
+	test_path_is_dir gate/.git/worktrees/prunable &&
+	test_path_is_missing gate/.git/worktrees/prune-other &&
+	echo remove >expect &&
+	test_cmp expect "$WORKTREE_POST_LOG" &&
+	REJECT_EVENT= &&
+	REJECT_ID= &&
+	: >"$WORKTREE_POST_LOG" &&
+	git -C gate worktree prune &&
+	test_path_is_missing gate/.git/worktrees/prunable &&
+	echo remove >expect &&
+	test_cmp expect "$WORKTREE_POST_LOG"
+'
+
+test_expect_success 'rejected forced add preserves stale registration' '
+	git -C gate worktree add -b stale-add ../stale-add &&
+	rm -rf stale-add &&
+	REJECT_EVENT=add &&
+	test_must_fail git -C gate worktree add -f -b stale-replacement ../stale-add &&
+	test_path_is_dir gate/.git/worktrees/stale-add &&
+	test_path_is_missing stale-add &&
+	test_must_fail git -C gate show-ref --verify refs/heads/stale-replacement &&
+	REJECT_EVENT= &&
+	git -C gate worktree prune
+'
+
+test_expect_success 'rejected forced move preserves stale destination registration' '
+	git -C gate worktree add -b move-source ../move-source &&
+	git -C gate worktree add -b move-stale ../move-stale &&
+	rm -rf move-stale &&
+	REJECT_EVENT=move &&
+	test_must_fail git -C gate worktree move -f ../move-source ../move-stale &&
+	test_path_is_dir gate/.git/worktrees/move-stale &&
+	test_path_is_file move-source/initial.t &&
+	REJECT_EVENT= &&
+	git -C gate worktree remove ../move-source &&
+	git -C gate worktree prune
+'
+
+test_expect_success 'accepting remove hook cannot bypass the cleanliness check' '
+	git -C gate worktree add -b hook-touch ../hook-touch &&
+	: >"$WORKTREE_POST_LOG" &&
+	WORKTREE_HOOK_TOUCH=1 &&
+	test_must_fail git -C gate worktree remove ../hook-touch &&
+	test_path_is_file hook-touch/hook-created &&
+	test_path_is_dir gate/.git/worktrees/hook-touch &&
+	test_must_be_empty "$WORKTREE_POST_LOG" &&
+	WORKTREE_HOOK_TOUCH= &&
+	rm hook-touch/hook-created &&
+	git -C gate worktree remove ../hook-touch
+'
+
+test_expect_success SANITY 'failed checkout and administrative deletion emit no remove notification' '
+	git -C gate worktree add -b cannot-remove ../cannot-remove &&
+	: >"$WORKTREE_POST_LOG" &&
+	test_when_finished "chmod u+w cannot-remove gate/.git/worktrees/cannot-remove" &&
+	chmod u-w cannot-remove gate/.git/worktrees/cannot-remove &&
+	test_must_fail git -C gate worktree remove -f ../cannot-remove &&
+	test_path_is_dir cannot-remove &&
+	test_path_is_dir gate/.git/worktrees/cannot-remove &&
+	test_must_be_empty "$WORKTREE_POST_LOG"
+'
+
+test_done
