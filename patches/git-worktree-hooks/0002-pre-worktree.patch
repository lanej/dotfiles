 }
 
+static int run_pre_worktree_hook(const char *event, const char *id,
+				 const char *old_path, const char *new_path)
+{
+	struct run_hooks_opt hook_opt = RUN_HOOKS_OPT_INIT_FORCE_SERIAL;
+	struct strbuf resolved = STRBUF_INIT;
+	int ret;
+
+	if (*new_path)
+		new_path = strbuf_realpath_forgiving(&resolved, new_path, 1);
+	strvec_pushl(&hook_opt.args, event, id, old_path, new_path, NULL);
+	ret = run_hooks_opt(the_repository, "pre-worktree", &hook_opt);
+	strbuf_release(&resolved);
+	return ret;
+}
+
 static int run_post_worktree_hook(const char *event, const char *id,
 				  const char *old_path, const char *new_path)
 {
@@ -188,14 +203,16 @@ static int prune_worktree(const char *id, const char *dotgit,
 	if (show_only)
 		return 0;
 
-	delete_git_dir(id);
-
 	/* path stays empty when the worktree path cannot be determined */
 	if (dotgit) {
 		strbuf_addstr(&path, dotgit);
 		strbuf_strip_suffix(&path, "/.git");
 	}
-	ret = run_post_worktree_hook("remove", id, path.buf, "");
+	ret = run_pre_worktree_hook("remove", id, path.buf, "");
+	if (!ret)
+		ret = delete_git_dir(id);
+	if (!ret)
+		ret = run_post_worktree_hook("remove", id, path.buf, "");
 	strbuf_release(&path);
 	return ret;
 }
@@ -1013,6 +1030,10 @@ static int add(int ac, const char **av, const char *prefix,
 		die(_("invalid reference: %s"), branch);
 	}
 
+	ret = run_pre_worktree_hook("add", "", "", path);
+	if (ret)
+		goto cleanup;
+
 	if (!opts.quiet)
 		print_preparing_worktree_line(opts.detach, branch, new_branch, !!new_branch_force);
 
@@ -1373,6 +1394,9 @@ static int move_worktree(int ac, const char **av, const char *prefix,
 		strbuf_trim_trailing_dir_sep(&dst);
 		strbuf_addstr(&dst, sep);
 	}
+	ret = run_pre_worktree_hook("move", wt->id, wt->path, dst.buf);
+	if (ret)
+		goto cleanup;
 	check_candidate_path(dst.buf, force, worktrees, "move");
 
 	validate_no_submodules(wt);
@@ -1398,7 +1422,9 @@ static int move_worktree(int ac, const char **av, const char *prefix,
 	ret = run_post_worktree_hook("move", wt->id, old_path, wt->path);
 
 	free(old_path);
+cleanup:
 	strbuf_release(&dst);
+	strbuf_release(&errmsg);
 	free_worktrees(worktrees);
 	return ret;
 }
@@ -1480,7 +1506,7 @@ static int remove_worktree(int ac, const char **av, const char *prefix,
