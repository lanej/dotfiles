#!/usr/bin/env bash
# Generic control script for the `dispatcher` skill template's resident
# session — the counterpart to scripts/dispatcher-worker (which handles the
# per-item builder/reviewer lifecycle). This script starts, attaches to, and
# inspects the *dispatcher session itself*. Any repo adopting the dispatcher
# pattern points at this one shared script instead of writing its own
# per-repo launcher (bugfix-dispatcher-launch, infra-dispatcher-launch,
# matrix-dispatcher-launch are the three repo/domain-specific precedents this
# generalizes from) — this script must never hardcode a path or convention
# belonging to any one of those.
#
# Run with cwd inside the target git repo, same convention as
# dispatcher-worker: everything (repo, session name, config path) is derived
# from `git rev-parse --show-toplevel`, never passed as a --repo argument.
#
# Session naming: `dispatcher-<repo-basename>` — no slug. dispatcher-worker's
# own per-item sessions are always `dispatcher-<repo-basename>-<slug>` (slug
# is never empty), so the two naming schemes can never collide.
set -euo pipefail

usage() {
  echo "Usage: dispatcher-launch <launch|attach|logs|status>" >&2
  exit 1
}

# ---------------------------------------------------------------------------
# repo context
# ---------------------------------------------------------------------------
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$repo_root" ] || { echo "ERROR: dispatcher-launch must be run with cwd inside the target git repo (no repo found via 'git rev-parse --show-toplevel')" >&2; exit 1; }
repo_basename="$(basename "$repo_root")"
session_name="dispatcher-${repo_basename}"
CONFIG_PATH="${DISPATCHER_CONFIG:-$repo_root/.claude/dispatcher.config.json}"

require_config() {
  [ -f "$CONFIG_PATH" ] || { echo "ERROR: config file not found at $CONFIG_PATH (set DISPATCHER_CONFIG to override the path)" >&2; exit 1; }
  if ! python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$CONFIG_PATH" >/dev/null 2>&1; then
    echo "ERROR: config file $CONFIG_PATH is not valid JSON" >&2
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# claude agents --json helpers — mirrors dispatcher-worker's agent_record /
# agent_ids_by_name exactly, extended with an --all variant so a fully
# exited ("done") session is still findable by attach/logs/status, not just
# a currently-live one.
# ---------------------------------------------------------------------------
PY_FIND_BY_NAME='
import json, os, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
name = os.environ["DW_NAME"]
repo = os.path.realpath(os.environ["DW_REPO"])
candidates = [o for o in data if o.get("name") == name and o.get("cwd")
              and os.path.realpath(o["cwd"]) == repo]
candidates.sort(key=lambda o: o.get("startedAt", 0))
if candidates:
    print(json.dumps(candidates[-1]))
'

find_session_live() {
  # Most recent LIVE session record named $1, or nothing.
  claude agents --json 2>/dev/null | DW_NAME="$1" DW_REPO="$repo_root" python3 -c "$PY_FIND_BY_NAME"
}

find_session_any() {
  # Most recent session record named $1, including already-exited
  # ("done") ones — --all is required for those to appear at all.
  claude agents --json --all 2>/dev/null | DW_NAME="$1" DW_REPO="$repo_root" python3 -c "$PY_FIND_BY_NAME"
}

agent_ids_by_name() {
  # Space-separated ids of every currently-LIVE session named $1.
  claude agents --json 2>/dev/null | DW_NAME="$1" DW_REPO="$repo_root" python3 -c "
import json, os, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
name = os.environ['DW_NAME']
repo = os.path.realpath(os.environ['DW_REPO'])
print(' '.join(o.get('id', '') for o in data if o.get('name') == name
               and o.get('cwd') and os.path.realpath(o['cwd']) == repo))
"
}

field_of() {
  # field_of <json-record> <key>
  DW_RECORD="$1" DW_KEY="$2" python3 -c "
import json, os
print(json.loads(os.environ['DW_RECORD']).get(os.environ['DW_KEY'], ''))
"
}

require_existing_session() {
  # Look up $session_name via find_session_any, print the record, or error
  # and exit 1 with a consistent message for attach/logs/status to share.
  local record
  record="$(find_session_any "$session_name")"
  if [ -z "$record" ]; then
    echo "ERROR: no dispatcher session found for repo '$repo_basename' (session name: $session_name) — run 'dispatcher-launch launch' first" >&2
    exit 1
  fi
  printf '%s' "$record"
}

cmd="${1:-}"; shift || true

case "$cmd" in
  # -------------------------------------------------------------------
  launch)
    require_config

    existing_ids="$(agent_ids_by_name "$session_name")"
    if [ -n "$existing_ids" ]; then
      echo "ERROR: a dispatcher session is already running for repo '$repo_basename' (id/pid: $existing_ids)." >&2
      echo "Only one may run at a time — stop it first (claude stop $existing_ids) before starting another." >&2
      exit 1
    fi

    # Snapshot pre-existing ids for this exact session name BEFORE
    # launching, so the post-launch lookup positively identifies the NEW
    # session rather than a stale one — mirrors dispatcher-worker's start
    # exactly. (existing_ids above is already known empty, but a session
    # could theoretically transition between the check above and the
    # launch below; re-snapshot right before launching to close that gap.)
    pre_launch_ids="$(agent_ids_by_name "$session_name")"

    launch_output="$(cd "$repo_root" && claude -n "$session_name" --bg \
      --settings '{"crossSessionInbound":"accept"}' \
      --permission-mode bypassPermissions \
      "Load and follow the dispatcher skill. Then wait for incoming change requests." 2>&1)" || {
      echo "ERROR: launch failed: $launch_output" >&2
      exit 1
    }

    # Poll up to ~10s for the launched session to actually appear in
    # `claude agents --json`, excluding any id that already existed before
    # this launch — never trust a zero exit / parsed banner text alone,
    # mirrors dispatcher-worker's own launch-verification loop.
    id=""
    for _attempt in 1 2 3 4 5; do
      id="$(claude agents --json 2>/dev/null | DW_NAME="$session_name" DW_REPO="$repo_root" DW_EXCLUDE="$pre_launch_ids" python3 -c "
import json, os, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
name = os.environ['DW_NAME']
repo = os.path.realpath(os.environ['DW_REPO'])
exclude = set(os.environ.get('DW_EXCLUDE', '').split())
candidates = [o for o in data if o.get('name') == name and o.get('id', '') not in exclude
              and o.get('cwd') and os.path.realpath(o['cwd']) == repo]
candidates.sort(key=lambda o: o.get('startedAt', 0))
if candidates:
    print(candidates[-1].get('id', ''))
" || true)"
      [ -n "$id" ] && break
      sleep 2
    done

    if [ -z "$id" ]; then
      echo "ERROR: launched session '$session_name' never appeared in 'claude agents --json' after ~10s (pre-existing ids for this name: '$pre_launch_ids'). Raw launch output: $launch_output" >&2
      exit 1
    fi

    echo "launched: $session_name (id: $id, repo: $repo_root)"
    ;;

  # -------------------------------------------------------------------
  attach)
    record="$(require_existing_session)"
    id="$(field_of "$record" id)"
    state="$(field_of "$record" state)"
    echo "attaching to $session_name (id: $id, state: ${state:-unknown})" >&2
    echo "Note: if this session was previously stopped or has already exited, attaching may resume it rather than opening a read-only view — Ctrl+Z detaches without stopping it again." >&2
    exec claude attach "$id"
    ;;

  # -------------------------------------------------------------------
  logs)
    record="$(require_existing_session)"
    id="$(field_of "$record" id)"
    exec claude logs "$id"
    ;;

  # -------------------------------------------------------------------
  status)
    record="$(require_existing_session)"
    id="$(field_of "$record" id)"
    state="$(field_of "$record" state)"
    cwd="$(field_of "$record" cwd)"
    started_at="$(field_of "$record" startedAt)"
    echo "session: $session_name"
    echo "id: $id"
    echo "state: ${state:-unknown}"
    echo "cwd: ${cwd:-unknown}"
    echo "startedAt: ${started_at:-unknown}"
    ;;

  *)
    usage
    ;;
esac
