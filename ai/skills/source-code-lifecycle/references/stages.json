{
  "schema_version": 1,
  "policy_version": "1.0.0",
  "stages": {
    "research": {"go": [["bash", "scripts/check-go.sh", "compile"]], "typescript": [["node", "scripts/check-typescript.mjs", "typecheck"]]},
    "alpha": {"go": [["bash", "scripts/check-go.sh", "alpha"]], "typescript": [["node", "scripts/check-typescript.mjs", "alpha"]]},
    "beta": {"go": [["bash", "scripts/check-go.sh", "all"]], "typescript": [["node", "scripts/check-typescript.mjs", "all"]]},
    "production": {"go": [["bash", "scripts/check-go.sh", "all"]], "typescript": [["node", "scripts/check-typescript.mjs", "all"]]}
  }
}
