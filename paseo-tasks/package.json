{
  "name": "paseo-tasks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "maintain": "node --import tsx cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . && eslint . --max-warnings 0",
    "check": "npm run check:beads-api && npm run format:check && npm run lint && npm run typecheck",
    "generate:beads": "openapi-typescript api/beads-1.3.4.yaml -o ../tools/task-runtime/generated/beads.ts",
    "check:beads-api": "openapi-typescript api/beads-1.3.4.yaml -o ../tools/task-runtime/generated/beads.ts --check"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@getpaseo/client": "0.15.1",
    "@getpaseo/plugin": "0.15.1",
    "@lanej/task-runtime": "file:../tools/task-runtime",
    "@octokit/rest": "^22.0.1",
    "commander": "14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@getpaseo/protocol": "0.15.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "eslint": "10.14.0",
    "openapi-typescript": "^7.13.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.2"
    }
  }
}
