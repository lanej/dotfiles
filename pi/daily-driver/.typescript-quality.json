{
  "version": 1,
  "rollout": "strict",
  "projects": [
    "tsconfig.json"
  ],
  "exclude": [
    {
      "path": "generated/zellij",
      "reason": "Upstream schemas generated by Protobuf-ES, checked by regeneration and the strict compiler"
    }
  ],
  "commands": {
    "legacy": [],
    "test": [
      "npm",
      "test"
    ],
    "audit": [
      "npm",
      "audit",
      "--audit-level=high"
    ]
  }
}
