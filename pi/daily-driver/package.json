{
  "name": "@lanej/pi-daily-driver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./extension.ts"
    ]
  },
  "scripts": {
    "driver": "node --import tsx cli.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:beads-native": "node --import tsx acceptance/beads-control.ts",
    "test:pi-native": "node --import tsx acceptance/pi-resources.ts",
    "format": "node scripts/check-typescript.mjs fmt",
    "check": "node scripts/check-typescript.mjs all",
    "lint": "node scripts/check-typescript.mjs lint",
    "typecheck": "node scripts/check-typescript.mjs typecheck",
    "quality:tools": "node scripts/check-typescript.mjs tools",
    "audit": "node scripts/check-typescript.mjs audit"
  },
  "dependencies": {
    "@lanej/task-runtime": "file:../../tools/task-runtime",
    "commander": "^14.0.0",
    "zod": "^4.0.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "undici": "8.12.3"
  }
}
