#!/bin/sh
# Run the compiled driver when this checkout has one.
set -eu

launcher=$0
while [ -L "$launcher" ]; do
    target=$(readlink "$launcher")
    case $target in
        /*) launcher=$target ;;
        *) launcher=${launcher%/*}/$target ;;
    esac
done
if ! package=$(CDPATH='' cd -P -- "${launcher%/*}/.." && pwd); then
    printf '%s\n' 'Could not locate the Pi driver package.' >&2
    exit 1
fi

compiled=$package/.aot/pi-driver
if [ "${PI_DRIVER_USE_SOURCE:-0}" != 1 ] && [ -x "$compiled" ]; then
    exec "$compiled" "$@"
fi

runtime=$package/runtime/bun
if [ -x "$runtime" ]; then
    exec "$runtime" --no-env-file "--config=$package/resources/bunfig.toml" "$package/cli.ts" "$@"
fi

if ! command -v bun >/dev/null 2>&1; then
    printf '%s\n' 'Install the Bun version in the driver .bun-version file.' >&2
    exit 1
fi
exec bun --no-env-file "--config=$package/resources/bunfig.toml" "$package/cli.ts" "$@"
