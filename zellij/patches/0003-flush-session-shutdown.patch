+    let listener = bind_listener(&name);
+    let client = connect_stream(&name);
+    let stream = listener.incoming().next().unwrap().unwrap();
+    drop(client);
+    let mut sender: IpcSenderWithContext<ServerToClientMsg> = IpcSenderWithContext::new(stream);
