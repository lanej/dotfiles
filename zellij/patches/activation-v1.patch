@@ -0,0 +1,666 @@
+//! Private opt-in native client checkpoint and same-TTY image replacement.
+use anyhow::{bail, ensure, Context, Result};
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{
+    fs::{self, File, OpenOptions},
+    io::{BufRead, BufReader, Read, Write},
+    os::unix::{
+        ffi::OsStrExt,
+        fs::{DirBuilderExt, MetadataExt, OpenOptionsExt, PermissionsExt},
+        net::{UnixListener, UnixStream},
+        process::CommandExt,
+    },
+    path::{Path, PathBuf},
+    process::Command,
+    sync::{Arc, Mutex, OnceLock},
+    thread,
+    time::Duration,
+};
+use uuid::Uuid;
+
+struct State {
+    record: Value,
+    metadata: PathBuf,
+    checkpoint: Option<(PathBuf, Value)>,
+    pending_input: usize,
+    retire: Option<Arc<dyn Fn() + Send + Sync>>,
+}
+static ACTIVE: OnceLock<Mutex<Option<Arc<Mutex<State>>>>> = OnceLock::new();
+
+fn private_directory(path: &Path) -> Result<()> {
+    fs::DirBuilder::new()
+        .recursive(true)
+        .mode(0o700)
+        .create(path)?;
+    let info = fs::symlink_metadata(path)?;
+    ensure!(
+        info.is_dir() && info.uid() == unsafe { nix::libc::getuid() } && info.mode() & 0o077 == 0,
+        "Native client lifecycle directory is not owned and private"
+    );
+    Ok(())
+}
+fn read_private(path: &Path) -> Result<Value> {
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(nix::libc::O_NOFOLLOW)
+        .open(path)?;
+    let info = file.metadata()?;
+    ensure!(
+        info.is_file()
+            && info.uid() == unsafe { nix::libc::getuid() }
+            && info.mode() & 0o077 == 0
+            && info.len() <= 4 * 1024 * 1024,
+        "Native client lifecycle file is not owned and private"
+    );
+    let mut bytes = Vec::new();
+    file.take(4 * 1024 * 1024 + 1).read_to_end(&mut bytes)?;
+    ensure!(
+        bytes.len() <= 4 * 1024 * 1024,
+        "Native client checkpoint exceeds its private limit"
+    );
+    Ok(serde_json::from_slice(&bytes)?)
+}
+
+fn save(path: &Path, value: &Value) -> Result<()> {
+    let parent = path
+        .parent()
+        .context("Native lifecycle parent is unavailable")?;
+    let temporary = parent.join(format!(".client-{}", Uuid::new_v4()));
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(&temporary)?;
+    serde_json::to_writer(&mut file, value)?;
+    file.write_all(b"\n")?;
+    file.sync_all()?;
+    fs::rename(&temporary, path)?;
+    File::open(parent)?.sync_all()?;
+    Ok(())
+}
+fn started() -> Result<String> {
+    let result = Command::new("ps")
+        .args(["-p", &std::process::id().to_string(), "-o", "lstart="])
+        .env("LC_ALL", "C")
+        .env("TZ", "UTC")
+        .output()?;
+    ensure!(
+        result.status.success(),
+        "Native client start identity unavailable"
+    );
+    let value = String::from_utf8(result.stdout)?.trim().to_owned();
+    ensure!(
+        !value.is_empty(),
+        "Native client start identity unavailable"
+    );
+    Ok(value)
+}
+fn tty() -> Result<Value> {
+    ensure!(
+        unsafe { nix::libc::isatty(0) } == 1,
+        "Managed activation requires the original user TTY"
+    );
+    let mut info = std::mem::MaybeUninit::<nix::libc::stat>::uninit();
+    ensure!(
+        unsafe { nix::libc::fstat(0, info.as_mut_ptr()) } == 0,
+        "Native TTY identity unavailable"
+    );
+    let info = unsafe { info.assume_init() };
+    Ok(
+        json!({"dev":info.st_dev.to_string(),"ino":info.st_ino.to_string(),"rdev":info.st_rdev.to_string()}),
+    )
+}
+pub fn socket_identity(path: &Path) -> Result<Value> {
+    let info = fs::symlink_metadata(path)?;
+    ensure!(
+        std::os::unix::fs::FileTypeExt::is_socket(&info.file_type())
+            && info.uid() == unsafe { nix::libc::getuid() },
+        "Native server socket is not owned"
+    );
+    let ctime = i128::from(info.ctime()) * 1_000_000_000 + i128::from(info.ctime_nsec());
+    Ok(json!([
+        path,
+        info.dev().to_string(),
+        info.ino().to_string(),
+        ctime.to_string()
+    ]))
+}
+fn sha256(bytes: &[u8]) -> String {
+    Sha256::digest(bytes)
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect()
+}
+fn immutable_image(path: &Path) -> Result<String> {
+    let path = path.canonicalize()?;
+    let info = fs::metadata(&path)?;
+    let bytes = fs::read(&path)?;
+    let after = fs::metadata(&path)?;
+    ensure!(
+        info.is_file()
+            && info.mode() & 0o222 == 0
+            && info.dev() == after.dev()
+            && info.ino() == after.ino()
+            && info.ctime() == after.ctime()
+            && info.ctime_nsec() == after.ctime_nsec(),
+        "Immutable native image changed"
+    );
+    let image = sha256(&bytes);
+    ensure!(
+        path.file_name().and_then(|s| s.to_str()) == Some("zellij")
+            && path
+                .parent()
+                .and_then(|p| p.file_name())
+                .and_then(|s| s.to_str())
+                == Some(&image),
+        "Managed clients require a content-addressed native image"
+    );
+    Ok(image)
+}
+fn own_image() -> Result<(PathBuf, String)> {
+    #[cfg(target_os = "linux")]
+    let path = fs::read_link("/proc/self/exe")?;
+    #[cfg(target_os = "macos")]
+    let path = {
+        #[link(name = "proc")]
+        unsafe extern "C" {
+            fn proc_pidpath(pid: i32, buffer: *mut std::ffi::c_void, size: u32) -> i32;
+        }
+        let mut buffer = [0u8; 4096];
+        ensure!(
+            unsafe { proc_pidpath(std::process::id() as i32, buffer.as_mut_ptr().cast(), 4096) }
+                > 0,
+            "Mapped native client path unavailable"
+        );
+        let end = buffer
+            .iter()
+            .position(|byte| *byte == 0)
+            .context("Mapped path is unterminated")?;
+        PathBuf::from(std::ffi::OsStr::from_bytes(&buffer[..end]))
+    };
+    #[cfg(not(any(target_os = "linux", target_os = "macos")))]
+    let path = std::env::current_exe()?;
+    let image = immutable_image(&path)?;
+    Ok((path, image))
+}
+fn peer_owned(stream: &UnixStream) -> Result<()> {
+    use std::os::fd::AsRawFd;
+    #[cfg(target_os = "macos")]
+    {
+        let mut uid = 0;
+        let mut gid = 0;
+        ensure!(
+            unsafe { nix::libc::getpeereid(stream.as_raw_fd(), &mut uid, &mut gid) } == 0
+                && uid == unsafe { nix::libc::getuid() },
+            "Native client control peer is not owned"
+        );
+    }
+    #[cfg(target_os = "linux")]
+    {
+        let mut credentials = std::mem::MaybeUninit::<nix::libc::ucred>::uninit();
+        let mut size = std::mem::size_of::<nix::libc::ucred>() as nix::libc::socklen_t;
+        ensure!(
+            unsafe {
+                nix::libc::getsockopt(
+                    stream.as_raw_fd(),
+                    nix::libc::SOL_SOCKET,
+                    nix::libc::SO_PEERCRED,
+                    credentials.as_mut_ptr().cast(),
+                    &mut size,
+                )
+            } == 0
+                && unsafe { credentials.assume_init() }.uid == unsafe { nix::libc::getuid() },
+            "Native client control peer is not owned"
+        );
+    }
+    Ok(())
+}
+pub fn parent_owner() -> Result<Option<Value>> {
+    let Ok(name) = std::env::var("ZELLIJ_SESSION_NAME") else {
+        return Ok(None);
+    };
+    let pane = std::env::var("ZELLIJ_PANE_ID")
+        .context("Native parent pane unavailable")?
+        .parse::<u32>()?;
+    let target = zellij_utils::sessions::resolve_session_id(&name)
+        .context("Native parent session UUID unavailable")?;
+    Ok(Some(
+        json!({"project":"zellij","target":target,"pane_id":pane}),
+    ))
+}
+
+impl State {
+    fn publish(&self) -> Result<()> {
+        save(&self.metadata, &self.record)
+    }
+    fn command(&mut self, request: Value) -> Result<Value> {
+        let action = request["action"]
+            .as_str()
+            .context("Native client action missing")?;
+        if matches!(action, "inventory" | "verify") {
+            return Ok(self.record.clone());
+        }
+        ensure!(
+            request["expected_process"] == self.record["process"],
+            "Native client incarnation changed"
+        );
+        if action == "retire_owned" {
+            let (path, cp) = self
+                .checkpoint
+                .as_mut()
+                .context("Owned nested client checkpoint unavailable")?;
+            ensure!(
+                cp["run_id"] == request["run_id"]
+                    && cp["defer_to_parent"] == true
+                    && cp["restoration_owner"] == request["restoration_owner"]
+                    && self.pending_input == 0
+                    && self.retire.is_some(),
+                "Native nested retirement owner differs"
+            );
+            if cp["retire_submitted"] == true {
+                return Ok(self.record.clone());
+            }
+            ensure!(
+                self.record["connected"] == true
+                    && socket_identity(Path::new(cp["server_identity"][0].as_str().unwrap()))?
+                        == cp["server_identity"],
+                "Native nested connection changed before retirement"
+            );
+            cp["retire_submitted"] = json!(true);
+            save(path, cp)?;
+            self.record["retire_submitted"] = json!(true);
+            self.publish()?;
+            return Ok(self.record.clone());
+        }
+        ensure!(
+            self.record["retire_submitted"] != true,
+            "Native nested retirement has already been submitted"
+        );
+        if action == "release_original" {
+            let (_, cp) = self
+                .checkpoint
+                .as_ref()
+                .context("Native client checkpoint unavailable")?;
+            ensure!(
+                cp["run_id"] == request["run_id"]
+                    && self.record["connected"] == true
+                    && socket_identity(Path::new(
+                        self.record["server_identity"][0].as_str().unwrap()
+                    ))? == self.record["server_identity"],
+                "Original client cannot be released after retirement"
+            );
+            self.checkpoint = None;
+            self.record["checkpoint"] = Value::Null;
+            self.publish()?;
+            return Ok(self.record.clone());
+        }
+        ensure!(action == "checkpoint", "Unsupported native client mutation");
+        let run = request["run_id"]
+            .as_str()
+            .context("Native client operation missing")?;
+        ensure!(
+            Uuid::parse_str(run)?.to_string() == run,
+            "Native client operation is invalid"
+        );
+        if let Some((_, cp)) = &self.checkpoint {
+            ensure!(
+                cp["run_id"] == request["run_id"],
+                "An earlier client checkpoint still owns this TTY"
+            );
+            return Ok(self.record.clone());
+        }
+        ensure!(
+            self.pending_input == 0,
+            "An admitted native client input handler is still unsettled"
+        );
+        ensure!(
+            self.record["connected"] == true
+                && request["server_identity"] == self.record["server_identity"]
+                && request["baseline_display"] == self.record["display"],
+            "Native client connection or independent display baseline changed"
+        );
+        let directory = PathBuf::from(
+            request["operation_directory"]
+                .as_str()
+                .context("Native client operation directory missing")?,
+        );
+        ensure!(
+            directory.is_absolute(),
+            "Native client operation must be absolute"
+        );
+        let info = fs::symlink_metadata(&directory)?;
+        ensure!(
+            info.is_dir()
+                && info.uid() == unsafe { nix::libc::getuid() }
+                && info.mode() & 0o077 == 0,
+            "Native client operation directory is not private"
+        );
+        let replacement = PathBuf::from(
+            request["replacement_path"]
+                .as_str()
+                .context("Native client replacement missing")?,
+        );
+        let replacement_sha = immutable_image(&replacement)?;
+        ensure!(
+            request["replacement_sha256"] == replacement_sha,
+            "Native client selected image changed"
+        );
+        let server_process = &request["server_process"];
+        ensure!(
+            server_process["owner_verified"] == true
+                && server_process["pid"].as_u64().is_some()
+                && server_process["start_identity"].as_str().is_some()
+                && serde_json::from_str::<Value>(
+                    server_process["native_id"]
+                        .as_str()
+                        .context("Server incarnation missing")?
+                )? == self.record["server_identity"],
+            "Native client server process binding changed"
+        );
+        let focus = &request["focus"];
+        ensure!(
+            focus["tab_position"].as_u64().is_some()
+                && focus["pane_id"].as_array().map(|a| a.len()) == Some(2),
+            "Native client focus is unavailable"
+        );
+        ensure!(
+            request["defer_to_parent"] != true || self.record["restoration_owner"].is_object(),
+            "Native client lacks a parent-pane owner"
+        );
+        let path = directory.join(format!(
+            "zellij-client-{}.json",
+            self.record["process"]["native_id"].as_str().unwrap()
+        ));
+        let cp = json!({"schema_version":1,"restoration_owner":self.record["restoration_owner"],"defer_to_parent":request["defer_to_parent"]==true,"state":"confirmed","run_id":run,"process":self.record["process"],"tty":self.record["tty"],"server_identity":self.record["server_identity"],"server_process":server_process,"session":self.record["session"],"runtime":replacement,"replacement_sha256":replacement_sha,"focus":focus,"recoverable_input":[]});
+        save(&path, &cp)?;
+        self.checkpoint = Some((path, cp));
+        self.record["checkpoint"] = json!({"run_id":run,"state":"confirmed"});
+        self.publish()?;
+        Ok(self.record.clone())
+    }
+}
+
+pub struct ManagedClient {
+    state: Arc<Mutex<State>>,
+}
+impl ManagedClient {
+    pub fn create(
+        enabled: bool,
+        restore: Option<&Path>,
+        owner_restore: Option<&Path>,
+        parent: Option<Value>,
+        session: &str,
+        server_socket: &Path,
+    ) -> Result<Option<Self>> {
+        if !enabled {
+            return Ok(None);
+        }
+        let (_path, image) = own_image()?;
+        let home = std::env::var_os("HOME").context("Native client HOME missing")?;
+        let root = std::env::var_os("XDG_STATE_HOME")
+            .map(PathBuf::from)
+            .unwrap_or_else(|| PathBuf::from(home).join(".local/state"))
+            .join("dotfiles/zellij-activation/clients");
+        private_directory(&root)?;
+        let nonce = Uuid::new_v4().to_string();
+        let socket = root.join(format!("{}.sock", &nonce[..8]));
+        let process = json!({"pid":std::process::id(),"start_identity":started()?,"native_id":nonce,"owner_verified":true});
+        let mut record = json!({"schema_version":1,"restoration_owner":parent,"socket":socket,"process":process,"session":session,"server_identity":socket_identity(server_socket)?,"tty":tty()?,"image_sha256":image,"connected":false,"checkpoint":null,"display": (["TERM","COLORTERM","NO_COLOR","GIT_PAGER"].into_iter().map(|key|(key,std::env::var(key).ok())).collect::<std::collections::BTreeMap<_,_>>())});
+        if let Some(path) = restore.or(owner_restore) {
+            let cp = read_private(path)?;
+            ensure!(
+                cp["state"] == "confirmed"
+                    && cp["session"] == session
+                    && cp["replacement_sha256"] == image
+                    && cp["server_identity"] != record["server_identity"],
+                "Native restored client session/image/server differs"
+            );
+            if owner_restore.is_some() {
+                ensure!(
+                    cp["defer_to_parent"] == true
+                        && cp["retire_submitted"] == true
+                        && cp["restoration_owner"] == record["restoration_owner"]
+                        && cp["process"] != process,
+                    "Native restored parent-pane ownership differs"
+                );
+                let owner = &cp["restoration_owner"];
+                let launch = read_private(&path.parent().unwrap().join(format!(
+                    "zellij-pane-launch-{}-{}.json",
+                    owner["target"].as_str().unwrap(),
+                    owner["pane_id"].as_u64().unwrap()
+                )))?;
+                ensure!(
+                    launch["run_id"] == cp["run_id"]
+                        && launch["terminal_session_id"] == owner["target"]
+                        && launch["pane_id"] == owner["pane_id"]
+                        && launch["wrapper_process"]["pid"] == process["pid"]
+                        && launch["wrapper_process"]["start_identity"] == process["start_identity"],
+                    "Native nested one-time wrapper binding differs"
+                );
+            } else {
+                ensure!(
+                    cp["process"]["pid"] == process["pid"]
+                        && cp["process"]["start_identity"] == process["start_identity"]
+                        && cp["tty"] == record["tty"],
+                    "Native restored client differs from original TTY/PID"
+                );
+                let launch = read_private(&path.parent().unwrap().join(format!(
+                    "zellij-client-exec-{}.json",
+                    cp["process"]["native_id"].as_str().unwrap()
+                )))?;
+                ensure!(
+                    launch["run_id"] == cp["run_id"] && launch["process"] == cp["process"],
+                    "Native client one-time exec receipt differs"
+                );
+            }
+            record["restored_checkpoint"] = json!({"run_id":cp["run_id"],"process":cp["process"],"tty":cp["tty"],"focus":cp["focus"],"input_recovery_path":path});
+        }
+        let listener = UnixListener::bind(&socket)?;
+        fs::set_permissions(&socket, fs::Permissions::from_mode(0o600))?;
+        let state = Arc::new(Mutex::new(State {
+            record,
+            metadata: root.join(format!("{}.json", nonce)),
+            checkpoint: None,
+            pending_input: 0,
+            retire: None,
+        }));
+        state.lock().unwrap().publish()?;
+        *ACTIVE.get_or_init(|| Mutex::new(None)).lock().unwrap() = Some(state.clone());
+        let served = state.clone();
+        thread::Builder::new()
+            .name("activation-client".into())
+            .spawn(move || {
+                for stream in listener.incoming() {
+                    let Ok(mut stream) = stream else { continue };
+                    let result = (|| -> Result<Value> {
+                        peer_owned(&stream)?;
+                        stream.set_read_timeout(Some(Duration::from_secs(5)))?;
+                        let mut line = String::new();
+                        BufReader::new(&stream).take(16_385).read_line(&mut line)?;
+                        ensure!(line.len() <= 16_384, "Native client request exceeds limit");
+                        served.lock().unwrap().command(serde_json::from_str(&line)?)
+                    })();
+                    let reply = match result {
+                        Ok(value) => value,
+                        Err(error) => json!({"error":error.to_string()}),
+                    };
+                    let _ = writeln!(stream, "{}", reply);
+                    let callback = {
+                        let mut state = served.lock().unwrap();
+                        if state.record["retire_submitted"] == true {
+                            state.retire.take()
+                        } else {
+                            None
+                        }
+                    };
+                    if let Some(callback) = callback {
+                        callback();
+                    }
+                }
+            })?;
+        Ok(Some(Self { state }))
+    }
+    pub fn nonce(&self) -> String {
+        self.state.lock().unwrap().record["process"]["native_id"]
+            .as_str()
+            .unwrap()
+            .to_owned()
+    }
+    pub fn connected(&self) -> Result<()> {
+        let mut state = self.state.lock().unwrap();
+        if state.record["connected"] == true {
+            return Ok(());
+        }
+        state.record["connected"] = json!(true);
+        state.publish()
+    }
+    pub fn retirement_callback(&self, callback: impl Fn() + Send + Sync + 'static) {
+        self.state.lock().unwrap().retire = Some(Arc::new(callback));
+    }
+    pub fn restoration_focus(path: Option<&Path>) -> Result<Option<(usize, (u32, bool))>> {
+        let Some(path) = path else { return Ok(None) };
+        let cp = read_private(path)?;
+        Ok(Some((
+            cp["focus"]["tab_position"]
+                .as_u64()
+                .context("Retained client tab unavailable")? as usize,
+            (
+                cp["focus"]["pane_id"][0]
+                    .as_u64()
+                    .context("Retained client pane unavailable")? as u32,
+                cp["focus"]["pane_id"][1]
+                    .as_bool()
+                    .context("Retained client pane type unavailable")?,
+            ),
+        )))
+    }
+    /// Retirement only waits for the owning operation's verified server-ready receipt.
+    pub fn resume_after_retirement(&self) -> Result<()> {
+        let (path, cp) = {
+            let mut state = self.state.lock().unwrap();
+            state.record["connected"] = json!(false);
+            state.publish()?;
+            ensure!(
+                state.record["input_retention_error"].is_null(),
+                "Native client input durability is unresolved; retain this TTY"
+            );
+            match &state.checkpoint {
+                Some(value) => value.clone(),
+                None => return Ok(()),
+            }
+        };
+        let old_socket = PathBuf::from(
+            cp["server_identity"][0]
+                .as_str()
+                .context("Retained native socket unavailable")?,
+        );
+        loop {
+            let key = sha256(cp["session"].as_str().unwrap().as_bytes());
+            let ready_path = path
+                .parent()
+                .unwrap()
+                .join(format!("zellij-server-ready-{}.json", key));
+            if let Ok(ready) = read_private(&ready_path) {
+                if ready["run_id"] == cp["run_id"]
+                    && ready["original_process"] == cp["server_process"]
+                    && socket_identity(&old_socket).ok()
+                        == Some(serde_json::from_str(
+                            ready["process"]["native_id"]
+                                .as_str()
+                                .context("Verified server incarnation missing")?,
+                        )?)
+                    && ready["process"]["native_id"] != cp["server_identity"].to_string()
+                {
+                    let runtime = PathBuf::from(cp["runtime"].as_str().unwrap());
+                    ensure!(
+                        immutable_image(&runtime)? == cp["replacement_sha256"],
+                        "Client replacement image changed before exec"
+                    );
+                    let launch = path.parent().unwrap().join(format!(
+                        "zellij-client-exec-{}.json",
+                        cp["process"]["native_id"].as_str().unwrap()
+                    ));
+                    let mut out = OpenOptions::new()
+                        .write(true)
+                        .create_new(true)
+                        .mode(0o600)
+                        .open(&launch)
+                        .context("Retained client exec intent: reconcile without replay")?;
+                    serde_json::to_writer(
+                        &mut out,
+                        &json!({"state":"requested","run_id":cp["run_id"],"process":cp["process"]}),
+                    )?;
+                    out.sync_all()?;
+                    File::open(path.parent().unwrap())?.sync_all()?;
+                    let error = Command::new(runtime)
+                        .args([
+                            "--activation-client",
+                            "--activation-client-restoration",
+                            path.to_str().unwrap(),
+                            "attach",
+                            cp["session"].as_str().unwrap(),
+                        ])
+                        .env_remove("ZELLIJ")
+                        .env_remove("ZELLIJ_SESSION_NAME")
+                        .env_remove("ZELLIJ_PANE_ID")
+                        .exec();
+                    bail!("Native client exec remains unconfirmed: {}", error);
+                }
+            }
+            thread::sleep(Duration::from_millis(20));
+        }
+    }
+}
+pub struct InputAdmission {
+    state: Option<Arc<Mutex<State>>>,
+}
+impl Drop for InputAdmission {
+    fn drop(&mut self) {
+        if let Some(state) = &self.state {
+            state.lock().unwrap().pending_input -= 1;
+        }
+    }
+}
+/// The admission count starts before forwarding and ends after the whole input handler.
+pub fn input_admission(bytes: &[u8]) -> Result<Option<InputAdmission>> {
+    let active = ACTIVE
+        .get()
+        .and_then(|global| global.lock().unwrap().clone());
+    let Some(active) = active else {
+        return Ok(Some(InputAdmission { state: None }));
+    };
+    let mut state = active.lock().unwrap();
+    if let Some((path, cp)) = &mut state.checkpoint {
+        cp["recoverable_input"]
+            .as_array_mut()
+            .unwrap()
+            .push(json!(bytes));
+        let retained = (|| -> Result<()> {
+            ensure!(
+                serde_json::to_vec(&cp["recoverable_input"])?.len() <= 3 * 1024 * 1024,
+                "Native recoverable input checkpoint reached its private size limit"
+            );
+            save(path, cp)
+        })();
+        state.record["input_retention_error"] = retained
+            .err()
+            .map(|error| json!(error.to_string()))
+            .unwrap_or(Value::Null);
+        let _ = state.publish();
+        return Ok(None);
+    }
+    state.pending_input += 1;
+    drop(state);
+    Ok(Some(InputAdmission {
+        state: Some(active),
+    }))
+}
+
+pub fn checkpointed() -> bool {
+    ACTIVE
+        .get()
+        .and_then(|global| global.lock().ok()?.clone())
+        .map(|active| active.lock().unwrap().checkpoint.is_some())
+        .unwrap_or(false)
+}
