+/// Read the actual connection peer rather than trusting a client-supplied nonce.
+#[cfg(unix)]
+fn activation_peer_pid(stream: &interprocess::local_socket::Stream) -> Option<u32> {
+    use std::os::fd::AsRawFd;
+    let interprocess::local_socket::Stream::UdSocket(socket) = stream;
+    let fd = socket.inner().as_raw_fd();
+    #[cfg(target_os = "linux")]
+    {
+        let mut credentials = std::mem::MaybeUninit::<nix::libc::ucred>::uninit();
+        let mut size = std::mem::size_of::<nix::libc::ucred>() as nix::libc::socklen_t;
+        if unsafe {
+            nix::libc::getsockopt(
+                fd,
+                nix::libc::SOL_SOCKET,
+                nix::libc::SO_PEERCRED,
+                credentials.as_mut_ptr().cast(),
+                &mut size,
+            )
+        } != 0
+        {
+            return None;
+        }
+        let credentials = unsafe { credentials.assume_init() };
+        if credentials.uid != unsafe { nix::libc::getuid() } {
+            return None;
+        }
+        return u32::try_from(credentials.pid).ok();
+    }
+    #[cfg(target_os = "macos")]
+    {
+        let mut uid = 0;
+        let mut gid = 0;
+        let mut pid: i32 = 0;
+        let mut size = std::mem::size_of::<i32>() as nix::libc::socklen_t;
+        if unsafe { nix::libc::getpeereid(fd, &mut uid, &mut gid) } != 0
+            || uid != unsafe { nix::libc::getuid() }
+        {
+            return None;
+        }
+        if unsafe { nix::libc::getsockopt(fd, 0, 2, (&mut pid as *mut i32).cast(), &mut size) } != 0
+        {
+            return None;
+        }
+        return u32::try_from(pid).ok();
+    }
+    #[cfg(not(any(target_os = "linux", target_os = "macos")))]
+    None
+}
