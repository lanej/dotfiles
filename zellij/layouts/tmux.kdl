// One row at the top on every tab; terminal panes use the configured title frames.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
    }
    tab { pane; }

    tab_template name="with_bar" {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
    }
    swap_tiled_layout name="columns" {
        with_bar {
            pane split_direction="vertical" { children; }
        }
    }
    swap_tiled_layout name="rows" {
        with_bar {
            pane split_direction="horizontal" { children; }
        }
    }
    swap_tiled_layout name="stacked" {
        with_bar {
            pane stacked=true { children; }
        }
    }
    // The left work pane occupies half the width. Remaining panes share the
    // right column vertically. Percent sizes continue to fit window resizes.
    swap_tiled_layout name="equalize" {
        with_bar {
            pane split_direction="vertical" {
                pane size="50%"
                pane { children; }
            }
        }
    }
}
