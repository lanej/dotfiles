// Zellij 0.46.0. See docs/zellij.md for tmux mappings and remaining gaps.
// Start explicitly with `zellij --session NAME`; shell startup is unchanged.
default_mode "locked"
default_layout "tmux"
theme "dotfiles"
on_force_close "detach"
// Give the dedicated nested popup client its own prefix keys immediately.
nested_session_handling "descend"
auto_layout false
pane_frames true
pane_frame_style "full"
// Show scroll position only while a pane is away from live output.
hide_scroll_indicator_when_idle true
mouse_mode false
mouse_hover_tips false
mouse_scroll_resize false
scroll_mode_sync false
show_startup_tips false
show_release_notes false
scrollback_editor "nvim"
copy_clipboard "system"
copy_on_select true
// A prefix is two keystrokes; never use its bare suffix to release live typing.
live_view_release_key "Alt Enter"

// Keep clipboard ownership outside any tab's visible status bar. Suppressed
// background plugins survive when their containing tab closes.
load_plugins {
    pane-navigation
    command-prompt
    "zellij:link"
    "file:~/.config/zellij/plugins/lane-status.wasm" {
        role "clipboard-receiver"
    }
}

// A bounded history, not a RAM-byte guarantee. Recovery snapshots are smaller
// than the live buffer so long-running agents do not rewrite 100k lines/second.
scroll_buffer_size 100000
session_serialization true
serialize_pane_viewport true
scrollback_lines_to_serialize 10000
serialization_interval 60

// Keep ordinary background output quiet. Explicitly watched panes still report
// activity; successful shell commands become attention after thirty seconds.
attention {
    idle_rule "watched"
    done_threshold_secs 30
}

plugins {
    command-prompt location="file:~/.local/share/zellij/plugins/command-prompt.wasm"
    pane-navigation location="file:~/.local/share/zellij/plugins/pane-navigation.wasm"
}
keybinds clear-defaults=true {
    locked {
        bind "Ctrl f" { SwitchToMode "Tmux"; }
    }
    normal {
        bind "Ctrl f" { SwitchToMode "Tmux"; }
    }
    tmux {
        bind "Esc" "Enter" "Ctrl c" { SwitchToMode "Locked"; }
        // which-key: Keybinding guide
        bind "?" {
            LaunchOrFocusPlugin "file:~/.local/share/zellij/plugins/which-key.wasm" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Locked";
        }
        // which-key: Command palette
        bind ":" {
            // Consent replaces this marker with this client's private plugin ID.
            MessagePlugin "command-prompt" { name "command-prompt"; }
            SwitchToMode "Locked"
        }
        // tmux.conf's later picker overrides its earlier Ctrl-f send-prefix.
        // Ctrl-f f still sends a literal Ctrl-f to the application.
        // which-key: Send Ctrl-f
        bind "f" { Write 6; SwitchToMode "Locked"; }
        // which-key: Tab picker
        bind "Ctrl f" {
            Run "zellij-picker" "tabs" {
                floating true
                close_on_exit true
                width "90%"
                height "90%"
            }
            SwitchToMode "Locked"
        }
        // which-key: Session picker
        bind "Ctrl w" {
            Run "zellij-picker" "sessions" {
                floating true
                close_on_exit true
            }
            SwitchToMode "Locked"
        }
        // which-key: Next attention
        bind "Ctrl a" {
            // The consented background receiver installs a client-private target.
            MessagePlugin "file:~/.config/zellij/plugins/lane-status.wasm" {
                name "attention-next-tab"
            }
            SwitchToMode "Locked"
        }
        // which-key: Inbox
        bind "b" { SwitchToMode "Locked"; ToggleSessionCard; }
        // which-key: Notification history
        bind "B" {
            Run "zellij-notify" "history" {
                floating true
                close_on_exit true
                name "Notification history"
                width "90%"
                height "90%"
            }
            SwitchToMode "Locked"
        }
        // which-key: Watch pane
        bind "a" {
            MessagePlugin "file:~/.config/zellij/plugins/lane-status.wasm" {
                name "attention-highest-tab"
            }
            SwitchToMode "Locked"
        }
        bind "A" { WatchPane; SwitchToMode "Locked"; }
        // which-key: Mute pane
        bind "U" { MutePane; SwitchToMode "Locked"; }

        // which-key: Focus left

        bind "h" "Left" { MoveFocus "Left"; SwitchToMode "Locked"; }
        // which-key: Focus down
        bind "j" "Down" { MoveFocus "Down"; SwitchToMode "Locked"; }
        // which-key: Focus up
        bind "k" "Up" { MoveFocus "Up"; SwitchToMode "Locked"; }
        // which-key: Focus right
        bind "l" "Right" { MoveFocus "Right"; SwitchToMode "Locked"; }
        // which-key: Next pane
        bind "Tab" "o" { FocusNextPane; SwitchToMode "Locked"; }
        // which-key: Last pane
        bind ";" { FocusLastPane; SwitchToMode "Locked"; }
        // which-key: Equalize panes
        bind "=" { Run "zellij-balance" "equalize" { background true; }; SwitchToMode "Locked"; }
        // which-key: Golden ratio
        bind "g" { Run "zellij-balance" "golden" { background true; }; SwitchToMode "Locked"; }
        // which-key: Force golden ratio
        bind "G" { Run "zellij-balance" "golden-force" { background true; }; SwitchToMode "Locked"; }
        // which-key: Split below
        bind "s" "\"" { NewPane "Down"; SwitchToMode "Locked"; }
        // which-key: Split right
        bind "v" "%" { NewPane "Right"; SwitchToMode "Locked"; }
        // which-key: New tab
        bind "c" { NewTab; SwitchToMode "Locked"; }
        // which-key: Next tab
        bind "Ctrl n" "n" { GoToNextTab; SwitchToMode "Locked"; }
        // which-key: Previous tab
        bind "Ctrl p" { ToggleTab; SwitchToMode "Locked"; }
        // which-key: Rename tab
        bind "r" "," { SwitchToMode "RenameTab"; TabNameInput 0; }
        // which-key: Detach
        bind "d" { SwitchToMode "Locked"; Detach; }
        // which-key: Detach client
        bind "D" {
            Run "zellij-picker" "clients" { floating true; close_on_exit true; }
            SwitchToMode "Locked"
        }
        // which-key: Close pane
        bind "x" { CloseFocus; SwitchToMode "Locked"; }
        // which-key: Zoom pane
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Locked"; }
        // which-key: Zoom without UI
        bind "Z" { ToggleFocusNoUiFullscreen; SwitchToMode "Locked"; }
        // which-key: Move pane down
        bind "J" { MovePane "Down"; SwitchToMode "Locked"; }
        // which-key: Move pane up
        bind "K" { MovePane "Up"; SwitchToMode "Locked"; }
        // which-key: Grow left
        bind "<" { Resize "Increase Left"; SwitchToMode "Locked"; }
        // which-key: Grow right
        bind ">" { Resize "Increase Right"; SwitchToMode "Locked"; }
        // which-key: Grow up
        bind "+" { Resize "Increase Up"; SwitchToMode "Locked"; }
        // which-key: Grow down
        bind "-" { Resize "Increase Down"; SwitchToMode "Locked"; }
        // Zellij has no timed tmux repeat table; Ctrl-r enables explicit repeats.
        // which-key: Resize mode
        bind "Ctrl r" { SwitchToMode "Resize"; }
        // which-key: Next layout
        bind "Space" { NextSwapLayout; SwitchToMode "Locked"; }
        // which-key: Previous layout
        bind "Ctrl o" { PreviousSwapLayout; SwitchToMode "Locked"; }
        // which-key: Shared popup
        bind "P" {
            Run "zellij-popup" {
                floating true
                close_on_exit true
                name "Shared popup — Ctrl-f P hides"
                width "90%"
                height "90%"
            }
            SwitchToMode "Locked"
        }
        // which-key: Floating panes
        bind "F" { ToggleFloatingPanes; SwitchToMode "Locked"; }
        // which-key: Host session
        bind "u" { SwitchToMode "Locked"; FocusHostSession; }
        // which-key: Guest session
        bind "i" { SwitchToMode "Locked"; FocusGuestSession; }
        // Native F9's inbox action, without stealing a bare application key.
        // which-key: Session card
        bind "I" { SwitchToMode "Locked"; ToggleSessionCard; }
        // which-key: Shutdown session
        bind "Ctrl q" {
            Run "zellij-shutdown" { floating true; close_on_exit true; }
            SwitchToMode "Locked"
        }
        // which-key: Break pane
        bind "!" { BreakPane; SwitchToMode "Locked"; }
        // which-key: Move pane to tab
        bind "m" {
            Run "zellij-picker" "move-pane" {
                floating true
                close_on_exit true
                width "90%"
                height "90%"
            }
            SwitchToMode "Locked"
        }
        // which-key: Gather panes
        bind "M" {
            Run "zellij-picker" "move-all-panes" {
                floating true
                close_on_exit true
                width "90%"
                height "90%"
            }
            SwitchToMode "Locked"
        }
        // which-key: Swap tabs
        bind "W" {
            Run "zellij-picker" "swap-tab" {
                floating true
                close_on_exit true
                width "90%"
                height "90%"
            }
            SwitchToMode "Locked"
        }

        // which-key: New session

        bind "C" {
            MessagePlugin "command-prompt" { name "new-session"; }
            SwitchToMode "Locked"
        }
        // which-key: Rename session
        bind "w" { SwitchToMode "RenameSession"; SessionNameInput 0; }
        // which-key: Edit scrollback
        bind "e" { EditScrollback { ansi true; }; SwitchToMode "Locked"; }
        // which-key: Paste session yank
        bind "p" {
            // After visible-bar consent, the background clipboard receiver
            // replaces this marker with a client-specific MessagePluginId.
            MessagePlugin "file:~/.config/zellij/plugins/lane-status.wasm" {
                name "clipboard-paste"
            }
            SwitchToMode "Locked"
        }
        // which-key: Scroll mode
        bind "[" { SwitchToMode "Scroll"; }
        // which-key: Search scrollback
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        // Display zero-based indices; Zellij's GoToTab API is one-based.
        // which-key: Tab 0
        bind "0" { GoToTab 1; SwitchToMode "Locked"; }
        // which-key: Tab 1
        bind "1" { GoToTab 2; SwitchToMode "Locked"; }
        // which-key: Tab 2
        bind "2" { GoToTab 3; SwitchToMode "Locked"; }
        // which-key: Tab 3
        bind "3" { GoToTab 4; SwitchToMode "Locked"; }
        // which-key: Tab 4
        bind "4" { GoToTab 5; SwitchToMode "Locked"; }
        // which-key: Tab 5
        bind "5" { GoToTab 6; SwitchToMode "Locked"; }
        // which-key: Tab 6
        bind "6" { GoToTab 7; SwitchToMode "Locked"; }
        // which-key: Tab 7
        bind "7" { GoToTab 8; SwitchToMode "Locked"; }
        // which-key: Tab 8
        bind "8" { GoToTab 9; SwitchToMode "Locked"; }
        // which-key: Tab 9
        bind "9" { GoToTab 10; SwitchToMode "Locked"; }
    }
    resize {
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
        bind "Esc" "Enter" "Ctrl c" { SwitchToMode "Locked"; }
    }
    move {
        bind "h" "Left" { MovePane "Left"; }
        bind "j" "Down" { MovePane "Down"; }
        bind "k" "Up" { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }
        bind "Tab" "n" { MovePane; }
        bind "p" { MovePaneBackwards; }
        bind "[" { BreakPaneLeft; SwitchToMode "Locked"; }
        bind "]" { BreakPaneRight; SwitchToMode "Locked"; }
        bind "Esc" "Enter" "Ctrl c" { SwitchToMode "Locked"; }
    }
    tab {
        bind "h" "Left" { MoveTab "Left"; }
        bind "l" "Right" { MoveTab "Right"; }
        bind "Esc" "Enter" "Ctrl c" { SwitchToMode "Locked"; }
    }
    renamesession {
        bind "Enter" { SwitchToMode "Locked"; }
        bind "Esc" "Ctrl c" { UndoRenameSession; SwitchToMode "Locked"; }
    }
    renametab {
        bind "Enter" { SwitchToMode "Locked"; }
        bind "Esc" "Ctrl c" { UndoRenameTab; SwitchToMode "Locked"; }
    }
    shared_among "scroll" "search" {
        bind "Ctrl h" { MoveFocus "Left"; SwitchToMode "Locked"; }
        bind "Ctrl j" { MoveFocus "Down"; SwitchToMode "Locked"; }
        bind "Ctrl k" { MoveFocus "Up"; SwitchToMode "Locked"; }
        bind "Ctrl l" { MoveFocus "Right"; SwitchToMode "Locked"; }
    }
    scroll {
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "d" "Ctrl d" { HalfPageScrollDown; }
        bind "u" "Ctrl u" { HalfPageScrollUp; }
        bind "g" "Home" { ScrollToTop; }
        bind "G" "End" { ScrollToBottom; }
        bind "[" { ScrollToPreviousPrompt; }
        bind "]" { ScrollToNextPrompt; }
        bind "/" "s" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "e" { EditScrollback { ansi true; }; SwitchToMode "Locked"; }
        bind "m" { SelectCommandAtScrollPosition; }
        bind "y" { Copy; ScrollToBottom; SwitchToMode "Locked"; }
        bind "c" { CopyLastCommandOutput; ScrollToBottom; SwitchToMode "Locked"; }
        bind "Esc" "Enter" "q" "Ctrl c" { ScrollToBottom; SwitchToMode "Locked"; }
    }
    entersearch {
        bind "Enter" { SwitchToMode "Search"; }
        bind "Esc" "Ctrl c" { SwitchToMode "Scroll"; }
    }
    search {
        bind "n" { Search "down"; }
        bind "N" "p" { Search "up"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
        bind "e" { EditScrollback { ansi true; }; SwitchToMode "Locked"; }
        bind "Esc" "Enter" "q" "Ctrl c" { ScrollToBottom; SwitchToMode "Locked"; }
    }
}
